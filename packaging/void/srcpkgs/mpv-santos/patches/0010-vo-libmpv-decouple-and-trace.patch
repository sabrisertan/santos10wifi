+// ---- SANTOS VO HOP TRACE (diagnostic, bounded, off unless SANTOS_VO_TRACE) --
+//
+// WHY THIS EXISTS. The app-side trace can show that a frame was already late by
+// the time the render API handed it over, but `vo_is_ready_for_frame()` makes
+// that STRUCTURALLY EXPECTED: it refuses to report ready while
+// `next_pts - timing_offset - flip_queue_offset > now`, so with
+// `video-timing-offset=0` a non-positive margin at handoff proves nothing about
+// lateness. The real deadline is the strict drop condition in render_frame(),
+// `end_time = pts + duration` dropped when `end_time < now`. So the hops have to
+// be measured inside the VO, on mpv's own clock, keyed by frame.
+//
+// Two things make attribution possible rather than merely possible-in-principle:
+// there are exactly TWO sites in this VO that increment drop_count -- the strict
+// `end_time < now` path in render_frame() and the 200 ms consumer-timeout
+// cleanup in vo_libmpv's flip_page() -- so every counted drop lands in one of
+// them, and this trace names which.
+//
+// Emitted on stderr, which the client's helper already redirects to the log.
+// Timestamps are mp_time_ns(), the same clock vo_is_ready_for_frame() itself uses
+// and the same clock `next_frame.pts` is expressed in.
+static int vo_trace_state = -1;
+static unsigned long vo_trace_lines = 0;
+// 4000 was hit inside a 30 s run, which silently truncated the evidence. The
+// bound is kept, but raised so a bounded 30 s run is covered end to end, and the
+// analyser is told the cap so it can refuse to claim whole-run percentiles if the
+// trace ever does stop early.
+#define VO_TRACE_MAX_LINES 40000
+
+bool vo_trace_enabled(void)
+{
+    if (vo_trace_state < 0) {
+        const char *e = getenv("SANTOS_VO_TRACE");
+        vo_trace_state = (e && *e && *e != '0') ? 1 : 0;
+    }
+    return vo_trace_state == 1;
+}
+
+void vo_trace_event(const char *stage, unsigned long long frame_id,
+                    const char *fmt, ...)
+{
+    if (!vo_trace_enabled())
+        return;
+    if (vo_trace_lines >= VO_TRACE_MAX_LINES)
+        return;
+    vo_trace_lines++;
+    va_list ap;
+    fprintf(stderr, "SANTOS_VOTRACE stage=%s frame_id=%llu ", stage, frame_id);
+    va_start(ap, fmt);
+    vfprintf(stderr, fmt, ap);
+    va_end(ap);
+    fprintf(stderr, "\n");
+    fflush(stderr);
+}
