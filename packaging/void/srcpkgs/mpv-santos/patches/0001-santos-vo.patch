+# santos10wifi PowerVR HWC direct VO (always built; runtime-gated).
+# (santos headers via template CFLAGS; sysroot-absolute.)
+sources += files('video/out/vo_santos.c')
+santos_libdir = get_option('prefix') / get_option('libdir') / 'santos-hybris'
+santos_lib_hardware = cc.find_library('hardware', dirs: santos_libdir, required: true)
+santos_lib_hwcwindow = cc.find_library('hybris-hwcomposerwindow', dirs: santos_libdir, required: true)
+santos_lib_common = cc.find_library('hybris-common', dirs: santos_libdir, required: true)
+santos_lib_egl = cc.find_library('EGL', dirs: santos_libdir, required: true)
+santos_lib_glesv2 = cc.find_library('GLESv2', dirs: santos_libdir, required: true)
+santos_lib_sync = cc.find_library('sync', dirs: santos_libdir, required: true)
+dependencies += [santos_lib_hardware, santos_lib_hwcwindow, santos_lib_common,
+                 santos_lib_egl, santos_lib_glesv2, santos_lib_sync]
