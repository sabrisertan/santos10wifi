+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+
+#include <gio/gio.h>
+
+/* The UI needs the Santos GTK/EGL profile; the non-graphical agent and its
+ * shells do not. Clean the agent's exec environment, not the process-global
+ * environment and not stderr. A shell rc file runs too late for constructors.
+ * Unrelated preload/path entries, terminal/session variables and diagnostics
+ * remain intact. Ordinary non-Santos launches are unchanged. */
+static inline void
+ptyxis_santos_clean_agent_environment (GSubprocessLauncher *launcher)
+{
+  static const char * const private_variables[] = {
+    "GDK_BACKEND", "GSK_RENDERER", "GDK_DISABLE", "LIBEGL", "LIBGLESV2",
+    "HYBRIS_ANDROID_SDK_VERSION", "HYBRIS_LINKER_DIR", "HYBRIS_EGLPLATFORM",
+    "HYBRIS_EGLPLATFORM_DIR", "EGL_PLATFORM", "SANTOS_EGL_PLATFORM",
+    "ANDROID_ROOT", "ANDROID_DATA", "LD_SHIM_LIBS", "SANTOS_GLES2_TRACE",
+  };
+  static const char * const private_preloads[] = {
+    "/root/libsantos-tlsfix.so",
+    "/root/santos/hybris-wayland/lib/libegl-platform-compat.so",
+    "/usr/lib/santos-hybris/libEGL.so.1",
+    "/usr/lib/santos-hybris/libGLESv2.so.2",
+    "/root/santos/hybris-wayland/lib/libwayland-egl.so.1",
+  };
+  const char *value;
+
+  if (g_strcmp0 (g_getenv ("GSK_RENDERER"), "santosgl") != 0 ||
+      g_strcmp0 (g_getenv ("HYBRIS_LINKER_DIR"),
+                 "/usr/lib/santos-hybris/libhybris/linker") != 0)
+    return;
+
+  for (guint i = 0; i < G_N_ELEMENTS (private_variables); i++)
+    g_subprocess_launcher_unsetenv (launcher, private_variables[i]);
+
+  value = g_getenv ("LD_PRELOAD");
+  if (value != NULL)
+    {
+      g_auto(GStrv) entries = g_strsplit_set (value, " :", -1);
+      g_autoptr(GString) kept = g_string_new (NULL);
+
+      for (guint i = 0; entries[i] != NULL; i++)
+        {
+          gboolean is_private = FALSE;
+
+          if (entries[i][0] == 0)
+            continue;
+          for (guint j = 0; j < G_N_ELEMENTS (private_preloads); j++)
+            if (g_str_equal (entries[i], private_preloads[j]))
+              is_private = TRUE;
+          if (is_private)
+            continue;
+          if (kept->len != 0)
+            g_string_append_c (kept, ':');
+          g_string_append (kept, entries[i]);
+        }
+
+      if (kept->len == 0)
+        g_subprocess_launcher_unsetenv (launcher, "LD_PRELOAD");
+      else
+        g_subprocess_launcher_setenv (launcher, "LD_PRELOAD", kept->str, TRUE);
+    }
+
+  value = g_getenv ("LD_LIBRARY_PATH");
+  if (value != NULL)
+    {
+      g_auto(GStrv) entries = g_strsplit (value, ":", -1);
+      g_autoptr(GString) kept = g_string_new (NULL);
+      guint count = 0;
+
+      for (guint i = 0; entries[i] != NULL; i++)
+        {
+          if (g_str_equal (entries[i], "/usr/lib/santos-gtk-runtime"))
+            continue;
+          if (count++ != 0)
+            g_string_append_c (kept, ':');
+          g_string_append (kept, entries[i]);
+        }
+
+      if (count == 0)
+        g_subprocess_launcher_unsetenv (launcher, "LD_LIBRARY_PATH");
+      else
+        g_subprocess_launcher_setenv (launcher, "LD_LIBRARY_PATH", kept->str, TRUE);
+    }
+}
