pkgname=android-headers-7.1-santos
version=7.1.20170630
revision=1
short_desc="Android 7.1 headers for santos10wifi libhybris"
maintainer="Orphaned <orphan@voidlinux.org>"
license="Apache-2.0"
homepage="https://github.com/Halium/android-headers"

_commit="1f6591ba7d42b91c32acf5a65a2a4fae983d6865"

distfiles="https://github.com/Halium/android-headers/archive/${_commit}.tar.gz"
checksum=18df9c06183368f635e8d3457cd4cd60aad5549b501719dd258e630cbec5eb67

wrksrc="android-headers-${_commit}"

do_install() {
	make 		PREFIX=/usr 		DESTDIR="$DESTDIR" 		install

	mv 		"$DESTDIR/usr/include/android" 		"$DESTDIR/usr/include/android-7.1"

	sed -i 		's#/usr/include/android#/usr/include/android-7.1#g' 		"$DESTDIR/usr/lib/pkgconfig/android-headers.pc"

	mv 		"$DESTDIR/usr/lib/pkgconfig/android-headers.pc" 		"$DESTDIR/usr/lib/pkgconfig/android-headers-7.1.pc"
}
