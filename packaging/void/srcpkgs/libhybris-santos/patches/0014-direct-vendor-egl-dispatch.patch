+/* Vendor EGL exposes extension entry points through eglGetProcAddress,
+ * even when they are absent from its dynamic symbol table. */
+static void *hybris_resolve_egl_extension(const char *name)
+{
+    HYBRIS_DLSYSM(egl, &_eglGetProcAddress, "eglGetProcAddress");
+    return _eglGetProcAddress ? (void *)_eglGetProcAddress(name) : NULL;
+}
