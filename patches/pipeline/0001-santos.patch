+/// Convert Pipeline's normalized 0..1 UI volume to libmpv's 0..100 scale.
+///
+/// libmpv applies `volume` to the software mixer.  Passing 1.0 directly
+/// would mean 1% and produces an apparently silent PipeWire stream.
+fn set_volume_on(handle: *mut MpvHandle, volume: f64) -> Result<(), String> {
+    let percent = volume.clamp(0.0, 1.0) * 100.0;
+    let result = set_double_property_on(handle, "volume", percent);
+    // ao-volume is not available until the AO has been created. The regular
+    // volume property is the authoritative mixer control; this best-effort
+    // write also updates PipeWire's AO control after file-loaded.
+    let _ = set_double_property_on(handle, "ao-volume", percent);
+    result
+}
