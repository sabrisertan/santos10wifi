diff --git a/integration/README.md b/integration/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..290f379574a63b39776fceb36da294386c742870
--- /dev/null
+++ b/integration/README.md
@@ -0,0 +1,57 @@
+# Pipeline private runtime integration
+
+`santos-pipeline` is the source of the installed desktop launcher. It uses the
+existing private app, resource and libmpv identities; historical `/opt` names
+are intentionally retained to avoid moving binaries or breaking rollback paths.
+
+The private stage must also contain:
+
+- `usr/share/glib-2.0/schemas/de.schmidhuberj.tubefeeder.gschema.xml`, copied from
+  this source tree's `data/` directory;
+- `usr/share/glib-2.0/schemas/gschemas.compiled`, compiled with
+  `glib-compile-schemas --strict`;
+- `usr/libexec/pipeline-network/yt-dlp`, built **static** from
+  `santos-network-exec.c`; every in-app PATH-based yt-dlp entry point uses this
+  boundary so no dynamic graphics preload runs before sanitation;
+- `data-identity.sha256`, containing the full SHA256 of both schema files and
+  the static network helper.
+
+The common GTK environment helper strips inherited GNOME schema paths. The
+launcher therefore sets **only this application's** `GSETTINGS_SCHEMA_DIR`
+after the common helper, leaving its allowlist, global GTK profile and existing
+user dconf values untouched. The application ID and schema path do not change.
+
+`santos-pipeline.desktop` supplies the public name **Pipeline** and the original
+upstream icon. Its historical installed desktop-file ID may be retained for
+existing favorites. URI placeholders are deliberately absent: this binary has
+no GApplication file/URI handler. The stable public command is
+`/usr/local/bin/santos-pipeline`; the old candidate command is a compatibility
+alias, not a second application or a second playback backend.
+
+Normal launches use `RUST_LOG=warn`: fault/error diagnostics and ordinary vendor
+stderr remain, while per-frame INFO and player DEBUG output are not written.
+An explicit `SANTOS_CANDIDATE_RUST_LOG=info,tubefeeder::player=debug` remains
+available for bounded instrumentation. This does not eliminate the binary's
+normal callbacks or establish an FPS gain. Expensive periodic metrics/RPC and
+sample vectors are separately opt-in with `PIPELINE_SANTOS_METRICS=1`.
+
+The VO decoupling preference is supplied before application exec, never with
+`set_var()` after GTK/Tokio threads start. The default is1; an explicit diagnostic
+`SANTOS_VO_LIBMPV_DECOUPLE=0` remains possible. The network child does not inherit
+that video preference or the GTK/schema/private-library environment. The exact
+known TLS-only networking shim is kept, as are user HOME/PATH/proxies and ordinary
+stdin/stdout/stderr; argv is forwarded unchanged to `/usr/bin/yt-dlp`.
+
+Streaming quality defaults to a720p maximum, with360/480/720/1080 choices in
+Preferences. This does not upscale or relabel the bitstream. Only verified
+H.264/MP4 sources at≤30fps are accepted, and the progressive fallback follows
+the same constraints. If HD is only offered at60fps, a lower compatible source
+can still be selected; the actual encoded/decoded width and height are shown,
+separately from the viewport. Download-quality settings remain independent.
+
+The synchronized local recipe now carries the source delta and complete private
+runtime layout, without a runtime dependency on the standalone mpv package.
+The app/private libmpv must still be built and frozen together;
+the standalone `mpv-santos-cli` package is independent and must not be removed
+to install Pipeline metadata. Actual launch/render/recovery acceptance remains
+separate from a file-hash or build check.
diff --git a/integration/santos-network-exec.c b/integration/santos-network-exec.c
new file mode 100644
index 0000000000000000000000000000000000000000..e0b0547887cafc983acfbf7abdacf934c1cdefef
--- /dev/null
+++ b/integration/santos-network-exec.c
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Static, single-threaded exec boundary for all Pipeline yt-dlp entry points.
+ * No dynamic loader/preloads run before cleanup. Preserve argv and ordinary
+ * stdin/stdout/stderr; do not log URLs, cookies, tokens or complete arguments.
+ */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static const char *const graphics_keys[] = {
+    "LD_PRELOAD", "LD_LIBRARY_PATH", "GDK_BACKEND", "GSK_RENDERER", "GDK_DISABLE",
+    "LIBEGL", "LIBGLESV2", "HYBRIS_ANDROID_SDK_VERSION", "HYBRIS_LINKER_DIR",
+    "HYBRIS_EGLPLATFORM", "HYBRIS_EGLPLATFORM_DIR", "EGL_PLATFORM", "SANTOS_EGL_PLATFORM",
+    "ANDROID_ROOT", "ANDROID_DATA", "LD_SHIM_LIBS", "GI_TYPELIB_PATH", "GNOME_SHELL_DATADIR",
+    "GSETTINGS_SCHEMA_DIR", "SANTOS_GLES2_TRACE", "SANTOS_VO_LIBMPV_DECOUPLE", NULL
+};
+
+int main(int argc, char **argv)
+{
+    const char *tls = "/root/libsantos-tlsfix.so";
+    const char *value = getenv("LD_PRELOAD");
+    char *preload = value ? strdup(value) : NULL;
+    int keep_tls = 0;
+    if (value && !preload)
+        return 125;
+    if (preload) {
+        char *save = NULL;
+        for (char *part = strtok_r(preload, ": \t\r\n", &save); part;
+             part = strtok_r(NULL, ": \t\r\n", &save)) {
+            if (strcmp(part, tls) == 0)
+                keep_tls = 1;
+        }
+    }
+    free(preload);
+    for (size_t i = 0; graphics_keys[i]; i++) {
+        if (unsetenv(graphics_keys[i]) != 0)
+            return 125;
+    }
+    if (keep_tls && setenv("LD_PRELOAD", tls, 1) != 0)
+        return 125;
+    (void)argc;
+    argv[0] = "/usr/bin/yt-dlp";
+    execv(argv[0], argv);
+    fprintf(stderr, "Pipeline network helper: yt-dlp exec failed: %s\n", strerror(errno));
+    return 127;
+}
diff --git a/integration/santos-pipeline b/integration/santos-pipeline
new file mode 100644
index 0000000000000000000000000000000000000000..65d42de024908048e266b88163a81d92a75ffd62
--- /dev/null
+++ b/integration/santos-pipeline
@@ -0,0 +1,117 @@
+#!/bin/sh
+# Verified private Pipeline runtime. Internal paths retain their historical
+# names; the public desktop name does not define acceptance or binary identity.
+set -eu
+
+ROOT=/opt/pipeline-santos-candidate
+APP=$ROOT/usr/bin/tubefeeder
+LIBDIR=$ROOT/usr/lib/pipeline-santos
+LIB=$LIBDIR/libmpv.so.2.5.0
+SONAME=$LIBDIR/libmpv.so.2
+IDENTITY=$ROOT/identity.sha256
+SCHEMA_DIR=$ROOT/usr/share/glib-2.0/schemas
+NETWORK_DIR=$ROOT/usr/libexec/pipeline-network
+DATA_IDENTITY=$ROOT/data-identity.sha256
+PROFILE=$ROOT/gtk4-client-candidate.ini
+HELPER=/usr/libexec/santos-client-environment
+PROCMATCH=/usr/local/bin/santos-proc-match
+LOG=/var/log/santos-pipeline-candidate.log
+
+log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG"; }
+
+# Preserve the accepted serialized launch and exact-identity stale-instance
+# cleanup. No cmdline-based shortcut is introduced for application cleanup.
+LOCKDIR=${XDG_RUNTIME_DIR:-/tmp}/santos-pipeline-candidate.lock
+LOCK_WAIT_TRIES=600
+lock_release() { rm -rf "$LOCKDIR" 2>/dev/null || true; }
+acquire_lock() {
+  _tries=0
+  while : ; do
+    if mkdir "$LOCKDIR" 2>/dev/null; then
+      echo "$$" > "$LOCKDIR/pid"
+      return 0
+    fi
+    _owner=$(cat "$LOCKDIR/pid" 2>/dev/null || echo "")
+    if [ -n "$_owner" ] && [ ! -d "/proc/$_owner" ]; then
+      rm -rf "$LOCKDIR" 2>/dev/null || true
+      continue
+    fi
+    _tries=$((_tries + 1))
+    if [ "$_tries" -ge "$LOCK_WAIT_TRIES" ]; then
+      return 1
+    fi
+    sleep 0.2
+  done
+}
+
+# Normal desktop launches already have the product user's live session.
+# This retained convenience path is only for an explicit root invocation.
+if [ "$(id -u)" = 0 ]; then
+  shell_pid=$(pgrep -u santos -f '/root/santos/gnome51/usr/bin/gnome-shell' | head -1 || true)
+  [ -n "$shell_pid" ] || { log "FATAL no live product session for re-exec"; exit 4; }
+  session_bus=$(tr '\0' '\n' <"/proc/$shell_pid/environ" \
+    | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' | head -1 || true)
+  [ -n "$session_bus" ] || { log "FATAL product session has no DBUS address"; exit 4; }
+  log "re-exec into product session uid=santos bus_present=yes"
+  exec runuser -u santos -- env -i \
+    HOME=/home/santos USER=santos LOGNAME=santos LANG=C.UTF-8 \
+    PATH=/usr/lib/santos-gtk-client-runtime/bin:/usr/local/bin:/usr/bin:/bin \
+    XDG_RUNTIME_DIR=/run/user/1001 WAYLAND_DISPLAY=wayland-0 \
+    DBUS_SESSION_BUS_ADDRESS="$session_bus" \
+    PULSE_SERVER=unix:/run/user/1001/pulse/native \
+    XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=GNOME XDG_SESSION_DESKTOP=gnome \
+    setsid "$0" "$@"
+fi
+
+[ -x "$APP" ] || { log "FATAL missing Pipeline app $APP"; exit 2; }
+[ -f "$LIB" ] || { log "FATAL missing private libmpv $LIB"; exit 2; }
+[ -L "$SONAME" ] || { log "FATAL missing SONAME link $SONAME"; exit 2; }
+[ -f "$PROFILE" ] || { log "FATAL missing private profile $PROFILE"; exit 2; }
+[ -f "$IDENTITY" ] || { log "FATAL missing identity file $IDENTITY"; exit 2; }
+[ -f "$DATA_IDENTITY" ] || { log "FATAL missing Pipeline data identity $DATA_IDENTITY"; exit 2; }
+[ -f "$SCHEMA_DIR/gschemas.compiled" ] || { log "FATAL missing Pipeline settings schema"; exit 2; }
+[ -x "$PROCMATCH" ] || { log "FATAL missing helper $PROCMATCH"; exit 2; }
+[ -x "$NETWORK_DIR/yt-dlp" ] || { log "FATAL missing scoped network helper"; exit 2; }
+
+# The original three-file identity gate remains a full hash on every launch.
+# The independent data gate also binds the schema XML and compiled table.
+# Neither gate caches mtime/inodes or continues after a mismatch.
+for _identity in "$IDENTITY" "$DATA_IDENTITY"; do
+  if ! (cd "$ROOT" && sha256sum -c --status "$_identity") 2>>"$LOG"; then
+    log "FATAL identity mismatch for Pipeline runtime:"
+    (cd "$ROOT" && sha256sum -c "$_identity") >>"$LOG" 2>&1 || true
+    exit 3
+  fi
+done
+log "identity_ok $(tr '\n' ' ' <"$IDENTITY")"
+
+if ! acquire_lock; then
+  log "FATAL could not acquire launcher lock; refusing to launch unlocked"
+  exit 5
+fi
+trap lock_release EXIT INT TERM
+
+# Keep the existing bounded TERM/KILL policy and authoritative pid + starttime
+# + resolved-exe revalidation in the compiled helper. A failed reap is fatal.
+reap_out=$("$PROCMATCH" reap 6000 2>/dev/null) || reap_rc=$?
+reap_rc=${reap_rc:-0}
+if [ "$reap_rc" -ne 0 ]; then
+  log "FATAL stale-instance reap failed rc=$reap_rc; refusing to launch"
+  exit 6
+fi
+case "$reap_out" in
+  *REAP*recorded=0*) ;;
+  *REAP*) log "stale_instances_reaped $(printf '%s' "$reap_out" | tr '\n' ' ')" ;;
+esac
+
+# The common helper deliberately removes an inherited GSETTINGS_SCHEMA_DIR
+# from GNOME. Set this application-specific directory AFTER that sanitation,
+# without adding it to the common allowlist or changing the desktop's schema.
+RUST_LOG=${SANTOS_CANDIDATE_RUST_LOG:-warn} \
+  setsid "$HELPER" --profile "$PROFILE" --exec /usr/bin/env \
+    GSETTINGS_SCHEMA_DIR="$SCHEMA_DIR" \
+    PATH="$NETWORK_DIR:$PATH" \
+    SANTOS_VO_LIBMPV_DECOUPLE="${SANTOS_VO_LIBMPV_DECOUPLE:-1}" \
+    "$APP" "$@" >>"$LOG" 2>&1 &
+
+exit 0
