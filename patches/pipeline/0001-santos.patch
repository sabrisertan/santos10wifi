+fn command_on(handle: *mut MpvHandle, args: &[&str]) -> Result<(), String> {
+    let mut owned = Vec::with_capacity(args.len());
+    for arg in args {
+        owned.push(c_string(arg)?);
+    }
+    let mut pointers = Vec::with_capacity(owned.len() + 1);
+    pointers.extend(owned.iter().map(|arg| arg.as_ptr()));
+    pointers.push(ptr::null());
+    let result = unsafe { mpv_command(handle, pointers.as_ptr()) };
+    if result < 0 {
+        Err(error_text(result))
+    } else {
+        Ok(())
+    }
+}
