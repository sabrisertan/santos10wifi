+        self.last_metrics_render_callbacks = self.render_callbacks;
+        self.last_metrics_render_submits = self.render_submits;
+        let update_p50 = percentile_ms(&self.update_samples_ns, 0.50);
+        let update_p95 = percentile_ms(&self.update_samples_ns, 0.95);
+        let update_max = percentile_ms(&self.update_samples_ns, 1.0);
+        let render_p50 = percentile_ms(&self.render_samples_ns, 0.50);
+        let render_p95 = percentile_ms(&self.render_samples_ns, 0.95);
+        let render_max = percentile_ms(&self.render_samples_ns, 1.0);
