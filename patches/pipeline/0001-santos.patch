+        // Per-interval, and ONLY per-interval. The previous code left the gap
+        // vector in place across intervals, so the "interval" p50/p95/max were
+        // whole-run figures that silently drifted as samples accumulated, and the
+        // buffer stopped accepting samples at 4096. The whole-run distribution is
+        // still available, but it is reported under an explicit `run_` prefix.
+        let interval_gaps = std::mem::take(&mut self.interval_submit_gaps_ns);
+        let run_jitter = self.run_jitter_summary();
+
+        // Supply-side loss, as a per-interval DELTA. `frame-drop-count` is mpv's
+        // own account of frames the VO discarded; `decoder-frame-drop-count` is
+        // the decoder's. Both must be differenced: an absolute counter beside a
+        // per-interval submit count is how a supply problem gets misread as an app
+        // problem.
+        let frame_drop_now = self.get_i64("frame-drop-count");
+        let decoder_drop_now = self.get_i64("decoder-frame-drop-count");
+        let frame_drop_delta = match (frame_drop_now, self.last_frame_drop) {
+            (Some(now), Some(previous)) if now >= previous => Some(now - previous),
+            _ => None,
+        };
+        let decoder_drop_delta = match (decoder_drop_now, self.last_decoder_drop) {
+            (Some(now), Some(previous)) if now >= previous => Some(now - previous),
+            _ => None,
+        };
+        self.last_frame_drop = frame_drop_now;
+        self.last_decoder_drop = decoder_drop_now;
+
+        // Drain the trace so completed records reach the log, and surface the
+        // supply-side inter-pending distribution for this interval.
+        let (trace_superseded, trace_emitted, trace_dropped, inter_pending) =
+            if let Some(sink) = self.frame_trace.as_ref() {
+                sink.log_completed();
+                let gaps = sink.take_inter_pending_gaps();
+                let mut sorted: Vec<u64> = gaps.iter().copied().collect();
+                sorted.sort_unstable();
+                let stat = |q: f64| -> f64 {
+                    if sorted.is_empty() {
+                        return -1.0;
+                    }
+                    let last = sorted.len() - 1;
+                    sorted[((last as f64) * q).round().clamp(0.0, last as f64) as usize] as f64
+                        / 1_000_000.0
+                };
+                let summary = format!(
+                    "inter_pending_p50_ms={:.1} inter_pending_p95_ms={:.1} inter_pending_max_ms={:.1} inter_pending_n={} inter_pending_gt67={} inter_pending_gt100={}",
+                    stat(0.50),
+                    stat(0.95),
+                    if sorted.is_empty() {
+                        -1.0
+                    } else {
+                        *sorted.last().unwrap() as f64 / 1_000_000.0
+                    },
+                    sorted.len(),
+                    sorted.iter().filter(|g| **g > 67_000_000).count(),
+                    sorted.iter().filter(|g| **g > 100_000_000).count(),
