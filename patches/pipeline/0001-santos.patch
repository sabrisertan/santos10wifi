+pub(crate) fn startup_mark(stage: &str) {
+    if !startup_trace_enabled() {
+        return;
+    }
+    note_stage(stage);
+    let base = *STARTUP_AT.get_or_init(std::time::Instant::now);
+    log::info!(
+        "Pipeline startup stage={stage} elapsed_ms={}",
+        base.elapsed().as_millis()
+    );
+}
