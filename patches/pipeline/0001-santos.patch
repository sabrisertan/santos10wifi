+            mstat(0.95),
+            margins.last().copied().unwrap_or(0.0),
+            margin_late,
+            if margins.is_empty() {
+                -1.0
+            } else {
+                margin_late as f64 / margins.len() as f64
+            },
+            target_jumps,
+        );
