+impl MpvPlayer {
+    pub fn new(volume: f64, speed: f64, render_wakeup: RenderWakeup) -> Result<Self, String> {
+        // The launcher supplies the explicit VO opt-in before exec. Never
+        // mutate the Unix process environment after Tokio/GTK threads exist.
+        let handle = unsafe { mpv_create() };
+        if handle.is_null() {
+            return Err("mpv_create returned null".into());
+        }
+
+        let player = Self {
+            handle,
+            render_context: ptr::null_mut(),
+            render_wakeup,
+            render_callback_state: None,
+            pending_update_flags: Cell::new(0),
+            render_queued: Cell::new(false),
+            frame_trace: None,
+            last_metrics_pump_attempts: 0,
+            last_metrics_update_frame_positives: 0,
+            last_metrics_pending_frame_transitions: 0,
+            last_metrics_queue_render_calls: 0,
+            last_metrics_queue_render_calls_pump: 0,
+            last_metrics_queue_render_calls_reveal: 0,
+            last_metrics_queue_render_calls_other: 0,
+            last_metrics_queue_coalesced: 0,
+            last_metrics_render_callbacks_frame: 0,
+            last_metrics_update_flag_positives: 0,
+            pump_attempts: 0,
+            update_frame_positives: 0,
+            pending_frame_transitions: 0,
+            queue_render_calls: 0,
+            queue_render_calls_pump: 0,
+            queue_render_calls_reveal: 0,
+            queue_render_calls_other: 0,
+            queue_coalesced: 0,
+            render_callbacks_frame: 0,
+            interval_submit_gaps_ns: Vec::new(),
+            run_submit_gaps_ns: Vec::new(),
+            last_submit_at: None,
+            last_frame_drop: None,
+            last_decoder_drop: None,
+            update_flag_positives: 0,
+            render_callback_counters: Arc::new(RenderCallbackCounters::new()),
+            render_wakeup_normal_priority: false,
+            state: PlaybackState::Stopped,
+            position: 0.0,
+            duration: 0.0,
+            volume: volume.clamp(0.0, 1.0),
+            muted: false,
+            speed: speed.clamp(0.25, 4.0),
+            error: None,
+            pending_stream: None,
+            active_stream: None,
+            first_current_frame_seen: false,
+            holding_recovery_frame: false,
+            has_file: false,
+            load_phase: LoadPhase::Idle,
+            renderer_error: None,
+            recovery_exhausted: false,
+            awaiting_new_start: false,
+            new_start_seen: false,
+            last_position: 0.0,
+            continuous_position: 0.0,
+            last_progress_at: Instant::now(),
+            recovery_request: None,
+            recovery_snapshot: None,
+            recovery_resume_target: None,
+            recovery_resume_seek_sent: false,
+            recovery_resume_started_at: None,
+            recovery_resume_landing_pending: false,
+            recovery_resume_restart_seen: false,
+            recovery_resume_landing_position: None,
+            recovery_resume_last_position: 0.0,
+            recovery_resume_last_forward_at: None,
+            recovery_sustained: false,
+            last_frame_submit_at: Instant::now(),
+            cache_pause_observed: false,
+            media_generation: 0,
+            current_playlist_entry_id: 0,
+            video_identity: String::new(),
+            video_format: None,
+            audio_format: None,
+            separate_audio: false,
+            poll_ticks: 0,
+            events_only_poll: false,
+            render_error_reported: false,
+            first_frame_submitted: false,
+            next_frame_counts: NextFrameCounts::default(),
+            next_frame_unsupported_logged: false,
+            frame_gate_logged: false,
+            vdx_log_seen: false,
+            fault_after_ms: std::env::var("PIPELINE_SANTOS_RECOVERY_FAULT_AFTER_MS")
+                .ok()
+                .and_then(|value| value.parse().ok())
+                .unwrap_or(0),
+            fault_injected: false,
+            queue_render_requests: 0,
+            render_callbacks: 0,
+            render_submits: 0,
+            last_metrics_at: Instant::now(),
+            last_metrics_cpu_ticks: None,
+            last_metrics_render_callbacks: 0,
+            last_metrics_render_submits: 0,
+            last_metrics_queue_render_requests: 0,
+            update_samples_ns: Vec::new(),
+            render_samples_ns: Vec::new(),
+            static_diagnostic_logged: false,
+            cached_video_w: 0,
+            cached_video_h: 0,
+            cached_video_fps: 0.0,
+            cached_video_params: String::new(),
+            cached_profile: String::new(),
+            cached_timing_offset: "0".to_string(),
+            quality_evidence: QualityEvidence::default(),
+            last_quality_probe: None,
+            metrics_enabled: matches!(std::env::var("PIPELINE_SANTOS_METRICS").as_deref(),
+                Ok("1") | Ok("true") | Ok("on")),
+        };
+
+        let timing_offset_override = std::env::var("PIPELINE_SANTOS_MPV_TIMING_OFFSET")
+            .ok()
+            .filter(|value| !value.trim().is_empty());
+        let timing_offset_val = timing_offset_override.as_deref().unwrap_or("0");
+
+        for (name, value) in [
+            ("vo", "libmpv"),
+            ("ao", "pipewire"),
+            ("audio-device", "auto"),
+            ("vd", "santos_vdx"),
+            ("opengl-es", "yes"),
+            // The GTK FBO is consumed by the next snapshot; forcing an
+            // OpenGL flush/finish inside libmpv serializes the i686 GLES2
+            // driver against that readback and throttles the UI callback.
+            ("opengl-early-flush", "no"),
+            ("opengl-glfinish", "no"),
+            ("hwdec", "no"),
+            ("config", "no"),
+            ("load-scripts", "no"),
+            ("osc", "no"),
+            ("ytdl", "no"),
+            ("load-stats-overlay", "no"),
+            ("load-console", "no"),
+            ("load-auto-profiles", "no"),
+            ("load-select", "no"),
+            ("load-positioning", "no"),
+            ("load-commands", "no"),
+            ("load-context-menu", "no"),
+            ("terminal", "no"),
+            ("audio-display", "no"),
+            ("idle", "yes"),
+            ("keep-open", "no"),
+            ("network-timeout", "30"),
+            (
+                "demuxer-lavf-o",
+                "reconnect=1,reconnect_at_eof=1,reconnect_streamed=1,reconnect_delay_max=5",
+            ),
+            ("demuxer-lavf-probe-info", "yes"),
+            ("video-sync", "audio"),
+            // Keep target-time pacing nonblocking while retaining audio as the
+            // timing source. This is the internally consistent first timing
+            // candidate; the GTK render callback must remain bounded.
+            ("video-timing-offset", timing_offset_val),
+        ] {
+            if let Err(error) = player.set_option(name, value) {
+                // A few mpv builds differ in optional option availability; the
+                // core path options remain hard failures below.
+                log::warn!("mpv option {name}={value} was rejected: {error}");
+            }
+        }
+
+        // FRAMEDROP A/B OVERRIDE -- diagnostic only, unset in the product path.
+        //
+        // mpv's own default for `framedrop` is `vo`, so leaving this unset is
+        // byte-for-byte the pre-existing product behaviour and is arm A. The
+        // override exists ONLY so a single binary can be run as arm B without a
+        // second build, which removes any build difference between the arms. It
+        // must never be baked in: `framedrop=no` makes mpv keep late frames and
+        // therefore accumulate A/V drift instead of dropping them, so it is a
+        // measurement, not a candidate product setting.
+        let framedrop_override = std::env::var("PIPELINE_SANTOS_MPV_FRAMEDROP")
+            .ok()
+            .filter(|value| !value.trim().is_empty());
+        if let Some(ref value) = framedrop_override {
+            if let Err(error) = player.set_option("framedrop", value) {
+                log::error!("mpv option framedrop={value} was rejected: {error}");
+            }
+        }
+        log::info!(
+            "Pipeline mpv timing options video_sync=audio video_timing_offset={} \
+             block_for_target_time=0 report_swap=never framedrop_override={} \
+             framedrop_effective=read-back-in-diagnostic video_timing_offset_effective=read-back-in-diagnostic",
+            timing_offset_val,
+            framedrop_override.as_deref().unwrap_or("unset-mpv-default(vo)")
+        );
+
+        let init_result = unsafe { mpv_initialize(player.handle) };
+        if init_result < 0 {
+            let error = error_text(init_result);
+            // `player` already owns the handle: Drop is the sole destroy path,
+            // including this failed-initialize return and later option errors.
+            return Err(error);
+        }
+
+        set_volume_on(player.handle, player.volume)?;
+        player.set_double_property("speed", player.speed)?;
+        let log_level = c_string("info")?;
+        let log_result = unsafe { mpv_request_log_messages(player.handle, log_level.as_ptr()) };
+        if log_result < 0 {
+            log::warn!(
+                "Could not request libmpv log messages: {}",
+                error_text(log_result)
+            );
+        }
+        Ok(player)
+    }
+
+    fn set_option(&self, name: &str, value: &str) -> Result<(), String> {
+        set_option_on(self.handle, name, value)
+    }
+
+    fn set_double_property(&self, name: &str, value: f64) -> Result<(), String> {
+        set_double_property_on(self.handle, name, value)
+    }
+
+    fn set_flag_property(&self, name: &str, value: bool) -> Result<(), String> {
+        set_flag_property_on(self.handle, name, value)
+    }
+
+    fn get_double(&self, name: &str) -> Option<f64> {
+        let name = c_string(name).ok()?;
+        let mut value = 0.0;
+        let result = unsafe {
+            mpv_get_property(
+                self.handle,
+                name.as_ptr(),
+                MPV_FORMAT_DOUBLE,
+                &mut value as *mut c_double as *mut c_void,
+            )
+        };
+        (result >= 0).then_some(value)
+    }
+
+    fn get_flag(&self, name: &str) -> Option<bool> {
+        let name = c_string(name).ok()?;
+        let mut value = 0;
+        let result = unsafe {
+            mpv_get_property(
+                self.handle,
+                name.as_ptr(),
+                MPV_FORMAT_FLAG,
+                &mut value as *mut c_int as *mut c_void,
+            )
+        };
+        (result >= 0).then_some(value != 0)
+    }
+
+    fn get_i64(&self, name: &str) -> Option<i64> {
+        let name = c_string(name).ok()?;
+        let mut value = 0i64;
+        let result = unsafe {
+            mpv_get_property(
+                self.handle,
+                name.as_ptr(),
+                MPV_FORMAT_INT64,
+                &mut value as *mut i64 as *mut c_void,
+            )
+        };
+        (result >= 0).then_some(value)
+    }
+
+    fn get_string(&self, name: &str) -> Option<String> {
+        let name = c_string(name).ok()?;
+        let ptr = unsafe { mpv_get_property_string(self.handle, name.as_ptr()) };
+        if ptr.is_null() {
+            return None;
+        }
+        let value = unsafe { CStr::from_ptr(ptr).to_string_lossy().into_owned() };
+        unsafe { mpv_free(ptr.cast()) };
+        Some(value)
+    }
+
+    fn command(&self, args: &[&str]) -> Result<(), String> {
+        command_on(self.handle, args)
+    }
+
+    fn loadfile_command(&self, video_url: &str, audio_url: Option<&str>) -> Result<i64, String> {
+        let command = c_string("loadfile")?;
+        let video = c_string(video_url)?;
+        let replace = c_string("replace")?;
+        let mut args = vec![
+            MpvNode {
+                data: MpvNodeData {
+                    string: command.as_ptr().cast_mut(),
+                },
+                format: MPV_FORMAT_STRING,
+            },
+            MpvNode {
+                data: MpvNodeData {
+                    string: video.as_ptr().cast_mut(),
+                },
+                format: MPV_FORMAT_STRING,
+            },
+            MpvNode {
+                data: MpvNodeData {
+                    string: replace.as_ptr().cast_mut(),
+                },
+                format: MPV_FORMAT_STRING,
+            },
+            MpvNode {
+                data: MpvNodeData { int64_: -1 },
+                format: MPV_FORMAT_INT64,
+            },
+        ];
+        let (option_name, option_value) = if let Some(audio_url) = audio_url {
+            (Some(c_string("audio-file")?), Some(c_string(audio_url)?))
+        } else {
+            (None, None)
+        };
+        let mut option_keys = [ptr::null_mut()];
+        let mut option_values = [MpvNode {
+            data: MpvNodeData {
+                string: ptr::null_mut(),
+            },
+            format: 0,
+        }];
+        let mut option_list;
+        if option_name.is_some() {
+            option_keys[0] = option_name.as_ref().unwrap().as_ptr().cast_mut();
+            option_values[0] = MpvNode {
+                data: MpvNodeData {
+                    string: option_value.as_ref().unwrap().as_ptr().cast_mut(),
+                },
+                format: MPV_FORMAT_STRING,
+            };
+            option_list = Some(MpvNodeList {
+                num: 1,
+                values: option_values.as_mut_ptr(),
+                keys: option_keys.as_mut_ptr(),
+            });
+            args.push(MpvNode {
+                data: MpvNodeData {
+                    list: option_list.as_mut().unwrap(),
+                },
+                format: MPV_FORMAT_NODE_MAP,
+            });
+        }
+        let mut arg_list = MpvNodeList {
+            num: args.len() as c_int,
+            values: args.as_mut_ptr(),
+            keys: ptr::null_mut(),
+        };
+        let mut arg_node = MpvNode {
+            data: MpvNodeData {
+                list: &mut arg_list,
+            },
+            format: MPV_FORMAT_NODE_ARRAY,
+        };
+        let mut result = MpvNode {
+            data: MpvNodeData {
+                list: ptr::null_mut(),
+            },
+            format: 0,
+        };
+        let status = unsafe { mpv_command_node(self.handle, &mut arg_node, &mut result) };
+        if status < 0 {
+            return Err(error_text(status));
+        }
+        let entry_id = playlist_entry_id_from_node(&result);
+        unsafe { mpv_free_node_contents(&mut result) };
+        entry_id.ok_or_else(|| "loadfile did not return playlist_entry_id".to_string())
+    }
+
+    fn recovery_snapshot(&self) -> RecoverySnapshot {
+        RecoverySnapshot {
+            video_identity: self.video_identity.clone(),
+            media_generation: self.media_generation,
+            position: self.continuous_position.max(0.0),
+            paused: self
+                .get_flag("pause")
+                .unwrap_or(self.state == PlaybackState::Paused),
+            volume: self.volume,
+            muted: self.muted,
+            speed: self.speed,
+            video_format: self.video_format.clone(),
+            audio_format: self.audio_format.clone(),
+            separate_audio: self.separate_audio,
+            max_height: self.quality_evidence.selected.as_ref().map_or(
+                crate::stream_quality::DEFAULT_MAX_HEIGHT, |quality| quality.max_height),
+        }
+    }
+
+    fn request_recovery(&mut self, cause: RecoveryCause) {
+        if self.recovery_exhausted {
+            // Terminal state is stable: only a Manual Retry or a new media
+            // selection may start another recovery cycle.
+            return;
+        }
+        // A replacement that has not produced a first frame, or whose one
+        // deferred resume seek never becomes sustained-forward, may request a
+        // fresh bounded resolution while preserving the original snapshot.
+        // Clear the pending target before handing the request to the page so a
+        // slow resolver cannot generate duplicate replacement requests.
+        let replacement_retry = matches!(
+            cause,
+            RecoveryCause::EndFileError | RecoveryCause::NoProgress
+        ) && self.recovery_snapshot.is_some()
+            && (self.recovery_resume_target.is_some() || cause == RecoveryCause::EndFileError);
+        if self.recovery_request.is_some()
+            || (self.recovery_snapshot.is_some() && !replacement_retry)
+        {
+            return;
+        }
+        let snapshot = match self.recovery_snapshot.clone() {
+            Some(snapshot) => snapshot,
+            None => self.recovery_snapshot(),
+        };
+        if replacement_retry {
+            self.recovery_resume_target = None;
+            self.recovery_resume_seek_sent = false;
+            self.recovery_resume_started_at = None;
+            self.recovery_resume_landing_pending = false;
+            self.recovery_resume_restart_seen = false;
+            self.recovery_resume_landing_position = None;
+            self.recovery_resume_last_forward_at = None;
+        }
+        log::warn!(
+            "Pipeline recovery classification={} saved_resume={:.2}s generation={} separate_audio={}",
+            cause.label(),
+            snapshot.position,
+            snapshot.media_generation,
+            snapshot.separate_audio
+        );
+        self.recovery_snapshot = Some(snapshot.clone());
+        self.recovery_request = Some(RecoveryRequest { cause, snapshot });
+        self.state = PlaybackState::Buffering;
+        self.error = None;
+    }
+
+    pub fn take_recovery_request(&mut self) -> Option<RecoveryRequest> {
+        self.recovery_request.take()
+    }
+
+    pub fn media_generation(&self) -> u64 {
+        self.media_generation
+    }
+
+    pub fn recovery_sustained(&self) -> bool {
+        self.recovery_sustained
+    }
+
+    pub fn acknowledge_recovery_sustained(&mut self) {
+        if !self.recovery_sustained {
+            return;
+        }
+        self.recovery_sustained = false;
+        self.recovery_snapshot = None;
+        self.recovery_resume_target = None;
+        self.recovery_resume_seek_sent = false;
+        self.recovery_resume_started_at = None;
+        self.recovery_resume_landing_pending = false;
+        self.recovery_resume_restart_seen = false;
+        self.recovery_resume_landing_position = None;
+        self.recovery_resume_last_position = self.position;
+        self.recovery_resume_last_forward_at = None;
+        log::info!("Pipeline recovery sustained playback confirmed");
+    }
+
+    pub fn cancel_recovery(&mut self) {
+        self.recovery_request = None;
+        self.recovery_snapshot = None;
+        self.recovery_resume_target = None;
+        self.recovery_resume_seek_sent = false;
+        self.recovery_resume_started_at = None;
+        self.recovery_resume_landing_pending = false;
+        self.recovery_resume_restart_seen = false;
+        self.recovery_resume_landing_position = None;
+        self.recovery_resume_last_position = self.position;
+        self.recovery_resume_last_forward_at = None;
+        self.recovery_sustained = false;
+    }
+
+    pub fn prepare_recovery_cycle(&mut self) {
+        self.error = None;
+        self.render_error_reported = false;
+        self.state = PlaybackState::Buffering;
+        self.has_file = false;
+        // A Manual Retry is an explicit user action, so it clears the terminal
+        // latch. Without this the terminal error would be unreachable.
+        self.recovery_exhausted = false;
+        self.load_phase = LoadPhase::Idle;
+        self.awaiting_new_start = false;
+        self.new_start_seen = false;
+        self.invalidate_frame_gate();
+    }
+
+    pub fn fail_recovery(&mut self, error: impl Into<String>) {
+        let error = error.into();
+        self.recovery_request = None;
+        self.recovery_snapshot = None;
+        self.recovery_resume_target = None;
+        self.recovery_resume_seek_sent = false;
+        self.recovery_resume_started_at = None;
+        self.recovery_resume_landing_pending = false;
+        self.recovery_resume_restart_seen = false;
+        self.recovery_resume_landing_position = None;
+        self.recovery_resume_last_forward_at = None;
+        self.recovery_sustained = false;
+        self.state = PlaybackState::Error;
+        self.error = Some(error.clone());
+        self.has_file = false;
+        // Latch the terminal state so automatic triggers cannot re-enter it.
+        // Previously each automatic trigger re-fired immediately after the
+        // budget was spent, producing an unbounded terminal-error loop.
+        self.recovery_exhausted = true;
+        self.load_phase = LoadPhase::Idle;
+        if !self.handle.is_null() {
+            let _ = self.set_flag_property("pause", true);
+            // A terminal deadline must also cancel an in-flight libavformat
+            // open/read, not merely pause a file that has not loaded yet.
+            // This is normal mpv file stop, never a driver unload or reset.
+            let _ = self.command(&["stop"]);
+        }
+        log::error!("Pipeline recovery failed: {error} (terminal state latched)");
+    }
+
+    fn fail_render(&mut self, error: impl Into<String>) {
+        let error = error.into();
+        if !self.render_error_reported {
+            log::error!("Pipeline render failure: {error}");
+        }
+        self.render_error_reported = true;
+        self.fail_renderer(error);
+    }
+
+    pub fn invalidate_frame_gate(&mut self) {
+        self.first_frame_submitted = false;
+        self.frame_gate_logged = false;
+        // Fresh presentation/media generation: restart the bounded next-frame
+        // evidence so the log describes the generation being gated, not a mix.
+        self.next_frame_counts = NextFrameCounts::default();
+    }
+
+    /// Attach the per-frame path trace sink and mirror the media generation into
+    /// it, so a replacement stream can never be confused with the outgoing one.
+    pub fn attach_frame_trace(&mut self, sink: Rc<FrameTraceSink>) {
+        sink.set_generation(self.media_generation);
+        self.frame_trace = Some(sink);
+    }
+
+    /// A `GtkGLArea::queue_render()` was ACTUALLY executed.
+    ///
+    /// This is the single accounting point, and it is only ever reached at a real
+    /// `queue_render()` call site. The previous `note_queue_render()` was called
+    /// before the pump had decided anything, so `queue_render_requests` recorded
+    /// PUMP ATTEMPTS and the separately-declared `queue_render_calls` was never
+    /// incremented at all, which is why evidence reported `qrender=0`. The reason
+    /// is kept so a reveal-boundary request is distinguishable from a pump-driven
+    /// one: the L197 boundary requests renders that carry no new video frame.
+    pub fn note_queue_render(&mut self, reason: QueueRenderReason) {
+        self.queue_render_calls = self.queue_render_calls.wrapping_add(1);
+        match reason {
+            QueueRenderReason::PumpFrame => {
+                self.queue_render_calls_pump =
+                    self.queue_render_calls_pump.wrapping_add(1);
+            }
+            QueueRenderReason::RevealBoundary => {
+                self.queue_render_calls_reveal =
+                    self.queue_render_calls_reveal.wrapping_add(1);
+            }
+            QueueRenderReason::Other => {
+                self.queue_render_calls_other = self.queue_render_calls_other.wrapping_add(1);
+            }
+        }
+        if let Some(sink) = self.frame_trace.as_ref() {
+            sink.mark_queued();
+        }
+    }
+
+    /// Inter-submit jitter in ms for the CURRENT interval:
+    /// (p50, p95, max, >50ms, >67ms, >100ms).
+    ///
+    /// This is the figure that belongs next to a per-interval submit count. A 30 fps
+    /// source expects a new displayed frame about every 33.3 ms, so sustained gaps
+    /// beyond ~67 ms are visible stutter even when the average rate looks
+    /// acceptable.
+    pub fn submit_jitter_summary(&self) -> Option<(f64, f64, f64, usize, usize, usize)> {
+        Self::jitter_of(&self.interval_submit_gaps_ns)
+    }
+
+    /// Whole-run inter-submit jitter in ms, same tuple shape as above. Reported
+    /// separately and explicitly as `run_*` so it is never mistaken for an
+    /// interval figure. Bounded at 4096 samples.
+    pub fn run_jitter_summary(&self) -> Option<(f64, f64, f64, usize, usize, usize)> {
+        Self::jitter_of(&self.run_submit_gaps_ns)
+    }
+
+    fn jitter_of(samples: &[u64]) -> Option<(f64, f64, f64, usize, usize, usize)> {
+        if samples.len() < 4 {
+            return None;
+        }
+        let mut v = samples.to_vec();
+        v.sort_unstable();
+        let ms = |x: u64| x as f64 / 1_000_000.0;
+        let last = v.len() - 1;
+        let p = |q: f64| ms(v[((last as f64) * q).round().clamp(0.0, last as f64) as usize]);
+        Some((
+            p(0.50),
+            p(0.95),
+            ms(*v.last().unwrap()),
+            v.iter().filter(|g| ms(**g) > 50.0).count(),
+            v.iter().filter(|g| ms(**g) > 67.0).count(),
+            v.iter().filter(|g| ms(**g) > 100.0).count(),
+        ))
+    }
+
+    /// Read the dispatch mode requested by the environment, so the A/B can be
+    /// run on device without rebuilding. Test-only; absent variable keeps the
+    /// existing default-idle behaviour.
+    ///
+    /// `PIPELINE_SANTOS_RENDER_WAKE_PRIORITY=normal` selects a normal-priority
+    /// main-context dispatch instead of the `glib::idle_add_once`
+    /// default-idle hop. Only the main-loop hop changes: the mpv callback
+    /// still performs no mpv API call and no GL call, there is no busy loop,
+    /// and the old 33 ms frame timer is not restored.
+    pub fn apply_wakeup_dispatch_env(&mut self) {
+        if let Ok(value) = std::env::var("PIPELINE_SANTOS_RENDER_WAKE_PRIORITY")
+            && value == "normal"
+        {
+            self.render_wakeup_normal_priority = true;
+        }
+    }
+
+    /// Standalone handle for recording wake-latency stage timestamps.
+    ///
+    /// The page holds its own clone so stage markers never have to borrow
+    /// `MpvPlayer`. That matters because a normal-priority wakeup can be
+    /// delivered from inside the GtkGLArea render callback, where the page is
+    /// already holding a `RefCell` borrow of the player; borrowing it again
+    /// would panic.
+    pub fn wake_counters(&self) -> Arc<RenderCallbackCounters> {
+        self.render_callback_counters.clone()
+    }
+
+    /// Drain and summarise the bounded wake-latency samples as
+    /// (p50, p95, max) milliseconds for each measured hop, in milliseconds.
+    /// Samples are consumed by the caller, so each interval reports only its own
+    /// measurements.
+    fn take_wake_latency(&mut self) -> Option<WakeLatencySummary> {
+        let counters = self.render_callback_counters.clone();
+        let take = |m: &std::sync::Mutex<Vec<Instant>>| -> Vec<Instant> {
+            match m.lock() {
+                Ok(mut v) => std::mem::take(&mut *v),
+                Err(_) => Vec::new(),
+            }
+        };
+        let callback = take(&counters.callback_at);
+        let wake = take(&counters.wake_at);
+        let queue = take(&counters.queue_at);
+        let gl_start = take(&counters.gl_start_at);
+        let gl_done = take(&counters.gl_done_at);
+        if callback.is_empty() {
+            return None;
+        }
+        // Pair consecutive samples per stage. The stages are produced in order
+        // for a single frame, so index i of each vector belongs to the same
+        // frame; the vectors are truncated to the shortest to stay paired.
+        let n = callback
+            .len()
+            .min(wake.len())
+            .min(queue.len())
+            .min(gl_start.len())
+            .min(gl_done.len());
+        if n == 0 {
+            return None;
+        }
+        fn delta(a: &[Instant], b: &[Instant], n: usize) -> Vec<u128> {
+            (0..n)
+                .map(|i| b[i].saturating_duration_since(a[i]).as_nanos())
+                .collect()
+        }
+        fn stats(mut v: Vec<u128>) -> (f64, f64, f64) {
+            v.sort_unstable();
+            let max = *v.last().unwrap_or(&0) as f64 / 1e6;
+            (percentile(&v, 0.50), percentile(&v, 0.95), max)
+        }
+        let cb_to_wake = stats(delta(&callback, &wake, n));
+        let wake_to_gl = stats(delta(&wake, &gl_start, n));
+        let cb_to_gl = stats(delta(&callback, &gl_start, n));
+        let gl_total = stats(delta(&gl_start, &gl_done, n));
+        Some(WakeLatencySummary {
+            samples: n,
+            cb_to_wake,
+            wake_to_gl,
+            cb_to_gl,
+            gl_total,
+        })
+    }
+
+    fn try_resume_recovery(&mut self) {
+        if self.recovery_resume_seek_sent
+            || !self.has_file
+            || self.load_phase.loadfile_accepted()
+            || self.recovery_snapshot.is_none()
+            || self.recovery_resume_target.is_none()
+            || !self.first_current_frame_seen
+        {
+            return;
+        }
+        let Some(snapshot) = self.recovery_snapshot.clone() else {
+            return;
+        };
+        let width = self
+            .get_i64("video-params/w")
+            .or_else(|| self.get_i64("width"))
+            .unwrap_or_default();
+        let height = self
+            .get_i64("video-params/h")
+            .or_else(|| self.get_i64("height"))
+            .unwrap_or_default();
+        if width <= 0 || height <= 0 {
+            return;
+        }
+        let target = if self.duration > 0.0 {
+            snapshot.position.clamp(0.0, self.duration)
+        } else {
+            snapshot.position.max(0.0)
+        };
+        let target_text = target.to_string();
+        // A paused replacement cannot play a keyframe preroll up to the saved
+        // position. One exact seek still preserves pause and avoids seek steps.
+        let mode = if snapshot.paused { "absolute+exact" } else { "absolute+keyframes" };
+        match self.command(&["seek", &target_text, mode]) {
+            Ok(()) => {
+                let now = Instant::now();
+                self.recovery_resume_target = Some(target);
+                self.recovery_resume_seek_sent = true;
+                self.recovery_resume_started_at = Some(now);
+                self.recovery_resume_landing_pending = true;
+                self.recovery_resume_restart_seen = false;
+                self.recovery_resume_landing_position = None;
+                self.recovery_resume_last_position = -1.0;
+                self.recovery_resume_last_forward_at = Some(now);
+                self.last_position = target;
+                self.continuous_position = target;
+                self.last_progress_at = now;
+                self.last_frame_submit_at = now;
+                let _ = self.set_flag_property("pause", snapshot.paused);
+                self.state = if snapshot.paused {
+                    PlaybackState::Paused
+                } else {
+                    PlaybackState::Playing
+                };
+                log::info!(
+                    "Pipeline recovery resume seek requested target={:.2}s paused={} generation={}",
+                    target,
+                    snapshot.paused,
+                    self.media_generation
+                );
+            }
+            Err(error) => {
+                self.fail_recovery(format!("resume seek failed: {error}"));
+            }
+        }
+    }
+
+    /// Current media-load lifecycle state.
+    pub fn load_phase(&self) -> LoadPhase {
+        self.load_phase
+    }
+
+    /// Render-infrastructure error, if the renderer itself failed. This is shown
+    /// as a renderer error with a Retry action and never spends the yt-dlp
+    /// recovery budget.
+    pub fn renderer_error(&self) -> Option<&str> {
+        self.renderer_error.as_deref()
