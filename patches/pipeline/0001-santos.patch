+            };
+        if !self.static_diagnostic_logged && self.load_phase == LoadPhase::Loaded {
+            self.static_diagnostic_logged = true;
+            self.cached_video_w = self
+                .get_i64("video-params/w")
+                .or_else(|| self.get_i64("width"))
+                .unwrap_or_default();
+            self.cached_video_h = self
+                .get_i64("video-params/h")
+                .or_else(|| self.get_i64("height"))
+                .unwrap_or_default();
+            self.cached_video_fps = self
+                .get_double("video-params/fps")
+                .or_else(|| self.get_double("fps"))
+                .unwrap_or_default();
+            self.cached_video_params = self
+                .get_string("video-params")
+                .unwrap_or_default()
+                .replace(['\n', '\r'], " ")
+                .chars()
+                .take(240)
+                .collect();
+            self.cached_profile = self.get_string("profile").unwrap_or_default();
+            self.cached_timing_offset = self
+                .get_string("video-timing-offset")
+                .or_else(|| self.get_string("options/video-timing-offset"))
+                .unwrap_or_else(|| "0".to_string());
+
+            log::info!(
+                "Pipeline render diagnostic interval_ms={} video_params={:?} video_dec_params={:?} video_out_params={:?} video_target_params={:?} video_frame_info={:?} audio_params={:?} audio_dec_params={:?} video_codec={:?} audio_codec={:?} video_sync_effective={:?} framedrop_effective={:?} video_timing_offset_effective={:?} avsync={:?} container_fps={:?} estimated_vf_fps={:?} vo_passes={:?} vf={:?} af={:?} renderer_options={:?}",
+                elapsed.as_millis(),
+                self.property_summary("video-params", 900),
+                self.property_summary("video-dec-params", 900),
+                self.property_summary("video-out-params", 900),
+                self.property_summary("video-target-params", 900),
+                self.property_summary("video-frame-info", 500),
+                self.property_summary("audio-params", 700),
+                self.property_summary("audio-dec-params", 500),
+                self.get_string("video-codec"),
+                self.get_string("audio-codec"),
+                self.get_string("video-sync"),
+                self.get_string("framedrop"),
+                Some(&self.cached_timing_offset),
