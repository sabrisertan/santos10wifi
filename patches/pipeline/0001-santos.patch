+/// Semantic classification of the next frame libmpv would render.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum NextFrameState {
+    /// The query is not implemented by this libmpv. The first-frame gate must
+    /// stay closed rather than assume a new frame exists.
+    Unsupported,
+    /// Valid query, but no frame is pending: the GLArea holds no new content.
+    NoFrame,
+    /// A genuinely presentable new video frame.
+    Present,
+    /// A redraw request: reproduce the previous frame, no new decode.
+    Redraw,
+    /// A repeat request: reproduce the previous frame perfectly, no new decode.
+    Repeat,
+}
+
+impl NextFrameState {
+    /// A frame that carries genuinely new decoded content for the current media
+    /// generation. Redraw and repeat deliberately do NOT qualify: they reproduce
+    /// the previous presentation contents, which is exactly the stale surface the
+    /// presentation cover exists to hide.
+    pub fn is_new_content(self) -> bool {
+        matches!(self, Self::Present)
+    }
+
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::Unsupported => "unsupported",
+            Self::NoFrame => "no-frame",
+            Self::Present => "present",
+            Self::Redraw => "redraw",
+            Self::Repeat => "repeat",
+        }
+    }
+}
+
+/// Decode `mpv_render_frame_info::flags` into a readable form for the bounded
+/// gate evidence. All four documented flags are decoded so the log shows exactly
+/// which semantic the gate acted on.
+fn frame_info_flags_label(flags: u64) -> String {
+    let mut out = String::new();
+    let mut push = |name: &str| {
+        if !out.is_empty() {
+            out.push('|');
+        }
+        out.push_str(name);
+    };
+    if flags & MPV_RENDER_FRAME_INFO_PRESENT != 0 {
+        push("PRESENT");
+    }
+    if flags & MPV_RENDER_FRAME_INFO_REDRAW != 0 {
+        push("REDRAW");
+    }
+    if flags & MPV_RENDER_FRAME_INFO_REPEAT != 0 {
+        push("REPEAT");
+    }
+    if flags & MPV_RENDER_FRAME_INFO_BLOCK_VSYNC != 0 {
+        push("BLOCK_VSYNC");
+    }
+    if out.is_empty() {
+        out.push_str("none");
+    }
+    out
+}
