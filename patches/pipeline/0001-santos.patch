diff --git a/src/stream_quality.rs b/src/stream_quality.rs
new file mode 100644
index 0000000000000000000000000000000000000000..88955d1c932ad0e467fa4e88f9e5a48ccd59c6bc
--- /dev/null
+++ b/src/stream_quality.rs
@@ -0,0 +1,203 @@
+//! Input selection, not a decoder upscaler. Keep stream, decode and viewport
+//! dimensions distinct so a small source cannot be reported as HD playback.
+use serde::Deserialize;
+
+pub const DEFAULT_MAX_HEIGHT: u32 = 720;
+pub const QUALITY_HEIGHTS: [u32; 4] = [360, 480, 720, 1080];
+const MAX_WIDTH: u32 = 1920;
+const MAX_FPS: f64 = 30.0;
+
+pub fn max_height(value: u32) -> u32 {
+    if QUALITY_HEIGHTS.contains(&value) { value } else { DEFAULT_MAX_HEIGHT }
+}
+
+pub fn format_selector(height: u32) -> String {
+    let height = max_height(height);
+    // The progressive fallback has the SAME codec/size/fps constraints. Do not
+    // fall back to unbounded `best` or infer H.264 merely from an MP4 extension.
+    format!(
+        "bestvideo[vcodec^=avc1][ext=mp4][width<=1920][height<={height}][fps<=30]+bestaudio[acodec^=mp4a][ext=m4a]/best[vcodec^=avc1][ext=mp4][width<=1920][height<={height}][fps<=30]"
+    )
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct StreamQuality {
+    pub width: u32,
+    pub height: u32,
+    pub fps: f64,
+    pub max_height: u32,
+}
+
+#[derive(Clone)]
+pub struct ResolvedStream {
+    pub video_url: String,
+    pub audio_url: Option<String>,
+    pub title: Option<String>,
+    pub duration: Option<f64>,
+    pub video_format: Option<String>,
+    pub audio_format: Option<String>,
+    pub quality: Option<StreamQuality>,
+    pub is_local: bool,
+}
+
+impl ResolvedStream {
+    pub fn direct(url: impl Into<String>, duration: Option<f64>, is_local: bool) -> Self {
+        Self { video_url: url.into(), audio_url: None, title: None, duration,
+               video_format: None, audio_format: None, quality: None, is_local }
+    }
+}
+
+#[derive(Deserialize)]
+pub struct YtDlpFormat {
+    pub url: String,
+    #[serde(default)]
+    pub format_id: Option<String>,
+    #[serde(default)]
+    pub ext: Option<String>,
+    #[serde(default)]
+    pub vcodec: Option<String>,
+    #[serde(default)]
+    pub acodec: Option<String>,
+    #[serde(default)]
+    pub width: Option<u32>,
+    #[serde(default)]
+    pub height: Option<u32>,
+    #[serde(default)]
+    pub fps: Option<f64>,
+}
+
+#[derive(Deserialize)]
+pub struct YtDlpInfo {
+    #[serde(default)]
+    pub url: Option<String>,
+    #[serde(default)]
+    pub title: Option<String>,
+    #[serde(default)]
+    pub duration: Option<f64>,
+    #[serde(default)]
+    pub requested_formats: Option<Vec<YtDlpFormat>>,
+    #[serde(default)]
+    pub format_id: Option<String>,
+    #[serde(default)]
+    pub ext: Option<String>,
+    #[serde(default)]
+    pub vcodec: Option<String>,
+    #[serde(default)]
+    pub acodec: Option<String>,
+    #[serde(default)]
+    pub width: Option<u32>,
+    #[serde(default)]
+    pub height: Option<u32>,
+    #[serde(default)]
+    pub fps: Option<f64>,
+}
+
+fn avc(codec: Option<&str>) -> bool {
+    codec.is_some_and(|value| value.starts_with("avc1") || value == "h264")
+}
+
+fn quality(format: &YtDlpFormat, limit: u32) -> Option<StreamQuality> {
+    let (width, height, fps) = (format.width?, format.height?, format.fps?);
+    if !avc(format.vcodec.as_deref()) || format.ext.as_deref() != Some("mp4")
+        || width == 0 || width > MAX_WIDTH || height == 0 || height > max_height(limit)
+        || !fps.is_finite() || fps <= 0.0 || fps > MAX_FPS
+        || !(format.url.starts_with("https://") || format.url.starts_with("http://"))
+    { return None; }
+    Some(StreamQuality { width, height, fps, max_height: max_height(limit) })
+}
+
+pub fn choose_stream(info: YtDlpInfo, limit: u32) -> Result<ResolvedStream, String> {
+    if let Some(formats) = info.requested_formats.as_ref() {
+        let video = formats.iter().filter_map(|format| quality(format, limit).map(|q| (format, q)))
+            .max_by_key(|(_, q)| (q.height, q.width));
+        let audio = formats.iter().find(|format| {
+            format.acodec.as_deref().is_some_and(|codec| codec.starts_with("mp4a"))
+                && format.vcodec.as_deref().is_none_or(|codec| codec == "none")
+                && format.ext.as_deref() == Some("m4a")
+                && (format.url.starts_with("https://") || format.url.starts_with("http://"))
+        });
+        if let Some((video, quality)) = video {
+            return Ok(ResolvedStream { video_url: video.url.clone(), audio_url: audio.map(|f| f.url.clone()),
+                title: info.title, duration: info.duration, video_format: video.format_id.clone(),
+                audio_format: audio.and_then(|f| f.format_id.clone()), quality: Some(quality), is_local: false });
+        }
+    }
+    if let Some(url) = info.url {
+        let format = YtDlpFormat { url, format_id: info.format_id, ext: info.ext, vcodec: info.vcodec,
+            acodec: info.acodec, width: info.width, height: info.height, fps: info.fps };
+        if let Some(quality) = quality(&format, limit) {
+            return Ok(ResolvedStream { video_url: format.url, audio_url: None, title: info.title,
+                duration: info.duration, video_format: format.format_id, audio_format: None,
+                quality: Some(quality), is_local: false });
+        }
+    }
+    Err(format!("No verified H.264/MP4 stream at or below {}p and 30 fps", max_height(limit)))
+}
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct QualityEvidence {
+    pub selected: Option<StreamQuality>,
+    pub decoded_width: u32,
+    pub decoded_height: u32,
+    pub viewport_width: u32,
+    pub viewport_height: u32,
+}
+
+impl QualityEvidence {
+    pub fn description(&self) -> String {
+        let decoded = if self.decoded_height == 0 { "Video size pending".to_string() } else {
+            format!("Video {}×{} ({}p)", self.decoded_width, self.decoded_height, self.decoded_height)
+        };
+        if self.viewport_width == 0 { decoded } else {
+            format!("{decoded} · Surface {}×{}", self.viewport_width, self.viewport_height)
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn info(json: serde_json::Value) -> YtDlpInfo { serde_json::from_value(json).unwrap() }
+    fn video(height: u32) -> serde_json::Value {
+        serde_json::json!({"url":"https://example.invalid/video", "format_id":"v", "ext":"mp4",
+            "vcodec":"avc1.64001f", "acodec":"none", "width":height*16/9, "height":height, "fps":30.0})
+    }
+    #[test] fn default_is_720_and_fallback_is_not_unbounded() {
+        let selector = format_selector(0);
+        assert!(selector.contains("height<=720"));
+        assert!(!selector.contains("/best[ext=mp4]/best"));
+        assert_eq!(selector.matches("fps<=30").count(), 2);
+        assert_eq!(max_height(1080), 1080);
+    }
+    #[test] fn adaptive_pair_keeps_actual_resolution_not_viewport() {
+        let input = serde_json::json!({"requested_formats":[video(720),
+            {"url":"https://example.invalid/audio","format_id":"a","ext":"m4a","vcodec":"none","acodec":"mp4a.40.2"}]});
+        let stream = choose_stream(info(input), 720).unwrap();
+        assert_eq!(stream.quality.unwrap().height, 720);
+        assert!(stream.audio_url.is_some());
+    }
+    #[test] fn low_source_is_reported_low_not_promoted_to_hd() {
+        let stream = choose_stream(info(video(360)), 720).unwrap();
+        assert_eq!(stream.quality.unwrap().height, 360);
+        let q = QualityEvidence { decoded_width:640, decoded_height:360, viewport_width:1280,
+            viewport_height:720, ..Default::default() };
+        assert_eq!(q.description(), "Video 640×360 (360p) · Surface 1280×720");
+    }
+    #[test] fn explicit_1080_is_not_selected_for_720() {
+        assert!(choose_stream(info(video(1080)), 720).is_err());
+        assert_eq!(choose_stream(info(video(1080)), 1080).unwrap().quality.unwrap().height, 1080);
+    }
+    #[test] fn incompatible_or_unknown_codec_size_fps_is_refused() {
+        for (key, value) in [("vcodec", serde_json::json!("vp09")), ("height", serde_json::json!(4320)),
+            ("width", serde_json::json!(3840)), ("fps", serde_json::json!(60)),
+            ("fps", serde_json::Value::Null), ("vcodec", serde_json::Value::Null)] {
+            let mut input = video(720); input[key] = value;
+            assert!(choose_stream(info(input), 720).is_err());
+        }
+    }
+    #[test] fn progressive_format_id_is_preserved() {
+        let mut input=video(480); input["format_id"]=serde_json::json!("18");
+        let stream=choose_stream(info(input),720).unwrap();
+        assert_eq!(stream.video_format.as_deref(),Some("18")); assert!(stream.audio_url.is_none());
+    }
+}
