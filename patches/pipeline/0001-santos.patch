+                return -1.0;
+            }
+            let last = margins.len() - 1;
+            margins[(last as f64 * q).round().clamp(0.0, last as f64) as usize]
+        };
+        // `pts_minus_now_nonpos` is expected to be ~100%: vo_is_ready_for_frame()
+        // guarantees it. It is reported so that expectation is checked rather
+        // than assumed, and it is NOT labelled a lateness figure.
+        let margin_late = margins.iter().filter(|m| **m <= 0.0).count();
+        let timing_summary = format!(
+            "pts_minus_now_n={} pts_minus_now_min_ms={:.1} pts_minus_now_p50_ms={:.1} \
+             pts_minus_now_p95_ms={:.1} pts_minus_now_max_ms={:.1} \
+             pts_minus_now_nonpos={} pts_minus_now_nonpos_frac={:.2} \
