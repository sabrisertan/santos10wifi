+    /// THIS callback rendered a genuinely new, presentable, current-generation
+    /// video frame (next-frame info valid, PRESENT, and neither REDRAW nor
+    /// REPEAT). Presentation containment reveals only on this signal.
+    pub new_frame_confirmed: bool,
+    /// The next-frame classification this callback acted on.
+    pub next_state: NextFrameState,
+}
