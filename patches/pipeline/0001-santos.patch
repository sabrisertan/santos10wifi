+/// Monotonic startup milestones, process-start relative. The operator reported
+/// launches taking more than 90 seconds; without per-stage numbers that is not a
+/// diagnosable claim, so every pre-present stage is timed explicitly.
+static STARTUP_AT: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();
+
+/// Startup milestone logging is OFF in the product build.
+///
+/// The milestones are cheap individually -- no forks, a handful of lines -- but
+/// the operator's product timing measurement is the number that decides whether
+/// the launcher work is done, and a diagnostic that runs during the measurement
+/// is a diagnostic that can move it. So the product path emits only fatal and
+/// error logging, and milestone logging is opt-in through
+/// `PIPELINE_SANTOS_STARTUP_TRACE`, which the product launcher does not set.
+///
+/// The milestone SITES stay, because they are also where real work happens: the
+/// first-paint boundary is what releases the deferred history load, and
+/// `data-ready` is what releases the startup probe.
+pub(crate) fn startup_trace_enabled() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(|| {
+        matches!(
+            std::env::var("PIPELINE_SANTOS_STARTUP_TRACE").as_deref(),
+            Ok("1") | Ok("true") | Ok("on") | Ok("yes")
+        )
+    })
+}
