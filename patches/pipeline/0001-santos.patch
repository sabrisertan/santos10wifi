+    fn property_summary(&self, name: &str, max_chars: usize) -> String {
+        self.get_string(name)
+            .map(|value| {
+                redact_urls(&value)
+                    .split_whitespace()
+                    .collect::<Vec<_>>()
+                    .join(" ")
+                    .chars()
+                    .take(max_chars)
+                    .collect()
+            })
+            .unwrap_or_else(|| "<unavailable>".to_string())
+    }
+
+    fn renderer_option_summary(&self) -> String {
