+    pub fn stop(&mut self) {
+        let _ = self.command(&["stop"]);
+        self.pending_stream = None;
+        self.current_playlist_entry_id = 0;
+        self.has_file = false;
+        self.load_phase = LoadPhase::Idle;
+        self.renderer_error = None;
+        self.recovery_exhausted = false;
+        self.awaiting_new_start = false;
+        self.new_start_seen = false;
+        self.last_position = 0.0;
+        self.continuous_position = 0.0;
+        self.last_progress_at = Instant::now();
+        self.last_frame_submit_at = Instant::now();
+        self.cache_pause_observed = false;
+        self.cancel_recovery();
+        self.recovery_resume_target = None;
+        self.recovery_resume_seek_sent = false;
+        self.recovery_resume_started_at = None;
+        self.recovery_resume_landing_pending = false;
+        self.recovery_resume_restart_seen = false;
+        self.recovery_resume_landing_position = None;
+        self.recovery_resume_last_position = 0.0;
+        self.recovery_resume_last_forward_at = None;
+        self.invalidate_frame_gate();
+        self.state = PlaybackState::Stopped;
+        self.position = 0.0;
+        self.duration = 0.0;
+    }
+
+    /// Drain mpv events while a retained VideoPage is unmapped. Property
+    /// polling/render bookkeeping stays disabled, but EOF and recovery events
+    /// must not wait until the page is remapped.
+    pub fn poll_events_only(&mut self) -> (Option<RecoveryRequest>, bool) {
+        self.events_only_poll = true;
+        self.poll();
+        self.events_only_poll = false;
+        (self.recovery_request.take(), self.recovery_sustained)
+    }
+
+    /// Poll mpv on the GTK thread. No mpv calls are made from the GL callback.
+    pub fn poll(&mut self) {
+        if self.handle.is_null() {
+            return;
+        }
+        if !self.render_context.is_null()
+            && let Err(error) = self.start_pending_stream()
+        {
+            log::error!("Pipeline pending stream start failed: {error}");
+        }
+
+        loop {
+            let event_ptr = unsafe { mpv_wait_event(self.handle, 0.0) };
+            if event_ptr.is_null() {
+                break;
+            }
+            let event = unsafe { *event_ptr };
+            match event.event_id {
+                MPV_EVENT_LOG_MESSAGE => {
+                    if !event.data.is_null() {
+                        let message = unsafe { &*event.data.cast::<MpvEventLogMessage>() };
+                        if !message.text.is_null() {
+                            let text = redact_urls(
+                                &unsafe { CStr::from_ptr(message.text) }.to_string_lossy(),
+                            );
+                            let level = if message.level.is_null() {
+                                String::new()
+                            } else {
+                                unsafe { CStr::from_ptr(message.level) }
+                                    .to_string_lossy()
+                                    .into_owned()
+                            };
+                            if text.contains("VDX") || text.contains("santos_vdx") {
+                                self.vdx_log_seen = true;
+                                log::info!("libmpv: {}", text.trim_end());
+                            } else if level.contains("error")
+                                || level.contains("warn")
+                                || text.to_ascii_lowercase().contains("failed")
+                                || text.to_ascii_lowercase().contains("decoder")
+                            {
+                                log::debug!("libmpv[{level}]: {}", text.trim_end());
+                            }
+                        }
+                    }
+                }
+                MPV_EVENT_START_FILE => {
+                    let start = (!event.data.is_null())
+                        .then(|| unsafe { *event.data.cast::<MpvEventStartFile>() });
+                    let Some(start) = start else {
+                        log::warn!(
+                            "Pipeline recovery stage=stale-start-file generation={} reason=missing-entry-id",
+                            self.media_generation,
+                        );
+                        continue;
+                    };
+                    if self.current_playlist_entry_id == 0
+                        || start.playlist_entry_id != self.current_playlist_entry_id
+                    {
+                        log::warn!(
+                            "Pipeline recovery stage=stale-start-file generation={} expected_entry_id={} event_entry_id={}",
+                            self.media_generation,
+                            self.current_playlist_entry_id,
+                            start.playlist_entry_id,
+                        );
+                        continue;
+                    }
+                    log::info!(
+                        "Pipeline recovery stage=start-file generation={} playlist_entry_id={} replacement={}",
+                        self.media_generation,
+                        start.playlist_entry_id,
+                        self.recovery_snapshot.is_some(),
+                    );
+                    self.state = PlaybackState::Buffering;
+                    self.has_file = false;
+                    self.awaiting_new_start = false;
+                    self.new_start_seen = true;
+                    self.load_phase = LoadPhase::AwaitingStartFile {
+                        playlist_entry_id: start.playlist_entry_id,
+                        since_secs: 0.0,
+                    };
+                    self.error = None;
+                    self.invalidate_frame_gate();
+                    self.last_progress_at = Instant::now();
+                    if self.recovery_resume_target.is_none() {
+                        self.position = 0.0;
+                        self.last_position = 0.0;
+                        self.continuous_position = 0.0;
+                    }
+                }
+                MPV_EVENT_FILE_LOADED => {
+                    let event_entry_id = self.get_i64("playlist-entry-id");
+                    let entry_mismatch = self.current_playlist_entry_id == 0
+                        || event_entry_id.is_some_and(|id| id != self.current_playlist_entry_id);
+                    if !self.new_start_seen || entry_mismatch {
+                        log::warn!(
+                            "Pipeline stale-file-loaded ignored generation={} expected_entry_id={} property_entry_id={:?}",
+                            self.media_generation,
+                            self.current_playlist_entry_id,
+                            event_entry_id,
+                        );
+                    } else {
+                        self.has_file = true;
+                        self.refresh_decoded_quality();
+                        self.load_phase = LoadPhase::Loaded;
+                        self.last_progress_at = Instant::now();
+                        log::info!(
