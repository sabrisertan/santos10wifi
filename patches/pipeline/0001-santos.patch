+                self.current_surface().queue_render();
+            }
+        }
+
+        /// Current renderer-infrastructure error, if any. Exposed on the imp so
+        /// the outer action router can decide between a renderer retry and a
+        /// yt-dlp recovery retry.
+        pub(super) fn renderer_error_message(&self) -> Option<String> {
+            self.player
+                .borrow()
+                .as_ref()
+                .and_then(|player| player.renderer_error().map(str::to_string))
+        }
+
+        /// Retry the renderer after a GL/render-context failure. This must NOT
+        /// go through yt-dlp: there is no media problem to re-resolve.
+        pub(super) fn retry_renderer(&self) {
+            log::info!("Pipeline lifecycle stage=renderer-retry requested=by-user");
+            let old = self.current_surface();
+            if !self.release_render_context(&old) {
+                self.set_player_error("Renderer retry cannot safely release the old GL context".into());
+                return;
+            }
+            if let Some(timer) = self.render_timer.borrow_mut().take() { timer.remove(); }
+            if let Some(tick) = self.render_tick.borrow_mut().take() { tick.remove(); }
+            for slot in [&self.render_handler, &self.resize_handler, &self.realize_handler,
+                         &self.map_handler, &self.unrealize_handler, &self.create_context_handler] {
+                if let Some(handler) = slot.borrow_mut().take() { old.disconnect(handler); }
+            }
+            if let Some(handler) = self.after_paint_handler.borrow_mut().take() {
+                if let Some(clock) = self.after_paint_clock.borrow_mut().take() { clock.disconnect(handler); }
+            }
+            if let Some(player) = self.player.borrow_mut().as_mut() {
+                player.retry_renderer();
+            }
+            self.cover_presentation("renderer-recreated");
+            let area = gtk::GLArea::new();
+            area.set_valign(Align::Fill);
+            area.set_halign(Align::Fill);
+            area.set_vexpand(true);
+            *self.replacement_surface.borrow_mut() = Some(area.clone());
+            // Hook and configure the NEW widget before parenting realizes it.
+            // This actually re-enters GdkGLContext construction rather than
+            // queueing another render on the old permanently failed widget.
+            self.setup_surface(true);
+            self.video_overlay.set_child(Some(&area));
+            log::info!("Pipeline lifecycle stage=renderer-retry new_glarea=true resolver_budget_unchanged=true");
+        }
+
+        fn release_render_context(&self, area: &gtk::GLArea) -> bool {
+            if self.player.borrow().as_ref().is_none_or(|player| !player.has_render_context()) {
+                self.retained_gl_context.borrow_mut().take();
+                self.retained_frame_generation.set(None);
+                return true;
+            }
+            // A minimized page can be disposed before it is reparented. Its
+            // exact original GDK context remains owned until libmpv is freed.
+            let context = self.retained_gl_context.borrow().clone().or_else(|| area.context());
+            let Some(context) = context else {
+                log::error!("GtkGLArea context cleanup failed: original context unavailable");
+                return false;
+            };
+            context.make_current();
+            if gdk::GLContext::current().as_ref() != Some(&context) {
+                log::error!("GtkGLArea context cleanup failed: original context not current");
+                return false;
+            }
+            // The cover must re-appear whenever the current GLArea contents are
+            // no longer guaranteed to be a valid frame for the active media.
+            //
+            // Order matters: the render context is freed first (which resets the
+            // player's first-frame gate), then the cover is re-applied. That
+            // leaves frame_visible=false and the player's gate closed, so no
+            // reveal can run until a new real current-generation frame is
+            // actually submitted after unrealize/re-realize.
+            if let Some(player) = self.player.borrow_mut().as_mut() {
+                player.free_render_context_current();
+            }
+            self.retained_gl_context.borrow_mut().take();
+            self.retained_frame_generation.set(None);
+            self.cover_presentation("render-context-freed");
+            true
+        }
+
+        // ---------------------------------------------------------------
+        // External native-mpv backend
+        // ---------------------------------------------------------------
+
+        /// The session-owned external player.
+        ///
+        /// Deliberately a process-wide singleton rather than one per page: the
+        /// window builds a new `VideoPage` per video, so a per-page controller
+        /// left one player process per open page and two players on screen after
+        /// a switch. Sharing makes "one player process per Pipeline session" a
+        /// structural property instead of a hope. Nothing is spawned here, so a
+        /// session that never plays still owns no player.
+        fn external(&self) -> Arc<ExternalPlayer> {
+            if let Some(player) = self.external_player.borrow().as_ref() {
+                return Arc::clone(player);
+            }
+            let mut config = ExternalConfig::default();
+            config.volume = self.settings.double("player-volume");
+            config.speed = self.settings.double("player-speed");
+            let player = crate::external_player::session_player(config);
+            *self.external_player.borrow_mut() = Some(Arc::clone(&player));
+            player
+        }
+
+        /// Hand a resolved stream to the external player. This is the only
+        /// place the external backend issues a load, and it always creates a
+        /// new playback generation, so a stale event from an older media load
+        /// cannot mutate current UI state.
+        pub(super) fn start_external_stream(
+            &self,
+            stream: &ResolvedStream,
+            resume_position: Option<f64>,
+        ) -> Result<(), String> {
+            let player = self.external();
+            let identity = self
+                .video_identity()
+                .unwrap_or_else(|| "unknown-video".to_string());
+            let duration = stream.duration.unwrap_or(0.0);
+            self.duration.set(duration);
+            self.state_value.set(PlaybackState::Buffering);
+            self.obj().notify_state();
+            self.obj().notify_duration();
+            log::info!(
+                "Pipeline external player start identity={identity} \
+                 video_format={:?} audio_format={:?} separate_audio={} local={} resume={resume_position:?}",
+                stream.video_format,
+                stream.audio_format,
+                stream.audio_url.is_some(),
+                stream.is_local,
+            );
+            if let Some(position) = resume_position {
+                // A recovery replacement is a NEW generation, never a reuse of
+                // the stalled one, so its events cannot be confused with the
+                // generation that failed.
+                player.replace(
+                    player.next_generation(),
+                    stream.video_url.clone(),
+                    stream.audio_url.clone(),
+                    identity,
+                    stream.title.clone(),
+                    Some(position),
+                );
+            } else {
+                player.load(
+                    stream.video_url.clone(),
+                    stream.audio_url.clone(),
+                    identity,
+                    stream.title.clone(),
+                    false,
+                );
+            }
+            Ok(())
+        }
+
+        pub(super) fn external_stop(&self) {
+            if let Some(player) = self.external_player.borrow().as_ref() {
+                player.stop();
+            }
+            self.external_recovery_attempts.set(0);
+            *self.external_snapshot.borrow_mut() = None;
+        }
+
+        /// Bounded external recovery. The accepted product semantics are kept:
+        /// capture a trustworthy snapshot, one fresh resolver attempt, a
+        /// replacement media generation, one keyframe-tolerant resume, then
+        /// require sustained forward playback before calling it successful.
+        ///
+        /// Classification is preserved: a player-process or window/VO failure is
+        /// never described as a network stall, and a normal user action or EOF
+        /// never reaches here at all.
+        fn begin_external_recovery(&self, signal: RecoverySignal) {
+            if signal.class == FailureClass::Normal {
+                return;
+            }
+            if self.external_snapshot.borrow().is_none() {
+                *self.external_snapshot.borrow_mut() = Some(signal.clone());
+            }
+            let attempt = self.external_recovery_attempts.get();
+            if attempt >= RECOVERY_MAX_ATTEMPTS {
+                let message = format!(
+                    "Playback error - recovery budget exhausted ({} attempts, class={})",
+                    attempt,
+                    signal.class.label()
+                );
+                log::error!("Pipeline external recovery {message}");
+                self.set_player_error(message);
+                return;
+            }
+            self.external_recovery_attempts.set(attempt + 1);
+            self.state_value.set(PlaybackState::Buffering);
+            self.obj().notify_state();
+            log::warn!(
+                "Pipeline external recovery stage=begin class={} attempt={} position={:.3} \
+                 generation={} detail={}",
+                signal.class.label(),
+                attempt + 1,
+                signal.position,
+                signal.generation,
+                signal.detail,
+            );
+            if self.external_recovery_attempts.get() > 1 {
+                let delay = recovery_backoff(attempt);
+                glib::timeout_add_local(
+                    delay,
+                    clone!(
+                        #[weak(rename_to = obj)]
+                        self.obj(),
+                        #[upgrade_or_panic]
+                        move || {
+                            obj.imp().run_external_resolve();
+                            glib::ControlFlow::Break
+                        }
+                    ),
+                );
+            } else {
+                self.run_external_resolve();
+            }
+        }
+
+        fn run_external_resolve(&self) {
+            let Some(request) = self.video_request() else {
+                return;
+            };
+            let generation = self
+                .resolution_generation
+                .get()
+                .wrapping_add(1);
+            self.resolution_generation.set(generation);
+            let snapshot = self.external_snapshot.borrow().clone();
+            let resolver = crate::tspawn!(crate::player::resolve_video(request));
+            gspawn!(clone!(
+                #[weak(rename_to = obj)]
+                self.obj(),
+                async move {
+                    let result = resolver.await;
+                    let imp = obj.imp();
+                    if imp.resolution_generation() != generation {
+                        return;
+                    }
+                    let stream = match result {
+                        Ok(stream) => stream,
+                        Err(error) => {
+                            log::error!(
+                                "Pipeline external recovery stage=resolve-task-failed \
+                                 error={error}"
+                            );
+                            imp.set_player_error(format!("yt-dlp resolver task: {error}"));
+                            return;
+                        }
+                    };
+                    match stream {
+                        Ok(stream) => {
+                            let resume: Option<f64> =
+                                snapshot.as_ref().map(|signal| signal.position);
+                            if let Err(error) = imp.start_external_stream(&stream, resume) {
+                                imp.set_player_error(error);
+                            }
+                        }
+                        Err(error) => {
+                            // Resolver failure is its own class and never
+                            // consumes the player-process budget.
+                            log::error!(
+                                "Pipeline external recovery stage=resolve-failed error={error}"
+                            );
+                            imp.set_player_error(format!("yt-dlp: {error}"));
+                        }
+                    }
+                }
+            ));
+        }
+
+        /// Map the external state machine onto the product's PlaybackState so
+        /// the existing UI, actions and templates keep working unchanged.
+        fn poll_external(&self) {
+            let Some(player) = self.external_player.borrow().as_ref().cloned() else {
+                return;
+            };
+            let snapshot = player.snapshot();
+            let state = match snapshot.state {
+                ExternalState::Stopped => PlaybackState::Stopped,
+                ExternalState::StartingPlayer | ExternalState::LoadingMedia => {
+                    PlaybackState::Buffering
+                }
+                ExternalState::Playing | ExternalState::Seeking => PlaybackState::Playing,
+                ExternalState::Paused => PlaybackState::Paused,
+                ExternalState::Stopping => PlaybackState::Stopped,
+                ExternalState::Recovering => PlaybackState::Buffering,
+                ExternalState::TerminalError | ExternalState::PlayerProcessDead => {
+                    PlaybackState::Error
+                }
+            };
+
+            if let Some(signal) = player.take_recovery_request() {
+                self.begin_external_recovery(signal);
+            }
+            if player.recovery_sustained() {
+                player.acknowledge_recovery();
+                self.external_recovery_attempts.set(0);
+                *self.external_snapshot.borrow_mut() = None;
+                log::info!("Pipeline external recovery stage=sustained result=success");
+            }
+
+            if state == PlaybackState::Error
+                && let Some(detail) = snapshot.failure_detail.clone()
+                && self.terminal_error.borrow().is_none()
+            {
+                self.set_player_error(detail);
+            }
+            self.maybe_run_external_selftest(&snapshot);
+
+            let old_state = self.state_value.replace(state);
+            let old_position = self.position.replace(snapshot.position);
+            let old_duration = self.duration.replace(snapshot.duration);
+            let old_volume = self.volume.replace(snapshot.volume);
+            let old_muted = self.muted.replace(snapshot.muted);
+            if old_state != state {
+                self.obj().notify_state();
+            }
+            if old_position != snapshot.position {
+                self.obj().notify_position();
+            }
+            if old_duration != snapshot.duration {
+                self.obj().notify_duration();
+            }
+            if old_volume != snapshot.volume {
+                self.obj().notify_volume();
+            }
+            if old_muted != snapshot.muted {
+                self.obj().notify_muted();
+            }
+            self.load_phase_value.set(if snapshot.file_loaded {
+                crate::player::LoadPhase::Loaded
+            } else if snapshot.load_issued {
+                crate::player::LoadPhase::AwaitingFileLoaded {
+                    playlist_entry_id: 0,
+                    since_secs: 0.0,
+                }
+            } else {
+                crate::player::LoadPhase::Idle
+            });
+
+            let status_text: Option<String> = match snapshot.failure_class {
+                Some(FailureClass::WindowVo) => Some(format!(
+                    "Video output unavailable: {}",
+                    snapshot.failure_detail.unwrap_or_default()
+                )),
+                Some(FailureClass::PlayerProcess) => Some(format!(
+                    "Player process ended: {}",
+                    snapshot.failure_detail.unwrap_or_default()
+                )),
+                Some(FailureClass::MediaStall) => {
+                    Some("Reconnecting playback\u{2026}".to_string())
+                }
+                Some(FailureClass::Resolver) => Some("yt-dlp could not resolve media".into()),
+                _ => (state == PlaybackState::Buffering).then(|| {
+                    "Starting native player\u{2026}".to_string()
+                }),
+            };
+            if let Some(label) = self.control_status.borrow().as_ref() {
+                match status_text {
+                    Some(text) => {
+                        label.set_text(&text);
+                        label.set_visible(true);
+                    }
+                    None => label.set_visible(false),
+                }
+            }
+            self.updating_controls.set(true);
+            if let Some(play) = self.control_play.borrow().as_ref() {
+                play.set_icon_name(match state {
+                    PlaybackState::Playing => "media-playback-pause-symbolic",
+                    PlaybackState::Error => "view-refresh-symbolic",
+                    _ => "media-playback-start-symbolic",
+                });
+                play.set_sensitive(matches!(
+                    state,
+                    PlaybackState::Playing | PlaybackState::Paused | PlaybackState::Error
+                ));
+            }
+            if let Some(position_scale) = self.control_position.borrow().as_ref() {
+                let fraction = if snapshot.duration > 0.0 {
+                    (snapshot.position / snapshot.duration).clamp(0.0, 1.0)
+                } else {
+                    0.0
+                };
+                position_scale.set_value(fraction);
+                position_scale.set_sensitive(snapshot.duration > 0.0);
+            }
+            if let Some(volume_scale) = self.control_volume.borrow().as_ref() {
+                volume_scale.set_value(if snapshot.muted {
+                    0.0
+                } else {
+                    snapshot.volume
+                });
+            }
+            if let Some(label) = self.control_time.borrow().as_ref() {
+                label.set_text(&format!(
+                    "{} / {}",
+                    super::format_time(snapshot.position),
+                    super::format_time(snapshot.duration)
+                ));
+            }
+            self.updating_controls.set(false);
+        }
+
+        /// Opt-in, bounded controls self-test for the external backend.
+        ///
+        /// It drives the REAL product entry points - `VideoPage::play_pause`,
+        /// `seek_by`, `stop` - rather than talking to mpv directly, so a
+        /// scripted gate exercises the same code the operator's buttons do.
+        /// Nothing runs unless `PIPELINE_SANTOS_EXTERNAL_SELFTEST` names steps.
+        /// Steps: `pause`, `seek`, `stop`, `stop-socket` (a stale socket from a
+        /// dead session must be reaped, not adopted).
+        fn maybe_run_external_selftest(
+            &self,
+            snapshot: &crate::external_player::ExternalSnapshot,
+        ) {
+            if self.external_selftest_armed.get() {
+                return;
+            }
+            let Ok(steps) = std::env::var("PIPELINE_SANTOS_EXTERNAL_SELFTEST") else {
+                return;
+            };
+            let steps = steps.trim().to_string();
+            if steps.is_empty() {
+                return;
+            }
+            if snapshot.state != ExternalState::Playing {
+                return;
+            }
+            // Wait for real forward progress: pausing or seeking a player that
+            // has not actually started would prove nothing.
+            if snapshot.position < 1.0 {
+                return;
+            }
+            self.external_selftest_armed.set(true);
+            let list: Vec<String> = steps
+                .split(',')
+                .map(|step| step.trim().to_string())
+                .filter(|step| !step.is_empty())
+                .collect();
+            log::info!(
+                "Pipeline external selftest stage=begin steps={list:?} \
+                 position={:.3} vo={:?} hwdec={:?}",
+                snapshot.position,
+                snapshot.current_vo,
+                snapshot.hwdec_current
+            );
+            let obj = self.obj();
+            let mut at = Duration::from_millis(1200);
+            for step in list {
+                // The closure below takes ownership of `step`, so the pacing
+                // decision has to be made before it is moved.
+                let pause_step = step == "pause";
+                at += Duration::from_millis(if pause_step { 2500 } else { 1800 });
+                let step_label = step.clone();
+                let obj = obj.clone();
+                glib::timeout_add_local(
+                    at - Duration::from_millis(if pause_step { 2500 } else { 1800 }),
+                    clone!(
+                        #[weak]
+                        obj,
+                        #[upgrade_or_panic]
+                        move || {
+                            obj.imp().external_selftest_step(&step_label);
+                            glib::ControlFlow::Break
+                        }
+                    ),
+                );
+                log::info!("Pipeline external selftest stage=scheduled step={step}");
+            }
+            let obj = obj.clone();
+            glib::timeout_add_local(
+                at,
+                clone!(
+                    #[weak]
+                    obj,
+                    #[upgrade_or_panic]
+                    move || {
+                        obj.imp().external_selftest_step("report");
+                        glib::ControlFlow::Break
+                    }
+                ),
+            );
+        }
+
+        fn external_selftest_step(&self, step: &str) {
+            let snapshot = self
+                .external_player
+                .borrow()
+                .as_ref()
+                .map(|player| player.snapshot());
+            let state = snapshot
+                .as_ref()
+                .map(|snapshot| snapshot.state)
+                .unwrap_or(ExternalState::Stopped);
+            match step {
+                "pause" => {
+                    self.play_pause();
+                    log::info!(
+                        "Pipeline external selftest stage=pause requested=true \
+                         paused_before={} position={:.3}",
+                        snapshot.as_ref().is_some_and(|s| s.paused),
+                        snapshot.as_ref().map(|s| s.position).unwrap_or(0.0)
+                    );
+                }
+                "seek" => {
+                    let before = snapshot.as_ref().map(|s| s.position).unwrap_or(0.0);
+                    self.seek_by(30.0);
+                    log::info!(
+                        "Pipeline external selftest stage=seek requested=+30s from={before:.3}"
+                    );
+                }
+                "verify" => {
+                    // Log the OBSERVED effect of the previous action, not the
+                    // request. A control gate that only proves it sent a command
+                    // proves nothing.
+                    log::info!(
+                        "Pipeline external selftest stage=verify state={} paused={} \
+                         position={:.3} duration={:.3} vo={:?} file_loaded={} \
+                         load_issued={} forward_progress={}",
+                        state.label(),
+                        snapshot.as_ref().map(|s| s.paused).unwrap_or(false),
+                        snapshot.as_ref().map(|s| s.position).unwrap_or(0.0),
+                        snapshot.as_ref().map(|s| s.duration).unwrap_or(0.0),
+                        snapshot.as_ref().and_then(|s| s.current_vo.clone()),
+                        snapshot.as_ref().map(|s| s.file_loaded).unwrap_or(false),
+                        snapshot.as_ref().map(|s| s.load_issued).unwrap_or(false),
+                        snapshot.as_ref().map(|s| s.forward_progress).unwrap_or(false),
+                    );
+                }
+                "switch" => {
+                    log::info!("Pipeline external selftest stage=switch requested=true");
+                }
+                "stop" => {
+                    self.stop();
+                    log::info!("Pipeline external selftest stage=stop requested=true");
+                }
+                "stop-socket" => {
+                    // Simulate a crashed prior session: leave a socket file
+                    // named for a PID that does not exist. Startup reaping must
+                    // remove it, and this session's own socket must be intact.
+                    if let Some(player) = self.external_player.borrow().as_ref() {
+                        let live = player.snapshot().socket_path.clone();
+                        let stale = std::env::var("XDG_RUNTIME_DIR")
+                            .unwrap_or_else(|_| "/tmp".into())
+                            + "/pipeline-santos-player-2147480000.ipc";
+                        let _ = std::fs::write(&stale, b"stale");
+                        log::info!(
+                            "Pipeline external selftest stage=stop-socket live={live:?} \
+                             stale_written={stale}"
+                        );
+                    }
+                }
+                "report" => {
+                    log::info!(
+                        "Pipeline external selftest stage=report state={} position={:.3} \
+                         duration={:.3} state_value={:?} alive={}",
+                        state.label(),
+                        snapshot.as_ref().map(|s| s.position).unwrap_or(0.0),
+                        snapshot.as_ref().map(|s| s.duration).unwrap_or(0.0),
+                        self.state_value.get(),
+                        self.external_player
+                            .borrow()
+                            .as_ref()
+                            .map(|player| player.is_alive())
+                            .unwrap_or(false)
+                    );
+                }
+                other => log::warn!("Pipeline external selftest stage=unknown step={other}"),
+            }
+        }
+
+        pub(super) fn start_stream(
+            &self,
+            stream: ResolvedStream,
+            recovery: Option<RecoverySnapshot>,
+        ) -> Result<(), String> {
+            if self.external_mode.get() {
+                // The embedded renderer, its cover and its render context are
+                // never constructed on this path.
+                let resume = recovery.map(|snapshot| snapshot.position);
+                return self.start_external_stream(&stream, resume);
+            }
+            log::info!(
+                "Starting embedded Santos player: title={:?}, video_format={:?}, audio_format={:?}, separate_audio={}, local={}, recovery={}",
+                stream.title,
+                stream.video_format,
+                stream.audio_format,
+                stream.audio_url.is_some(),
+                stream.is_local,
+                recovery.is_some(),
+            );
+            *self.terminal_error.borrow_mut() = None;
+            let volume = self.settings.double("player-volume");
+            let speed = self.settings.double("player-speed");
+            if self.player.borrow().is_none() {
+                let mut player = MpvPlayer::new(volume, speed, self.make_render_wakeup())?;
+                // Test-only A/B switch for the frame-wakeup dispatch; see
+                // MpvPlayer::apply_wakeup_dispatch_env.
+                player.apply_wakeup_dispatch_env();
+                // Attach the per-frame path trace BEFORE the player is published,
+                // so the very first pending frame is already traced.
+                let trace_on = matches!(
+                    std::env::var("PIPELINE_SANTOS_FRAME_TRACE").as_deref(),
+                    Ok("1") | Ok("true") | Ok("on") | Ok("yes")
+                );
+                if trace_on {
+                    let limit = std::env::var("PIPELINE_SANTOS_FRAME_TRACE_LIMIT")
+                        .ok()
+                        .and_then(|v| v.trim().parse::<usize>().ok())
+                        .unwrap_or(4096);
+                    let sink = crate::player::FrameTraceSink::new(true, limit);
+                    player.attach_frame_trace(sink.clone());
+                    *self.frame_trace.borrow_mut() = Some(sink);
+                    log::info!(
+                        "Pipeline frame trace enabled limit={} hops=pending,queue_render,render_start,render_done,after_paint",
+                        limit
+                    );
+                }
+                *self.wake_counters.borrow_mut() = Some(player.wake_counters());
+                self.wake_counters_armed.set(true);
+                *self.player.borrow_mut() = Some(player);
+            }
+            // Deterministic renderer bootstrap, the authoritative site. This is
+            // the first point where BOTH halves exist: the GtkGLArea has been
+            // realized and mapped (so its GDK GL context exists and can be made
+            // current), and the player now exists. The GLArea realize/map hooks
+            // cannot do this because the player has not been created yet at that
+            // point, which is exactly why the render context used to be created
+            // lazily inside the first render callback and the L218 pump could
+            // deadlock waiting for a context that nothing would create.
+            if self.current_surface().is_realized() {
+                self.bootstrap_render_context();
+            }
+            let identity = self
+                .video_identity()
+                .unwrap_or_else(|| "unknown-video".to_string());
+            let result = self
+                .player
+                .borrow_mut()
+                .as_mut()
+                .ok_or_else(|| "libmpv player is not initialized".to_string())
+                .and_then(|player| match recovery {
+                    Some(snapshot) => player.replace_for_recovery(&stream, &snapshot),
+                    None => player.load(&stream, identity),
+                });
+            let duration = stream.duration.unwrap_or(0.0);
+            self.duration.set(duration);
+            self.state_value.set(PlaybackState::Buffering);
+            self.obj().notify_state();
+            self.obj().notify_duration();
+            self.pump_render_update();
+            result
+        }
+
+        pub(super) fn begin_recovery(&self, request: RecoveryRequest) {
+            if self.recovery_started_at.get().is_none() {
+                self.recovery_started_at.set(Some(std::time::Instant::now()));
+            }
+            *self.terminal_error.borrow_mut() = None;
+            if self.recovery_snapshot.borrow().is_none() {
+                *self.recovery_snapshot.borrow_mut() = Some(request.snapshot.clone());
+            }
+            *self.retry_snapshot.borrow_mut() = Some(request.snapshot.clone());
+            if self.recovery_in_flight.get() {
+                return;
+            }
+            if self.recovery_attempts.get() >= RECOVERY_MAX_ATTEMPTS {
+                let message = "Playback recovery retry budget exhausted".to_string();
+                log::error!(
+                    "Pipeline recovery stage=terminal reason=budget-exhausted attempts={} saved_resume={:.2}s",
+                    self.recovery_attempts.get(),
+                    self.recovery_snapshot
+                        .borrow()
+                        .as_ref()
+                        .map_or(0.0, |snapshot| snapshot.position),
+                );
+                if let Some(player) = self.player.borrow_mut().as_mut() {
+                    player.fail_recovery(message.clone());
+                }
+                self.recovery_snapshot.borrow_mut().take();
+                self.set_player_error(message);
+                return;
+            }
+            let generation = self.begin_resolution();
+            let attempt = self.recovery_attempts.get().wrapping_add(1);
+            self.recovery_attempts.set(attempt);
+            let delay = recovery_backoff(attempt);
+            log::warn!(
+                "Pipeline recovery stage=resolver-scheduled cause={} attempt={} generation={} identity={} saved_resume={:.2}s video_format={:?} audio_format={:?} separate_audio={} backoff_ms={}",
+                request.cause.label(),
+                attempt,
+                generation,
+                request.snapshot.video_identity,
+                request.snapshot.position,
+                request.snapshot.video_format,
+                request.snapshot.audio_format,
+                request.snapshot.separate_audio,
+                delay.as_millis(),
+            );
+            self.schedule_recovery_resolve(generation, delay);
+        }
+
+        fn schedule_recovery_resolve(&self, generation: u64, delay: Duration) {
+            let obj = self.obj();
+            let source = glib::timeout_add_local(
+                delay,
+                clone!(
+                    #[weak]
+                    obj,
+                    #[upgrade_or_panic]
+                    move || {
+                        let imp = obj.imp();
+                        imp.recovery_backoff_source.borrow_mut().take();
+                        if imp.resolution_generation.get() != generation {
+                            return glib::ControlFlow::Break;
+                        }
+                        imp.start_recovery_resolve(generation);
+                        glib::ControlFlow::Break
+                    }
+                ),
+            );
+            *self.recovery_backoff_source.borrow_mut() = Some(source);
+        }
+
+        fn start_recovery_resolve(&self, generation: u64) {
+            if self.resolution_generation.get() != generation
+                || self.recovery_in_flight.get()
+                || self.recovery_snapshot.borrow().is_none()
+            {
+                return;
+            }
+            let Some(request) = self.video_request() else {
+                self.set_player_error("Recovery could not identify the current video".into());
+                return;
+            };
+            self.recovery_in_flight.set(true);
+            let attempt = self.recovery_attempts.get();
+            let saved_resume = self
+                .recovery_snapshot
+                .borrow()
+                .as_ref()
+                .map_or(0.0, |snapshot| snapshot.position);
+            log::info!(
+                "Pipeline recovery stage=resolver-start attempt={} saved_resume={:.2}s",
+                attempt,
+                saved_resume,
+            );
+            // Bounded, test-only resolver failure injection.
+            //
+            // RESOLVE_FAIL=1 fails every attempt until Manual Retry re-arms the
+            // fault, which proves terminal exhaustion. RESOLVE_FAIL_COUNT=n fails
+            // exactly the first n resolver attempts of this media generation and
+            // then lets a later attempt succeed, which is the only way to prove
+            // "first resolver failure followed by bounded retry success" as a
+            // distinct gate from Manual Retry. Both are absent in production.
+            let force_resolver_failure = if std::env::var("PIPELINE_SANTOS_RECOVERY_FAULT_RESOLVE_FAIL")
+                .as_deref() == Ok("1") && !self.recovery_fault_consumed.get() {
+                true
+            } else if self.recovery_resolve_fail_armed.get() {
+                let count = self.recovery_resolve_fail_remaining.get().saturating_sub(1);
+                self.recovery_resolve_fail_remaining.set(count);
+                self.recovery_resolve_fail_armed.set(count > 0);
+                true
+            } else {
+                false
+            };
+            let resolver = (!force_resolver_failure)
+                .then(|| crate::tspawn!(crate::player::resolve_video(request)));
+            if let Some(resolver) = resolver.as_ref() {
+                *self.resolver_abort.borrow_mut() = Some(resolver.abort_handle());
+            }
+            let obj = self.obj();
+            gspawn!(clone!(
+                #[weak]
+                obj,
+                async move {
+                    let result = match resolver {
+                        Some(resolver) => match resolver.await {
+                            Ok(result) => result,
+                            Err(error) => {
+                                Err(format!("yt-dlp recovery resolver task failed: {error}"))
+                            }
+                        },
+                        None => Err("Pipeline test fault: recovery resolver failure".to_string()),
+                    };
+                    let imp = obj.imp();
+                    if imp.resolution_generation.get() != generation
+                        || !imp.recovery_in_flight.get()
+                    {
+                        return;
+                    }
+                    imp.recovery_in_flight.set(false);
+                    imp.resolver_abort.borrow_mut().take();
+                    match result {
+                        Ok(stream) => {
+                            log::info!(
+                                "Pipeline recovery stage=resolved attempt={} video_url=yes audio_url={} video_format={:?} audio_format={:?}",
+                                attempt,
+                                stream.audio_url.is_some(),
+                                stream.video_format,
+                                stream.audio_format,
+                            );
+                            let Some(mut snapshot) = imp.recovery_snapshot.borrow().clone() else {
+                                return;
+                            };
+                            if let Some(player) = imp.player.borrow_mut().as_mut() {
+                                snapshot.media_generation = player.media_generation();
+                            }
+                            if let Err(error) = imp.start_stream(stream, Some(snapshot)) {
+                                imp.recovery_attempt_failed(generation, error);
+                            }
+                        }
+                        Err(error) => {
+                            log::warn!(
+                                "Pipeline recovery stage=resolve-failed attempt={} error={}",
+                                attempt,
+                                error,
+                            );
+                            imp.recovery_attempt_failed(generation, error);
+                        }
+                    }
+                }
+            ));
+        }
+
+        fn recovery_attempt_failed(&self, generation: u64, error: String) {
+            if self.resolution_generation.get() != generation {
+                return;
+            }
+            let attempt = self.recovery_attempts.get();
+            if attempt >= RECOVERY_MAX_ATTEMPTS {
+                let message = format!("Playback recovery failed: {error}");
+                log::error!(
+                    "Pipeline recovery stage=terminal reason=resolve-budget attempts={} saved_resume={:.2}s error={}",
+                    attempt,
+                    self.recovery_snapshot
+                        .borrow()
+                        .as_ref()
+                        .map_or(0.0, |snapshot| snapshot.position),
+                    error,
+                );
+                if let Some(player) = self.player.borrow_mut().as_mut() {
+                    player.fail_recovery(message.clone());
+                }
+                *self.recovery_snapshot.borrow_mut() = None;
+                self.set_player_error(message);
+                return;
+            }
+            let next_attempt = attempt.wrapping_add(1);
+            let delay = recovery_backoff(next_attempt);
+            log::warn!(
+                "Pipeline recovery stage=resolve-backoff attempt={} next_attempt={} backoff_ms={} saved_resume={:.2}s error={}",
+                attempt,
+                next_attempt,
+                delay.as_millis(),
+                self.recovery_snapshot
+                    .borrow()
+                    .as_ref()
+                    .map_or(0.0, |snapshot| snapshot.position),
+                error,
+            );
+            self.recovery_attempts.set(next_attempt);
+            self.schedule_recovery_resolve(generation, delay);
+        }
+
+        pub(super) fn acknowledge_recovery_progress(&self) {
+            let sustained = self
+                .player
+                .borrow_mut()
+                .as_mut()
+                .is_some_and(|player| player.recovery_sustained());
+            if !sustained {
+                return;
+            }
+            if let Some(player) = self.player.borrow_mut().as_mut() {
+                player.acknowledge_recovery_sustained();
+            }
+            self.recovery_attempts.set(0);
+            self.recovery_started_at.set(None);
+            *self.recovery_snapshot.borrow_mut() = None;
+            *self.retry_snapshot.borrow_mut() = None;
+            log::info!("Pipeline recovery controller reset budget after sustained playback");
+        }
+
+        pub(super) fn retry_recovery(&self) {
+            // Keep the captured position across the user-visible error state.
+            // A Retry is a new bounded recovery cycle, not a synthetic seek
+            // loop and not an implicit restart from 0:00.
+            let saved = self
+                .retry_snapshot
+                .borrow()
+                .clone()
+                .or_else(|| self.recovery_snapshot.borrow().clone());
+            let saved_resume = saved.as_ref().map_or(0.0, |snapshot| snapshot.position);
+            log::info!(
+                "Pipeline recovery stage=manual-retry saved_resume={:.2}s has_snapshot={}",
+                saved_resume,
+                saved.is_some(),
+            );
+            if std::env::var("PIPELINE_SANTOS_RECOVERY_FAULT_RESOLVE_FAIL")
+                .ok()
+                .is_some_and(|value| value == "1")
+            {
+                // Test-only fault mode: a manual Retry starts a fresh resolver
+                // cycle so the UI action can be verified without weakening the
+                // normal bounded-failure path.
+                self.recovery_fault_consumed.set(true);
+            }
+            // A manual Retry also re-arms the bounded per-generation resolver
+            // budget, so "terminal exhaustion then Manual Retry" can be driven
+            // end to end instead of only the unbounded-fail mode.
+            if self.recovery_resolve_fail_armed.get() {
+                self.recovery_resolve_fail_remaining
+                    .set(self.recovery_resolve_fail_remaining.get().max(1));
+            }
+            self.reset_recovery();
+            if let Some(player) = self.player.borrow_mut().as_mut() {
+                player.prepare_recovery_cycle();
+            }
+            if let Some(snapshot) = saved {
+                *self.recovery_snapshot.borrow_mut() = Some(snapshot.clone());
+                *self.retry_snapshot.borrow_mut() = Some(snapshot.clone());
+                self.begin_recovery(RecoveryRequest {
+                    cause: crate::player::RecoveryCause::ManualRetry,
+                    snapshot,
+                });
+            } else {
+                self.obj().play();
+            }
+        }
+
+        pub(super) fn play_pause(&self) {
+            if self.external_mode.get() {
+                if self.state_value.get() == PlaybackState::Error {
+                    self.retry_external();
+                    return;
+                }
+                let Some(player) = self.external_player.borrow().as_ref().cloned() else {
+                    return;
+                };
+                let paused = player.snapshot().paused;
+                player.set_paused(!paused);
+                return;
+            }
+            if self.state_value.get() == PlaybackState::Error {
+                self.retry_recovery();
+                return;
+            }
+            if self.recovery_in_flight.get() || self.recovery_snapshot.borrow().is_some() {
+                self.reset_recovery();
+            }
+            if let Some(player) = self.player.borrow_mut().as_mut() {
+                player.play_pause();
+                self.state_value.set(player.state);
+                self.obj().notify_state();
+            }
+        }
+
+        /// Manual retry for the external backend. A player-process or
+        /// window/VO failure must not be driven through yt-dlp: there is no
+        /// media problem to re-resolve.
+        pub(super) fn retry_external(&self) {
+            let Some(player) = self.external_player.borrow().as_ref().cloned() else {
+                return;
+            };
+            let saved = self.external_snapshot.borrow().clone();
+            let resume = saved.as_ref().map(|signal| signal.position);
+            self.external_recovery_attempts.set(0);
+            *self.external_snapshot.borrow_mut() = None;
+            *self.terminal_error.borrow_mut() = None;
+            player.clear_terminal();
+            log::info!(
+                "Pipeline external recovery stage=manual-retry saved_resume={:?} has_snapshot={}",
+                resume,
+                saved.is_some()
+            );
+            self.run_external_resolve();
+        }
+
+        pub(super) fn pause(&self) {
+            if self.external_mode.get() {
+                if let Some(player) = self.external_player.borrow().as_ref() {
+                    player.set_paused(true);
+                }
+                return;
+            }
+            if self.recovery_in_flight.get() || self.recovery_snapshot.borrow().is_some() {
+                self.reset_recovery();
+            }
+            if let Some(player) = self.player.borrow_mut().as_mut() {
+                if player.state == PlaybackState::Playing
+                    || player.state == PlaybackState::Buffering
+                {
+                    player.play_pause();
+                }
+                self.state_value.set(player.state);
+                self.obj().notify_state();
+            }
+        }
+
+        pub(super) fn stop(&self) {
+            if self.external_mode.get() {
+                self.external_stop();
+                self.state_value.set(PlaybackState::Stopped);
+                self.obj().notify_state();
+                return;
+            }
+            self.reset_recovery();
+            if let Some(player) = self.player.borrow_mut().as_mut() {
+                player.stop();
+                self.state_value.set(player.state);
+                self.obj().notify_state();
+            }
+            // A bottom-card page is already unrealized, so neither dismiss nor
+            // window close can depend on another unrealize signal for cleanup.
+            // Stop media first, then release using its exact retained GL context.
+            self.release_render_context(&self.current_surface());
+        }
+
+        pub(super) fn finished(&self) -> bool {
+            matches!(
+                self.state_value.get(),
+                PlaybackState::Stopped | PlaybackState::Ended | PlaybackState::Error
+            ) || (self.duration.get() > 0.0 && self.position.get() >= self.duration.get() - 0.25)
+        }
+
+        pub(super) fn test_log_background(&self) {
+            if let Some(player) = self.player.borrow().as_ref() {
+                log::info!(
+                    "Pipeline background test state={:?} page_state={:?} position={:.3} duration={:.3} generation={} mapped={} render_context={} frame_visible={} play_sensitive={}",
+                    player.state, self.obj().state(), player.position, player.duration, player.media_generation(),
+                    self.obj().is_mapped(), player.has_render_context(), self.frame_visible.get(),
+                    self.control_play.borrow().as_ref().is_some_and(|button| button.is_sensitive()),
+                );
+            }
+        }
+
+        pub(super) fn seek_by(&self, seconds: f64) {
+            let target = self.position.get() + seconds;
+            self.seek_to(target);
+        }
+
+        pub(super) fn seek_to_percent(&self, percent: f64) {
+            self.seek_to(percent * self.duration.get());
+        }
+
+        fn seek_to(&self, seconds: f64) {
+            if self.external_mode.get() {
+                if let Some(player) = self.external_player.borrow().as_ref() {
+                    player.seek_absolute(seconds.max(0.0));
+                }
+                return;
+            }
+            if self.recovery_in_flight.get() || self.recovery_snapshot.borrow().is_some() {
+                self.reset_recovery();
+            }
+            if let Some(player) = self.player.borrow_mut().as_mut() {
+                player.seek_absolute(seconds);
+            }
+        }
+
+        fn change_volume(&self, delta: f64) {
+            if self.external_mode.get() {
+                if let Some(player) = self.external_player.borrow().as_ref() {
+                    let current = player.snapshot().volume;
+                    player.set_volume((current + delta).clamp(0.0, 1.0));
+                }
+                return;
+            }
+            if let Some(player) = self.player.borrow_mut().as_mut() {
+                player.change_volume(delta);
+                self.volume.set(player.volume);
+                self.muted.set(player.muted);
+                self.obj().notify_volume();
+                self.obj().notify_muted();
+            }
+        }
+
+        fn toggle_muted(&self) {
+            if self.external_mode.get() {
+                if let Some(player) = self.external_player.borrow().as_ref() {
+                    let muted = player.snapshot().muted;
+                    player.set_muted(!muted);
+                }
+                return;
+            }
+            if let Some(player) = self.player.borrow_mut().as_mut() {
+                player.toggle_muted();
+                self.muted.set(player.muted);
+                self.obj().notify_muted();
+            }
+        }
+
+        fn change_speed(&self, delta: f64) {
+            if self.external_mode.get() {
+                if let Some(player) = self.external_player.borrow().as_ref() {
+                    let speed = player.snapshot().speed;
+                    player.set_speed((speed + delta).clamp(0.25, 4.0));
+                }
+                return;
+            }
+            if let Some(player) = self.player.borrow_mut().as_mut() {
+                player.set_speed(player.speed + delta);
+            }
+        }
+
+        fn page_is_active(&self) -> bool {
+            if self.external_mode.get() {
+                // The native player owns its own surface; this page is
+                // deliberately still mapped underneath it, so the external poll
+                // must keep running.
+                return self.obj().is_mapped();
+            }
+            self.obj().is_mapped() && self.current_surface().is_mapped()
+        }
+
+        /// Toggle fullscreen.
+        ///
+        /// The containment side effect lives in the property setter so that
+        /// every path (button, Escape/F11 shortcut, test hook, any programmatic
+        /// change) re-covers the surface, not just the UI toggles.
+        pub(super) fn toggle_fullscreen(&self) {
+            let obj = self.obj();
+            obj.set_fullscreened(!obj.fullscreened());
+        }
+
+        /// Fullscreen transitions tear down and re-create the GLArea rendering
+        /// surface, so whatever the widget backing store held is no longer a
+        /// validated frame. Re-cover immediately; the next real
+        /// current-generation frame removes it again through the render gate.
+        fn set_fullscreened_containing(&self, value: bool) {
+            self.fullscreened.set(value);
+            self.cover_presentation("fullscreen-transition");
+        }
+
+        fn render_mpv(&self, area: &gtk::GLArea) {
+            if let Some(player) = self.player.borrow_mut().as_mut() {
+                let scale = area.scale_factor().max(1) as i32;
+                // Stage: GtkGLArea render callback start.
+                self.mark_wake_stage(crate::player::WakeStage::GlStart);
+                let outcome = player.render(area.width() * scale, area.height() * scale);
+                // Stage: render completion.
+                self.mark_wake_stage(crate::player::WakeStage::GlDone);
+                // Presentation containment (L197). Two distinct signals:
+                //
+                //  * `new_frame_confirmed` is proven with
+                //    MPV_RENDER_PARAM_NEXT_FRAME_INFO: a genuinely new,
+                //    presentable frame for the CURRENT media generation, not a
+                //    redraw/repeat of previous presentation contents. Only this
+                //    moves the cover from covered to "frame confirmed".
+                //  * a later gate-open render callback is the additional bounded
+                //    frame boundary this vendor stack needs; arming the reveal
+                //    here guarantees the confirmed frame has itself been through
+                //    a GTK paint before the cover is dropped.
+                //
+                // Anything else (gate closed: new generation, recovery
+                // replacement, render-context recreation, unrealize) re-covers
+                // immediately, so stale or uninitialized GLArea contents can
+                // never become user-visible.
+                if outcome.new_frame_confirmed {
+                    self.retained_frame_generation.set(None);
+                    self.confirm_presentation_frame();
+                    // This same render callback is ALSO a frame boundary. Both
+                    // facts are true simultaneously and must be recorded
+                    // together: the `else if` treated them as mutually exclusive,
+                    // so once VDX delivered a genuinely new frame on (almost)
+                    // every render, new_frame_confirmed was true every time and
+                    // note_presentation_boundary() was never reached. The state
+                    // machine then sat at FrameConfirmed forever and the cover
+                    // was never dropped, so decoded frames were never visible.
+                    // note_presentation_boundary() returns immediately unless the
+                    // state is exactly FrameConfirmed, so this advances
+                    // FrameConfirmed -> BoundarySeen -> armed exactly once, and
+                    // the L197 requirement is unchanged: the confirmed frame must
+                    // still pass through a real frame-clock paint before the
+                    // cover is dropped.
+                    if outcome.gate_open {
+                        self.note_presentation_boundary();
+                    }
+                } else if outcome.gate_open {
+                    self.note_presentation_boundary();
+                } else if !self.frame_visible.get() {
+                    // This render has no new frame and the gate is closed. If a
+                    // confirmed frame is ALREADY revealed and on screen, the
+                    // content the user is looking at is still that correct frame,
+                    // so re-covering here would flap the cover once per idle
+                    // render. With the bounded 33 ms self-timed render driver
+                    // that measured 24 cover/reveal cycles in a 10 s clip, i.e.
+                    // the picture blinked black about two to five times a
+                    // second. Only cover when there is genuinely nothing
+                    // trustworthy on screen.
+                    //
+                    // L197 containment is unchanged: every real transition --
+                    // new media generation, recovery replacement, render-context
+                    // recreation, unrealize and fullscreen -- calls
+                    // cover_presentation() explicitly at its own site, and
+                    // cover_presentation() is idempotent, so it still re-covers
+                    // on exactly those events and never in between.
+                    self.cover_presentation("render-gate-closed");
+                }
+            } else {
+                self.cover_presentation("no-player");
+            }
+        }
+
+        /// A genuinely new, presentable frame for the current generation has been
+        /// drawn into the GLArea FBO. The cover deliberately stays up: the frame
+        /// still has to pass a GTK paint, and the cover removal itself has to be
+        /// composited in a later paint. One more render is requested so that
+        /// boundary is guaranteed to happen even if no further video frame
+        /// arrives.
+        fn confirm_presentation_frame(&self) {
+            // A revealed valid surface needs no per-frame presentation-state
+            // reset, log or extra pump. Only a fresh/frozen generation advances
+            // the bounded reveal state machine.
+            if self.frame_visible.get() && !self.presentation_frozen.get() { return; }
+            let was = self
+                .presentation_state
+                .replace(PresentationState::FrameConfirmed);
+            if !matches!(was, PresentationState::FrameConfirmed) {
+                log::info!(
+                    "Pipeline presentation frame confirmed generation={} epoch={}",
+                    self.resolution_generation.get(),
+                    self.presentation_epoch.get()
+                );
