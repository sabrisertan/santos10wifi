+            "current-vo",
+            "current-gpu-context",
+            "current-vd",
+            "hwdec-current",
+            "scale",
+            "dscale",
+            "cscale",
+            "tscale",
+            "dither",
+            "dither-depth",
+            "deband",
+            "gpu-dumb-mode",
+            "opengl-pbo",
+            "correct-downscaling",
+            "linear-downscaling",
+            "linear-upscaling",
+            "sigmoid-upscaling",
+            "interlace",
+            "deinterlace",
+            "video-rotate",
+            "fbo-format",
+        ]
+        .into_iter()
+        .map(|name| format!("{}={}", name, self.property_summary(name, 96)))
+        .collect::<Vec<_>>()
+        .join(" ")
+    }
+
+    fn log_metrics_if_due(&mut self) {
+        // No property RPC, /proc read, sample sorting or allocation on the
+        // normal product path. Logging suppression alone is not a lazy guard.
+        if !self.metrics_enabled { return; }
+        let now = Instant::now();
+        let elapsed = now.duration_since(self.last_metrics_at);
+        if elapsed < Duration::from_secs(2) {
+            return;
+        }
+        let elapsed_seconds = elapsed.as_secs_f64().max(0.001);
+        let cpu_ticks = read_main_thread_ticks();
+        let cpu_percent = self.last_metrics_cpu_ticks.zip(cpu_ticks).map(
+            |((previous_utime, previous_stime), (current_utime, current_stime))| {
+                let ticks = current_utime
+                    .saturating_sub(previous_utime)
+                    .saturating_add(current_stime.saturating_sub(previous_stime));
+                let hz = unsafe { sysconf(SC_CLK_TCK) };
+                if hz > 0 {
+                    ticks as f64 * 100.0 / hz as f64 / elapsed_seconds
+                } else {
+                    0.0
+                }
+            },
+        );
+        self.last_metrics_cpu_ticks = cpu_ticks;
+        self.last_metrics_at = now;
+
+        let update_callbacks = self
+            .render_callback_counters
+            .update_callbacks
+            .swap(0, Ordering::Relaxed);
+        let wakeups = self
+            .render_callback_counters
+            .wakeups
+            .swap(0, Ordering::Relaxed);
+        // Pump-side accounting, so the ~30fps -> ~15fps halving boundary can be
+        // located from measured per-interval numbers instead of inferred:
+        //   pump_attempts         = mpv_render_context_update() calls
+        //   pump_frame_flags      = of those, how many reported UPDATE_FRAME
+        //   update_flag_positives = how many of those the render callback acted on
+        let pump_attempts = self.pump_attempts - self.last_metrics_pump_attempts;
+        let update_frame_positives =
+            self.update_frame_positives - self.last_metrics_update_frame_positives;
+        let pending_frame_transitions =
+            self.pending_frame_transitions - self.last_metrics_pending_frame_transitions;
+        let queue_render_calls =
+            self.queue_render_calls - self.last_metrics_queue_render_calls;
+        let queue_render_calls_pump =
+            self.queue_render_calls_pump - self.last_metrics_queue_render_calls_pump;
+        let queue_render_calls_reveal =
+            self.queue_render_calls_reveal - self.last_metrics_queue_render_calls_reveal;
+        let queue_render_calls_other =
+            self.queue_render_calls_other - self.last_metrics_queue_render_calls_other;
+        let queue_coalesced = self.queue_coalesced - self.last_metrics_queue_coalesced;
+        let render_callbacks_frame =
+            self.render_callbacks_frame - self.last_metrics_render_callbacks_frame;
+        let update_flag_positives =
+            self.update_flag_positives.wrapping_sub(self.last_metrics_update_flag_positives);
+        self.last_metrics_update_flag_positives = self.update_flag_positives;
+        self.last_metrics_pump_attempts = self.pump_attempts;
+        self.last_metrics_update_frame_positives = self.update_frame_positives;
+        self.last_metrics_pending_frame_transitions = self.pending_frame_transitions;
+        self.last_metrics_queue_render_calls = self.queue_render_calls;
+        self.last_metrics_queue_render_calls_pump = self.queue_render_calls_pump;
+        self.last_metrics_queue_render_calls_reveal = self.queue_render_calls_reveal;
+        self.last_metrics_queue_render_calls_other = self.queue_render_calls_other;
+        self.last_metrics_queue_coalesced = self.queue_coalesced;
+        self.last_metrics_render_callbacks_frame = self.render_callbacks_frame;
+        let render_callbacks = self.render_callbacks - self.last_metrics_render_callbacks;
+        let render_submits = self.render_submits - self.last_metrics_render_submits;
