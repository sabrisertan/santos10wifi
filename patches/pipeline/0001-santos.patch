+use glib::{Object, clone, subclass::types::ObjectSubclassIsExt};
+use gtk::prelude::*;
+
+/// Presentation containment state machine (L197).
+///
+/// The opaque cover is dropped only after a genuinely new, presentable frame
+/// for the CURRENT media generation has been rendered (`FrameConfirmed`) AND a
+/// subsequent render boundary plus a real GTK paint have occurred
+/// (`BoundarySeen` -> armed reveal). Redraw/repeat of previous presentation
+/// contents never advance this machine.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum PresentationState {
+    /// Cover is up; no confirmed frame for the current generation.
+    Covered,
+    /// A genuinely new frame was drawn into the GLArea FBO. Cover still up.
+    FrameConfirmed,
+    /// An additional render boundary happened after the confirmed frame, so the
+    /// reveal may be armed against the next GTK paint.
+    BoundarySeen,
+    /// Cover removed; the surface is showing a validated frame.
+    Revealed,
+}
+
+/// A pending reveal, bound to the presentation epoch that armed it and to the
+/// frame-clock paint boundary observed at that moment. The reveal completes at
+/// the first paint boundary strictly after `boundary`, provided `epoch` is still
