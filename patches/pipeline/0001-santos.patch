+//! Santos external native-mpv playback controller.
+//!
+//! This is the second playback backend. It does NOT replace or rewrite the
+//! embedded libmpv/GtkGLArea backend in `player.rs`; it is a separable
+//! candidate so rollback is one environment variable. Backend selection is
+//! `PIPELINE_SANTOS_PLAYER=embedded|external` (default `embedded`).
+//!
+//! Architecture (deliberately fullscreen-only, no embedding):
+//!
+//! ```text
+//! Pipeline / GTK  = UI + search/details/subscriptions + yt-dlp resolver + control plane
+//! native mpv      = video/audio playback + native VO + VDX, its own fullscreen surface
+//! ```
+//!
+//! There is no GtkGLArea, no GTK video rendering and no foreign-window
+//! embedding on this path. Pipeline stays alive underneath.
+//!
+//! Threading: all mpv process and JSON-IPC work happens on one dedicated worker
+//! thread. The GTK main context only sends commands and reads a snapshot. That
+//! is not cosmetic: a client that floods mpv's IPC at startup measurably
+//! changes whether a load succeeds (L234), so the product client is
+//! deliberately lean and never shares the GTK main loop with the player.
+//!
+//! Media URLs never touch a shell: the worker spawns mpv directly with an argv
+//! array and speaks JSON over the IPC socket. URLs are never logged.
+
+use std::{
+    collections::VecDeque,
+    io::{BufReader, Read, Write},
+    os::unix::{net::UnixStream, process::CommandExt},
+    path::{Path, PathBuf},
+    process::{Child, Command, ExitStatus, Stdio},
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicBool, AtomicU64, Ordering},
+    },
+    thread,
+    time::{Duration, Instant},
+};
+
+use serde_json::{Value, json};
