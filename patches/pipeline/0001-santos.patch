+fn percentile_ms(samples: &[u64], percentile: f64) -> f64 {
+    if samples.is_empty() {
+        return 0.0;
+    }
+    let mut sorted = samples.to_vec();
+    sorted.sort_unstable();
+    let index = ((sorted.len() as f64 - 1.0) * percentile).round() as usize;
+    sorted[index.min(sorted.len() - 1)] as f64 / 1_000_000.0
+}
