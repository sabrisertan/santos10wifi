+/// A startup milestone with extra scalar fields. Used where the milestone needs to
+/// carry a duration and a row count, so a pathological query is visible without
+/// having to reconstruct it from two separate lines.
+pub(crate) fn startup_mark_kv(stage: &str, fields: &[(&str, String)]) {
+    if !startup_trace_enabled() {
+        return;
+    }
+    note_stage(stage);
+    let base = *STARTUP_AT.get_or_init(std::time::Instant::now);
+    let extra = fields
+        .iter()
+        .map(|(k, v)| format!("{k}={v}"))
+        .collect::<Vec<_>>()
+        .join(" ");
+    log::info!(
+        "Pipeline startup stage={stage} elapsed_ms={} {extra}",
+        base.elapsed().as_millis()
+    );
+}
