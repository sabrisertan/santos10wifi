+    );
+
+    if let Some(path) = request.downloaded_path {
+        if Path::new(&path).exists() {
+            log::info!(
+                "Pipeline resolver stage=direct-resolved source=downloaded elapsed_ms={}",
+                resolver_started.elapsed().as_millis(),
+            );
+            return Ok(ResolvedStream::direct(path, duration, true));
+        }
+    }
+
+    if request.platform != "youtube" {
+        log::info!(
+            "Pipeline resolver stage=direct-resolved source=playable elapsed_ms={}",
+            resolver_started.elapsed().as_millis(),
+        );
+        return Ok(ResolvedStream::direct(
+            request.playable_url,
+            duration,
+            false,
+        ));
+    }
+
+    let input = youtube_url(&request.id)?;
+    let cookies = request.cookies;
+    let extractor_args = request.extractor_args;
+
+    let mut command = Command::new("yt-dlp");
+    crate::resolver_environment::configure(&mut command);
+    command
+        .arg("--no-playlist")
+        .arg("--skip-download")
+        .arg("--no-warnings")
+        .arg("--dump-single-json")
+        .arg("--format")
+        .arg(format_selector(request.max_height));
+    if !cookies.is_empty() {
+        command.arg("--cookies").arg(cookies);
+    }
+    if !extractor_args.is_empty() {
+        command.arg("--extractor-args").arg(extractor_args);
+    }
+    command.arg(input);
+    command.kill_on_drop(true);
+
+    let output = tokio::time::timeout(Duration::from_secs(60), command.output())
+        .await
+        .map_err(|_| "yt-dlp resolver timed out after 60s".to_string())?
+        .map_err(|e| format!("failed to execute yt-dlp: {e}"))?;
+    log::info!(
+        "Pipeline resolver stage=yt-dlp-exit status={} elapsed_ms={}",
+        output.status,
+        resolver_started.elapsed().as_millis(),
+    );
+    if !output.status.success() {
+        // Do not surface yt-dlp stderr: resolver diagnostics can echo signed
+        // media URLs or cookie/extractor material. Keep the bounded status only.
+        return Err(format!("yt-dlp exited with {}", output.status));
+    }
+
+    let info: YtDlpInfo = serde_json::from_slice(&output.stdout)
+        .map_err(|e| format!("could not parse yt-dlp JSON: {e}"))?;
+    let stream = choose_stream(info, request.max_height)?;
+    if let Some(quality) = stream.quality.as_ref() {
+        log::info!("Pipeline quality selected={}x{} fps={:.3} requested_max_height={} video_format={:?}",
+            quality.width, quality.height, quality.fps, quality.max_height, stream.video_format);
+    }
+    log::info!(
+        "Pipeline resolver stage=urls-resolved video_url=yes audio_url={} video_format={:?} audio_format={:?} elapsed_ms={}",
+        stream.audio_url.is_some(),
+        stream.video_format,
+        stream.audio_format,
+        resolver_started.elapsed().as_millis(),
+    );
+    Ok(stream)
+}
+
+/// State exposed to the GTK templates and the mini-player.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, glib::Enum)]
+#[enum_type(name = "PipelinePlaybackState")]
+pub enum PlaybackState {
+    Stopped,
+    Buffering,
+    Playing,
+    Paused,
+    Ended,
+    Error,
+}
+
+/// Explicit media-load lifecycle.
+///
+/// The previous design set `awaiting_file_load` when a stream was merely
+/// RESOLVED, and `start_pending_stream()` then returned success without sending
+/// `loadfile` whenever the libmpv render context did not exist yet. A 15 s timer
+/// on that flag therefore classified a missing GtkGLArea render context as
+/// `playback-no-progress` and started yt-dlp recovery, even though mpv had never
+/// been asked to load the resolved stream. These states make that impossible:
+/// only `AwaitingFileLoaded` / `AwaitingStartFile` may arm a media-load timeout.
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub enum LoadPhase {
+    /// No media requested.
+    Idle,
+    /// A stream is resolved and held, waiting for the GtkGLArea / libmpv render
+    /// context. No `loadfile` command has been sent. Renderer-infrastructure
+    /// state; a renderer problem here is NOT a network problem.
+    PendingRenderContext { since_secs: f64 },
+    /// The `loadfile` command is being issued right now.
+    LoadfileIssuing,
+    /// `loadfile` was accepted and a playlist entry id exists. This is the only
+    /// state in which a load timeout means the media/network path is at fault.
+    AwaitingFileLoaded {
+        playlist_entry_id: i64,
+        since_secs: f64,
+    },
+    /// START_FILE was observed; still waiting for FILE_LOADED.
+    AwaitingStartFile {
+        playlist_entry_id: i64,
+        since_secs: f64,
+    },
+    /// FILE_LOADED was observed: media is loaded.
+    Loaded,
+}
+
+impl LoadPhase {
+    /// True only when a `loadfile` command has actually been accepted, i.e. when
+    /// a media/network load timeout is meaningful.
+    pub fn loadfile_accepted(self) -> bool {
+        matches!(
+            self,
+            Self::AwaitingFileLoaded { .. } | Self::AwaitingStartFile { .. }
+        )
+    }
+
+    /// True while the renderer (not the network) still owes us a context.
+    pub fn awaiting_render_context(self) -> bool {
+        matches!(self, Self::PendingRenderContext { .. })
+    }
+
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::Idle => "idle",
+            Self::PendingRenderContext { .. } => "pending-render-context",
+            Self::LoadfileIssuing => "loadfile-issuing",
+            Self::AwaitingFileLoaded { .. } => "awaiting-file-loaded",
+            Self::AwaitingStartFile { .. } => "awaiting-start-file",
+            Self::Loaded => "loaded",
+        }
+    }
+}
+
+pub struct MpvPlayer {
+    handle: *mut MpvHandle,
+    render_context: *mut MpvRenderContext,
+    render_wakeup: RenderWakeup,
+    render_callback_state: Option<Arc<RenderCallbackState>>,
+    /// Update flags observed by the render-update PUMP, waiting for the
+    /// GtkGLArea render callback to consume them exactly once. The pump calls
+    /// `mpv_render_context_update()`; the render callback must NOT call it
+    /// again, or the same update would be consumed twice.
+    pending_update_flags: Cell<u64>,
+    /// True between an actual `queue_render()` and the render callback that
+    /// consumes it. Prevents repeated pumps from manufacturing extra GTK
+    /// invalidations of a surface that may already hold a valid frame.
+    render_queued: Cell<bool>,
+    /// Per-frame path trace sink, shared with the page so the GDK after-paint
+    /// boundary can be stamped from the frame clock. `None` unless
+    /// `PIPELINE_SANTOS_FRAME_TRACE` selects tracing.
+    frame_trace: Option<Rc<FrameTraceSink>>,
+    /// Pump accounting, so the cadence boundary can be located per interval.
+    last_metrics_pump_attempts: u64,
+    last_metrics_update_frame_positives: u64,
+    last_metrics_pending_frame_transitions: u64,
+    last_metrics_queue_render_calls: u64,
+    last_metrics_queue_render_calls_pump: u64,
+    last_metrics_queue_render_calls_reveal: u64,
+    last_metrics_queue_render_calls_other: u64,
+    last_metrics_queue_coalesced: u64,
+    last_metrics_render_callbacks_frame: u64,
+    last_metrics_update_flag_positives: u64,
+    pump_attempts: u64,
+    /// update() calls that returned MPV_RENDER_UPDATE_FRAME
+    update_frame_positives: u64,
+    /// distinct transitions of "no pending FRAME" -> "pending FRAME"
+    pending_frame_transitions: u64,
+    /// times a queue_render() was actually executed
+    queue_render_calls: u64,
+    queue_render_calls_pump: u64,
+    queue_render_calls_reveal: u64,
+    queue_render_calls_other: u64,
+    /// times a pending FRAME was coalesced because a render was already queued
+    queue_coalesced: u64,
+    /// render callbacks that consumed a FRAME
+    render_callbacks_frame: u64,
+    /// Inter-submit gaps for the CURRENT metrics interval, cleared on every
+    /// aggregate log. The previous single vector was never reset, so the
+    /// "interval" p50/p95/max were actually whole-run values that drifted as the
+    /// sample buffer filled -- and it stopped collecting entirely at 4096 samples.
+    interval_submit_gaps_ns: Vec<u64>,
+    /// Inter-submit gaps for the WHOLE run, bounded and reported separately as
+    /// `run_*` so a per-interval figure is never silently a cumulative one.
+    run_submit_gaps_ns: Vec<u64>,
+    last_submit_at: Option<Instant>,
+    /// Baselines for the per-interval drop deltas. `None` until the first reading,
+    /// so the very first interval reports "unknown" instead of a fake zero.
+    last_frame_drop: Option<i64>,
+    last_decoder_drop: Option<i64>,
+    update_flag_positives: u64,
+    render_callback_counters: Arc<RenderCallbackCounters>,
+    render_wakeup_normal_priority: bool,
+    pub state: PlaybackState,
+    pub position: f64,
+    pub duration: f64,
+    pub volume: f64,
+    pub muted: bool,
+    pub speed: f64,
+    pub error: Option<String>,
+    pending_stream: Option<ResolvedStream>,
+    active_stream: Option<ResolvedStream>,
+    first_current_frame_seen: bool,
+    holding_recovery_frame: bool,
+    has_file: bool,
+    /// Explicit load lifecycle. See `LoadPhase`.
+    load_phase: LoadPhase,
+    /// Render-infrastructure failure (GL context / libmpv render context).
+    /// Distinct from `error`, which is the user-visible media/playback error.
+    /// Never routed through yt-dlp recovery.
+    renderer_error: Option<String>,
+    /// Latched when the recovery budget is exhausted, so the terminal state is
+    /// STABLE. Without this latch every automatic trigger re-fires immediately
+    /// after the budget is spent and the terminal error spins forever.
+    recovery_exhausted: bool,
+    awaiting_new_start: bool,
+    new_start_seen: bool,
+    last_position: f64,
+    continuous_position: f64,
+    last_progress_at: Instant,
+    recovery_request: Option<RecoveryRequest>,
+    recovery_snapshot: Option<RecoverySnapshot>,
+    recovery_resume_target: Option<f64>,
+    recovery_resume_seek_sent: bool,
+    recovery_resume_started_at: Option<Instant>,
+    recovery_resume_landing_pending: bool,
+    recovery_resume_restart_seen: bool,
+    recovery_resume_landing_position: Option<f64>,
+    recovery_resume_last_position: f64,
+    recovery_resume_last_forward_at: Option<Instant>,
+    recovery_sustained: bool,
+    last_frame_submit_at: Instant,
+    cache_pause_observed: bool,
+    media_generation: u64,
