+const RECOVERY_NO_PROGRESS_TIMEOUT: Duration = Duration::from_secs(8);
+/// Bounded wait for the GtkGLArea / libmpv render context after a stream has
+/// been resolved. This is RENDER INFRASTRUCTURE, not media or network: mpv has
+/// not been asked to load anything yet, so timing out here must never start
+/// yt-dlp recovery.
+const RENDER_CONTEXT_TIMEOUT: Duration = Duration::from_secs(10);
+const RECOVERY_LOAD_TIMEOUT: Duration = Duration::from_secs(15);
+const RECOVERY_EOF_TOLERANCE_SECONDS: f64 = 1.0;
+const RECOVERY_SUSTAINED_MEDIA_SECONDS: f64 = 3.0;
+const SC_CLK_TCK: c_int = 2;
+
+/// Upper bound on how many per-generation next-frame classification samples are
+/// logged individually, so a long run cannot flood the log.
+const NEXT_FRAME_EVIDENCE_SAMPLES: u64 = 8;
+
+/// Bounded per-generation tally of next-frame classifications. This is the
+/// evidence that the first-frame gate rejects redraw/repeat instead of
+/// mistaking them for a new decoded frame.
+#[derive(Default, Clone, Copy)]
+struct NextFrameCounts {
+    present: u64,
+    no_frame: u64,
+    redraw: u64,
+    repeat: u64,
+    unsupported: u64,
+}
+
+impl NextFrameCounts {
+    fn total(&self) -> u64 {
+        self.present + self.no_frame + self.redraw + self.repeat + self.unsupported
+    }
+}
+
+pub type RenderWakeup = Arc<dyn Fn() + Send + Sync + 'static>;
+
+#[derive(Default)]
+pub struct RenderCallbackCounters {
+    update_callbacks: AtomicU64,
+    wakeups: AtomicU64,
+    // Bounded wake-latency instrumentation. Each stage is a fixed-capacity ring
+    // of recent samples, flushed into the periodic render aggregate.
+    callback_at: std::sync::Mutex<Vec<Instant>>,
+    wake_at: std::sync::Mutex<Vec<Instant>>,
+    queue_at: std::sync::Mutex<Vec<Instant>>,
+    gl_start_at: std::sync::Mutex<Vec<Instant>>,
+    gl_done_at: std::sync::Mutex<Vec<Instant>>,
+}
+
+const WAKE_SAMPLE_CAP: usize = 256;
+
+impl RenderCallbackCounters {
+    fn new() -> Self {
+        Self {
+            update_callbacks: AtomicU64::new(0),
+            wakeups: AtomicU64::new(0),
+            callback_at: std::sync::Mutex::new(Vec::new()),
+            wake_at: std::sync::Mutex::new(Vec::new()),
+            queue_at: std::sync::Mutex::new(Vec::new()),
+            gl_start_at: std::sync::Mutex::new(Vec::new()),
+            gl_done_at: std::sync::Mutex::new(Vec::new()),
+        }
+    }
+
+    /// Record a stage timestamp, keeping only the most recent samples. The
+    /// oldest entry is dropped once the ring is full so the buffers stay
+    /// bounded for a long run.
+    fn mark(vec: &std::sync::Mutex<Vec<Instant>>, now: Instant) {
+        // A poisoned lock only means a previous holder panicked; the ring is a
+        // diagnostic buffer, so drop the sample rather than propagating.
+        let Ok(mut v) = vec.lock() else {
+            return;
+        };
+        if v.len() >= WAKE_SAMPLE_CAP {
+            v.remove(0);
+        }
+        v.push(now);
+    }
+}
+
+/// Percentile helper for the bounded wake-latency samples.
+fn percentile(sorted: &[u128], p: f64) -> f64 {
+    if sorted.is_empty() {
+        return 0.0;
+    }
+    let idx = (((sorted.len() - 1) as f64) * p).round() as usize;
+    sorted[idx] as f64 / 1e6
+}
+
+// ---------------------------------------------------------------------------
+// Per-frame path trace.
+//
+// The purpose is to attribute a long inter-present gap to ONE hop instead of
+// guessing. Every record is keyed by a single monotonic sequence number, so the
+// five stamps always describe the SAME video frame:
+//
+//   seq  = FRAME first became pending        (mpv_render_context_update -> FRAME,
+//                                             pending went 0 -> FRAME)
+//   t_pending      -> actual queue_render()   executed for that frame
+//   t_queued       -> GtkGLArea render start
+//   t_render_start -> mpv_render_context_render() returned
+//   t_render_done  -> GDK after-paint on the GLArea's frame clock
+//   t_after_paint
+//
+// Reading the trace:
+//   * a long gap in inter_pending_gaps_ns, with a rising mpv `frame-drop-count`
+//     and NO new seq, points at the mpv VO / timing / supply side, before the
+//     application ever sees a frame;
+//   * t_queued - t_pending large          -> GTK/main-loop scheduling;
+//   * t_render_done - t_render_start large -> GL / texture upload work;
+//   * t_after_paint - t_render_done large -> GDK / compositor path;
+//   * `superseded` on a record             -> a new FRAME became pending while
+//     the previous frame had not been rendered yet. This is the ONLY app-side
+//     frame-loss signal, and it is deliberately kept distinct from the benign
+//     "FRAME reported again for the frame already pending" case, which is
+//     counted as `queue_coalesced` instead.
+//
+// A trace only proves what it observed. `pending_frame_transitions ==
+// render_submits` proves the app consumed each pending-state transition; it does
+// NOT prove libmpv offered every distinct video frame, because update
+// notifications can coalesce. Supply-side loss is visible only as a rising
+// `frame-drop-count` / `decoder-frame-drop-count`, which is why both are reported
+// as per-interval deltas alongside this trace.
+// ---------------------------------------------------------------------------
+
+/// Why a `GtkGLArea::queue_render()` was executed.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum QueueRenderReason {
+    /// The pump found a genuinely pending FRAME that was not already queued.
+    PumpFrame,
+    /// The L197 presentation-containment boundary asked for one more paint. This
+    /// carries no new video frame, so it must not be counted as frame supply.
+    RevealBoundary,
+    /// Resize, mapping, or another non-frame invalidation.
+    Other,
+}
+
+/// One genuine video frame's full path through the app, on one monotonic sequence.
+#[derive(Clone, Debug)]
+pub struct FrameTrace {
+    pub seq: u64,
+    /// Media generation, so a replacement stream cannot be confused with the
+    /// outgoing one.
+    pub generation: u64,
+    /// `MPV_RENDER_PARAM_NEXT_FRAME_INFO.target_time` at the moment the frame
+    /// became pending. `None` when libmpv did not report one.
+    pub target_time: Option<i64>,
+    /// mpv's own pacing interval: the gap to the PREVIOUS frame's
+    /// `target_time`, in milliseconds. This is the ONLY part of
+    /// `target_time` that is usable on this private libmpv, because it is a
+    /// difference of two adjacent samples of one series. For a 30 fps source the
+    /// usual step is exactly 33.33 ms. `-1.0` for the first sample and for any
+    /// sample where mpv reported `target_time = 0`.
+    ///
+    /// NO lateness, margin or schedule-drift number is reported anywhere from
+    /// `target_time`, and none may be derived downstream. `target_time` is
+    /// documented as sharing `mpv_get_time_us()`'s base and on this build it
+    /// does not: the two were measured on the SAME sample at ~3.2 s and
+    /// ~10053 s respectively, and the series additionally makes rare
+    /// multi-thousand-second forward jumps, so its cumulative advance exceeds
+    /// wall time by roughly 500x. See [`FrameTraceSink::target_jumps`].
+    pub target_dt_ms: f64,
+    /// `target_time - mpv_get_time_ns()` at the moment the frame became pending,
+    /// in milliseconds.
+    ///
+    /// THIS IS NOT A LATENESS MEASUREMENT, and an earlier version of this file
+    /// claimed it was. That claim was wrong and is withdrawn. Two upstream facts
+    /// make it unwrong-able here:
+    ///
+    /// 1. `vo_is_ready_for_frame()` refuses to report ready while
+    ///    `next_pts - timing_offset - flip_queue_offset > now`. With
+    ///    `video-timing-offset=0` that means a frame is only ever handed over
+    ///    once `next_pts <= now`, so a NON-POSITIVE value is a structural
+    ///    guarantee of the API, not evidence of lateness. A large negative value
+    ///    only says the handoff waited longer than the minimum, which is
+    ///    expected and correct behaviour.
+    /// 2. The deadline that actually governs dropping is
+    ///    `end_time = pts + duration`, and the strict rule in `render_frame()`
+    ///    drops on `end_time < now`, NOT on `pts < now`. `vo_frame.duration` is
+    ///    not exposed through the render API at all, so the app cannot evaluate
+    ///    that deadline even in principle.
+    ///
+    /// It is retained as a raw quantity, and as the join key against the in-VO
+    /// hop trace, which is where the real per-hop accounting is done.
+    pub pts_minus_now_ms: f64,
+    /// mpv's own clock at the pending hop, in nanoseconds. Same clock as the
+    /// in-VO trace, so `app_pending_ns - publish_ns` is an exact hop cost.
+    pub mpv_now_ns: i64,
+    /// Run-wide count of consecutive `target_time` samples differing by more
+    /// than one second. Non-zero means the series has discontinuities, so
+    /// `target_dt_ms` is the usual step and not a per-frame guarantee.
+    pub target_time_jumps: u64,
+    pub next_state: &'static str,
+    pub t_pending: Instant,
+    pub t_queued: Option<Instant>,
+    pub t_render_start: Option<Instant>,
+    pub t_render_done: Option<Instant>,
+    pub t_after_paint: Option<Instant>,
+    /// A newer FRAME became pending before this frame was ever rendered.
+    pub superseded: bool,
+    /// An after-paint was expected but never observed for this frame.
+    pub paint_missing: bool,
+    /// Gap from the previous frame becoming pending to this one. Long values with
+    /// no new sequence in between mean libmpv offered nothing, which is a
+    /// supply-side fact and cannot be attributed to rendering.
+    pub inter_pending_ms: f64,
+    /// Gap between consecutive mpv_render_context_render() completions (actual app submit).
+    pub inter_submit_ms: f64,
+    /// Gap from the PREVIOUS frame's after-paint to this frame becoming pending.
+    /// This is the operator-visible inter-present interval: it is what the eye
+    /// sees, and it is deliberately different from the inter-pending gap because a
+    /// frame that stays pending across a paint compresses the two.
+    pub inter_present_ms: f64,
+}
+
+impl FrameTrace {
+    fn hop_ms(&self, from: &Option<Instant>, to: &Option<Instant>) -> f64 {
+        match (from, to) {
+            (Some(a), Some(b)) => b.saturating_duration_since(*a).as_secs_f64() * 1000.0,
+            _ => -1.0,
+        }
+    }
+
+    /// pending -> queue_render(). GTK/main-loop scheduling.
+    pub fn pending_to_queued_ms(&self) -> f64 {
+        self.hop_ms(&Some(self.t_pending), &self.t_queued)
+    }
+    /// queue_render() -> GtkGLArea render callback start.
+    pub fn queued_to_start_ms(&self) -> f64 {
+        self.hop_ms(&self.t_queued, &self.t_render_start)
+    }
+    /// render start -> mpv_render_context_render() returned. GL/upload work.
+    pub fn render_ms(&self) -> f64 {
+        self.hop_ms(&self.t_render_start, &self.t_render_done)
+    }
+    /// render returned -> GDK after-paint. Compositor path.
+    pub fn done_to_paint_ms(&self) -> f64 {
+        self.hop_ms(&self.t_render_done, &self.t_after_paint)
+    }
+    /// The whole app-visible path, pending -> after-paint.
+    pub fn end_to_end_ms(&self) -> f64 {
+        self.hop_ms(&Some(self.t_pending), &self.t_after_paint)
+    }
+
+    /// One log line per traced frame. Unstamped hops print as `na`, never as a
+    /// fabricated zero, so a missing boundary is visible instead of implied.
+    pub fn log_line(&self) -> String {
+        format!(
+            "seq={} gen={} state={} target_time={} target_dt_ms={:.1} pts_minus_now_ms={:.1} mpv_now_ns={} target_time_jumps={} inter_pending_ms={:.1} \
+             inter_submit_ms={:.1} inter_present_ms={:.1} p2q_ms={:.1} q2s_ms={:.1} render_ms={:.1} \
+             d2p_ms={:.1} e2e_ms={:.1} superseded={} paint_missing={}",
+            self.seq,
+            self.generation,
+            self.next_state,
+            self.target_time
+                .map(|t| t.to_string())
+                .unwrap_or_else(|| "na".to_string()),
+            self.target_dt_ms,
+            self.pts_minus_now_ms,
+            self.mpv_now_ns,
+            self.target_time_jumps,
+            self.inter_pending_ms,
+            self.inter_submit_ms,
+            self.inter_present_ms,
+            self.pending_to_queued_ms(),
+            self.queued_to_start_ms(),
+            self.render_ms(),
+            self.done_to_paint_ms(),
+            self.end_to_end_ms(),
+            u8::from(self.superseded),
+            u8::from(self.paint_missing),
+        )
+    }
+}
+
+/// Collects [`FrameTrace`] records. All methods take `&self` and are called from
+/// the GTK main context only, so no locking is needed; they never borrow the
+/// player, which matters because the reveal-boundary path already calls
+/// `queue_render()` from inside the render callback.
+pub struct FrameTraceSink {
+    pub enabled: bool,
+    /// Maximum completed records retained. Bounded so a long run cannot grow
+    /// without limit.
+    pub limit: usize,
+    seq: Cell<u64>,
+    generation: Cell<u64>,
+    /// Pending, but not yet rendered.
+    in_flight: RefCell<Option<FrameTrace>>,
+    /// Rendered, waiting for the GDK after-paint that closes the record.
+    awaiting_paint: RefCell<Option<FrameTrace>>,
+    done: RefCell<std::collections::VecDeque<FrameTrace>>,
+    last_pending_at: RefCell<Option<Instant>>,
+    last_render_done_at: RefCell<Option<Instant>>,
+    /// When the previous traced frame reached its after-paint boundary. Used for
+    /// the operator-visible inter-present interval.
+    last_after_paint_at: RefCell<Option<Instant>>,
+    /// First non-zero `target_time` seen, kept only to detect discontinuities.
+    ///
+    /// IT IS NOT A CLOCK REFERENCE and the code deliberately does not treat it
+    /// as one. See the `FrameTrace::target_dt_ms` documentation for the
+    /// measurement that ruled that out.
+    first_target_time: RefCell<Option<i64>>,
+    last_target_time: RefCell<Option<i64>>,
+    /// Consecutive `target_time` samples differing by more than one second.
+    pub target_jumps: Cell<u64>,
+    /// `pts - now` per frame, in milliseconds. See
+    /// [`FrameTrace::pts_minus_now_ms`] for why this is NOT a lateness
+    /// measurement and must not be read as one.
+    pts_minus_now_ms: RefCell<std::collections::VecDeque<f64>>,
+    margin_limit: usize,
+    /// Gap from the previous FRAME-became-pending to this one. A long value here
+    /// with no new seq in between means libmpv offered nothing, which is a supply
+    /// question, not an app one.
+    inter_pending_gaps_ns: RefCell<std::collections::VecDeque<u64>>,
+    /// A new FRAME arrived while the previous frame had not been rendered.
+    pub superseded: Cell<u64>,
+    /// Records dropped because `limit` was reached.
+    pub dropped: Cell<u64>,
+    /// Records emitted to the log.
+    pub emitted: Cell<u64>,
+    /// Inter-pending gaps retained for the whole run.
+    pub inter_pending_limit: usize,
+}
+
+impl FrameTraceSink {
+    pub fn new(enabled: bool, limit: usize) -> Rc<Self> {
+        Rc::new(Self {
+            enabled,
+            limit,
+            seq: Cell::new(0),
+            generation: Cell::new(0),
+            in_flight: RefCell::new(None),
+            awaiting_paint: RefCell::new(None),
+            done: RefCell::new(std::collections::VecDeque::new()),
+            last_pending_at: RefCell::new(None),
+            last_render_done_at: RefCell::new(None),
+            last_after_paint_at: RefCell::new(None),
+            first_target_time: RefCell::new(None),
+            last_target_time: RefCell::new(None),
+            target_jumps: Cell::new(0),
+            pts_minus_now_ms: RefCell::new(std::collections::VecDeque::new()),
+            margin_limit: 8192,
+            inter_pending_gaps_ns: RefCell::new(std::collections::VecDeque::new()),
+            superseded: Cell::new(0),
+            dropped: Cell::new(0),
+            emitted: Cell::new(0),
+            inter_pending_limit: 4096,
+        })
+    }
+
+    pub fn set_generation(&self, generation: u64) {
+        self.generation.set(generation);
+    }
+
+    pub fn current_seq(&self) -> Option<u64> {
+        self.in_flight
+            .borrow()
+            .as_ref()
+            .map(|t| t.seq)
+            .or_else(|| self.awaiting_paint.borrow().as_ref().map(|t| t.seq))
+    }
+
+    fn push_done(&self, record: FrameTrace) {
+        let mut done = self.done.borrow_mut();
+        done.push_back(record);
+        while done.len() > self.limit {
+            done.pop_front();
+            self.dropped.set(self.dropped.get().wrapping_add(1));
+        }
+    }
+
+    /// A genuinely new pending frame. Returns its sequence number, or `None` when
+    /// tracing is off.
+    pub fn begin_pending(
+        &self,
+        target_time: Option<i64>,
+        mpv_now_ns: Option<i64>,
+        next_state: &'static str,
+    ) -> Option<u64> {
+        if !self.enabled {
+            return None;
+        }
+        let now = Instant::now();
+        // Both gaps are computed HERE and stored ON the record. An earlier version
+        // kept only a gap vector and re-derived the per-line value at log time by
+        // indexing that vector with the sequence number, which silently paired the
+        // wrong gap with the wrong frame as soon as the metrics interval trimmed
+        // the vector. The value that is reported for a frame is now the value that
+        // was measured for that frame.
+        let mut inter_pending_ms = -1.0;
+        if let Some(previous) = *self.last_pending_at.borrow() {
+            let gap = now
+                .saturating_duration_since(previous)
+                .as_nanos()
+                .min(u128::from(u64::MAX)) as u64;
+            inter_pending_ms = gap as f64 / 1_000_000.0;
+            let mut gaps = self.inter_pending_gaps_ns.borrow_mut();
+            gaps.push_back(gap);
+            while gaps.len() > self.inter_pending_limit {
+                gaps.pop_front();
+            }
+        }
+        // RESTORED, and this line is load-bearing. Without it `last_pending_at`
+        // is never set, every `inter_pending_ms` stays -1.0, and the entire
+        // inter-pending series then reads as "no data" instead of as a number --
+        // which is exactly what happened once already in this pass.
+        *self.last_pending_at.borrow_mut() = Some(now);
+
+        // mpv's own pacing interval and lateness, from `target_time`.
+        //
+        // UNIT, measured rather than assumed. `mpv_render_frame_info.target_time`
+        // is documented as microseconds on the same base as `mpv_get_time_us()`.
+        // On this private libmpv it is NANOSECONDS: adjacent samples at 30 fps
+        // differ by 33,334,000, and the absolute values land in the same range as
+        // `mpv_get_time_us()` once that is multiplied by 1000. Reading the field
+        // as microseconds made the series look like it advanced 1000x too fast,
+        // which is what produced the earlier absurd "margin grows by hours"
+        // numbers. Everything below therefore scales by 1e6.
+        //
+        // `target_time = 0` means mpv has no presentation clock for this frame
+        // (the render API documents 0 for redraws and for vsync-locked timing),
+        // so those samples carry neither an interval nor a margin.
+        let mut target_dt_ms = -1.0;
+        let mut pts_minus_now_ms = -1.0;
+        if let Some(tt) = target_time.filter(|t| *t > 0) {
+            if self.first_target_time.borrow().is_none() {
+                *self.first_target_time.borrow_mut() = Some(tt);
+            }
+            if let Some(previous) = *self.last_target_time.borrow() {
+                let delta = tt.saturating_sub(previous);
+                if delta > 1_000_000_000 {
+                    self.target_jumps.set(self.target_jumps.get().wrapping_add(1));
+                }
+                target_dt_ms = delta as f64 / 1_000_000.0;
+            }
+            if let Some(now_ns) = mpv_now_ns {
+                pts_minus_now_ms = tt.saturating_sub(now_ns) as f64 / 1_000_000.0;
+                let mut margins = self.pts_minus_now_ms.borrow_mut();
+                margins.push_back(pts_minus_now_ms);
+                while margins.len() > self.margin_limit {
+                    margins.pop_front();
+                }
+            }
+            *self.last_target_time.borrow_mut() = Some(tt);
+        }
+        let target_time_jumps = self.target_jumps.get();
+
+        let inter_present_ms = match *self.last_after_paint_at.borrow() {
+            Some(previous) => {
+                now.saturating_duration_since(previous).as_secs_f64() * 1000.0
+            }
+            None => -1.0,
+        };
+
+        // A frame that became pending and was never rendered before a newer one
+        // arrived. This is the only app-side loss signal in the trace.
+        let previous_in_flight = self.in_flight.borrow_mut().take();
+        if let Some(mut stale) = previous_in_flight {
+            stale.superseded = true;
+            self.superseded.set(self.superseded.get().wrapping_add(1));
+            self.push_done(stale);
+        }
+        // A rendered frame whose after-paint never arrived.
+        let previous_awaiting = self.awaiting_paint.borrow_mut().take();
+        if let Some(mut stale) = previous_awaiting {
+            stale.paint_missing = true;
+            self.push_done(stale);
+        }
+
+        let seq = self.seq.get().wrapping_add(1);
+        self.seq.set(seq);
+        *self.in_flight.borrow_mut() = Some(FrameTrace {
+            seq,
+            generation: self.generation.get(),
+            target_time,
+            target_dt_ms,
+            pts_minus_now_ms,
+            mpv_now_ns: mpv_now_ns.unwrap_or(-1),
+            target_time_jumps,
+            next_state,
+            t_pending: now,
+            t_queued: None,
+            t_render_start: None,
+            t_render_done: None,
+            t_after_paint: None,
+            superseded: false,
+            paint_missing: false,
+            inter_pending_ms,
+            inter_submit_ms: -1.0,
+            inter_present_ms,
+        });
+        Some(seq)
+    }
+
+    /// `GtkGLArea::queue_render()` site, so this counts real calls, not intent.
+    /// Drain the per-frame `pts - now` values collected since the last call.
+    pub fn take_pts_minus_now_ms(&self) -> Vec<f64> {
+        self.pts_minus_now_ms.borrow_mut().drain(..).collect()
+    }
+
+    /// A `queue_render()` was actually executed. Only ever called at a real
+    /// `GtkGLArea::queue_render()` site, so this counts real calls, not intent.
+    pub fn mark_queued(&self) {
+        if !self.enabled {
+            return;
+        }
+        if let Some(record) = self.in_flight.borrow_mut().as_mut() {
+            if record.t_queued.is_none() {
+                record.t_queued = Some(Instant::now());
+            }
+        }
+    }
+
+    /// The GtkGLArea render callback started, for the frame currently in flight.
+    pub fn mark_render_start(&self) {
+        if !self.enabled {
+            return;
+        }
+        if let Some(record) = self.in_flight.borrow_mut().as_mut() {
+            if record.t_render_start.is_none() {
+                record.t_render_start = Some(Instant::now());
+            }
+        }
+    }
+
+    /// `mpv_render_context_render()` returned. Moves the record to the
+    /// after-paint wait.
+    pub fn mark_render_done(&self) {
+        if !self.enabled {
+            return;
+        }
+        let now = Instant::now();
+        let inter_submit_ms = match *self.last_render_done_at.borrow() {
+            Some(prev) => now.saturating_duration_since(prev).as_secs_f64() * 1000.0,
+            None => -1.0,
+        };
+        *self.last_render_done_at.borrow_mut() = Some(now);
+        let mut in_flight = self.in_flight.borrow_mut();
+        let Some(mut record) = in_flight.take() else {
+            return;
+        };
+        record.t_render_done = Some(now);
+        record.inter_submit_ms = inter_submit_ms;
+        drop(in_flight);
+        let mut awaiting = self.awaiting_paint.borrow_mut();
+        if let Some(mut previous) = awaiting.take() {
+            previous.paint_missing = true;
+            self.push_done(previous);
+        }
+        *awaiting = Some(record);
+    }
+
+    /// The GDK after-paint on the GLArea's frame clock.
+    pub fn mark_after_paint(&self) {
+        if !self.enabled {
+            return;
+        }
+        let now = Instant::now();
+        let record = self.awaiting_paint.borrow_mut().take();
+        if let Some(mut record) = record {
+            record.t_after_paint = Some(now);
+            *self.last_after_paint_at.borrow_mut() = Some(now);
+            self.push_done(record);
+        }
+    }
+
+    /// Inter-pending gaps for the current interval, cleared by the caller.
+    pub fn take_inter_pending_gaps(&self) -> std::collections::VecDeque<u64> {
+        std::mem::take(&mut *self.inter_pending_gaps_ns.borrow_mut())
+    }
+
+    /// Whole-run inter-pending gap distribution, independent of the interval.
+    pub fn all_inter_pending_gaps(&self) -> Vec<u64> {
+        self.inter_pending_gaps_ns.borrow().iter().copied().collect()
+    }
+
+    /// Log every record completed since the last call. Returns how many were
+    /// emitted.
+    pub fn log_completed(&self) -> usize {
+        if !self.enabled {
+            return 0;
+        }
+        let ready: Vec<FrameTrace> = self.done.borrow_mut().drain(..).collect();
+        if ready.is_empty() {
+            return 0;
+        }
+        for record in &ready {
+            log::info!("Pipeline frame trace {}", record.log_line());
+            self.emitted.set(self.emitted.get().wrapping_add(1));
+        }
+        ready.len()
+    }
+}
+
+/// Which wake-latency stage a timestamp belongs to.
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum WakeStage {
+    /// Main-context wake callback began executing.
+    Wake,
+    /// The page asked GtkGLArea to queue a render.
+    Queue,
+    /// The GtkGLArea render callback started.
+    GlStart,
+    /// The GtkGLArea render callback finished.
+    GlDone,
+}
+
+impl RenderCallbackCounters {
+    /// Record a wake-latency stage timestamp. Safe to call from any stage
+    /// without borrowing the player.
+    pub fn mark_stage(&self, stage: WakeStage) {
+        let now = Instant::now();
+        let slot = match stage {
+            WakeStage::Wake => &self.wake_at,
+            WakeStage::Queue => &self.queue_at,
+            WakeStage::GlStart => &self.gl_start_at,
+            WakeStage::GlDone => &self.gl_done_at,
+        };
+        RenderCallbackCounters::mark(slot, now);
+    }
+}
+
+/// Bounded wake-latency summary for one reporting interval. Each tuple is
+/// (p50, p95, max) in milliseconds.
+struct WakeLatencySummary {
+    samples: usize,
+    cb_to_wake: (f64, f64, f64),
+    wake_to_gl: (f64, f64, f64),
+    cb_to_gl: (f64, f64, f64),
+    gl_total: (f64, f64, f64),
+}
+
+struct RenderCallbackState {
+    wakeup: RenderWakeup,
+    counters: Arc<RenderCallbackCounters>,
+    wakeup_pending: Arc<AtomicBool>,
+    /// Captured main context used for the normal-priority dispatch. The mpv
+    /// callback thread must not touch mpv or GL, and it does not: it only
+    /// records a timestamp and asks this context to invoke a closure.
+    main_context: glib::MainContext,
+    /// When set, dispatch through the captured main context at normal priority
+    /// instead of the default-priority idle hop. A/B switch for the wakeup
+    /// scheduling measurement.
+    normal_priority: bool,
+}
+
+unsafe extern "C" fn render_update_callback(context: *mut c_void) {
+    if context.is_null() {
+        return;
+    }
+    let state = unsafe { &*context.cast::<RenderCallbackState>() };
+    state
+        .counters
+        .update_callbacks
+        .fetch_add(1, Ordering::Relaxed);
+    if !state.wakeup_pending.swap(true, Ordering::AcqRel) {
+        state.counters.wakeups.fetch_add(1, Ordering::Relaxed);
+        let wakeup = state.wakeup.clone();
+        let pending = state.wakeup_pending.clone();
+        let counters = state.counters.clone();
+        // Stage: mpv render-update callback arrival, recorded on the mpv
+        // thread before the main-loop hop is requested. This is a timestamp
+        // only: no mpv API and no GL call happens here.
+        RenderCallbackCounters::mark(&counters.callback_at, Instant::now());
+        // The callback is deliberately limited to an atomic wakeup and a
+        // main-loop hop. libmpv forbids calling any mpv API from this thread.
+        if state.normal_priority {
+            // Normal/default-priority invoke on the captured context. Unlike
+            // glib::idle_add_once (a G_PRIORITY_DEFAULT_IDLE source), this is
+            // not starved behind ordinary idle work such as thumbnails,
+            // layout and CSS.
+            let ctx = state.main_context.clone();
+            ctx.invoke(move || {
+                pending.store(false, Ordering::Release);
+                wakeup();
+            });
+        } else {
+            glib::idle_add_once(move || {
+                pending.store(false, Ordering::Release);
+                wakeup();
+            });
+        }
+    }
+}
