+fn playlist_entry_id_from_node(node: &MpvNode) -> Option<i64> {
+    if node.format != MPV_FORMAT_NODE_MAP {
+        return None;
+    }
+    let list = unsafe { node.data.list };
+    if list.is_null() {
+        return None;
+    }
+    let keys = unsafe { (*list).keys };
+    let values = unsafe { (*list).values };
+    if keys.is_null() || values.is_null() {
+        return None;
+    }
+    let count = unsafe { (*list).num };
+    for index in 0..count.max(0) as isize {
+        let key = unsafe { *keys.offset(index) };
+        if key.is_null() {
+            continue;
+        }
+        let key_matches = unsafe { CStr::from_ptr(key) }.to_bytes() == b"playlist_entry_id";
+        if !key_matches {
+            continue;
+        }
+        let value = unsafe { *values.offset(index) };
+        return (value.format == MPV_FORMAT_INT64).then_some(unsafe { value.data.int64_ });
+    }
+    None
+}
