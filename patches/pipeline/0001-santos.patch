+        let width = self.cached_video_w;
+        let height = self.cached_video_h;
+        let fps = self.cached_video_fps;
+        let params = &self.cached_video_params;
+        let profile = &self.cached_profile;
+        let timing_offset = &self.cached_timing_offset;
+        let jitter = Self::jitter_of(&interval_gaps);
+        log::info!(
+            "Pipeline render aggregate interval_ms={} load_phase={} renderer_error={:?} \
+             recovery_exhausted={} update_callbacks={} wakeups={} pump_attempts={} update_frame_positives={} pending_frame_transitions={} queue_render_calls={} queue_render_calls_pump={} queue_render_calls_reveal={} queue_render_calls_other={} queue_coalesced={} render_cb_frame={} update_flag_positives={} queue_render_requests={} render_callbacks={} render_submits={} update_ms_p50={:.3} update_ms_p95={:.3} update_ms_max={:.3} render_ms_p50={:.3} render_ms_p95={:.3} render_ms_max={:.3} video={}x{}@{:.3} video_params={:?} frame_drop_count={:?} decoder_frame_drop_count={:?} main_cpu_pct={:.1} profile={:?} video_sync=audio timing_offset={} submit_gap_p50={:.1} submit_gap_p95={:.1} submit_gap_max={:.1} gaps_gt50={} gaps_gt67={} gaps_gt100={} gap_scope=interval frame_drop_delta={:?} decoder_frame_drop_delta={:?} trace_superseded={} trace_emitted={} trace_dropped={} {} {} ### render supply run_gap_p50={:.1} run_gap_p95={:.1} run_gap_max={:.1}",
+            elapsed.as_millis(),
