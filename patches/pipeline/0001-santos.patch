+        &self.quality_evidence
+    }
+
+    fn refresh_decoded_quality(&mut self) {
+        if !self.has_file { return; }
+        self.last_quality_probe = Some(Instant::now());
+        let width = self.get_i64("video-params/w").unwrap_or(0).max(0) as u32;
+        let height = self.get_i64("video-params/h").unwrap_or(0).max(0) as u32;
+        if width != 0 && height != 0 && (width, height) !=
+            (self.quality_evidence.decoded_width, self.quality_evidence.decoded_height) {
+            self.quality_evidence.decoded_width = width;
+            self.quality_evidence.decoded_height = height;
+            log::info!("Pipeline quality decoded={}x{} selected={:?} viewport={}x{} generation={}",
+                width, height, self.quality_evidence.selected, self.quality_evidence.viewport_width,
+                self.quality_evidence.viewport_height, self.media_generation);
+            if let Some(selected) = self.quality_evidence.selected.as_ref() {
+                if (width, height) != (selected.width, selected.height) {
+                    log::warn!("Pipeline selected/decode size mismatch selected={}x{} decoded={}x{}",
+                        selected.width, selected.height, width, height);
+                }
+            }
+        }
+    }
+
+    /// True once the recovery budget is spent and the terminal state has latched.
+    pub fn is_recovery_exhausted(&self) -> bool {
+        self.recovery_exhausted
+    }
+
+    /// Bounded, monotonic renderer-failure guard so a broken GL stack is
+    /// reported once per generation instead of on every poll.
+    fn fail_renderer(&mut self, reason: impl Into<String>) {
+        let reason = reason.into();
+        if self.renderer_error.as_deref() == Some(reason.as_str()) {
+            return;
+        }
+        self.renderer_error = Some(reason.clone());
+        self.state = PlaybackState::Error;
+        self.error = Some(format!("Renderer error: {reason}"));
+        self.load_phase = LoadPhase::Idle;
+        log::error!("Pipeline renderer error: {reason}");
+    }
+
+    /// Called by the page when the GtkGLArea render context becomes available,
+    /// so a pending stream can be issued immediately instead of waiting for the
+    /// next poll tick.
+    /// Only legal once the libmpv render context really exists. The previous
+    /// call site fired on GtkGLArea map, which says nothing about the libmpv
+    /// context and produced a misleading lifecycle name; readiness is now
+    /// reported by `prepare_render_context_current` itself.
+    /// Issue an already-resolved stream as soon as a render context exists.
+    ///
+    /// Previously issuance waited for the first GLArea render callback to create
+    /// the context, so `loadfile` depended on an incidental GTK redraw. With the
+    /// deterministic bootstrap it can be issued from the realize/map path.
+    /// Idempotent: no-op when there is no pending stream or one is already loaded.
+    pub fn issue_pending_stream_if_ready(&mut self) {
+        if self.render_context.is_null() || self.pending_stream.is_none() || self.has_file {
+            return;
+        }
+        log::info!("Pipeline bootstrap loadfile issued from bootstrap path");
+        if self.start_pending_stream().is_err() {
+            // The issuing function has already latched/logged the media error.
+            self.load_phase = LoadPhase::Idle;
+        }
+    }
+
+    pub fn note_render_context_ready(&mut self) {
+        if self.render_context.is_null() {
+            return;
+        }
+        if self.load_phase.awaiting_render_context() {
+            log::info!(
+                "Pipeline lifecycle stage=render-context-ready generation={} phase={}",
+                self.media_generation,
+                self.load_phase.label()
+            );
+        }
+    }
+
+    /// Clear a renderer failure and wait for the GLArea render context again.
+    /// Deliberately does NOT touch the recovery budget: a GL problem is not a
+    /// media problem, so yt-dlp must not be involved.
+    pub fn retry_renderer(&mut self) {
+        if self.pending_stream.is_none() {
+            if let Some(stream) = self.active_stream.clone() {
+                let snapshot = self.recovery_snapshot();
+                self.recovery_resume_target = Some(snapshot.position);
+                self.recovery_snapshot = Some(snapshot);
+                self.recovery_resume_seek_sent = false;
+                self.recovery_resume_landing_pending = false;
+                self.recovery_resume_restart_seen = false;
+                self.pending_stream = Some(stream);
+                self.has_file = false;
+            }
+        }
+        self.renderer_error = None;
+        self.error = None;
+        self.state = PlaybackState::Buffering;
+        self.recovery_exhausted = false;
+        self.load_phase = if self.pending_stream.is_some() {
+            LoadPhase::PendingRenderContext { since_secs: 0.0 }
+        } else {
+            LoadPhase::Idle
+        };
+        self.last_progress_at = Instant::now();
+        self.first_current_frame_seen = false;
+        self.holding_recovery_frame = false;
+        log::info!(
+            "Pipeline lifecycle stage=renderer-retry-armed generation={} phase={} \
+             has_pending_stream={}",
+            self.media_generation,
+            self.load_phase.label(),
+            self.pending_stream.is_some()
+        );
+    }
+
+    /// Report a GtkGLArea / GL context failure captured at realize or
+    /// make_current time. This is renderer infrastructure: it must not be
+    /// classified as a media stall and must not spend recovery attempts.
+    pub fn report_glarea_error(&mut self, detail: &str) {
+        self.fail_renderer(format!("GtkGLArea GL context unavailable ({detail})"));
+    }
+
+    fn observe_playback_progress(&mut self, cache_paused: bool) {
+        let now = Instant::now();
+        if cache_paused {
+            self.last_progress_at = now;
+            if !self.cache_pause_observed {
+                log::debug!(
+                    "Pipeline recovery classification=normal-cache-starvation suppression=1 generation={}",
+                    self.media_generation
+                );
+            }
+        }
+        self.cache_pause_observed = cache_paused;
+
+        if self.state == PlaybackState::Playing
+            && !cache_paused
+            && self.get_flag("pause") == Some(false)
+            && self.position > self.continuous_position + 0.05
+        {
+            self.continuous_position = self.position;
+        }
+
+        if self.state == PlaybackState::Playing
+            && !cache_paused
+            && self.get_flag("pause") == Some(false)
+            && (self.position - self.last_position).abs() >= 0.05
+        {
+            self.last_position = self.position;
+            self.last_progress_at = now;
+        }
+
+        if self.fault_after_ms > 0
+            && !self.fault_injected
+            && !self.recovery_exhausted
+            && self.position >= self.fault_after_ms as f64 / 1000.0
+            && self.state == PlaybackState::Playing
+        {
+            self.fault_injected = true;
+            self.request_recovery(RecoveryCause::InjectedFault);
+            return;
+        }
+
+        // Renderer infrastructure: bounded and never routed to yt-dlp.
+        if self.load_phase.awaiting_render_context()
+            && now.duration_since(self.last_progress_at) >= RENDER_CONTEXT_TIMEOUT
+        {
+            let waited = now.duration_since(self.last_progress_at).as_secs_f64();
+            log::error!(
+                "Pipeline lifecycle stage=render-context-timeout generation={} \
+                 waited_secs={:.1} classification=render-infrastructure \
+                 (loadfile was never issued, so this is NOT a media stall)",
+                self.media_generation,
+                waited
+            );
+            self.fail_renderer(format!(
+                "no GL render context after {:.0}s",
+                RENDER_CONTEXT_TIMEOUT.as_secs_f64()
+            ));
+            return;
+        }
+
+        // Media/network load timeout. Armed ONLY once `loadfile` was actually
+        // accepted, so a missing render context can never reach this branch.
+        if self.load_phase.loadfile_accepted()
+            && !cache_paused
+            && self.recovery_request.is_none()
+            && !self.recovery_exhausted
+            && now.duration_since(self.last_progress_at) >= RECOVERY_LOAD_TIMEOUT
+        {
+            self.request_recovery(RecoveryCause::NoProgress);
+            // request_recovery suppresses an already-owned recovery. Log only
+            // a newly scheduled request, not every 100ms while its open stalls.
+            if self.recovery_request.is_some() {
+                log::warn!(
+                    "Pipeline lifecycle stage=load-timeout generation={} phase={} \
+                     playlist_entry_id={} classification=media-load-stall",
+                    self.media_generation,
+                    self.load_phase.label(),
+                    self.current_playlist_entry_id
+                );
+            }
+            return;
+        }
+
+        if self.recovery_resume_target.is_some()
+            && !self.recovery_resume_seek_sent
+            && self.recovery_request.is_none()
+            && !self.recovery_exhausted
+            && now.duration_since(self.last_progress_at) >= RECOVERY_LOAD_TIMEOUT
+        {
+            self.request_recovery(RecoveryCause::NoProgress);
+            return;
+        }
+
+        if self.has_file
+            && self.state == PlaybackState::Playing
+            && !cache_paused
+            && self.get_flag("pause") == Some(false)
+            && self.recovery_snapshot.is_none()
+            && !self.recovery_exhausted
+            && self.duration > self.position + 1.0
+            && now.duration_since(self.last_progress_at) >= RECOVERY_NO_PROGRESS_TIMEOUT
+            && now.duration_since(self.last_frame_submit_at) >= Duration::from_secs(2)
+        {
+            self.request_recovery(RecoveryCause::NoProgress);
+            return;
+        }
+
+        if !self.recovery_sustained
+            && let Some(target) = self.recovery_resume_target
+            && let Some(started) = self.recovery_resume_started_at
+        {
+            if !self.recovery_resume_landing_pending
+                && self.position > self.recovery_resume_last_position + 0.05
+            {
+                self.recovery_resume_last_position = self.position;
+                self.recovery_resume_last_forward_at = Some(now);
+            }
+            if !self.recovery_resume_landing_pending {
+                let landing = self
+                    .recovery_resume_landing_position
+                    .unwrap_or(self.recovery_resume_last_position);
+                let forward = (self.position - landing).max(0.0);
+                if forward >= RECOVERY_SUSTAINED_MEDIA_SECONDS
+                    || (forward >= 0.5 && now.duration_since(started) >= Duration::from_secs(6))
+                {
+                    self.recovery_sustained = true;
+                    log::info!(
+                        "Pipeline recovery forward interval confirmed target={:.2}s landing={:.2}s actual={:.2}s elapsed_ms={}",
+                        target,
+                        landing,
+                        self.position,
+                        now.duration_since(started).as_millis()
+                    );
+                } else if !cache_paused
+                    && self.get_flag("pause") == Some(false)
+                    && now.duration_since(self.recovery_resume_last_forward_at.unwrap_or(started))
+                        >= RECOVERY_NO_PROGRESS_TIMEOUT
+                {
+                    self.request_recovery(RecoveryCause::NoProgress);
+                }
+            } else if !cache_paused
+                && self.get_flag("pause") == Some(false)
+                && now.duration_since(self.recovery_resume_last_forward_at.unwrap_or(started))
+                    >= RECOVERY_NO_PROGRESS_TIMEOUT
+            {
+                self.request_recovery(RecoveryCause::NoProgress);
+            }
+        }
+    }
+
+    pub fn load(
+        &mut self,
+        stream: &ResolvedStream,
+        video_identity: impl Into<String>,
+    ) -> Result<(), String> {
+        self.error = None;
+        self.holding_recovery_frame = false;
+        self.first_current_frame_seen = false;
+        self.render_error_reported = false;
+        self.position = 0.0;
+        self.duration = stream.duration.unwrap_or(0.0);
+        self.state = PlaybackState::Buffering;
+        self.has_file = false;
+        // A resolved stream is NOT yet a media load. It first needs the render
+        // context, because libmpv cannot be handed the file before the GLArea
+        // exists. No media-load timeout is armed here.
+        self.load_phase = LoadPhase::PendingRenderContext { since_secs: 0.0 };
+        self.renderer_error = None;
+        self.recovery_exhausted = false;
+        self.awaiting_new_start = true;
+        self.new_start_seen = false;
+        self.last_position = 0.0;
+        self.continuous_position = 0.0;
+        self.last_progress_at = Instant::now();
+        self.last_frame_submit_at = Instant::now();
+        self.cache_pause_observed = false;
+        self.cancel_recovery();
+        self.media_generation = self.media_generation.wrapping_add(1);
+        self.current_playlist_entry_id = 0;
+        self.video_identity = video_identity.into();
+        self.video_format = stream.video_format.clone();
+        self.audio_format = stream.audio_format.clone();
+        self.separate_audio = stream.audio_url.is_some();
+        self.invalidate_frame_gate();
+        self.pending_stream = Some(stream.clone());
+        self.active_stream = Some(stream.clone());
+        self.quality_evidence.selected = stream.quality.clone();
+        self.quality_evidence.decoded_width = 0;
+        self.quality_evidence.decoded_height = 0;
+        self.last_quality_probe = None;
+        log::debug!(
+            "loading mpv stream generation={} identity={} video_url_len={} separate_audio={} video_format={:?} audio_format={:?}",
+            self.media_generation,
+            self.video_identity,
+            stream.video_url.len(),
+            self.separate_audio,
+            self.video_format,
+            self.audio_format,
+        );
+        self.start_pending_stream()
+    }
+
+    pub fn replace_for_recovery(
+        &mut self,
+        stream: &ResolvedStream,
+        snapshot: &RecoverySnapshot,
+    ) -> Result<(), String> {
+        if snapshot.media_generation != self.media_generation
+            || snapshot.video_identity != self.video_identity
+        {
+            return Err("stale recovery snapshot rejected".into());
+        }
+        self.holding_recovery_frame = self.first_frame_submitted && !self.render_context.is_null();
+        self.first_current_frame_seen = false;
+        self.media_generation = self.media_generation.wrapping_add(1);
+        self.current_playlist_entry_id = 0;
+        self.video_format = stream.video_format.clone();
+        self.audio_format = stream.audio_format.clone();
+        self.separate_audio = stream.audio_url.is_some();
+        self.recovery_snapshot = Some(snapshot.clone());
+        self.recovery_resume_target = Some(snapshot.position);
+        self.recovery_resume_seek_sent = false;
+        self.recovery_resume_started_at = None;
+        self.recovery_resume_landing_pending = false;
+        self.recovery_resume_restart_seen = false;
+        self.recovery_resume_landing_position = None;
+        self.recovery_resume_last_position = snapshot.position;
+        self.recovery_resume_last_forward_at = None;
+        self.recovery_sustained = false;
+        self.recovery_request = None;
+        self.error = None;
+        self.render_error_reported = false;
+        self.state = PlaybackState::Buffering;
+        self.has_file = false;
+        self.load_phase = LoadPhase::PendingRenderContext { since_secs: 0.0 };
+        self.renderer_error = None;
+        self.awaiting_new_start = true;
+        self.new_start_seen = false;
+        self.last_position = snapshot.position;
+        self.continuous_position = snapshot.position;
+        self.last_progress_at = Instant::now();
+        self.invalidate_frame_gate();
+        self.pending_stream = Some(stream.clone());
+        self.active_stream = Some(stream.clone());
+        self.quality_evidence.selected = stream.quality.clone();
+        self.quality_evidence.decoded_width = 0;
+        self.quality_evidence.decoded_height = 0;
+        self.last_quality_probe = None;
+        log::info!(
+            "Pipeline recovery stage=replacement-start generation={} resume={:.2}s separate_audio={} video_format={:?} audio_format={:?}",
+            self.media_generation,
+            snapshot.position,
+            self.separate_audio,
+            self.video_format,
+            self.audio_format,
+        );
+        self.start_pending_stream()
+    }
+
+    fn start_pending_stream(&mut self) -> Result<(), String> {
+        if self.render_context.is_null() {
+            // Renderer infrastructure, not a media stall. Record the phase and
+            // return success; the bounded render-context timer owns this state.
+            if !self.load_phase.awaiting_render_context() {
+                self.load_phase = LoadPhase::PendingRenderContext { since_secs: 0.0 };
+                log::info!(
+                    "Pipeline lifecycle stage=pending-render-context generation={} \
+                     note=loadfile-not-issued",
+                    self.media_generation
+                );
+            }
+            return Ok(());
+        }
+        let Some(stream) = self.pending_stream.take() else {
+            return Ok(());
+        };
+        self.load_phase = LoadPhase::LoadfileIssuing;
+        log::info!(
+            "Pipeline lifecycle stage=loadfile-issued generation={} video_url_len={} \
+             audio_url={} separate_audio={}",
+            self.media_generation,
+            stream.video_url.len(),
+            stream.audio_url.is_some(),
+            self.separate_audio
+        );
+        log::info!(
+            "Pipeline recovery stage=loadfile-request generation={} video_url_len={} audio_url={} video_format={:?} audio_format={:?}",
+            self.media_generation,
+            stream.video_url.len(),
+            stream.audio_url.is_some(),
+            stream.video_format,
+            stream.audio_format,
+        );
+        let result = self.loadfile_command(&stream.video_url, stream.audio_url.as_deref());
+        let entry_id = match result {
+            Ok(entry_id) => entry_id,
+            Err(error) => {
+                log::error!(
+                    "Pipeline recovery stage=loadfile-error generation={} error={}",
+                    self.media_generation,
+                    error,
+                );
+                self.current_playlist_entry_id = 0;
+                self.state = PlaybackState::Error;
+                self.error = Some(error.clone());
+                return Err(error);
+            }
+        };
+        self.current_playlist_entry_id = entry_id;
+        // Only now is a media-load timeout meaningful.
+        self.load_phase = LoadPhase::AwaitingFileLoaded {
+            playlist_entry_id: entry_id,
+            since_secs: 0.0,
+        };
+        self.static_diagnostic_logged = false;
+        self.last_progress_at = Instant::now();
+        log::info!(
+            "Pipeline lifecycle stage=loadfile-accepted generation={} \
+             playlist_entry_id={} armed_media_load_timeout_secs={}",
+            self.media_generation,
+            entry_id,
+            RECOVERY_LOAD_TIMEOUT.as_secs()
+        );
+        Ok(())
+    }
+
+    pub fn play_pause(&mut self) {
+        match self.state {
+            PlaybackState::Playing => {
+                if self.set_flag_property("pause", true).is_ok() {
+                    self.state = PlaybackState::Paused;
+                    self.last_position = self.position;
+                    self.last_progress_at = Instant::now();
+                    self.cancel_recovery();
+                }
+            }
+            PlaybackState::Paused => {
+                if self.set_flag_property("pause", false).is_ok() {
+                    self.state = PlaybackState::Playing;
+                    self.last_position = self.position;
+                    self.last_progress_at = Instant::now();
+                    self.cancel_recovery();
+                }
+            }
+            PlaybackState::Ended | PlaybackState::Stopped | PlaybackState::Error => {}
+            PlaybackState::Buffering => {
+                if self.has_file
+                    && let Some(paused) = self.get_flag("pause")
+                    && self.set_flag_property("pause", !paused).is_ok()
+                {
+                    self.state = if paused {
+                        PlaybackState::Playing
+                    } else {
+                        PlaybackState::Paused
+                    };
+                    self.last_position = self.position;
+                    self.last_progress_at = Instant::now();
+                    self.cancel_recovery();
+                }
+            }
+        }
+    }
+
+    pub fn seek_absolute(&mut self, seconds: f64) {
+        if self.state == PlaybackState::Stopped || self.state == PlaybackState::Error {
+            return;
+        }
+        let target = seconds.clamp(0.0, self.duration.max(0.0));
+        let target_text = target.to_string();
+        let _ = self.command(&["seek", &target_text, "absolute"]);
+        self.last_position = target;
+        self.continuous_position = target;
+        self.last_progress_at = Instant::now();
+        self.last_frame_submit_at = Instant::now();
+        self.cache_pause_observed = false;
+        self.cancel_recovery();
+    }
+
+    /// Rebuild a paused frame after GTK discards/recreates its presentation
+    /// buffers. Keep pause, media generation, and the existing resolved stream;
+    /// a precise same-position seek supplies a real frame rather than exposing
+    /// cached GPU pixels after the surface transition.
+    pub fn refresh_paused_surface_frame(&mut self) {
+        if self.state != PlaybackState::Paused || !self.has_file {
+            return;
+        }
+        if self.get_flag("seekable") != Some(true) {
+            return;
+        }
+        let position = self.get_double("time-pos").unwrap_or(self.position).max(0.0);
+        let target = position.to_string();
+        if let Err(error) = self.command(&["seek", &target, "absolute+exact"]) {
+            log::warn!("Pipeline paused surface refresh failed: {error}");
+            return;
+        }
+        self.invalidate_frame_gate();
+        self.last_progress_at = Instant::now();
+        log::info!("Pipeline paused surface refresh position={position:.3} generation={} same_stream=true", self.media_generation);
+    }
+
+    pub fn set_volume(&mut self, volume: f64) {
+        self.volume = volume.clamp(0.0, 1.0);
+        if set_volume_on(self.handle, self.volume).is_err() {
+            self.error = Some("mpv rejected the volume update".into());
+        }
+    }
+
+    pub fn change_volume(&mut self, delta: f64) {
+        self.set_volume(self.volume + delta);
+    }
+
+    pub fn set_muted(&mut self, muted: bool) {
+        self.muted = muted;
