+    /// Deterministic renderer bootstrap. MUST be called with the GtkGLArea GL
+    /// context current, from GLArea realize/map, NOT from the first render
+    /// callback.
+    ///
+    /// The L218 update pump made this a hard dependency: the pump needs an
+    /// existing render context to ask `mpv_render_context_update()`, and it only
+    /// calls `GtkGLArea::queue_render()` when that context reports a real frame.
+    /// If the context is only ever created inside `render()`, then with
+    /// `auto_render=false` and no incidental GTK redraw the GLArea render callback
+    /// never runs, the context is never created, the pump can never report a
+    /// frame, and the page sits at a NULL renderer until the renderer timeout --
+    /// exactly the reported "no GL context to render". Creating the context here,
+    /// while the GDK context is current, breaks that cycle deterministically.
+    ///
+    /// Every `mpv_render_*` call still uses this same current GL context, so the
+    /// one-context rule is preserved.
+    pub fn prepare_render_context_current(&mut self) -> bool {
+        let already = !self.render_context.is_null();
+        if already {
+            log::info!("Pipeline bootstrap libmpv render context already present");
+            return true;
+        }
+        log::info!("Pipeline bootstrap libmpv render context creation start");
+        let ok = self.ensure_render_context();
+        log::info!(
+            "Pipeline bootstrap libmpv render context creation result={} pending_stream={}",
+            if ok { "ok" } else { "failed" },
+            self.pending_stream.is_some()
+        );
+        ok
+    }
+
+    fn ensure_render_context(&mut self) -> bool {
+        if !self.render_context.is_null() {
+            return true;
+        }
+        if self.handle.is_null() {
+            self.fail_render("libmpv handle is unavailable");
+            return false;
+        }
+
+        let api_type = match c_string("opengl") {
+            Ok(value) => value,
+            Err(error) => {
+                self.fail_render(error);
+                return false;
+            }
+        };
+        let gl_params = MpvOpenGlInitParams {
+            get_proc_address: Some(get_gl_proc_address),
+            get_proc_address_ctx: ptr::null_mut(),
+        };
+        let mut params = [
+            MpvRenderParam {
+                type_: MPV_RENDER_PARAM_API_TYPE,
+                data: api_type.as_ptr().cast_mut().cast(),
+            },
+            MpvRenderParam {
+                type_: MPV_RENDER_PARAM_OPENGL_INIT_PARAMS,
+                data: (&gl_params as *const MpvOpenGlInitParams).cast_mut().cast(),
+            },
+            MpvRenderParam {
+                type_: MPV_RENDER_PARAM_INVALID,
+                data: ptr::null_mut(),
+            },
+        ];
+        let mut context = ptr::null_mut();
+        let result =
+            unsafe { mpv_render_context_create(&mut context, self.handle, params.as_mut_ptr()) };
+        if result < 0 {
+            let error = error_text(result);
+            log::error!("libmpv OpenGL render context creation failed: {error}");
+            self.fail_render(error);
+            return false;
+        }
+        self.render_context = context;
+        let callback_state = Arc::new(RenderCallbackState {
+            wakeup: self.render_wakeup.clone(),
+            counters: self.render_callback_counters.clone(),
+            wakeup_pending: Arc::new(AtomicBool::new(false)),
+            main_context: glib::MainContext::default(),
+            normal_priority: self.render_wakeup_normal_priority,
+        });
+        let callback_context = Arc::as_ptr(&callback_state).cast::<c_void>().cast_mut();
+        unsafe {
+            mpv_render_context_set_update_callback(
+                self.render_context,
+                Some(render_update_callback),
+                callback_context,
+            );
+        }
+        self.render_callback_state = Some(callback_state);
+        log::info!("Pipeline libmpv render update callback registered");
+        true
+    }
+
+    /// Query and classify the next frame libmpv would render, using this
+    /// render context.
+    ///
+    /// This is the semantic counterpart to `MPV_RENDER_UPDATE_FRAME`. The update
+    /// flag only says "something to draw": it is also set for a redraw or a
+    /// repeat, which reproduce the previous presentation contents. Presentation
+    /// containment must never reveal on that, so the classification is made
+    /// explicit here instead of inferred.
+    pub fn next_frame_state(&self) -> (NextFrameState, u64, i64) {
+        if self.render_context.is_null() {
+            return (NextFrameState::NoFrame, 0, 0);
+        }
+        let mut info = MpvRenderFrameInfo {
+            flags: 0,
+            target_time: 0,
+        };
+        let result = unsafe {
+            mpv_render_context_get_info(
+                self.render_context,
+                MpvRenderParam {
+                    type_: MPV_RENDER_PARAM_NEXT_FRAME_INFO,
+                    data: (&mut info as *mut MpvRenderFrameInfo).cast(),
+                },
+            )
+        };
+        if result < 0 {
+            // Not implemented by this libmpv: fail closed rather than assume.
+            return (NextFrameState::Unsupported, 0, 0);
+        }
+        let state = if info.flags & MPV_RENDER_FRAME_INFO_PRESENT == 0 {
+            NextFrameState::NoFrame
+        } else if info.flags & MPV_RENDER_FRAME_INFO_REPEAT != 0 {
+            NextFrameState::Repeat
+        } else if info.flags & MPV_RENDER_FRAME_INFO_REDRAW != 0 {
+            NextFrameState::Redraw
+        } else {
+            NextFrameState::Present
+        };
+        (state, info.flags, info.target_time)
+    }
+
+    /// Bounded evidence for the first-frame gate decision. Classification is
+    /// counted per media generation and only the first few samples of each kind
+    /// are logged, so a long run cannot flood the log.
+    fn note_next_frame_evidence(
+        &mut self,
+        state: NextFrameState,
+        flags: u64,
+        target_time: i64,
+        gate_open: bool,
+    ) {
+        let supported = state != NextFrameState::Unsupported;
+        if !supported {
+            // This is a build/regression failure, not a transient. Make it loud
+            // and fail closed; do not silently fall back to the update flag.
+            if !self.next_frame_unsupported_logged {
+                self.next_frame_unsupported_logged = true;
+                log::error!(
+                    "Pipeline first-frame gate cannot classify the next frame: \
+                     mpv_render_context_get_info is not implemented by this libmpv; \
+                     the presentation cover will stay up. generation={}",
+                    self.media_generation
+                );
+            }
+            self.next_frame_counts.unsupported += 1;
+            return;
+        }
+        if !log::log_enabled!(log::Level::Info) { return; }
+        match state {
+            NextFrameState::NoFrame => self.next_frame_counts.no_frame += 1,
+            NextFrameState::Present => self.next_frame_counts.present += 1,
+            NextFrameState::Redraw => self.next_frame_counts.redraw += 1,
+            NextFrameState::Repeat => self.next_frame_counts.repeat += 1,
+            NextFrameState::Unsupported => {}
+        }
+        let total = self.next_frame_counts.total();
+        if total <= NEXT_FRAME_EVIDENCE_SAMPLES {
+            log::info!(
+                "Pipeline next-frame evidence generation={} sample={} state={} \
+                 flags={} target_time={} gate_open={}",
+                self.media_generation,
+                total,
+                state.label(),
+                frame_info_flags_label(flags),
+                target_time,
+                gate_open
+            );
+        }
+        if total % 100 == 0 {
+            log::info!(
+                "Pipeline next-frame tally generation={} samples={} present={} \
+                 no_frame={} redraw={} repeat={} redraw_repeat_rejected={}",
+                self.media_generation,
+                total,
+                self.next_frame_counts.present,
+                self.next_frame_counts.no_frame,
+                self.next_frame_counts.redraw,
+                self.next_frame_counts.repeat,
+                self.next_frame_counts.redraw + self.next_frame_counts.repeat
+            );
+        }
+    }
+
+    /// Render one frame into the current GtkGLArea FBO.
+    ///
+    /// `gate_open` is true only when a frame was rendered for the current media
+    /// generation. `new_frame_confirmed` is true only when THIS callback
+    /// rendered genuinely new decoded content, proven with
+    /// `MPV_RENDER_PARAM_NEXT_FRAME_INFO`: a redraw or repeat of the previous
+    /// presentation contents never satisfies it. Presentation containment
+    /// reveals the surface only on `new_frame_confirmed`.
+    /// Render-update PUMP step. Must be called on the GTK main context with the
+    /// GtkGLArea GL context already current, because `mpv_render_context_update()`
+    /// is a GL-context-bound call.
+    ///
+    /// Returns `true` only when libmpv actually has a new frame for us
+    /// (`MPV_RENDER_UPDATE_FRAME`). The caller must invalidate the GLArea ONLY on
+    /// `true`. With `auto-render=false` a blind `queue_render()` invalidates the
+    /// widget's cached snapshot and makes GTK re-run the render callback; if
+    /// libmpv had nothing new, that callback had nothing to draw, and re-exposing
+    /// the backing FBO is what produced the operator's stale/corrupt motion.
+    ///
+    /// The flags are stashed for the render callback instead of being acted on
+    /// here, so `render()` never calls `mpv_render_context_update()` itself and
+    /// the same update can never be consumed twice.
+    pub fn pump_render_update(&mut self) -> bool {
+        if self.render_context.is_null() {
+            return false;
+        }
+        self.pump_attempts = self.pump_attempts.wrapping_add(1);
+        let flags = unsafe { mpv_render_context_update(self.render_context) };
+        if flags & MPV_RENDER_UPDATE_FRAME != 0 {
+            self.update_frame_positives = self.update_frame_positives.wrapping_add(1);
+        }
+
+        // ACCUMULATE, never assign-then-zero.
+        //
+        // `GtkGLArea::queue_render()` is asynchronous: this pump returns, the GTK
+        // render callback has not run yet, and another pump (the 33 ms fallback, or
+        // libmpv's own update callback) can fire in between. The previous code
+        // assigned `pending = flags` on a FRAME update and then set `pending = 0`
+        // on any non-FRAME update, so that intervening 0-returning update ERASED a
+        // FRAME that was still waiting to be consumed:
+        //
+        //     pump A: FRAME -> pending=FRAME -> queue_render()
+        //     pump B (before GTK paint): 0 -> pending=0
+        //     GtkGLArea render: take 0 -> no frame rendered
+        //
+        // That would drop a pending frame on the floor. A non-FRAME update must
+        // therefore leave existing pending work alone.
+        //
+        // SCOPE, stated precisely because an earlier version of this comment
+        // overclaimed: fixing this makes the app consume every pending-state
+        // transition exactly once, and that is all it proves. It does NOT prove
+        // every distinct video frame reached the app, because libmpv's update
+        // notifications can coalesce. Whether frames are actually missing upstream
+        // is a supply-side question, answered only by mpv's own `frame-drop-count`
+        // and `decoder-frame-drop-count` deltas plus the inter-pending gap in the
+        // per-frame trace -- not by the absence of this defect.
+        let before = self.pending_update_flags.get();
+        let after = before | flags;
+        self.pending_update_flags.set(after);
+        if flags & MPV_RENDER_UPDATE_FRAME != 0 && before & MPV_RENDER_UPDATE_FRAME == 0 {
+            // A genuinely NEW pending frame, not a repeat notification for the frame
+            // already waiting.
+            self.pending_frame_transitions =
+                self.pending_frame_transitions.wrapping_add(1);
+            // Hop 1 of the trace. The GLArea context is current here, so
+            // NEXT_FRAME_INFO may be queried safely, and this is the ONLY point
+            // where the app learns a distinct frame exists. Querying it here is
+            // what makes `inter_pending_gaps_ns` meaningful: a long gap with no new
+            // sequence means libmpv offered nothing, which is a supply-side fact
+            // and cannot be attributed to rendering.
+            if self.frame_trace.is_some() {
+                let (state, _flags, target_time) = self.next_frame_state();
+                let reported_target_time = if state == NextFrameState::Unsupported {
+                    None
+                } else {
+                    Some(target_time)
+                };
+                // Read at exactly this instant, on mpv's own clock, so this
+                // sample can be joined against the in-VO hop trace without any
+                // clock conversion. That join is the whole point: the app cannot
+                // see `vo_frame.duration`, so it cannot evaluate the deadline
+                // that actually governs dropping, and the in-VO trace supplies
+                // both halves.
+                let mpv_now_ns = if reported_target_time.is_some() {
+                    Some(unsafe { mpv_get_time_ns(self.handle) })
+                } else {
+                    None
+                };
+                if let Some(sink) = self.frame_trace.as_ref() {
+                    sink.begin_pending(reported_target_time, mpv_now_ns, state.label());
+                }
+            }
+        }
+
+        if after & MPV_RENDER_UPDATE_FRAME == 0 {
+            return false;
+        }
+        if self.render_queued.replace(true) {
+            // A render is already pending with GTK; queuing again would only
+            // manufacture an extra invalidation of a possibly-valid surface.
+            self.queue_coalesced = self.queue_coalesced.wrapping_add(1);
+            return false;
+        }
+        true
+    }
+
+    /// Called from the render callback: this render is now being consumed.
+    pub fn note_render_consumed(&self) {
+        self.render_queued.set(false);
+    }
+
+    /// Consume the accumulated flags. Called exactly once per render callback so
+    /// an update is never applied twice, and so a FRAME stays pending until a real
+    /// render callback takes it.
+    fn take_pending_update_flags(&self) -> u64 {
+        self.render_queued.set(false);
+        self.pending_update_flags.replace(0)
+    }
+
+    pub fn render(&mut self, width: i32, height: i32) -> RenderOutcome {
+        let viewport = (width.max(1) as u32, height.max(1) as u32);
+        if viewport != (self.quality_evidence.viewport_width, self.quality_evidence.viewport_height) {
+            self.quality_evidence.viewport_width = viewport.0;
+            self.quality_evidence.viewport_height = viewport.1;
+            log::info!("Pipeline quality viewport={}x{} decoded={}x{} generation={}",
+                viewport.0, viewport.1, self.quality_evidence.decoded_width,
+                self.quality_evidence.decoded_height, self.media_generation);
+        }
+        let gate_closed = RenderOutcome {
+            gate_open: false,
+            new_frame_confirmed: false,
+            next_state: NextFrameState::NoFrame,
+        };
+        self.render_callbacks = self.render_callbacks.wrapping_add(1);
+        if !self.ensure_render_context() {
+            return gate_closed;
+        }
+
+        let mut target_fbo = 0;
+        unsafe {
+            glGetIntegerv(0x8CA6, &mut target_fbo); // GL_FRAMEBUFFER_BINDING
+        }
+
+        // The flags come from the PUMP, which already called
+        // `mpv_render_context_update()` on the main context with this GL context
+        // current. Calling it again here would consume the same update twice and
+        // would also be a GL-context-bound call from the wrong place. A render
+        // callback with no stashed flags means libmpv had no new frame, so the
+        // GLArea must be left completely untouched this time.
+        let update_flags = self.take_pending_update_flags();
+        let update_frame_flag = update_flags & MPV_RENDER_UPDATE_FRAME != 0;
+        if update_frame_flag {
+            self.update_flag_positives = self.update_flag_positives.wrapping_add(1);
+            self.render_callbacks_frame = self.render_callbacks_frame.wrapping_add(1);
+        }
+
+        // Semantic gate. The update flag alone is not sufficient evidence of new
+        // content: it is also raised for redraw/repeat, which reproduce the
+        // previous surface. The next-frame query is taken in the same render
+        // context, immediately before rendering, and the frame it describes is
+        // exactly the frame `mpv_render_context_render()` then consumes.
+        let (next_state, next_flags, next_target) = self.next_frame_state();
+        // A redraw/repeat can legitimately carry a zero timestamp, so a positive
+        // target time is required as well as the PRESENT flag. This makes the
+        // "new decoded frame" claim explicit rather than inferred.
+        let new_frame_confirmed = next_state.is_new_content() && next_target > 0;
+        let can_render = update_frame_flag && !matches!(next_state, NextFrameState::Unsupported);
+        let gate_open = can_render
+            && (self.first_frame_submitted || new_frame_confirmed)
+            && !(self.recovery_resume_landing_pending && !new_frame_confirmed);
+        self.note_next_frame_evidence(next_state, next_flags, next_target, gate_open);
+
+        let awaiting_resume = self.recovery_snapshot.is_some()
+            && (!self.recovery_resume_seek_sent || (self.recovery_resume_landing_pending
+                && (!self.recovery_resume_restart_seen || self.recovery_resume_target.is_none_or(|target|
+                    !crate::recovery_policy::resume_is_close(self.position, target)))));
+        if self.has_file && self.load_phase == LoadPhase::Loaded && can_render && awaiting_resume {
+            // Consume current-generation frames to bootstrap the single resume
+            // seek and discard preroll, but never overwrite the last valid FBO.
+            // SKIP_RENDERING is the render API's explicit no-target-write path.
+            let mut skip = 1;
+            let mut block = 0;
+            let mut params = [
+                MpvRenderParam { type_: MPV_RENDER_PARAM_SKIP_RENDERING, data: (&mut skip as *mut c_int).cast() },
+                MpvRenderParam { type_: MPV_RENDER_PARAM_BLOCK_FOR_TARGET_TIME, data: (&mut block as *mut c_int).cast() },
+                MpvRenderParam { type_: MPV_RENDER_PARAM_INVALID, data: ptr::null_mut() },
+            ];
+            let result = unsafe { mpv_render_context_render(self.render_context, params.as_mut_ptr()) };
+            if result < 0 { self.fail_render(error_text(result)); }
+            else if new_frame_confirmed {
+                if !self.first_current_frame_seen {
+                    log::info!("Pipeline recovery first current-generation frame consumed output_write=skipped frozen={} generation={}",
+                        self.holding_recovery_frame, self.media_generation);
+                }
+                self.first_current_frame_seen = true;
+            }
+            unsafe {
+                glBindFramebuffer(0x8D40, target_fbo);
+                glViewport(0, 0, width.max(1), height.max(1));
+            }
+            return gate_closed;
+        }
+
+        // GtkGLArea renders into its own texture-backed FBO, and the clear has
+        // to be placed deliberately, not unconditionally.
+        //
+        // It used to run at the very top of every render callback, BEFORE
+        // `mpv_render_context_update()` was consulted and before any early
+        // return, so a callback that found no new frame left the FBO wiped to
+        // near-black (0.008, 0.01, 0.012) and that black surface is what got
+        // presented. Once the bounded 33 ms self-timed render driver existed, GTK
+        // was asked to paint far more often than libmpv produces frames, so most
+        // paints presented a freshly cleared black surface and the operator saw
+        // the picture turn black about five times a second. Renders were rare
+        // before that driver, which is why the defect was invisible.
+        //
+        // Two cases still need the clear, and both are preserved here:
+        //   * a new file must not expose stale or corrupt pixels while its first
+        //     real decoded frame is still pending -- that is exactly
+        //     `!first_frame_submitted`;
+        //   * a new frame is about to be drawn, so the previous frame's pixels
+        //     must not show around it -- that is `gate_open`.
+        //
+        // In every other case a confirmed frame is already on screen and mpv
+        // simply has nothing new this tick, so the FBO is left untouched and the
+        // last good picture stays visible.
+        if (!self.first_frame_submitted && !self.holding_recovery_frame) || gate_open {
+            unsafe {
+                glViewport(0, 0, width.max(1), height.max(1));
+                glClearColor(0.008, 0.01, 0.012, 1.0);
+                glClear(0x4000 | 0x0100 | 0x0400);
+            }
+        }
+
+        // No frame may be drawn before mpv was actually handed a file.
+        if self.load_phase != LoadPhase::Loaded || !self.has_file || !gate_open {
+            if !self.frame_gate_logged {
+                self.frame_gate_logged = true;
+                log::info!(
+                    "Pipeline first decoded frame pending generation={} surface cleared \
+                     next_frame={} update_frame={} target_time={}",
+                    self.media_generation,
+                    next_state.label(),
+                    update_frame_flag,
+                    next_target
+                );
+            }
+            unsafe {
+                glBindFramebuffer(0x8D40, target_fbo);
+                glViewport(0, 0, width.max(1), height.max(1));
+            }
+            return RenderOutcome {
+                gate_open: false,
+                new_frame_confirmed: false,
+                next_state,
+            };
+        }
+
+        let mut fbo = MpvOpenGlFbo {
+            fbo: target_fbo,
+            w: width.max(1),
+            h: height.max(1),
+            internal_format: 0,
+        };
+        let mut flip_y = 1;
+        // GtkGLArea presents this FBO after the render callback returns. Keep
+        // libmpv nonblocking here; video-timing-offset=0 supplies the matching
+        // audio-sync timing policy and the callback remains bounded.
+        let mut block_for_target_time = 0;
+        let mut params = [
+            MpvRenderParam {
+                type_: MPV_RENDER_PARAM_OPENGL_FBO,
+                data: (&mut fbo as *mut MpvOpenGlFbo).cast(),
+            },
+            MpvRenderParam {
+                type_: MPV_RENDER_PARAM_FLIP_Y,
+                data: (&mut flip_y as *mut c_int).cast(),
+            },
+            MpvRenderParam {
+                type_: MPV_RENDER_PARAM_BLOCK_FOR_TARGET_TIME,
+                data: (&mut block_for_target_time as *mut c_int).cast(),
+            },
+            MpvRenderParam {
+                type_: MPV_RENDER_PARAM_INVALID,
+                data: ptr::null_mut(),
+            },
+        ];
+        if let Some(sink) = self.frame_trace.as_ref() {
+            sink.mark_render_start();
+        }
+        let render_started = self.metrics_enabled.then(Instant::now);
+        let result = unsafe { mpv_render_context_render(self.render_context, params.as_mut_ptr()) };
+        if let Some(render_started) = render_started {
+            self.render_samples_ns.push(render_started
+                .elapsed()
+                .as_nanos()
+                .min(u128::from(u64::MAX)) as u64);
+        }
+        if result >= 0 {
+            if let Some(sink) = self.frame_trace.as_ref() {
+                sink.mark_render_done();
+            }
+            self.render_submits = self.render_submits.wrapping_add(1);
+            let submit_now = Instant::now();
+            if self.metrics_enabled && let Some(previous) = self.last_submit_at.replace(submit_now) {
+                let gap = submit_now.saturating_duration_since(previous).as_nanos();
+                let gap = gap.min(u128::from(u64::MAX)) as u64;
+                self.interval_submit_gaps_ns.push(gap);
+                if self.run_submit_gaps_ns.len() < 4096 {
+                    self.run_submit_gaps_ns.push(gap);
+                }
+            }
+            self.last_frame_submit_at = submit_now;
+            // `mpv_render_context_report_swap()` is deliberately NOT called here.
+            // It is optional and it asserts that a frame was actually flipped to a
+            // display. GtkGLArea renders into an offscreen FBO and GTK has NOT yet
+            // painted that texture into the window when this function returns, so
+            // reporting a swap here would be false presentation feedback. L214a
+            // added it on the mistaken belief that the render API requires it after
+            // every successful render; that is wrong, and the call is reverted. A
+            // correct report_swap would belong to the real after-paint boundary,
+            // which this pass does not attempt to prove.
+            self.first_current_frame_seen |= new_frame_confirmed;
+            if self.recovery_resume_landing_pending && self.recovery_resume_restart_seen && new_frame_confirmed
+                && self.recovery_resume_target.is_some_and(|target| crate::recovery_policy::resume_is_close(self.position, target)) {
+                self.recovery_resume_landing_pending = false;
+                self.recovery_resume_landing_position = Some(self.position);
+                self.recovery_resume_last_position = self.position;
+                self.recovery_resume_last_forward_at = Some(Instant::now());
+                self.holding_recovery_frame = false;
+                if self.recovery_snapshot.as_ref().is_some_and(|snapshot| snapshot.paused) {
+                    self.recovery_sustained = true;
+                }
+                log::info!(
+                    "Pipeline recovery keyframe frame observed target={:.2}s landing={:.2}s generation={}",
+                    self.recovery_resume_target.unwrap_or(self.position),
+                    self.position,
+                    self.media_generation,
+                );
+            }
+            if !self.first_frame_submitted {
+                self.first_frame_submitted = true;
+                log::info!(
+                    "Pipeline first decoded frame submitted; recovery stage=first-frame \
+                     generation={} position={:.2}s replacement={} next_frame={} target_time={}",
+                    self.media_generation,
+                    self.position,
+                    self.recovery_snapshot.is_some(),
+                    next_state.label(),
+                    next_target,
+                );
+            }
+        } else {
+            self.fail_render(error_text(result));
+        }
+        unsafe {
+            glBindFramebuffer(0x8D40, target_fbo);
+            glViewport(0, 0, width.max(1), height.max(1));
+        }
+        // `new_frame_confirmed` is the only signal presentation containment acts
+        // on. It is true only when a genuinely new, presentable,
+        // current-generation frame was just handed to the FBO.
+        RenderOutcome {
+            gate_open: result >= 0,
+            new_frame_confirmed: result >= 0 && new_frame_confirmed,
+            next_state,
+        }
+    }
+
+    pub fn free_render_context_current(&mut self) {
+        if self.render_context.is_null() {
+            return;
+        }
+        unsafe {
+            // This method is called only from the GLArea realize/unrealize
+            // lifecycle after make_current(). Unregister first so the callback
+            // context cannot outlive the render context.
+            mpv_render_context_set_update_callback(self.render_context, None, ptr::null_mut());
+            mpv_render_context_free(self.render_context);
+        }
+        self.render_context = ptr::null_mut();
+        self.render_callback_state = None;
+        self.first_frame_submitted = false;
+        self.first_current_frame_seen = false;
+        self.holding_recovery_frame = false;
+        self.pending_update_flags.set(0);
+        self.render_queued.set(false);
+        self.frame_gate_logged = false;
+        self.next_frame_counts = NextFrameCounts::default();
+        self.next_frame_unsupported_logged = false;
+        log::info!("Pipeline libmpv render context freed with GtkGLArea context current");
+    }
+
+    pub fn has_render_context(&self) -> bool {
+        !self.render_context.is_null()
+    }
+
+    /// True once a real frame for the current media generation has been
+    /// submitted into the GLArea FBO, and the frame gate has not been reopened
+    /// since. Presentation containment uses this to decide whether a deferred
+    /// reveal is still allowed to expose the surface.
+    pub fn first_frame_presented(&self) -> bool {
+        self.first_frame_submitted && !self.recovery_resume_landing_pending
+            && (self.recovery_resume_target.is_none() || self.recovery_resume_seek_sent)
+    }
+}
+
+impl Drop for MpvPlayer {
+    fn drop(&mut self) {
+        if !self.render_context.is_null() {
+            // A core cannot be destroyed while its render context exists. The
+            // GLArea unrealize path normally frees it first; if a future
+            // lifecycle regression reaches here, leak the core rather than call
+            // mpv_render_context_free without the current GL context.
+            log::error!(
+                "Pipeline dropping MpvPlayer with an unverified render context; core teardown deferred"
+            );
+            // The raw context may retain the callback pointer. Keep its
+            // callback state alive as a last-resort leak instead of allowing
+            // a late libmpv callback to dereference freed memory.
+            if let Some(state) = self.render_callback_state.take() {
+                std::mem::forget(state);
+            }
+            return;
+        }
+        if !self.handle.is_null() {
+            unsafe { mpv_terminate_destroy(self.handle) };
+            self.handle = ptr::null_mut();
+        }
+    }
+}
diff --git a/src/recovery_policy.rs b/src/recovery_policy.rs
new file mode 100644
index 0000000000000000000000000000000000000000..8fe357a3744ff4dfa158881eb06f970f948da2c7
--- /dev/null
+++ b/src/recovery_policy.rs
@@ -0,0 +1,30 @@
+//! Pure, bounded recovery decisions shared by the page and the render gate.
+use std::time::{Duration, Instant};
+pub const TOTAL_TIMEOUT: Duration = Duration::from_secs(45);
+pub const RESUME_TOLERANCE: f64 = 0.5;
+
+pub fn deadline_expired(started: Option<Instant>, now: Instant) -> bool {
+    started.is_some_and(|value| now.saturating_duration_since(value) >= TOTAL_TIMEOUT)
+}
+
+pub fn resume_is_close(position: f64, target: f64) -> bool {
+    position.is_finite() && target.is_finite() && position >= 0.0 && target >= 0.0
+        && (position - target).abs() <= RESUME_TOLERANCE
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test] fn deadline_is_total_not_reset_by_an_attempt() {
+        let start=Instant::now();
+        assert!(!deadline_expired(Some(start), start + Duration::from_secs(44)));
+        assert!(deadline_expired(Some(start), start + Duration::from_secs(45)));
+        assert!(!deadline_expired(None, start + Duration::from_secs(999)));
+    }
+    #[test] fn reveal_rejects_preroll_overshoot_and_unknown_position() {
+        assert!(resume_is_close(11.6,12.0)); assert!(resume_is_close(12.5,12.0));
+        for value in [0.0,10.9,12.6,f64::NAN,f64::INFINITY,-1.0] {
+            assert!(!resume_is_close(value,12.0));
+        }
+    }
+}
diff --git a/src/resolver_environment.rs b/src/resolver_environment.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6c892861c4c1676f43d931607aa30e995dd8b84c
--- /dev/null
+++ b/src/resolver_environment.rs
@@ -0,0 +1,48 @@
+//! Non-graphical resolver boundary. Preserve ordinary networking/user variables
+//! but never map the UI's GLES/EGL stack into Python before its first instruction.
+use tokio::process::Command;
+
+pub const GRAPHICS_ENVIRONMENT: &[&str] = &[
+    "LD_PRELOAD", "LD_LIBRARY_PATH", "GDK_BACKEND", "GSK_RENDERER", "GDK_DISABLE",
+    "LIBEGL", "LIBGLESV2", "HYBRIS_ANDROID_SDK_VERSION", "HYBRIS_LINKER_DIR",
+    "HYBRIS_EGLPLATFORM", "HYBRIS_EGLPLATFORM_DIR", "EGL_PLATFORM", "SANTOS_EGL_PLATFORM",
+    "ANDROID_ROOT", "ANDROID_DATA", "LD_SHIM_LIBS", "GI_TYPELIB_PATH", "GNOME_SHELL_DATADIR",
+    "GSETTINGS_SCHEMA_DIR", "SANTOS_GLES2_TRACE", "SANTOS_VO_LIBMPV_DECOUPLE",
+];
+const TLS_PRELOAD: &str = "/root/libsantos-tlsfix.so";
+
+fn tls_preload(value: &str) -> Option<&'static str> {
+    // This known networking-only shim is distinct from the graphics preloads.
+    // Do not propagate unknown preload paths by merely matching a filename.
+    value.split(|c: char| c == ':' || c.is_ascii_whitespace())
+        .any(|entry| entry == TLS_PRELOAD).then_some(TLS_PRELOAD)
+}
+
+pub fn configure(command: &mut Command) {
+    let inherited = std::env::var("LD_PRELOAD").ok();
+    for key in GRAPHICS_ENVIRONMENT { command.env_remove(key); }
+    if inherited.as_deref().and_then(tls_preload).is_some() {
+        command.env("LD_PRELOAD", TLS_PRELOAD);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test] fn only_exact_networking_shim_is_retained() {
+        assert_eq!(tls_preload("/root/libsantos-tlsfix.so:/usr/lib/libEGL.so"), Some(TLS_PRELOAD));
+        assert_eq!(tls_preload("/untrusted/libsantos-tlsfix.so"), None);
+        assert_eq!(tls_preload("/usr/lib/libEGL.so /usr/lib/libGLESv2.so"), None);
+    }
+    #[test] fn command_cleans_graphics_without_clearing_unrelated_user_environment() {
+        let mut cmd = Command::new("yt-dlp"); configure(&mut cmd);
+        let removals = cmd.as_std().get_envs().collect::<Vec<_>>();
+        for key in GRAPHICS_ENVIRONMENT {
+            if *key == "LD_PRELOAD" { continue; }
+            assert!(removals.iter().any(|(name, value)| name == key && value.is_none()));
+        }
+        for preserved in ["HOME", "PATH", "HTTPS_PROXY", "LANG"] {
+            assert!(!removals.iter().any(|(name, _)| name == &preserved));
+        }
+    }
+}
