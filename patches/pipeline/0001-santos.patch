+            }
+            if let Some(duration) = self.get_double("duration") {
+                if duration.is_finite() && duration >= 0.0 {
+                    self.duration = duration;
+                }
+            }
+            return;
+        }
+
+        if self.has_file && self.quality_evidence.decoded_height == 0
+            && self.last_quality_probe.is_none_or(|last| last.elapsed() >= Duration::from_secs(1)) {
+            self.refresh_decoded_quality();
+        }
+
+        if let Some(position) = self.get_double("time-pos") {
+            self.position = position.max(0.0);
+        }
+        if let Some(duration) = self.get_double("duration") {
+            if duration.is_finite() && duration >= 0.0 {
+                self.duration = duration;
+            }
+        }
+        let cache_paused = self.get_flag("paused-for-cache").unwrap_or(false);
+        if cache_paused {
+            self.last_progress_at = Instant::now();
+        }
+        if cache_paused && self.state != PlaybackState::Ended && self.state != PlaybackState::Error
