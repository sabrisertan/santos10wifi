+
+fn requested_local_video() -> Option<crate::backend::Video> {
+    let path = std::env::var("PIPELINE_SANTOS_VIDEO_FILE").ok()?;
+    // A direct http(s) media URL is accepted as well as a local path, so a test
+    // harness can serve the canonical fixture itself and stop serving it. That
+    // is the only honest way to produce a real media/network stall - removing
+    // the bytes - without touching the firewall or the resolver. A value that
+    // is neither a file nor an http(s) URL is still ignored, so a mistyped path
+    // cannot silently start playing something.
+    let is_direct_url = path.starts_with("http://") || path.starts_with("https://");
+    let path_ref = Path::new(&path);
+    if !is_direct_url && !path_ref.is_file() {
+        return None;
+    }
+    let playable_url = if is_direct_url {
+        Url::parse(&path).ok()?
+    } else {
+        Url::from_file_path(path_ref).ok()?
+    };
+    let platform = Cow::Borrowed("local");
+    let title = playable_url
+        .path_segments()
+        .and_then(|segments| segments.filter(|part| !part.is_empty()).next_back())
+        .map(str::to_string)
+        .filter(|name| !name.is_empty() && name.len() <= 80)
+        .unwrap_or_else(|| "local-test".to_string());
+    let channel_core = pcore::Channel {
+        id: pcore::ChannelId {
+            id: "santos-local".to_string(),
+            platform: platform.clone(),
+        },
+        name: "Local test media".to_string(),
+        avatar: None,
+        banner: None,
+        description: None,
+        subscribers: None,
+    };
+    let video_core = pcore::Video {
+        id: pcore::VideoId {
+            id: "local-test".to_string(),
+            platform,
+        },
+        playable_url,
+        uploader: channel_core.clone(),
+        title,
+        uploaded: Utc::now(),
+        duration: None,
+        thumbnail: None,
+        description: None,
+        views: None,
+        likes: None,
+        dislikes: None,
+        is_live: Some(false),
+        requires_payment: Some(false),
+    };
+    let channel = crate::backend::Channel::new(channel_core);
+    Some(crate::backend::Video::new(video_core, &channel))
+}
