+unsafe extern "C" {
+    fn prctl(option: i32, arg2: u64, arg3: u64, arg4: u64, arg5: u64) -> i32;
+    fn fcntl(fd: i32, command: i32, ...) -> i32;
+}
+
+const PR_SET_PDEATHSIG: i32 = 1;
+const SIGTERM: i32 = 15;
+const F_GETFL: i32 = 3;
+const F_SETFL: i32 = 4;
+const O_NONBLOCK: i32 = 0o4000;
+
+/// Put a pipe into non-blocking mode.
+///
+/// The player's stderr must be drained, but a BLOCKING read on a pipe that has
+/// nothing to say stops the whole worker thread forever. That is not
+/// theoretical: it froze the controller after the first sample, so position,
+/// pause, seek and stop silently stopped reaching the player while an external
+/// observer on the same socket still saw perfect playback.
+fn set_nonblocking(fd: i32) {
+    unsafe {
+        let flags = fcntl(fd, F_GETFL, 0 as u64);
+        if flags >= 0 {
+            fcntl(fd, F_SETFL, (flags | O_NONBLOCK) as u64);
+        }
+    }
+}
+
+/// Ask the kernel to SIGTERM the player if Pipeline dies unexpectedly. This is
+/// what makes "no orphaned audio/video" true without polling, without a
+/// `pkill` and without a shell watchdog. Best effort: the owned-child shutdown
+/// path still applies when it is refused.
+fn arm_parent_death_signal() {
+    unsafe {
+        prctl(PR_SET_PDEATHSIG, SIGTERM as u64, 0, 0, 0);
+    }
+}
+
+/// Session-owned IPC socket path, bound to this Pipeline PID. A stale path from
+/// a crashed session can therefore never be confused with a live one, and
+/// adoption/reaping can use exact identity instead of a name pattern.
+fn session_socket_path() -> PathBuf {
+    let dir = std::env::var("XDG_RUNTIME_DIR").unwrap_or_else(|_| "/tmp".to_string());
+    PathBuf::from(dir).join(format!(
+        "pipeline-santos-player-{}.ipc",
+        std::process::id()
+    ))
+}
+
+/// Reap sockets left by a previous, dead Pipeline session.
+///
+/// Identity rule: the name carries the owning PID, and the socket is removed
+/// only when that PID is not alive or is not this executable. A live sibling
+/// Pipeline keeps its socket. No heuristic `pgrep -f`, no broad pattern kill.
+fn reap_stale_session_sockets(own_exe: &Path) -> usize {
+    let Ok(dir) = std::env::var("XDG_RUNTIME_DIR").map(PathBuf::from) else {
+        return 0;
+    };
+    let Ok(entries) = std::fs::read_dir(&dir) else {
+        return 0;
+    };
+    let mut reaped = 0;
+    for entry in entries.flatten() {
+        let name = entry.file_name();
+        let Some(name) = name.to_str() else { continue };
+        let Some(rest) = name
+            .strip_prefix("pipeline-santos-player-")
+            .and_then(|rest| rest.strip_suffix(".ipc"))
+        else {
+            continue;
+        };
+        let Ok(pid) = rest.parse::<u32>() else {
+            continue;
+        };
+        if pid == std::process::id() {
+            continue;
+        }
+        let same_exe = std::fs::read_link(format!("/proc/{pid}/exe"))
+            .map(|exe| exe == own_exe)
+            .unwrap_or(false);
+        if same_exe {
+            continue;
+        }
+        if std::fs::remove_file(entry.path()).is_ok() {
+            reaped += 1;
+        }
+    }
+    reaped
+}
+
+/// Identity of a process, for evidence. Signalling never relies on this: only a
+/// recorded child handle is ever signalled, so PID reuse cannot be confused
+/// with our own player.
+fn process_identity(pid: u32) -> Option<String> {
+    let exe = std::fs::read_link(format!("/proc/{pid}/exe")).ok()?;
+    let starttime = std::fs::read_to_string(format!("/proc/{pid}/stat"))
+        .ok()
+        .and_then(|raw| {
+            let after = raw.rsplit_once(") ")?.1;
+            after.split_whitespace().nth(19).map(str::to_string)
+        });
+    Some(format!(
+        "exe={} starttime={}",
+        exe.display(),
+        starttime.as_deref().unwrap_or("?")
+    ))
+}
+
+#[derive(Clone, Debug)]
+struct Media {
+    video_url: String,
+    audio_url: Option<String>,
+    media_identity: String,
+    title: Option<String>,
+}
+
+#[derive(Clone, Debug)]
+struct Pending {
+    generation: u64,
+    media: Media,
+    resume_position: Option<f64>,
+    #[allow(dead_code)]
+    start_paused: bool,
+}
+
+/// The session-owned controller.
+///
+/// One per Pipeline process, not one per page. The window creates a new
+/// `VideoPage` for every video, so a per-page controller produced one player
+/// process per open page and two players on screen after a switch - which is
+/// exactly what "exactly one intended player process per Pipeline session"
+/// forbids. Sharing also makes the ownership story true by construction: there
+/// is one worker thread and at most one child, always.
+static SESSION_PLAYER: std::sync::OnceLock<Mutex<Arc<ExternalPlayer>>> =
+    std::sync::OnceLock::new();
+
+/// The session controller, created on first use with `config`.
+pub fn session_player(config: ExternalConfig) -> Arc<ExternalPlayer> {
+    let slot = SESSION_PLAYER.get_or_init(|| Mutex::new(Arc::new(ExternalPlayer::new(config))));
+    let guard = slot.lock().unwrap_or_else(|error| error.into_inner());
+    Arc::clone(&guard)
+}
+
+/// True when this process already owns an external player session.
+pub fn session_player_exists() -> bool {
+    SESSION_PLAYER.get().is_some_and(|slot| {
+        slot.lock()
+            .map(|player| player.is_alive())
+            .unwrap_or(false)
+    })
+}
+
+/// The GTK-side handle. All real work is on the worker thread.
+pub struct ExternalPlayer {
+    shared: Arc<Mutex<ExternalSnapshot>>,
+    tx: Mutex<Option<std::sync::mpsc::Sender<PlayerCommand>>>,
+    thread: Mutex<Option<thread::JoinHandle<()>>>,
+    config: Arc<ExternalConfig>,
+    alive: Arc<AtomicBool>,
+    next_generation: AtomicU64,
+}
+
+impl ExternalPlayer {
+    pub fn new(config: ExternalConfig) -> Self {
+        let shared = Arc::new(Mutex::new(ExternalSnapshot {
+            volume: config.volume,
+            speed: config.speed,
+            ..Default::default()
+        }));
+        let (tx, rx) = std::sync::mpsc::channel::<PlayerCommand>();
+        let alive = Arc::new(AtomicBool::new(true));
+        let worker_config = Arc::new(config);
+        let handle = thread::Builder::new()
+            .name("santos-external-player".to_string())
+            .spawn({
+                let shared = Arc::clone(&shared);
+                let alive = Arc::clone(&alive);
+                let config = Arc::clone(&worker_config);
+                move || worker_loop(config, shared, rx, alive)
+            });
+        if handle.is_err() {
+            log::error!(
+                "Pipeline external player stage=start result=failed reason=thread-spawn"
+            );
+        }
+        Self {
+            shared,
+            tx: Mutex::new(Some(tx)),
+            thread: Mutex::new(handle.ok()),
+            config: worker_config,
+            alive,
+            next_generation: AtomicU64::new(1),
+        }
+    }
+
+    pub fn config(&self) -> &ExternalConfig {
+        &self.config
+    }
+
+    pub fn snapshot(&self) -> ExternalSnapshot {
+        self.shared
+            .lock()
+            .map(|guard| guard.clone())
+            .unwrap_or_default()
+    }
+
+    fn send(&self, command: PlayerCommand) {
+        let sender = self.tx.lock().ok().and_then(|guard| guard.clone());
+        if let Some(sender) = sender
+            && sender.send(command).is_err()
+        {
+            log::error!(
+                "Pipeline external player stage=command result=failed reason=worker-gone"
+            );
+        }
+    }
+
+    /// Allocate the next playback generation. Every Play/Switch/Recovery
+    /// request takes a fresh one, so a stale event from an older media load
+    /// can never mutate current UI state.
+    pub fn next_generation(&self) -> u64 {
+        self.next_generation.fetch_add(1, Ordering::SeqCst)
+    }
+
+    /// Start a new playback generation and return the generation issued.
+    pub fn load(
+        &self,
+        video_url: String,
+        audio_url: Option<String>,
+        media_identity: String,
+        title: Option<String>,
+        start_paused: bool,
+    ) -> u64 {
+        let generation = self.next_generation.fetch_add(1, Ordering::SeqCst);
+        self.send(PlayerCommand::Load {
+            generation,
+            video_url,
+            audio_url,
+            media_identity,
+            title,
+            resume_position: None,
+            start_paused,
+        });
+        generation
+    }
+
+    pub fn stop(&self) {
+        self.send(PlayerCommand::Stop);
+    }
+
+    pub fn set_paused(&self, paused: bool) {
+        self.send(PlayerCommand::Pause(paused));
+    }
+
+    pub fn seek_absolute(&self, seconds: f64) {
+        self.send(PlayerCommand::Seek {
+            absolute: Some(seconds),
+            relative: None,
+        });
+    }
+
+    pub fn seek_relative(&self, seconds: f64) {
+        self.send(PlayerCommand::Seek {
+            absolute: None,
+            relative: Some(seconds),
+        });
+    }
+
+    pub fn set_volume(&self, volume: f64) {
+        self.send(PlayerCommand::SetVolume(volume));
+    }
+
+    pub fn set_muted(&self, muted: bool) {
+        self.send(PlayerCommand::SetMuted(muted));
+    }
+
+    pub fn set_speed(&self, speed: f64) {
+        self.send(PlayerCommand::SetSpeed(speed));
+    }
+
+    /// Player-side recovery replacement for a bounded retry.
+    pub fn replace(
+        &self,
+        generation: u64,
+        video_url: String,
+        audio_url: Option<String>,
+        media_identity: String,
+        title: Option<String>,
+        resume_position: Option<f64>,
+    ) {
+        self.send(PlayerCommand::Replace {
+            generation,
+            video_url,
+            audio_url,
+            media_identity,
+            title,
+            resume_position,
+        });
+    }
+
+    pub fn acknowledge_recovery(&self) {
+        self.send(PlayerCommand::AcknowledgeRecovery);
+    }
+
+    pub fn clear_terminal(&self) {
+        self.send(PlayerCommand::ClearTerminal);
+    }
+
+    /// Single consumer: the page.
+    pub fn take_recovery_request(&self) -> Option<RecoverySignal> {
+        let mut guard = self.shared.lock().ok()?;
+        guard.recovery_request.take()
+    }
+
+    pub fn recovery_sustained(&self) -> bool {
+        self.shared
+            .lock()
+            .map(|guard| guard.recovery_sustained)
+            .unwrap_or(false)
+    }
+
+    pub fn is_alive(&self) -> bool {
+        self.alive.load(Ordering::SeqCst)
+    }
+}
+
+impl Drop for ExternalPlayer {
+    fn drop(&mut self) {
+        self.alive.store(false, Ordering::SeqCst);
+        // Ask the worker to stop and reap the owned child, then join it, so an
+        // owned player is never left running behind us.
+        self.send(PlayerCommand::Shutdown);
+        if let Some(handle) = self.thread.lock().ok().and_then(|mut g| g.take()) {
+            let _ = handle.join();
+        }
+    }
+}
+
+fn worker_loop(
+    config: Arc<ExternalConfig>,
+    shared: Arc<Mutex<ExternalSnapshot>>,
+    rx: std::sync::mpsc::Receiver<PlayerCommand>,
+    alive: Arc<AtomicBool>,
+) {
+    let own_exe = std::env::current_exe().unwrap_or_else(|_| PathBuf::from("pipeline"));
+    let reaped = reap_stale_session_sockets(&own_exe);
+    log::info!(
+        "Pipeline external player stage=start result=ok mpv={} per_playback={} fullscreen={} app_id={} stale_sockets_reaped={}",
+        config.mpv,
+        config.per_playback_process,
+        config.fullscreen,
+        config.app_id,
+        reaped
+    );
+    let mut session = Session::new(config, shared, Arc::clone(&alive));
+    // A persistent idle player is spawned lazily on the first load, so a
+    // Pipeline session that never plays anything owns no player at all.
+    while alive.load(Ordering::SeqCst) {
+        session.drain_commands(&rx);
+        session.pump();
+        thread::sleep(Duration::from_millis(20));
+    }
+    session.shutdown();
+}
+
+// ---------------------------------------------------------------------------
+// Worker session
+// ---------------------------------------------------------------------------
+
+struct Session {
+    config: Arc<ExternalConfig>,
+    shared: Arc<Mutex<ExternalSnapshot>>,
+    alive: Arc<AtomicBool>,
+    child: Option<Child>,
+    ipc: Option<Ipc>,
+    socket: Option<PathBuf>,
+    current: Option<Pending>,
+    state: ExternalState,
+    /// When the current generation's load was issued.
+    load_issued_at: Option<Instant>,
+    /// When time-pos last advanced.
+    last_progress_at: Option<Instant>,
+    /// When forward progress was first seen for this generation.
+    progress_since: Option<Instant>,
+    last_position: f64,
+    pending_resume: Option<f64>,
+    /// A start-paused request is applied once the file is really loaded, so the
+    /// first thing the player does is still decode a real frame.
+    pending_start_paused: bool,
+    /// When the current generation is a recovery replacement whose sustained
+    /// forward playback still has to be confirmed.
+    ///
+    /// This is deliberately NOT the same thing as the display state: the state
+    /// leaves `Recovering` as soon as time-pos advances, so a check that only
+    /// ran while `Recovering` could never fire and the confirmation was
+    /// unreachable.
+    recovery_confirmation: Option<Instant>,
+    /// Reason from the last `end-file` event seen on this session's socket.
+    /// Set even when the socket dies in the same read, because that is the only
+    /// way to tell a completed playback from a failed player.
+    end_reason: Option<String>,
+    spawn_count: u64,
+    last_poll: Instant,
+}
+
+impl Session {
+    fn new(
+        config: Arc<ExternalConfig>,
+        shared: Arc<Mutex<ExternalSnapshot>>,
+        alive: Arc<AtomicBool>,
+    ) -> Self {
+        if let Ok(mut guard) = shared.lock() {
+            guard.state = ExternalState::Stopped;
+        }
+        Self {
+            config,
+            shared,
+            alive,
+            child: None,
+            ipc: None,
+            socket: None,
+            current: None,
+            state: ExternalState::Stopped,
+            load_issued_at: None,
+            last_progress_at: None,
+            progress_since: None,
+            last_position: 0.0,
+            pending_resume: None,
+            pending_start_paused: false,
+            recovery_confirmation: None,
+            end_reason: None,
+            spawn_count: 0,
+            last_poll: Instant::now() - Duration::from_secs(1),
+        }
+    }
+
+    fn set_state(&mut self, state: ExternalState) {
+        if self.state == state {
+            return;
+        }
+        self.state = state;
+        let generation = self.generation();
+        if let Ok(mut guard) = self.shared.lock() {
+            guard.state = state;
+        }
+        log::info!(
+            "Pipeline external player stage=state state={} generation={generation}",
+            state.label()
+        );
+    }
+
+    fn generation(&self) -> u64 {
+        self.shared
+            .lock()
+            .map(|guard| guard.generation)
+            .unwrap_or(0)
+    }
+
+    fn publish(&self, edit: impl FnOnce(&mut ExternalSnapshot)) {
+        if let Ok(mut guard) = self.shared.lock() {
+            edit(&mut guard);
+        }
+    }
+
+    // -- command intake ----------------------------------------------------
+
+    fn drain_commands(&mut self, rx: &std::sync::mpsc::Receiver<PlayerCommand>) {
+        while let Ok(command) = rx.try_recv() {
+            match command {
+                PlayerCommand::Load {
+                    generation,
+                    video_url,
+                    audio_url,
+                    media_identity,
+                    title,
+                    resume_position,
+                    start_paused,
+                } => {
+                    self.begin_generation(Pending {
+                        generation,
+                        media: Media {
+                            video_url,
+                            audio_url,
+                            media_identity,
+                            title,
+                        },
+                        resume_position,
+                        start_paused,
+                    });
+                }
+                PlayerCommand::Replace {
+                    generation,
+                    video_url,
+                    audio_url,
+                    media_identity,
+                    title,
+                    resume_position,
+                } => {
+                    self.begin_generation(Pending {
+                        generation,
+                        media: Media {
+                            video_url,
+                            audio_url,
+                            media_identity,
+                            title,
+                        },
+                        resume_position,
+                        start_paused: false,
+                    });
+                }
+                PlayerCommand::Stop => {
+                    if self.child.is_some() {
+                        self.set_state(ExternalState::Stopping);
+                    }
+                    self.teardown("stop");
+                    self.current = None;
+                    self.pending_resume = None;
+                    self.load_issued_at = None;
+                    self.publish(|guard| {
+                        guard.position = 0.0;
+                        guard.duration = 0.0;
+                        guard.load_issued = false;
+                        guard.file_loaded = false;
+                        guard.forward_progress = false;
+                        guard.eof_seen = false;
+                        guard.recovery_request = None;
+                        guard.recovery_sustained = false;
+                        guard.failure_class = None;
+                        guard.failure_detail = None;
+                        guard.current_vo = None;
+                        guard.hwdec_current = None;
+                        guard.video_width = None;
+                        guard.video_height = None;
+                        guard.video_fps = None;
+                        guard.video_pixel_format = None;
+                    });
+                    self.set_state(ExternalState::Stopped);
+                }
+                PlayerCommand::Pause(paused) => {
+                    if self.ipc.is_some() {
+                        self.command(&[json!(["set_property", "pause", paused])]);
+                    }
+                }
+                PlayerCommand::Seek { absolute, relative } => {
+                    if self.ipc.is_none() {
+                        continue;
+                    }
+                    let target = match (absolute, relative) {
+                        (Some(value), _) => value,
+                        (None, Some(delta)) => self.last_position + delta,
+                        _ => continue,
+                    };
+                    if target.is_finite() && target >= 0.0 {
+                        self.set_state(ExternalState::Seeking);
+                        // exact = keyframe tolerant, then accurate.
+                        self.command(&[json!(["seek", target, "absolute", "exact"])]);
+                    }
+                }
+                PlayerCommand::SetVolume(volume) => {
+                    if self.ipc.is_some() {
+                        self.command(&[json!(["set_property", "volume", volume])]);
+                    }
+                }
+                PlayerCommand::SetMuted(muted) => {
+                    if self.ipc.is_some() {
+                        self.command(&[json!(["set_property", "mute", muted])]);
+                    }
+                }
+                PlayerCommand::SetSpeed(speed) => {
+                    if self.ipc.is_some() {
+                        self.command(&[json!(["set_property", "speed", speed])]);
+                    }
+                }
+                PlayerCommand::AcknowledgeRecovery => {
+                    self.publish(|guard| {
+                        guard.recovery_request = None;
+                        guard.recovery_sustained = false;
+                    });
+                }
+                PlayerCommand::ClearTerminal => {
+                    self.teardown("clear-terminal");
+                    self.publish(|guard| {
+                        guard.failure_class = None;
+                        guard.failure_detail = None;
+                        guard.recovery_request = None;
+                    });
+                    self.set_state(ExternalState::Stopped);
+                }
+                PlayerCommand::Shutdown => {
+                    self.teardown("shutdown");
+                    self.alive.store(false, Ordering::SeqCst);
+                }
+            }
+        }
+    }
+
+    /// A new generation always supersedes the previous one. Every media
+    /// generation gets a new identity, so a stale event from an older load can
+    /// never mutate current UI state.
+    fn begin_generation(&mut self, pending: Pending) {
+        self.teardown("superseded");
+        let identity = pending.media.media_identity.clone();
+        let generation = pending.generation;
+        self.current = Some(pending);
+        self.pending_resume = self
+            .current
+            .as_ref()
+            .and_then(|pending| pending.resume_position);
+        self.load_issued_at = Some(Instant::now());
+        self.last_progress_at = None;
+        self.progress_since = None;
+        self.last_position = 0.0;
+        // A replacement generation must prove sustained forward playback before
+        // the recovery counts as successful.
+        self.recovery_confirmation = self
+            .current
+            .as_ref()
+            .and_then(|current| current.resume_position)
+            .map(|_| Instant::now());
+        self.publish(|guard| {
+            guard.generation = generation;
+            guard.media_identity = Some(identity);
+            guard.load_issued = true;
+            guard.file_loaded = false;
+            guard.forward_progress = false;
+            guard.eof_seen = false;
+            guard.position = 0.0;
+            guard.duration = 0.0;
+            guard.recovery_request = None;
+            guard.recovery_sustained = false;
+            guard.failure_class = None;
+            guard.failure_detail = None;
+        });
+        log::info!(
+            "Pipeline external player stage=load generation={generation} identity={} per_playback={}",
+            self.current
+                .as_ref()
+                .map(|pending| pending.media.media_identity.clone())
+                .unwrap_or_default(),
+            self.config.per_playback_process
+        );
+        if self.config.per_playback_process {
+            self.spawn_for_current();
+        } else {
+            self.ensure_idle_player();
+            self.issue_load();
+        }
+    }
+
+    // -- process lifecycle -------------------------------------------------
+
+    /// The exact proven native invocation (Phase 0). Not "improved".
+    fn mpv_argv(&self, media: Option<&Media>, idle: bool) -> Vec<String> {
+        let mut argv: Vec<String> = Vec::new();
+        let arg = |argv: &mut Vec<String>, value: String| argv.push(value);
+
+        arg(&mut argv, "--no-config".into());
+        arg(&mut argv, "--load-scripts=no".into());
+        arg(&mut argv, "--no-input-terminal".into());
+        arg(&mut argv, "--demuxer-lavf-probe-info=yes".into());
+        arg(&mut argv, "--vd=santos_vdx".into());
+        arg(&mut argv, "--vo=gpu".into());
+        arg(&mut argv, "--gpu-context=wayland".into());
+        arg(&mut argv, "--opengl-es=yes".into());
+        arg(&mut argv, "--profile=fast".into());
+        arg(
+            &mut argv,
+            format!("--msg-level={}", self.config.msg_level),
+        );
+        // A distinct app-id so the Shell and any operator tooling can tell the
+        // Santos player surface from every other window.
+        arg(
+            &mut argv,
+            format!("--wayland-app-id={}", self.config.app_id),
+        );
+        if self.config.osc {
+            // Native mpv OSC: the temporary human pause/seek path.
+            arg(&mut argv, "--osc=yes".into());
+        }
+        if self.config.fullscreen {
+            arg(&mut argv, "--fs".into());
+        }
+        if idle {
+            arg(&mut argv, "--idle=yes".into());
+            if self.config.idle_force_window {
+                arg(&mut argv, "--force-window=immediate".into());
+            }
+        }
+        if let Some(dir) = self.config.script_dir.as_ref() {
+            let script = dir.join("santos-controls.lua");
+            if script.is_file() {
+                arg(&mut argv, format!("--script={}", script.display()));
+            }
+        }
+        if let Some(media) = media {
+            // Structured argv: no shell, no interpolation, never logged.
+            arg(&mut argv, media.video_url.clone());
+            if let Some(audio) = media.audio_url.as_deref() {
+                // Preserve the product's video+audio pairing. mpv never
+                // resolves YouTube itself.
+                arg(&mut argv, format!("--audio-file={audio}"));
+            }
+        }
+        argv
+    }
+
+    /// Keep Pipeline's GTK runtime out of the player's environment.
+    ///
+    /// Only the GTK/client-runtime entries are removed. LD_PRELOAD and every
+    /// hybris/PowerVR variable survive untouched, because that stack IS the
+    /// measured standalone oracle; changing it would be "improving" the oracle
+    /// rather than testing the architecture.
+    fn apply_env_isolation(&self, command: &mut Command) {
+        if !self.config.isolate_gtk_runtime {
+            return;
+        }
+        let gtk_paths = [
+            "/usr/lib/pipeline-santos",
+            "/opt/pipeline-santos-candidate/usr/lib/pipeline-santos",
+            "/usr/lib/santos-gtk-runtime",
+        ];
+        if let Ok(value) = std::env::var("LD_LIBRARY_PATH") {
+            let kept: Vec<&str> = value
+                .split(':')
+                .filter(|entry| !entry.is_empty())
+                .filter(|entry| !gtk_paths.contains(entry))
+                .collect();
+            if kept.is_empty() {
+                command.env_remove("LD_LIBRARY_PATH");
+            } else {
+                command.env("LD_LIBRARY_PATH", kept.join(":"));
+            }
+        }
+        for key in [
+            "GDK_BACKEND",
+            "GSK_RENDERER",
+            "GDK_DISABLE",
+            "GI_TYPELIB_PATH",
+            "GSETTINGS_SCHEMA_DIR",
+            "PIPELINE_SANTOS_FRAME_TRACE",
+            "PIPELINE_SANTOS_STARTUP_TRACE",
+        ] {
+            command.env_remove(key);
+        }
+    }
+
+    fn spawn(&mut self, media: Option<&Media>, idle: bool) -> bool {
+        if self.child.is_some() {
+            return true;
+        }
+        let socket = session_socket_path();
+        // Our own session-unique path: removing a stale file here cannot
+        // destroy a live session's socket.
+        let _ = std::fs::remove_file(&socket);
+
+        let mut command = Command::new(&self.config.mpv);
+        command
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::piped());
+        // SANTOS_WAYLAND_LEGACY_EGL is REQUIRED (L233): mpv-santos patch 0002
+        // makes the Wayland GPU context fall back to eglGetDisplay(wl_display)
+        // only when it is set, because the hybris libEGL is EGL 1.4 and never
+        // advertises EGL_EXT_platform_wayland. Without it there is no VO.
+        command.env("SANTOS_WAYLAND_LEGACY_EGL", "1");
+        self.apply_env_isolation(&mut command);
+        command.arg(format!("--input-ipc-server={}", socket.display()));
+        for value in self.mpv_argv(media, idle) {
+            command.arg(value);
+        }
+        unsafe {
+            command.pre_exec(|| {
+                arm_parent_death_signal();
+                Ok(())
+            });
+        }
+
+        let started = Instant::now();
+        let child = match command.spawn() {
+            Ok(child) => child,
+            Err(error) => {
+                log::error!(
+                    "Pipeline external player stage=spawn result=failed reason={error} mpv={}",
+                    self.config.mpv
+                );
+                self.fail(
+                    FailureClass::PlayerProcess,
+                    format!("mpv spawn failed: {error}"),
+                );
+                return false;
+            }
+        };
+        if let Some(stderr) = child.stderr.as_ref() {
+            use std::os::fd::AsRawFd;
+            set_nonblocking(stderr.as_raw_fd());
+        }
+        let pid = child.id();
+        self.spawn_count += 1;
+        let spawn_count = self.spawn_count;
+        let generation = self.generation();
+        log::info!(
+            "Pipeline external player stage=spawn result=ok pid={pid} idle={idle} identity={:?} spawn_ms={} generation={generation}",
+            process_identity(pid),
+            started.elapsed().as_millis(),
+        );
+        self.child = Some(child);
+        self.socket = Some(socket.clone());
+        self.publish(|guard| {
+            guard.pid = Some(pid);
+            guard.socket_path = Some(socket.display().to_string());
+            guard.spawn_count = spawn_count;
+        });
+        self.set_state(ExternalState::StartingPlayer);
+        true
+    }
+
+    /// Apply the session's audio settings to a freshly started player.
+    fn apply_audio_settings(&mut self) {
+        let (volume, muted, speed) = self
+            .shared
+            .lock()
+            .map(|guard| (guard.volume, guard.muted, guard.speed))
+            .unwrap_or((1.0, false, 1.0));
+        self.command(&[
+            json!(["set_property", "volume", volume]),
+            json!(["set_property", "mute", muted]),
+            json!(["set_property", "speed", speed]),
+        ]);
+    }
+
+    fn connect_ipc(&mut self) -> bool {
+        let Some(socket) = self.socket.clone() else {
+            return false;
+        };
+        let Some(mut ipc) = Ipc::connect(socket, self.config.spawn_timeout, &self.alive) else {
+            self.fail(
+                FailureClass::PlayerProcess,
+                "mpv IPC socket never appeared".to_string(),
+            );
+            return false;
+        };
+        ipc.observe();
+        self.ipc = Some(ipc);
+        true
+    }
+
+    /// Per-playback lifecycle: the media goes on the command line, which is the
+    /// measured-reliable path (18/18 runs, cadence median 1.000).
+    fn spawn_for_current(&mut self) -> bool {
+        let Some(pending) = self.current.clone() else {
+            return false;
+        };
+        if !self.spawn(Some(&pending.media), false) {
+            return false;
+        }
+        if !self.connect_ipc() {
+            self.teardown("ipc-connect-failed");
+            return false;
+        }
+        self.set_state(ExternalState::LoadingMedia);
+        self.apply_audio_settings();
+        // A start-paused request is honoured after the file is loaded, so the
+        // first frame is still a real decoded frame.
+        if pending.start_paused {
+            self.pending_start_paused = true;
+        }
+        true
+    }
+
+    fn ensure_idle_player(&mut self) -> bool {
+        if self.child.is_some() {
+            return true;
+        }
+        if !self.spawn(None, true) {
+            return false;
+        }
+        self.connect_ipc()
+    }
+
+    fn issue_load(&mut self) {
+        let Some(pending) = self.current.clone() else {
+            return;
+        };
+        let mut request = vec![
+            json!("loadfile"),
+            json!(pending.media.video_url),
+            json!("replace"),
+        ];
+        if let Some(audio) = pending.media.audio_url.as_deref() {
+            // Same pairing semantics as the embedded player:
+            // loadfile <video> replace -- 0 <audio> 1
+            request.push(Value::Array(vec![
+                json!("--"),
+                json!(0),
+                json!(audio),
+                json!(1),
+            ]));
+        }
+        if self.ipc.is_none() {
+            return;
+        }
+        self.command(&[Value::Array(request)]);
+        self.load_issued_at = Some(Instant::now());
+        self.publish(|guard| guard.load_issued = true);
+        self.set_state(ExternalState::LoadingMedia);
+    }
+
+    /// Stop the owned player. Only the recorded child handle is signalled, so
+    /// there is no `pkill`, no name matching and no PID-reuse hazard.
+    fn teardown(&mut self, reason: &str) {
+        let had_child = self.child.is_some();
+        self.ipc = None;
+        if let Some(mut child) = self.child.take() {
+            if had_child {
+                self.set_state(ExternalState::Stopping);
+            }
+            // Ask nicely through IPC so the surface unmaps cleanly, then
+            // escalate on the exact child handle.
+            if let Some(socket) = self.socket.clone()
+                && let Some(mut ipc) = Ipc::connect_quiet(socket, Duration::from_millis(500))
+            {
+                ipc.send_quiet(&[json!(["quit"])]);
+            }
+            let deadline = Instant::now() + Duration::from_millis(1500);
+            loop {
+                match child.try_wait() {
+                    Ok(Some(_)) | Err(_) => break,
+                    Ok(None) => {
+                        if Instant::now() >= deadline {
+                            let _ = child.kill();
+                            let _ = child.wait();
+                            break;
+                        }
+                        thread::sleep(Duration::from_millis(25));
+                    }
+                }
+            }
+            if let Some(socket) = self.socket.take() {
+                let _ = std::fs::remove_file(socket);
+            }
+            self.publish(|guard| {
+                guard.pid = None;
+                guard.socket_path = None;
+            });
+            log::info!("Pipeline external player stage=teardown reason={reason} result=ok");
+        } else if let Some(socket) = self.socket.take() {
+            let _ = std::fs::remove_file(socket);
+        }
+        self.pending_resume = None;
+        self.load_issued_at = None;
+        self.recovery_confirmation = None;
+        self.end_reason = None;
+    }
+
+    fn fail(&mut self, class: FailureClass, detail: String) {
+        let generation = self.generation();
+        log::error!(
+            "Pipeline external player stage=failure class={} detail={detail} generation={generation}",
+            class.label()
+        );
+        self.publish(|guard| {
+            guard.failure_class = Some(class);
+            guard.failure_detail = Some(detail);
+        });
+        self.set_state(match class {
+            FailureClass::PlayerProcess => ExternalState::PlayerProcessDead,
+            _ => ExternalState::TerminalError,
+        });
+    }
+
+    fn shutdown(&mut self) {
+        self.teardown("session-shutdown");
+        self.publish(|guard| {
+            guard.pid = None;
+            guard.socket_path = None;
+            guard.position = 0.0;
+            guard.load_issued = false;
+        });
+        self.set_state(ExternalState::Stopped);
+    }
+
+    // -- observation -------------------------------------------------------
+
+    fn pump(&mut self) {
+        if self.last_poll.elapsed() < Duration::from_millis(200) {
+            return;
+        }
+        self.last_poll = Instant::now();
+        self.drain_stderr();
+        if self.ipc.is_none() {
+            self.reap_child();
+            return;
+        }
+        self.sample_properties();
+        self.reap_child();
+    }
+
+    fn drain_stderr(&mut self) {
+        // Bounded drain so a chatty player can never block on a full pipe. The
+        // last lines are kept for the report only; URLs are redacted here.
+        let Some(child) = self.child.as_mut() else {
+            return;
+        };
+        let Some(stderr) = child.stderr.as_mut() else {
+            return;
+        };
+        let mut buffer = [0u8; 4096];
+        match stderr.read(&mut buffer) {
+            // Nothing buffered right now. This is the normal case and must not
+            // be treated as an error, and must never block.
+            Ok(0) => {}
+            Err(error)
+                if matches!(
+                    error.kind(),
+                    std::io::ErrorKind::WouldBlock | std::io::ErrorKind::Interrupted
+                ) => {}
+            Err(_) => {}
+            Ok(read) => {
+                for line in String::from_utf8_lossy(&buffer[..read]).lines() {
+                    let redacted = redact_urls(line);
+                    if redacted.is_empty() {
+                        continue;
+                    }
+                    log::debug!("Pipeline external player stage=mpv-stderr {redacted}");
+                }
+            }
+        }
+    }
+
+    fn sample_properties(&mut self) {
+        // Events first. An end-file event and the socket closing can arrive in
+        // the same read, and a controller that only looks at properties after
+        // the socket died classifies a normal end of file as a crash.
+        let events = self.ipc.as_mut().map(Ipc::drain_events).unwrap_or_default();
+        let mut end_reason: Option<String> = None;
+        for event in &events {
+            match event.name.as_str() {
+                "file-loaded" => {
+                    self.publish(|guard| guard.file_loaded = true);
+                    log::info!(
+                        "Pipeline external player stage=file-loaded generation={}",
+                        self.generation()
+                    );
+                    if self.pending_start_paused {
+                        self.pending_start_paused = false;
+                        self.command(&[json!(["set_property", "pause", true])]);
+                    }
+                }
+                "end-file" => {
+                    end_reason = event.reason.clone();
+                    self.end_reason = event.reason.clone();
+                    log::info!(
+                        "Pipeline external player stage=end-file reason={} generation={}",
+                        event.reason.as_deref().unwrap_or("unknown"),
+                        self.generation()
+                    );
+                }
+                "seek" => {
+                    if self.state == ExternalState::Seeking {
+                        let paused = self
+                            .shared
+                            .lock()
+                            .map(|guard| guard.paused)
+                            .unwrap_or(false);
+                        self.set_state(if paused {
+                            ExternalState::Paused
+                        } else {
+                            ExternalState::Playing
+                        });
+                    }
+                }
+                _ => {}
+            }
+        }
+        if end_reason.as_deref() == Some("eof") {
+            self.handle_eof();
+            return;
+        }
+        if matches!(end_reason.as_deref(), Some("stop") | Some("quit")) {
+            return;
+        }
+
+        let keys = [
+            "time-pos",
+            "duration",
+            "pause",
+            "volume",
+            "mute",
+            "speed",
+            "eof-reached",
+            "current-vo",
+            "hwdec-current",
+            "video-params",
+            "frame-drop-count",
+            "decoder-frame-drop-count",
+            "media-title",
+        ];
+        let mut values: Vec<(&'static str, Value)> = Vec::with_capacity(keys.len());
+        for key in keys {
+            if let Some(value) = self.get_property(key) {
+                values.push((key, value));
+            }
+        }
+        let lookup = |name: &str| values.iter().find(|(key, _)| *key == name).map(|(_, v)| v);
+
+        let position = lookup("time-pos").and_then(Value::as_f64).unwrap_or(0.0);
+        let duration = lookup("duration").and_then(Value::as_f64).unwrap_or(0.0);
+        let paused = lookup("pause").and_then(Value::as_bool).unwrap_or(false);
+        let eof = lookup("eof-reached").and_then(Value::as_bool).unwrap_or(false);
+        let current_vo = lookup("current-vo")
+            .and_then(Value::as_str)
+            .map(str::to_string);
+        let hwdec = lookup("hwdec-current")
+            .and_then(Value::as_str)
+            .map(str::to_string);
+        let frame_drops = lookup("frame-drop-count").and_then(Value::as_i64);
+        let decoder_drops = lookup("decoder-frame-drop-count").and_then(Value::as_i64);
+        let title = lookup("media-title")
+            .and_then(Value::as_str)
+            .map(str::to_string);
+        let video = lookup("video-params").cloned().unwrap_or(Value::Null);
+        let width = video.get("w").and_then(Value::as_i64);
+        let height = video.get("h").and_then(Value::as_i64);
+        let fps = video.get("fps").and_then(Value::as_f64);
+        let pixel_format = video
+            .get("pixelformat")
+            .and_then(Value::as_str)
+            .map(str::to_string);
+        let volume = lookup("volume").and_then(Value::as_f64);
+        let muted = lookup("mute").and_then(Value::as_bool);
+        let speed = lookup("speed").and_then(Value::as_f64);
+
+        self.publish(|guard| {
+            guard.position = position;
+            guard.duration = duration;
+            guard.paused = paused;
+            if let Some(value) = volume {
+                guard.volume = value;
+            }
+            if let Some(value) = muted {
+                guard.muted = value;
+            }
+            if let Some(value) = speed {
+                guard.speed = value;
+            }
+            guard.eof_seen = eof;
+            guard.current_vo = current_vo.clone();
+            guard.hwdec_current = hwdec.clone();
+            guard.frame_drop_count = frame_drops;
+            guard.decoder_frame_drop_count = decoder_drops;
+            guard.media_title = title.clone();
+            guard.video_width = width;
+            guard.video_height = height;
+            guard.video_fps = fps;
+            guard.video_pixel_format = pixel_format.clone();
+        });
+
+        if eof {
+            self.handle_eof();
+            return;
+        }
+
+        if position > self.last_position + 0.05 {
+            self.last_position = position;
+            let now = Instant::now();
+            self.last_progress_at = Some(now);
+            if self.progress_since.is_none() {
+                self.progress_since = Some(now);
+            }
+            self.publish(|guard| guard.forward_progress = true);
+            if !paused && self.state != ExternalState::Recovering {
+                self.set_state(ExternalState::Playing);
+            }
+        } else if paused && self.state == ExternalState::Playing {
+            self.set_state(ExternalState::Paused);
+        }
+
+        self.apply_pending_resume();
+        self.check_load_timeout();
+        self.check_sustained_recovery();
+        self.classify_stall();
+    }
+
+    /// One keyframe-tolerant resume, applied only after the replacement file is
+    /// actually loaded. Never a seek loop, never a restart from zero.
+    fn apply_pending_resume(&mut self) {
+        let Some(position) = self.pending_resume else {
+            return;
+        };
+        let loaded = self
+            .shared
+            .lock()
+            .map(|guard| guard.file_loaded)
+            .unwrap_or(false);
+        if !loaded {
+            // Keep it pending rather than seeking into a file that is not there.
+            return;
+        }
+        self.pending_resume = None;
+        if position > 0.0 {
+            self.command(&[json!(["seek", position, "absolute", "keyframes"])]);
+            log::info!(
+                "Pipeline external player stage=resume position={position:.3} generation={}",
+                self.generation()
+            );
+        }
+    }
+
+    /// A media load that was actually issued and never produced output is
+    /// classified, not left hanging. A missing VO is a window/VO failure, not a
+    /// network stall.
+    fn check_load_timeout(&mut self) {
+        if self.state != ExternalState::LoadingMedia {
+            return;
+        }
+        let Some(issued) = self.load_issued_at else {
+            return;
+        };
+        if issued.elapsed() < self.config.load_timeout {
+            return;
+        }
+        let (vo, file_loaded, generation, identity) = self
+            .shared
+            .lock()
+            .map(|guard| {
+                (
+                    guard.current_vo.clone(),
+                    guard.file_loaded,
+                    guard.generation,
+                    guard.media_identity.clone(),
+                )
+            })
+            .unwrap_or((None, false, 0, None));
+        let class = if vo.is_none() {
+            FailureClass::WindowVo
+        } else {
+            FailureClass::MediaStall
+        };
+        let detail = format!(
+            "load issued but no output after {}s (vo={:?} file_loaded={file_loaded})",
+            self.config.load_timeout.as_secs(),
+            vo
+        );
+        log::warn!(
+            "Pipeline external player stage=load-timeout class={} detail={detail} generation={generation}",
+            class.label()
+        );
+        self.teardown("load-timeout");
+        self.publish(|guard| {
+            guard.failure_class = Some(class);
+            guard.failure_detail = Some(detail.clone());
+            guard.recovery_request = Some(RecoverySignal {
+                class,
+                position: self.last_position,
+                was_paused: false,
+                generation,
+                media_identity: identity,
+                detail,
+            });
+        });
+        self.set_state(ExternalState::Recovering);
+    }
+
+    /// Sustained forward playback is what makes a recovery successful.
+    ///
+    /// Checked independently of the display state, because the state leaves
+    /// `Recovering` on the first advancing sample - a check tied to that state
+    /// can never fire.
+    fn check_sustained_recovery(&mut self) {
+        let Some(armed) = self.recovery_confirmation else {
+            return;
+        };
+        let Some(since) = self.progress_since else {
+            return;
+        };
+        if since.elapsed() < self.config.sustained_media {
+            return;
+        }
+        self.recovery_confirmation = None;
+        log::info!(
+            "Pipeline external player stage=recovery-sustained generation={} \
+             sustained_ms={}",
+            self.generation(),
+            armed.elapsed().as_millis()
+        );
+        self.publish(|guard| guard.recovery_sustained = true);
+    }
+
+    /// Distinguish a genuine media stall from everything else.
+    ///
+    /// A media stall requires that the media actually demonstrated forward
+    /// progress first. A process/window/control failure is never reported here.
+    fn classify_stall(&mut self) {
+        if self.state != ExternalState::Playing {
+            return;
+        }
+        let progressed = self
+            .shared
+            .lock()
+            .map(|guard| guard.forward_progress)
+            .unwrap_or(false);
+        if !progressed {
+            return;
+        }
+        let Some(last) = self.last_progress_at else {
+            return;
+        };
+        if last.elapsed() < self.config.stall_timeout {
+            return;
+        }
+        let pending = self
+            .shared
+            .lock()
+            .map(|guard| guard.recovery_request.is_some())
+            .unwrap_or(true);
+        if pending {
+            return;
+        }
+        let (generation, identity) = self
+            .shared
+            .lock()
+            .map(|guard| (guard.generation, guard.media_identity.clone()))
+            .unwrap_or((0, None));
+        let position = self.last_position;
+        let detail = format!(
+            "no forward playback for {:.1}s",
+            self.config.stall_timeout.as_secs_f64()
+        );
+        log::warn!(
+            "Pipeline external player stage=stall class={} position={position:.3} detail={detail} generation={generation}",
+            FailureClass::MediaStall.label()
+        );
+        self.teardown("media-stall");
+        self.publish(|guard| {
+            guard.failure_class = Some(FailureClass::MediaStall);
+            guard.failure_detail = Some(detail.clone());
+            guard.recovery_request = Some(RecoverySignal {
+                class: FailureClass::MediaStall,
+                position,
+                was_paused: false,
+                generation,
+                media_identity: identity,
+                detail,
+            });
+        });
+        self.set_state(ExternalState::Recovering);
+    }
+
+    /// EOF is a normal transition and must never enter recovery.
+    fn handle_eof(&mut self) {
+        if matches!(
+            self.state,
+            ExternalState::Stopping | ExternalState::Stopped | ExternalState::Recovering
+        ) {
+            return;
+        }
+        let generation = self.generation();
+        log::info!(
+            "Pipeline external player stage=eof class={} generation={generation}",
+            FailureClass::Normal.label()
+        );
+        self.teardown("eof");
+        self.current = None;
+        self.pending_resume = None;
+        self.publish(|guard| {
+            guard.eof_seen = true;
+            guard.load_issued = false;
+            guard.file_loaded = false;
+            guard.forward_progress = false;
+            guard.recovery_request = None;
+        });
+        self.set_state(ExternalState::Stopped);
+    }
+
+    /// Detect process death and classify it separately from a media stall.
+    fn reap_child(&mut self) {
+        let Some(mut child) = self.child.take() else {
+            return;
+        };
+        let status = match child.try_wait() {
+            Ok(status) => status,
+            Err(_) => {
+                self.child = Some(child);
+                return;
+            }
+        };
+        let Some(status) = status else {
+            self.child = Some(child);
+            return;
+        };
+        let pid = child.id();
+        // Drain before the IPC handle is dropped: a buffered end-file event is
+        // the only record of why the player ended.
+        if let Some(ipc) = self.ipc.as_mut() {
+            for event in ipc.drain_events() {
+                if event.name == "end-file" {
+                    self.end_reason = event.reason.clone();
+                }
+            }
+        }
+        self.child = None;
+        self.ipc = None;
+        if let Some(socket) = self.socket.take() {
+            let _ = std::fs::remove_file(socket);
+        }
+        self.publish(|guard| {
+            guard.pid = None;
+            guard.socket_path = None;
+        });
+        let was_stopping = matches!(
+            self.state,
+            ExternalState::Stopping | ExternalState::Stopped
+        );
+        let saw_eof = self
+            .shared
+            .lock()
+            .map(|guard| guard.eof_seen)
+            .unwrap_or(false);
+        // The socket can die in the same read that carried the end-file event, so
+        // the buffered events are the authority on WHY the process ended. A
+        // player that ran to the end of its media is not a failed player.
+        let end_reason = self.end_reason.clone();
+        if was_stopping {
+            return;
+        }
+        if saw_eof || end_reason.as_deref() == Some("eof") {
+            self.handle_eof();
+            return;
+        }
+        if end_reason.as_deref() == Some("stop") || end_reason.as_deref() == Some("quit") {
+            return;
+        }
+        if status.code() == Some(0) {
+            // mpv exits 0 when it runs out of media, whether or not the
+            // end-file event survived the socket close. A zero exit that nobody
+            // asked for is a completed playback, never a failed player.
+            self.handle_eof();
+            return;
+        }
+        let detail = format!(
+            "mpv exited pid={pid} code={:?} signal={:?}",
+            status.code(),
+            status_signal(&status)
+        );
+        log::warn!("Pipeline external player stage=exit class={} {detail}", FailureClass::PlayerProcess.label());
+        let (generation, identity, position) = self
+            .shared
+            .lock()
+            .map(|guard| {
+                (
+                    guard.generation,
+                    guard.media_identity.clone(),
+                    guard.position,
+                )
+            })
+            .unwrap_or((0, None, 0.0));
+        self.publish(|guard| {
+            guard.failure_class = Some(FailureClass::PlayerProcess);
+            guard.failure_detail = Some(detail.clone());
+            guard.recovery_request = Some(RecoverySignal {
+                class: FailureClass::PlayerProcess,
+                position,
+                was_paused: false,
+                generation,
+                media_identity: identity,
+                detail,
+            });
+        });
+        self.set_state(ExternalState::PlayerProcessDead);
+    }
+
+    // -- IPC ---------------------------------------------------------------
+
+    /// Send commands and require a success response for each one.
+    ///
+    /// An mpv error response is logged, never swallowed: the first version of
+    /// this file discarded it, which is how a mis-shaped `set_property` looked
+    /// exactly like a player that ignored pause.
+    fn command(&mut self, commands: &[Value]) {
+        let Some(mut ipc) = self.ipc.take() else {
+            log::warn!(
+                "Pipeline external player stage=command result=not-sent reason=no-ipc"
+            );
+            return;
+        };
+        for command in commands {
+            let request_id = ipc.next_id();
+            let name = command
+                .get(0)
+                .and_then(Value::as_str)
+                .unwrap_or("?")
+                .to_string();
+            let line = json!({"command": command, "request_id": request_id});
+            if ipc.write_line(&line).is_err() {
+                log::warn!(
+                    "Pipeline external player stage=command result=failed command={name} \
+                     reason=write"
+                );
+                self.ipc = Some(ipc);
+                return;
+            }
+            match ipc.await_response(request_id, Duration::from_secs(5), &self.alive) {
+                None => {
+                    log::warn!(
+                        "Pipeline external player stage=command result=failed command={name} \
+                         reason=no-response"
+                    );
+                    self.ipc = Some(ipc);
+                    return;
+                }
+                Some(response) => {
+                    if let Some(error) = response.get("error").and_then(Value::as_str)
+                        && error != "success"
+                    {
+                        log::warn!(
+                            "Pipeline external player stage=command result=rejected \
+                             command={name} error={error}"
+                        );
+                    } else {
+                        log::info!(
+                            "Pipeline external player stage=command result=ok command={name}"
+                        );
+                    }
+                }
+            }
+        }
+        self.ipc = Some(ipc);
+    }
+
+    fn get_property(&mut self, name: &'static str) -> Option<Value> {
+        let mut ipc = self.ipc.take()?;
+        let request_id = ipc.next_id();
+        let line = json!({"command": ["get_property", name], "request_id": request_id});
+        let result = if ipc.write_line(&line).is_ok() {
+            ipc.await_value(request_id, Duration::from_millis(1500), &self.alive)
+        } else {
+            None
+        };
+        match result {
+            Some(value) => {
+                self.ipc = Some(ipc);
+                Some(value)
+            }
+            None => {
+                // A broken socket is a player-process fact, never silent loss -
+                // but the HANDLE is kept, because a buffered `end-file` event is
+                // the only record of why the player ended, and it is usually
+                // delivered in the very read that reports the close. Dropping
+                // the handle here is what made a normal end of file look like a
+                // crashed player.
+                self.ipc = Some(ipc);
+                None
+            }
+        }
+    }
+}
+
+fn status_signal(status: &ExitStatus) -> Option<i32> {
+    use std::os::unix::process::ExitStatusExt;
+    status.signal()
+}
+
+fn redact_urls(line: &str) -> String {
+    let mut out = String::with_capacity(line.len());
+    let mut rest = line;
+    loop {
+        let found = rest.find("http://").or_else(|| rest.find("https://"));
+        let Some(index) = found else { break };
+        out.push_str(&rest[..index]);
+        out.push_str("<url>");
+        let tail = &rest[index..];
+        let end = tail
+            .find(|c: char| c.is_whitespace() || c == '"' || c == '\'')
+            .unwrap_or(tail.len());
+        rest = &tail[end..];
+    }
+    out.push_str(rest);
+    out.trim().to_string()
+}
+
+const OBSERVED_PROPERTIES: [&str; 12] = [
+    "time-pos",
+    "duration",
+    "pause",
+    "eof-reached",
+    "idle-active",
+    "video-params",
+    "current-vo",
+    "hwdec-current",
+    "frame-drop-count",
+    "decoder-frame-drop-count",
+    "media-title",
+    "core-idle",
+];
+
+/// One decoded mpv event. `name` and `reason` are protocol; nothing else is
+/// ever taken from the event.
+struct MpvEvent {
+    name: String,
+    reason: Option<String>,
+}
+
+/// Minimal, strict mpv JSON IPC client: one long-lived connection with request
+/// IDs, plus event observation.
+///
+/// Two properties are load-bearing and were both got wrong in the first
+/// version of this file:
+///
+///   * A read timeout is NOT a failure. mpv answers property requests in well
+///     under a millisecond, but a sample that straddles the 200 ms socket
+///     timeout is normal. Treating that as "IPC dead" silently froze the whole
+///     controller: position stopped updating and pause/seek/stop never reached
+///     the player while an external observer on the same socket still saw
+///     perfect playback.
+///   * A partial line is never discarded. `read_line` on a timing-out socket
+///     returns the bytes it did get, and throwing them away desynchronises the
+///     stream permanently: every later line then fails to parse.
+struct Ipc {
+    reader: BufReader<UnixStream>,
+    writer: UnixStream,
+    next_id: u64,
+    broken: bool,
+    /// Bytes of a not-yet-complete line. Never cleared on a timeout.
+    partial: Vec<u8>,
+    events: VecDeque<MpvEvent>,
+}
+
+impl Ipc {
+    fn connect(path: PathBuf, timeout: Duration, alive: &AtomicBool) -> Option<Self> {
+        let deadline = Instant::now() + timeout;
+        while Instant::now() < deadline && alive.load(Ordering::SeqCst) {
+            if path.exists()
+                && let Ok(stream) = UnixStream::connect(&path)
+                && let Ok(writer) = stream.try_clone()
+            {
+                return Some(Self {
+                    reader: BufReader::new(stream),
+                    writer,
+                    next_id: 1,
+                    broken: false,
+                    partial: Vec::new(),
+                    events: VecDeque::new(),
+                });
+            }
+            thread::sleep(Duration::from_millis(25));
+        }
+        None
+    }
+
+    fn connect_quiet(path: PathBuf, timeout: Duration) -> Option<Self> {
+        let alive = AtomicBool::new(true);
+        Self::connect(path, timeout, &alive)
+    }
+
+    fn next_id(&mut self) -> u64 {
+        self.next_id += 1;
+        self.next_id
+    }
+
+    fn broken(&self) -> bool {
+        self.broken
+    }
+
+    fn write_line(&mut self, value: &Value) -> std::io::Result<()> {
+        let mut payload = serde_json::to_vec(value)?;
+        payload.push(b'\n');
+        self.writer.write_all(&payload)?;
+        self.writer.flush()
+    }
+
+    fn send_quiet(&mut self, commands: &[Value]) {
+        for command in commands {
+            let request_id = self.next_id();
+            let line = json!({"command": command, "request_id": request_id});
+            let _ = self.write_line(&line);
+        }
+    }
+
+    fn observe(&mut self) {
+        for name in OBSERVED_PROPERTIES {
+            let request_id = self.next_id();
+            let line = json!({
+                "command": ["observe_property", request_id, name],
+                "request_id": request_id,
+            });
+            if self.write_line(&line).is_err() {
+                self.broken = true;
+                return;
+            }
+        }
+    }
+
+    /// Read one complete line.
+    ///
+    /// `Ok(Some(value))` a parsed message, `Ok(None)` nothing yet (timeout, keep
+    /// waiting), `Err(())` the peer is gone and this connection is finished.
+    fn read_message(
+        &mut self,
+        alive: &AtomicBool,
+    ) -> Result<Option<Value>, ()> {
+        if !alive.load(Ordering::SeqCst) {
+            return Err(());
+        }
+        let _ = self.writer.set_read_timeout(Some(Duration::from_millis(250)));
+        let mut chunk = [0u8; 8192];
+        loop {
+            if let Some(index) = self.partial.iter().position(|byte| *byte == b'\n') {
+                let line: Vec<u8> = self.partial.drain(..=index).collect();
+                let text = String::from_utf8_lossy(&line[..line.len() - 1]);
+                if text.trim().is_empty() {
+                    continue;
+                }
+                return match serde_json::from_str::<Value>(&text) {
+                    Ok(value) => Ok(Some(value)),
+                    // An unparsable line means the stream is not what we think it
+                    // is. Refusing to continue is the honest response; silently
+                    // skipping is how a controller ends up driving nothing.
+                    Err(_) => Err(()),
+                };
+            }
+            match self.reader.read(&mut chunk) {
+                Ok(0) => {
+                    self.broken = true;
+                    return Err(());
+                }
+                Ok(read) => self.partial.extend_from_slice(&chunk[..read]),
+                Err(error) => {
+                    return match error.kind() {
+                        // Nothing yet. The partial line is kept for next time.
+                        std::io::ErrorKind::WouldBlock
+                        | std::io::ErrorKind::TimedOut
+                        | std::io::ErrorKind::Interrupted => Ok(None),
+                        _ => {
+                            self.broken = true;
+                            Err(())
+                        }
+                    };
+                }
+            }
+        }
+    }
+
+    fn await_response(
+        &mut self,
+        request_id: u64,
+        timeout: Duration,
+        alive: &AtomicBool,
+    ) -> Option<Value> {
+        let deadline = Instant::now() + timeout;
+        while Instant::now() < deadline {
+            match self.read_message(alive) {
+                Ok(Some(data)) => {
+                    if data.get("request_id").and_then(Value::as_u64) == Some(request_id) {
+                        return Some(data);
+                    }
+                    self.absorb_event(data);
+                }
+                // A timeout is not a failure: keep waiting for our response.
+                Ok(None) => continue,
+                Err(()) => return None,
+            }
+        }
+        None
+    }
+
+    fn await_value(
+        &mut self,
+        request_id: u64,
+        timeout: Duration,
+        alive: &AtomicBool,
+    ) -> Option<Value> {
+        let data = self.await_response(request_id, timeout, alive)?;
+        if data
+            .get("error")
+            .and_then(Value::as_str)
+            .is_some_and(|error| error != "success")
+        {
+            return None;
+        }
+        data.get("data").cloned()
+    }
+
+    fn absorb_event(&mut self, data: Value) {
+        let Some(name) = data.get("event").and_then(Value::as_str) else {
+            return;
+        };
+        if self.events.len() >= 256 {
+            self.events.pop_front();
+        }
+        self.events.push_back(MpvEvent {
+            name: name.to_string(),
+            reason: data
+                .get("reason")
+                .and_then(Value::as_str)
+                .map(str::to_string),
+        });
+    }
+
+    fn drain_events(&mut self) -> Vec<MpvEvent> {
+        self.events.drain(..).collect()
+    }
+}
