+/// External playback lifecycle. Explicit and small. Every transition comes from
+/// an mpv event, an mpv property, or a process exit - never from log text.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ExternalState {
+    Stopped,
+    StartingPlayer,
+    LoadingMedia,
+    Playing,
+    Paused,
+    Seeking,
+    Stopping,
+    Recovering,
+    TerminalError,
+    PlayerProcessDead,
+}
+
+impl ExternalState {
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::Stopped => "stopped",
+            Self::StartingPlayer => "starting-player",
+            Self::LoadingMedia => "loading-media",
+            Self::Playing => "playing",
+            Self::Paused => "paused",
+            Self::Seeking => "seeking",
+            Self::Stopping => "stopping",
+            Self::Recovering => "recovering",
+            Self::TerminalError => "terminal-error",
+            Self::PlayerProcessDead => "player-process-dead",
+        }
+    }
+}
+
+/// Failure classification. The accepted product rule is preserved verbatim:
+/// renderer/process/control failures are NOT network/media stalls, and a
+/// normal user action or EOF never enters recovery.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum FailureClass {
+    /// mpv process and IPC healthy, media really entered loading/playback, then
+    /// forward playback stopped unexpectedly.
+    MediaStall,
+    /// yt-dlp / new media resolution failed. Owned by the page, not the worker.
+    Resolver,
+    /// mpv exited, crashed, the socket vanished, or startup failed.
+    PlayerProcess,
+    /// mpv core exists but no usable native video output was established.
+    WindowVo,
+    /// A normal user action or EOF.
+    Normal,
+}
+
+impl FailureClass {
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::MediaStall => "media-stall",
+            Self::Resolver => "resolver",
+            Self::PlayerProcess => "player-process",
+            Self::WindowVo => "window-vo",
+            Self::Normal => "normal",
+        }
+    }
+}
