+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn redacts_media_urls() {
+        // Deliberately a reserved, non-routable host: this test asserts that
+        // nothing resembling a media URL can reach a log, so it must not itself
+        // contain a realistic one.
+        let line = "opening https://media.invalid/videoplayback?token=REDACTME&x=1";
+        let redacted = redact_urls(line);
+        assert!(!redacted.contains("media.invalid"));
+        assert!(!redacted.contains("REDACTME"));
+        assert!(redacted.contains("<url>"));
+    }
+
+    #[test]
+    fn session_socket_is_pid_bound() {
+        let path = session_socket_path();
+        let name = path.file_name().unwrap().to_str().unwrap();
+        assert!(name.contains(&std::process::id().to_string()));
+        assert!(name.ends_with(".ipc"));
+    }
+
+    #[test]
+    fn failure_classes_stay_distinct() {
+        assert_ne!(FailureClass::PlayerProcess, FailureClass::MediaStall);
+        assert_ne!(FailureClass::WindowVo, FailureClass::MediaStall);
+        assert_ne!(FailureClass::Resolver, FailureClass::MediaStall);
+        assert_ne!(FailureClass::Normal, FailureClass::MediaStall);
+    }
+
+    #[test]
+    fn media_stall_is_not_a_normal_transition() {
+        assert!(!matches!(
+            FailureClass::Normal,
+            FailureClass::MediaStall | FailureClass::PlayerProcess
+        ));
+    }
+}
