@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * sst_clv_mfld_ipc.h - validation rules for Cloverview/MFLD IPC replies.
+ *
+ * Kept free of kernel includes so a host-side synthetic message test can
+ * exercise the same predicates; the driver couples the constants to the real
+ * structures with BUILD_BUG_ON().
+ */
+#ifndef __SST_CLV_MFLD_IPC_H__
+#define __SST_CLV_MFLD_IPC_H__
+
+#define SST_CLV_MAILBOX_SIZE		1024u
+#define SST_CLV_FW_INIT_PAYLOAD_SIZE	40u
+
+static inline int sst_clv_fw_init_reply_valid(int large, const void *payload,
+					      unsigned int size)
+{
+	if (!large || !payload)
+		return 0;
+	if (size < SST_CLV_FW_INIT_PAYLOAD_SIZE || size > SST_CLV_MAILBOX_SIZE)
+		return 0;
+	return 1;
+}
+
+static inline int sst_clv_large_reply_valid(int large, const void *payload,
+					    unsigned int size)
+{
+	if (!large || !payload)
+		return 0;
+	if (size < 1 || size > SST_CLV_MAILBOX_SIZE)
+		return 0;
+	return 1;
+}
+
+#endif /* __SST_CLV_MFLD_IPC_H__ */
