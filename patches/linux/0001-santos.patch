+#ifdef CONFIG_X86_SANTOS10
+/*
+ * Diagnostic A60: dump faulting user bytes + user stack on any shown
+ * user trap. TWRP recovery dies every ~5 s in __android_log_assert
+ * (ud2) with the assert message lost (no logd); the stack words carry
+ * the assert arguments (cond/tag/file/fmt pointers) and return
+ * addresses, which name the exact asserting caller offline against the
+ * frozen ramdisk. probe_kernel_read is used: nothing here may fault.
+ */
+static void santos10_show_user_trap(struct pt_regs *regs)
+{
+	unsigned long stack[16];
+	u8 code[16];
+
+	if (!user_mode(regs))
+		return;
+	if (copy_from_user_nofault(stack, (void __user *)regs->sp,
+				   sizeof(stack))) {
+		pr_info("santos10: trap stack unreadable sp=%lx\n", regs->sp);
+	} else {
+		pr_info("santos10: trap stack sp=%lx: %08lx %08lx %08lx %08lx\n",
+			regs->sp, stack[0], stack[1], stack[2], stack[3]);
+		pr_info("santos10: trap stack sp+32: %08lx %08lx %08lx %08lx\n",
+			stack[4], stack[5], stack[6], stack[7]);
+		pr_info("santos10: trap stack sp+64: %08lx %08lx %08lx %08lx\n",
+			stack[8], stack[9], stack[10], stack[11]);
+		pr_info("santos10: trap stack sp+96: %08lx %08lx %08lx %08lx\n",
+			stack[12], stack[13], stack[14], stack[15]);
+	}
+	if (copy_from_user_nofault(code, (void __user *)regs->ip,
+				   sizeof(code))) {
+		pr_info("santos10: trap code unreadable ip=%lx\n", regs->ip);
+	} else {
+		pr_info("santos10: trap code ip=%lx: %16ph\n", regs->ip,
+			code);
+	}
+}
+#endif
