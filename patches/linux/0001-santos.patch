index bd3a6355559420b5dd18c11ae49efbbebd8355db..06da43786c2ca2e592e3a7d9c5f059d0febda70c 100644
--- a/drivers/usb/host/ehci-pci.c
+++ b/drivers/usb/host/ehci-pci.c
@@ -378,11 +378,45 @@ static const struct ehci_driver_overrides pci_overrides __initconst = {
 
 /*-------------------------------------------------------------------------*/
 
+#ifdef CONFIG_X86_SANTOS10
+/* Santos10 product policy (canonical since A53; proven as diagnostic A52):
+ * Cloverview SPH (8086:08f2) stays disabled on wifi-only P5210, matching
+ * vendor 3.4 (`sph_enabled() == false` → -ENODEV) and the golden dmesg
+ * ("USB SPH is disabled", probe fails -19). Generic 7.2 ehci-pci would run
+ * it to CMD_RUN and freeze the box (proven A39–A51), so it is rejected here
+ * before any MMIO/DMA/IRQ is touched.
+ * Deliberately no REFCKDIS/D1 here (vendor does both): zero-HW-touch reject
+ * is sufficient for boot (proven #56), and no battery/power regression has
+ * been measured that would justify the extra writes. Revisit only on
+ * measured need. P5200 (cellular, modem present) may need real SPH
+ * detection instead of this board policy — out of santos10wifi scope.
+ * 00:02.3/e006 takes vanilla's natural is_bypassed_id() path. */
+#define SANTOS10_SPH_DEVICE 0x08f2
+#endif
+
 static int ehci_pci_probe(struct pci_dev *pdev, const struct pci_device_id *id)
 {
+#ifdef CONFIG_X86_SANTOS10
+	int santos10_rc;
+
+	/* Diagnostic A49: name the exact wedging access in the async
+	 * EHCI probe (freezer in every run since A39). */
+	pr_info("santos10: ehci_pci_probe entry %s\n", pci_name(pdev));
+	if (pdev->device == SANTOS10_SPH_DEVICE) {
+		pr_info("santos10: ehci_pci_probe reject 8086:08f2 (Santos10 SPH disabled, policy -ENODEV)\n");
+		return -ENODEV;
+	}
+#endif
 	if (is_bypassed_id(pdev))
 		return -ENODEV;
+#ifdef CONFIG_X86_SANTOS10
+	santos10_rc = usb_hcd_pci_probe(pdev, &ehci_pci_hc_driver);
+	pr_info("santos10: ehci_pci_probe exit %s rc=%d\n",
+		pci_name(pdev), santos10_rc);
+	return santos10_rc;
+#else
 	return usb_hcd_pci_probe(pdev, &ehci_pci_hc_driver);
+#endif
 }
 
 static void ehci_pci_remove(struct pci_dev *pdev)
