+static void max77693_charger_cable_work(struct work_struct *work)
+{
+	struct max77693_charger *chg =
+		container_of(work, struct max77693_charger, cable_work);
+	struct extcon_dev *edev = chg->edev;
+	unsigned int input_curr;
+	unsigned int fast_curr;
+	unsigned int top_off_curr;
+	const char *policy = "disconnected";
+	int ret;
+
+	if (!edev)
+		return;
+
+	if (extcon_get_state(edev, EXTCON_CHG_USB_DCP) > 0 ||
+	    extcon_get_state(edev, EXTCON_CHG_USB_FAST) > 0) {
+		/* Santos golden MAINS (AC adapter / fast charge) */
+		policy = "mains";
+		input_curr = 2000000;
+		fast_curr = 2100000;
+		top_off_curr = 300000;
+	} else if (extcon_get_state(edev, EXTCON_CHG_USB_CDP) > 0) {
+		/* Santos golden CDP (Charging Downstream Port) */
+		policy = "cdp";
+		input_curr = 1460000;
+		fast_curr = 1460000;
+		top_off_curr = 300000;
+	} else if (extcon_get_state(edev, EXTCON_CHG_USB_SDP) > 0 ||
+		   extcon_get_state(edev, EXTCON_CHG_USB_SLOW) > 0 ||
+		   extcon_get_state(edev, EXTCON_USB) > 0) {
+		/* Santos golden USB baseline */
+		policy = "usb";
+		input_curr = 460000;
+		fast_curr = 460000;
+		top_off_curr = 300000;
+	} else {
+		/* Santos golden disconnected / battery baseline */
+		input_curr = 460000;
+		fast_curr = 0;
+		top_off_curr = 100000;
+	}
+
+	/*
+	 * Fail closed while changing policy: stop battery charging first, then
+	 * set the input and top-off limits, and only finally enable the target
+	 * fast-charge current.  A failed write leaves the fast-charge current at
+	 * zero whenever the first write succeeded, and never advertises a
+	 * partially applied policy to power_supply users.
+	 */
+	ret = max77693_set_charger_state(chg, false);
