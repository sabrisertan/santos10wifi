diff --git a/sound/soc/intel/atom/sst/sst_clv_mfld.c b/sound/soc/intel/atom/sst/sst_clv_mfld.c
new file mode 100644
index 0000000000000000000000000000000000000000..6f1795ccc2545b47dbe70ac7255bdb388c005f0a
--- /dev/null
+++ b/sound/soc/intel/atom/sst/sst_clv_mfld.c
@@ -0,0 +1,952 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * sst_clv_mfld.c - Cloverview (8086:08e7) MFLD/32-bit LPE path.
+ *
+ * The 7.2 atom SST core only carries the MRFLD/TNG path (64-bit shim,
+ * MRFLD IPC framing, DCCM download). Cloverview is the original MFLD LPE
+ * design: 32-bit shim and IPC header, "$SST" raw firmware, DSP reset/start
+ * through CSR. This is ported from the authoritative Samsung 3.4
+ * sound/soc/mid-x86/sst sources, adapted to the 7.2 driver structures.
+ */
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/types.h>
+#include <linux/platform_data/x86/intel_scu_ipc.h>
+
+#include <asm/platform_sst_audio.h>
+
+#include "../sst-mfld-platform.h"
+#include "sst.h"
+#include "sst_clv_mfld_ipc.h"
+
+/* 3.4 MFLD shim registers not present in 7.2 sst.h */
+#define SST_PISR		0x08
+#define SST_PIMR		0x10
+#define SST_ISRD		0x20
+#define SST_IMRD		0x30
+
+#define SST_CONFIG_SSP_SIGN	0x7ffe8001
+
+/*
+ * Bring-up option: 7.2 normally boots the DSP lazily on the first PCM open.
+ * CLV has no card yet and the firmware only appears once the rootfs is up,
+ * so the async firmware callback boots the DSP directly. Set to 0 to keep
+ * the golden lazy behaviour.
+ */
+static bool sst_clv_boot = true;
+module_param(sst_clv_boot, bool, 0644);
+MODULE_PARM_DESC(sst_clv_boot, "Boot the CLV DSP when firmware is cached");
+
+/*
+ * Test-only fault injection: force DROP (bit 0) and/or FREE (bit 1) sync
+ * replies to time out so each quarantine path can be exercised on hardware
+ * without a wedged DSP.
+ */
+#define SST_CLV_FAIL_DROP	BIT(0)
+#define SST_CLV_FAIL_FREE	BIT(1)
+
+static unsigned int sst_clv_fail_sync;
+module_param(sst_clv_fail_sync, uint, 0644);
+MODULE_PARM_DESC(sst_clv_fail_sync,
+		 "Test only: fail DROP (1) and/or FREE (2) sync messages");
+
+void sst_clv_fw_loaded(struct intel_sst_drv *ctx)
+{
+	if (!sst_clv_boot || ctx->dev_id != SST_CLV_PCI_ID)
+		return;
+
+	/* Same ensure-fw-running semantics as the PCM-open path. */
+	if (sst_load_fw(ctx))
+		dev_err(ctx->dev, "CLV firmware boot failed\n");
+}
+
+/* 3.4 intel_sst_reset_dsp_mfld() */
+int intel_sst_reset_dsp_mfld(struct intel_sst_drv *ctx)
+{
+	u32 csr;
+
+	csr = sst_shim_read(ctx->shim, SST_CSR);
+	csr |= 0x382;
+	csr |= BIT(10);	/* run_stall */
+	sst_shim_write(ctx->shim, SST_CSR, csr);
+	return 0;
+}
+
+/* 3.4 sst_start_mfld() */
+int sst_start_mfld(struct intel_sst_drv *ctx)
+{
+	u32 csr;
+
+	csr = sst_shim_read(ctx->shim, SST_CSR);
+	csr &= ~(0x7 << 7);	/* bypass = 0 */
+	sst_shim_write(ctx->shim, SST_CSR, csr);
+
+	csr = sst_shim_read(ctx->shim, SST_CSR);
+	csr |= BIT(0);		/* mfld_strb = 1 */
+	sst_shim_write(ctx->shim, SST_CSR, csr);
+
+	csr = sst_shim_read(ctx->shim, SST_CSR);
+	csr &= ~BIT(10);	/* run_stall = 0 */
+	csr &= ~BIT(1);		/* sst_reset = 0 */
+	sst_shim_write(ctx->shim, SST_CSR, csr);
+	return 0;
+}
+
+/* 3.4 intel_sst_clear_intr_mfld() */
+void intel_sst_clear_intr_mfld(struct intel_sst_drv *ctx)
+{
+	u32 isr, imr, ipc;
+	unsigned long flags;
+
+	spin_lock_irqsave(&ctx->ipc_spin_lock, flags);
+	imr = sst_shim_read(ctx->shim, SST_IMRX);
+	isr = sst_shim_read(ctx->shim, SST_ISRX);
+	isr |= BIT(1);		/* write 1 to clear busy */
+	sst_shim_write(ctx->shim, SST_ISRX, isr);
+
+	ipc = sst_shim_read(ctx->shim, ctx->ipc_reg.ipcd);
+	ipc &= ~BIT(31);	/* busy = 0 */
+	ipc |= BIT(30);		/* done = 1 */
+	ipc &= ~(0x3FFF << 14);	/* data = IPC_ACK_SUCCESS (0) */
+	sst_shim_write(ctx->shim, ctx->ipc_reg.ipcd, ipc);
+
+	imr &= ~BIT(1);		/* unmask busy interrupt */
+	sst_shim_write(ctx->shim, SST_IMRX, imr);
+	spin_unlock_irqrestore(&ctx->ipc_spin_lock, flags);
+}
+
+static irqreturn_t intel_sst_interrupt_mfld(int irq, void *context)
+{
+	struct intel_sst_drv *drv = context;
+	struct ipc_post *msg = NULL;
+	u32 isr, imr, header, size;
+
+	isr = sst_shim_read(drv->shim, SST_ISRX);
+	if (!isr)
+		return IRQ_NONE;
+
+	if (isr & BIT(0)) {
+		u32 ipcx;
+
+		/* clear IA done: IPCX.done = 0, write 1 to ISRX.done */
+		spin_lock(&drv->ipc_spin_lock);
+		ipcx = sst_shim_read(drv->shim, drv->ipc_reg.ipcx);
+		ipcx &= ~BIT(30);
+		sst_shim_write(drv->shim, drv->ipc_reg.ipcx, ipcx);
+		isr = sst_shim_read(drv->shim, SST_ISRX);
+		isr |= BIT(0);
+		sst_shim_write(drv->shim, SST_ISRX, isr);
+		spin_unlock(&drv->ipc_spin_lock);
+
+		queue_work(drv->post_msg_wq, &drv->ipc_post_msg_wq);
+	}
+
+	if (!(isr & BIT(1)))
+		return IRQ_HANDLED;
+
+	/* mask busy until the threaded handler has consumed the message */
+	spin_lock(&drv->ipc_spin_lock);
+	imr = sst_shim_read(drv->shim, SST_IMRX);
+	imr |= BIT(1);
+	sst_shim_write(drv->shim, SST_IMRX, imr);
+	spin_unlock(&drv->ipc_spin_lock);
+
+	header = sst_shim_read(drv->shim, drv->ipc_reg.ipcd);
+
+	/* MFLD async period elapsed: handle inline like 3.4 */
+	if ((header & 0xFF) == IPC_SST_PERIOD_ELAPSED) {
+		unsigned int str_id = (header >> 8) & 0x1F;
+
+		if (str_id > 0 && str_id <= drv->info.max_streams) {
+			struct stream_info *stream = &drv->streams[str_id];
+			void (*cb)(void *) = READ_ONCE(stream->period_elapsed);
+			void *arg = READ_ONCE(stream->pcm_substream);
+
+			/* Only a running stream owns the callback; after a failed
+			 * DROP/FREE the DSP may keep raising this interrupt. */
+			if (READ_ONCE(stream->status) == STREAM_RUNNING && cb)
+				cb(arg);
+		}
+		drv->ops->clear_interrupt(drv);
+		return IRQ_HANDLED;
+	}
+
+	if (sst_create_ipc_msg(&msg, !!(header & BIT(13)))) {
+		drv->ops->clear_interrupt(drv);
+		return IRQ_HANDLED;
+	}
+
+	msg->header.full = header;
+
+	if (header & BIT(13)) {
+		size = msg->header.part.data;
+		if (size <= SST_MAILBOX_SIZE) {
+			/* MFLD receive payload starts after the 4-byte status */
+			memcpy_fromio(msg->mailbox_data,
+				      drv->mailbox + drv->mailbox_recv_offset + 4,
+				      size);
+		} else {
+			dev_err(drv->dev,
+				"Mailbox not copied, payload size is: %u\n",
+				size);
+			msg->malformed = true;
+		}
+	}
+
+	msg->is_process_reply = false;
+	spin_lock(&drv->rx_msg_lock);
+	list_add_tail(&msg->node, &drv->rx_list);
+	spin_unlock(&drv->rx_msg_lock);
+
+	drv->ops->clear_interrupt(drv);
+	return IRQ_WAKE_THREAD;
+}
+
+static irqreturn_t intel_sst_irq_thread_mfld(int irq, void *context)
+{
+	struct intel_sst_drv *drv = context;
+	struct ipc_post *__msg, *msg;
+	unsigned long irq_flags;
+
+	spin_lock_irqsave(&drv->rx_msg_lock, irq_flags);
+	list_for_each_entry_safe(msg, __msg, &drv->rx_list, node) {
+		list_del(&msg->node);
+		spin_unlock_irqrestore(&drv->rx_msg_lock, irq_flags);
+
+		drv->ops->process_reply(drv, msg);
+
+		if (msg->is_large)
+			kfree(msg->mailbox_data);
+		kfree(msg);
+
+		spin_lock_irqsave(&drv->rx_msg_lock, irq_flags);
+	}
+	spin_unlock_irqrestore(&drv->rx_msg_lock, irq_flags);
+	return IRQ_HANDLED;
+}
+
+int sst_post_message_mfld(struct intel_sst_drv *ctx,
+			  struct ipc_post *ipc_msg, bool sync)
+{
+	struct ipc_post *msg = ipc_msg;
+	union ipc_header header;
+	unsigned long irq_flags;
+	int ret = 0;
+
+	spin_lock_irqsave(&ctx->ipc_spin_lock, irq_flags);
+	header.full = sst_shim_read(ctx->shim, ctx->ipc_reg.ipcx);
+	if (sync) {
+		unsigned int loop_count = 0;
+
+		while (header.part.busy) {
+			if (loop_count++ > 25) {
+				dev_err(ctx->dev,
+					"Busy wait failed, can't send this msg\n");
+				ret = -EBUSY;
+				goto out;
+			}
+			cpu_relax();
+			header.full = sst_shim_read(ctx->shim,
+						    ctx->ipc_reg.ipcx);
+		}
+	} else {
+		if (list_empty(&ctx->ipc_dispatch_list)) {
+			spin_unlock_irqrestore(&ctx->ipc_spin_lock, irq_flags);
+			return 0;
+		}
+		if (header.part.busy) {
+			spin_unlock_irqrestore(&ctx->ipc_spin_lock, irq_flags);
+			return 0;
+		}
+		msg = list_first_entry(&ctx->ipc_dispatch_list,
+				       struct ipc_post, node);
+		list_del(&msg->node);
+	}
+
+	if (msg->header.part.large)
+		memcpy_toio(ctx->mailbox + SST_MAILBOX_SEND,
+			    msg->mailbox_data, msg->header.part.data);
+	sst_shim_write(ctx->shim, ctx->ipc_reg.ipcx, msg->header.full);
+out:
+	spin_unlock_irqrestore(&ctx->ipc_spin_lock, irq_flags);
+	kfree(msg->mailbox_data);
+	kfree(msg);
+	return ret;
+}
+
+/* 3.4 process_fw_init() for the MFLD/CLV bare payload */
+static void sst_process_fw_init_mfld(struct intel_sst_drv *ctx, void *msg)
+{
+	struct ipc_header_fw_init *init = msg;
+	int retval = 0;
+	int i;
+
+	if (init->result) {
+		sst_set_fw_state_locked(ctx, SST_RESET);
+		dev_err(ctx->dev, "FW Init failed, Error %x\n", init->result);
+		retval = init->result;
+		goto out;
+	}
+
+	dev_info(ctx->dev,
+		 "FW Version %02x.%02x.%02x.%02x build %.*s %.*s\n",
+		 init->fw_version.type, init->fw_version.major,
+		 init->fw_version.minor, init->fw_version.build,
+		 16, init->build_info.date, 16, init->build_info.time);
+
+	ctx->fw_version.type = init->fw_version.type;
+	ctx->fw_version.major = init->fw_version.major;
+	ctx->fw_version.minor = init->fw_version.minor;
+	ctx->fw_version.build = init->fw_version.build;
+
+	/* A fresh firmware load wipes all DSP-side stream state. */
+	for (i = 1; i <= ctx->info.max_streams; i++) {
+		struct stream_info *stream = &ctx->streams[i];
+
+		if (stream->quarantined)
+			dev_info(ctx->dev, "stream %d quarantine cleared\n", i);
+		stream->quarantined = false;
+		stream->status = STREAM_UN_INIT;
+		stream->prev = STREAM_UN_INIT;
+	}
+out:
+	sst_wake_up_block(ctx, retval, FW_DWNL_ID, 0, NULL, 0);
+}
+
+void sst_process_reply_mfld(struct intel_sst_drv *ctx, struct ipc_post *msg)
+{
+	u32 msg_id = msg->header.part.msg_id;
+	void *data = NULL;
+	u32 size = 0;
+	u32 result = 0;
+
+	BUILD_BUG_ON(sizeof(struct ipc_header_fw_init) !=
+		     SST_CLV_FW_INIT_PAYLOAD_SIZE);
+	BUILD_BUG_ON(SST_MAILBOX_SIZE != SST_CLV_MAILBOX_SIZE);
+
+	if (msg->malformed) {
+		dev_err_ratelimited(ctx->dev,
+				    "malformed MFLD reply id=%#x str=%u\n",
+				    msg_id, msg->header.part.str_id);
+		if (msg_id == IPC_IA_FW_INIT_CMPLT) {
+			sst_set_fw_state_locked(ctx, SST_RESET);
+			sst_wake_up_block(ctx, EIO, FW_DWNL_ID, 0, NULL, 0);
+		} else if (!(msg_id & PROCESS_MSG)) {
+			sst_wake_up_block(ctx, EIO, msg->header.part.str_id,
+					  msg_id, NULL, 0);
+		}
+		return;
+	}
+
+	if (msg_id & PROCESS_MSG) {
+		switch (msg_id) {
+		case IPC_IA_FW_INIT_CMPLT:
+			if (!sst_clv_fw_init_reply_valid(
+				    msg->header.part.large, msg->mailbox_data,
+				    msg->header.part.data)) {
+				dev_err(ctx->dev,
+					"malformed FW init reply large=%u size=%u\n",
+					msg->header.part.large,
+					msg->header.part.data);
+				sst_set_fw_state_locked(ctx, SST_RESET);
+				sst_wake_up_block(ctx, EIO, FW_DWNL_ID, 0,
+						  NULL, 0);
+				break;
+			}
+			sst_process_fw_init_mfld(ctx, msg->mailbox_data);
+			break;
+		default:
+			dev_dbg(ctx->dev, "unhandled MFLD msg %#x\n", msg_id);
+			break;
+		}
+		return;
+	}
+
+	if (msg->header.part.large) {
+		/* 3.4: large reply carries data with result 0 */
+		if (!sst_clv_large_reply_valid(msg->header.part.large,
+					       msg->mailbox_data,
+					       msg->header.part.data)) {
+			dev_err_ratelimited(ctx->dev,
+					    "malformed large reply id=%#x str=%u size=%u\n",
+					    msg_id, msg->header.part.str_id,
+					    msg->header.part.data);
+			sst_wake_up_block(ctx, EIO, msg->header.part.str_id,
+					  msg_id, NULL, 0);
+			return;
+		}
+		size = msg->header.part.data;
+		data = kmemdup(msg->mailbox_data, size, GFP_ATOMIC);
+		if (!data)
+			return;
+		result = 0;
+	} else {
+		/* short reply: header data field is the result code */
+		result = msg->header.part.data;
+	}
+
+	dev_dbg(ctx->dev, "MFLD reply id=%#x str=%u large=%u size=%u res=%u\n",
+		 msg_id, msg->header.part.str_id, msg->header.part.large,
+		 size, result);
+
+	if (sst_wake_up_block(ctx, result, msg->header.part.str_id, msg_id,
+			      data, size))
+		kfree(data);
+}
+
+/*
+ * 3.4 sst_fill_config() for CLV: 112 bytes at DRAM base carrying the CTP SSP
+ * configuration plus the live shim/mailbox physical addresses. The DSP needs
+ * this before start; without it the core runs but stays silent.
+ */
+void sst_post_download_clv(struct intel_sst_drv *ctx)
+{
+	static const u8 ssp_cfg[104] = {
+		[0] = 0x01, [1] = 0x80, [2] = 0xfe, [3] = 0x7f,
+		[4] = 0x01, [5] = 0x00, [6] = 0x00, [7] = 0x01,
+		[8] = 0x02, [9] = 0x20, [10] = 0x03, [11] = 0x03,
+		[12] = 0x03, [13] = 0x00, [14] = 0x00, [15] = 0x20,
+		[16] = 0x03, [17] = 0x02, [18] = 0xff, [19] = 0xff,
+		[20] = 0x00, [21] = 0x00, [22] = 0xa2, [23] = 0xff,
+		[84] = 0x04, [85] = 0x02, [86] = 0x01, [87] = 0x02,
+		[88] = 0x00, [89] = 0xf8, [90] = 0x24, [91] = 0x01,
+		[92] = 0x00, [93] = 0x00, [94] = 0xfc, [95] = 0xff,
+	};
+	u32 v;
+
+	memcpy_toio(ctx->dram, ssp_cfg, sizeof(ssp_cfg));
+	v = ctx->shim_phy_add;
+	memcpy_toio(ctx->dram + 104, &v, sizeof(v));
+	v = ctx->mailbox_add;
+	memcpy_toio(ctx->dram + 108, &v, sizeof(v));
+	dev_dbg(ctx->dev, "CLV ssp config written (shim %#x mailbox %#x)\n",
+		 ctx->shim_phy_add, ctx->mailbox_add);
+}
+
+/*
+ * MFLD stream commands, ported from 3.4 intel_sst_stream.c.
+ * str_id == device_type for CLV (SST_PCM_OUT0=1, ...).
+ */
+static void sst_fill_header_mfld32(union ipc_header *header, int msg,
+				   int large, int str_id)
+{
+	header->full = 0;
+	header->part.msg_id = msg;
+	header->part.str_id = str_id;
+	header->part.large = large;
+	header->part.done = 0;
+	header->part.busy = 1;
+	header->part.data = 0;
+}
+
+/* 3.4 sst_alloc_stream_mfld: payload = str_type + stream_params */
+/* 3.4 MFLD PCM params (include/sound/intel_sst_ioctl.h snd_pcm_params_mfld) */
+struct sst_pcm_params_mfld {
+	u16 codec;
+	u8 num_chan;
+	u8 pcm_wd_sz;
+	u32 reserved;
+	u32 sfreq;
+	u32 ring_buffer_size;
+	u32 period_count;
+	u32 ring_buffer_addr;
+} __packed;
+
+/* 3.4 snd_ppp_params minus the trailing params pointer */
+struct sst_ppp_params_mfld {
+	u8 algo_id;
+	u8 str_id;
+	u8 enable;
+	u8 reserved;
+	u32 size;
+} __packed;
+
+/* 3.4 sst_platform.h / intel_sst_ioctl.h */
+#define SST_CODEC_MIXER			0x65
+#define SST_ALGO_PARAM_MIXER_STREAM_CFG	0x801
+#define SST_STREAM_DEVICE_IHF		33
+#define SST_INPUT_STREAM_PCM		0x6
+#define SST_INPUT_STREAM_MIXED		0xE
+
+/*
+ * 3.4 sst_send_lpe_mixer_algo_params(): required by the CLV firmware before
+ * the first stream allocation (device_input_mixer = IHF | Mixed for CLV,
+ * matching the golden 'LPE IHF mixer' = 3 userspace preset).
+ */
+static int sst_clv_send_mixer_params(struct intel_sst_drv *ctx)
+{
+	struct snd_ppp_mixer_params mixer = {0};
+	struct sst_ppp_params_mfld algo = {0};
+	struct ipc_post *msg = NULL;
+	u32 device_input = SST_STREAM_DEVICE_IHF | SST_INPUT_STREAM_MIXED;
+	u32 input_mixer, stream_device_id;
+
+	input_mixer = device_input & SST_INPUT_STREAM_MIXED;
+	stream_device_id = device_input - input_mixer;
+
+	algo.algo_id = SST_CODEC_MIXER;
+	algo.str_id = stream_device_id;
+	algo.enable = 1;
+	algo.reserved = 0;
+	algo.size = 12;	/* 3.4 sizeof(struct snd_ppp_params) */
+
+	mixer.type = SST_ALGO_PARAM_MIXER_STREAM_CFG;
+	mixer.size = sizeof(input_mixer);
+	mixer.input_stream_bitmap = input_mixer;
+
+	if (sst_create_ipc_msg(&msg, true))
+		return -ENOMEM;
+
+	sst_fill_header_mfld32(&msg->header, IPC_IA_ALG_PARAMS, 1,
+			       stream_device_id);
+	msg->header.part.data = sizeof(u32) + sizeof(algo) + sizeof(mixer);
+	memcpy(msg->mailbox_data, &msg->header, sizeof(u32));
+	memcpy(msg->mailbox_data + sizeof(u32), &algo, sizeof(algo));
+	memcpy(msg->mailbox_data + sizeof(u32) + sizeof(algo), &mixer,
+	       sizeof(mixer));
+
+	dev_dbg(ctx->dev, "MFLD mixer algo: id=%u str=%u type=%#x bm=%#x\n",
+		 algo.algo_id, algo.str_id, mixer.type,
+		 mixer.input_stream_bitmap);
+
+	return sst_post_message_mfld(ctx, msg, true);
+}
+
+/*
+ * CLV uses the 3.4 CTP alloc path (sst_alloc_stream_ctp), NOT the MFLD one:
+ * payload = snd_sst_alloc_params {str_type, stream_params, alloc_params},
+ * fixed PCM slot 0x03, str_id = str_params->stream_id.
+ */
+int sst_alloc_stream_mfld(struct intel_sst_drv *ctx, void *params)
+{
+	struct snd_sst_params *str_params = params;
+	struct snd_sst_alloc_params alloc = {0};
+	struct stream_info *str_info;
+	struct sst_block *block;
+	struct ipc_post *msg = NULL;
+	int str_id, ret;
+
+	if (!str_params)
+		return -EINVAL;
+
+	str_id = str_params->stream_id;
+	if (str_id <= 0 || str_id > ctx->info.max_streams)
+		return -EBUSY;
+
+	str_info = get_stream_info(ctx, str_id);
+	if (!str_info)
+		return -EINVAL;
+	if (str_info->quarantined) {
+		dev_err(ctx->dev, "stream %d is quarantined\n", str_id);
+		return -EBUSY;
+	}
+
+	/* 3.4 sst_get_stream_allocated(): CLV sends mixer algo params first */
+	sst_clv_send_mixer_params(ctx);
+
+	alloc.str_type.codec_type = str_params->codec;
+	alloc.str_type.str_type = str_params->stream_type;
+	alloc.str_type.operation = str_params->ops;
+	alloc.str_type.protected_str = 0;
+	alloc.str_type.time_slots = 0x03;	/* CTP path */
+	alloc.str_type.reserved = 0;
+	alloc.str_type.result = 0;
+	memcpy(&alloc.stream_params, &str_params->sparams,
+	       sizeof(alloc.stream_params));
+	memcpy(&alloc.alloc_params, &str_params->aparams,
+	       sizeof(alloc.alloc_params));
+
+	if (sst_create_ipc_msg(&msg, true))
+		return -ENOMEM;
+
+	dev_dbg(ctx->dev,
+		 "CLV alloc pkt: id=%d codec=%u st=%u ops=%u slot=%#x ch=%u wd=%u sfreq=%u rb=%#x sz=%u frag=%u data=%u\n",
+		 str_id, alloc.str_type.codec_type, alloc.str_type.str_type,
+		 alloc.str_type.operation, alloc.str_type.time_slots,
+		 alloc.stream_params.uc.pcm_params.num_chan,
+		 alloc.stream_params.uc.pcm_params.pcm_wd_sz,
+		 alloc.stream_params.uc.pcm_params.sfreq,
+		 alloc.alloc_params.ring_buf_info[0].addr,
+		 alloc.alloc_params.ring_buf_info[0].size,
+		 alloc.alloc_params.frag_size,
+		 (u32)(sizeof(u32) + sizeof(alloc)));
+
+	sst_fill_header_mfld32(&msg->header, IPC_IA_ALLOC_STREAM, 1, str_id);
+	msg->header.part.data = sizeof(u32) + sizeof(alloc);
+	memcpy(msg->mailbox_data, &msg->header, sizeof(u32));
+	memcpy(msg->mailbox_data + sizeof(u32), &alloc, sizeof(alloc));
+
+	block = sst_create_block(ctx, IPC_IA_ALLOC_STREAM, str_id);
+	if (!block) {
+		kfree(msg->mailbox_data);
+		kfree(msg);
+		return -ENOMEM;
+	}
+
+	str_info->status = STREAM_INIT;
+	str_info->prev = STREAM_UN_INIT;
+	str_info->pipe_id = str_id;
+	str_info->task_id = str_params->task;
+	str_info->num_ch = sst_get_num_channel(str_params);
+
+	{
+		unsigned long flags;
+
+		spin_lock_irqsave(&ctx->ipc_spin_lock, flags);
+		list_add_tail(&msg->node, &ctx->ipc_dispatch_list);
+		spin_unlock_irqrestore(&ctx->ipc_spin_lock, flags);
+	}
+	queue_work(ctx->post_msg_wq, &ctx->ipc_post_msg_wq);
+
+	ret = sst_wait_timeout(ctx, block);
+	dev_dbg(ctx->dev,
+		 "MFLD alloc str %d: wait ret=%d data=%s ret_code=%d\n",
+		 str_id, ret, block->data ? "yes" : "no", block->ret_code);
+	if (block->data) {
+		struct snd_sst_alloc_response *resp = block->data;
+
+		dev_dbg(ctx->dev, "CLV alloc resp result=%u slot=%#x\n",
+			 resp->str_type.result, alloc.str_type.time_slots);
+		if (resp->str_type.result)
+			ret = -resp->str_type.result;
+	} else if (ret) {
+		str_info->status = STREAM_UN_INIT;
+		dev_err(ctx->dev,
+			 "MFLD alloc timeout: ISRX=%#x IMRX=%#x IPCX=%#x IPCD=%#x\n",
+			 sst_shim_read(ctx->shim, SST_ISRX),
+			 sst_shim_read(ctx->shim, SST_IMRX),
+			 sst_shim_read(ctx->shim, ctx->ipc_reg.ipcx),
+			 sst_shim_read(ctx->shim, ctx->ipc_reg.ipcd));
+	}
+	sst_free_block(ctx, block);
+
+	if (ret) {
+		str_info->status = STREAM_UN_INIT;
+		return ret < 0 ? ret : -EIO;
+	}
+
+	dev_dbg(ctx->dev, "CLV alloc str %d pipe %#x ch %u rb %#x/%u frag %u\n",
+		 str_id, str_info->pipe_id, str_info->num_ch,
+		 alloc.alloc_params.ring_buf_info[0].addr,
+		 alloc.alloc_params.ring_buf_info[0].size,
+		 alloc.alloc_params.frag_size);
+	return str_id;
+}
+
+/*
+ * A DROP/FREE that was not acknowledged leaves the DSP-side stream in an
+ * unknown state. Quarantine the id and stall the DSP before the ALSA core can
+ * reuse or free the ring buffer it may still be reading.
+ *
+ * This part must not sleep: the DROP path can run under the ALSA stream
+ * spinlock (snd_pcm_drop() -> trigger STOP while the stream is running,
+ * sound/core/pcm_native.c). The plain state store matches what
+ * sst_wait_timeout() already does on timeout.
+ */
+static void sst_clv_quarantine_stream(struct intel_sst_drv *ctx,
+				      struct stream_info *str_info)
+{
+	str_info->quarantined = true;
+	WRITE_ONCE(ctx->sst_state, SST_RESET);
+	if (ctx->ops->reset) {
+		int ret = ctx->ops->reset(ctx);
+
+		if (ret)
+			dev_err(ctx->dev, "DSP stop after stream failure: %d\n",
+				ret);
+	}
+}
+
+/*
+ * Sleepable drain for the same failure, mirroring intel_sst_runtime_suspend():
+ * move to RESET, wait for in-flight IRQs and queued post work, then re-assert
+ * the DSP stall. Called from the close/free path, where no ALSA stream lock
+ * is held.
+ */
+static void sst_clv_drain_dsp(struct intel_sst_drv *ctx)
+{
+	sst_set_fw_state_locked(ctx, SST_RESET);
+	synchronize_irq(ctx->irq_num);
+	flush_workqueue(ctx->post_msg_wq);
+	if (ctx->ops->reset) {
+		int ret = ctx->ops->reset(ctx);
+
+		if (ret)
+			dev_err(ctx->dev, "DSP stop after drain: %d\n", ret);
+	}
+}
+
+static int sst_send_sync_msg_mfld(struct intel_sst_drv *ctx, int ipc,
+				  int str_id)
+{
+	struct ipc_post *msg = NULL;
+	struct sst_block *block;
+	int ret;
+
+	if (((ipc == IPC_IA_DROP_STREAM) &&
+	     (sst_clv_fail_sync & SST_CLV_FAIL_DROP)) ||
+	    ((ipc == IPC_IA_FREE_STREAM) &&
+	     (sst_clv_fail_sync & SST_CLV_FAIL_FREE))) {
+		dev_err(ctx->dev, "test: forced timeout for ipc %#x str %d\n",
+			ipc, str_id);
+		return -ETIMEDOUT;
+	}
+
+	if (sst_create_block_and_ipc_msg(&msg, false, ctx, &block, ipc, str_id))
+		return -ENOMEM;
+
+	sst_fill_header_mfld32(&msg->header, ipc, 0, str_id);
+	ret = sst_post_message_mfld(ctx, msg, true);
+	if (!ret)
+		ret = sst_wait_timeout(ctx, block);
+	if (!ret && block->ret_code)
+		ret = block->ret_code < 0 ? block->ret_code : -EIO;
+	sst_free_block(ctx, block);
+	return ret;
+}
+
+/*
+ * Blocking DROP transaction for the atomic trigger path (L17). The ALSA
+ * trigger holds the PCM stream spinlock, so the trigger only queues this on
+ * the dedicated ordered workqueue; the fence (sst_clv_drop_wait) runs before
+ * the DMA buffer is released and waits for the DSP reply.
+ */
+void sst_clv_drop_work(struct work_struct *work)
+{
+	struct stream_info *str_info = container_of(work, struct stream_info,
+						    drop_work);
+	struct intel_sst_drv *ctx = str_info->drv;
+	int ret;
+
+	ret = sst_send_sync_msg_mfld(ctx, IPC_IA_DROP_STREAM,
+				     str_info->str_id);
+	if (ret) {
+		dev_err(ctx->dev, "DROP stream %d failed %d, stopping DSP\n",
+			str_info->str_id, ret);
+		sst_clv_quarantine_stream(ctx, str_info);
+	}
+	str_info->drop_result = ret;
+	atomic_set(&str_info->drop_pending, 0);
+	complete(&str_info->drop_done);
+}
+
+static void sst_clv_queue_drop(struct stream_info *str_info)
+{
+	reinit_completion(&str_info->drop_done);
+	str_info->drop_result = 0;
+	atomic_set(&str_info->drop_pending, 1);
+	queue_work(str_info->drv->ctl_wq, &str_info->drop_work);
+}
+
+/*
+ * Fence for the ALSA managed DMA buffer: wait for a queued DROP to finish
+ * before the buffer can be freed/reused. On failure or timeout the stream is
+ * quarantined and the DSP is stalled, so no DMA can target the freed ring.
+ */
+int sst_clv_drop_wait(struct intel_sst_drv *ctx, int str_id)
+{
+	struct stream_info *str_info = get_stream_info(ctx, str_id);
+
+	if (!str_info)
+		return -EINVAL;
+	if (!atomic_read(&str_info->drop_pending))
+		return str_info->drop_result;
+
+	if (!wait_for_completion_timeout(&str_info->drop_done,
+			msecs_to_jiffies(SST_BLOCK_TIMEOUT + 200))) {
+		dev_err(ctx->dev,
+			"DROP stream %d did not complete, quarantined\n",
+			str_id);
+		sst_clv_quarantine_stream(ctx, str_info);
+		return -ETIMEDOUT;
+	}
+	return str_info->drop_result;
+}
+
+static int sst_clv_post_short_mfld(struct intel_sst_drv *ctx, int ipc,
+				   int str_id)
+{
+	struct ipc_post *msg = NULL;
+
+	if (sst_create_ipc_msg(&msg, false))
+		return -ENOMEM;
+
+	sst_fill_header_mfld32(&msg->header, ipc, 0, str_id);
+	return sst_post_message_mfld(ctx, msg, true);
+}
+
+int sst_start_stream_mfld(struct intel_sst_drv *ctx, int str_id)
+{
+	struct stream_info *str_info = get_stream_info(ctx, str_id);
+	struct ipc_post *msg = NULL;
+
+	if (!str_info)
+		return -EINVAL;
+	if (str_info->status != STREAM_RUNNING)
+		return -EBADRQC;
+
+	if (sst_create_ipc_msg(&msg, true))
+		return -ENOMEM;
+
+	/* 3.4: large message, mailbox = header + u32 0 */
+	sst_fill_header_mfld32(&msg->header, IPC_IA_START_STREAM, 1, str_id);
+	msg->header.part.data = sizeof(u32) + sizeof(u32);
+	memcpy(msg->mailbox_data, &msg->header, sizeof(u32));
+	memset(msg->mailbox_data + sizeof(u32), 0, sizeof(u32));
+
+	return sst_post_message_mfld(ctx, msg, true);
+}
+
+int sst_drop_stream_mfld(struct intel_sst_drv *ctx, int str_id)
+{
+	struct stream_info *str_info = get_stream_info(ctx, str_id);
+	int ret;
+
+	if (!str_info)
+		return -EINVAL;
+	if (str_info->status == STREAM_UN_INIT)
+		return -EBADRQC;
+
+	str_info->prev = str_info->status;
+	str_info->status = STREAM_INIT;
+	str_info->cumm_bytes = 0;
+
+	/*
+	 * The ALSA trigger runs under the PCM stream spinlock: queue the
+	 * blocking DROP on the dedicated ordered workqueue instead of
+	 * sleeping here. The hw_free/FREE fence waits for completion before
+	 * the DMA ring is released.
+	 */
+	if (in_atomic() || irqs_disabled()) {
+		sst_clv_queue_drop(str_info);
+		return 0;
+	}
+
+	ret = sst_send_sync_msg_mfld(ctx, IPC_IA_DROP_STREAM, str_id);
+	if (ret) {
+		dev_err(ctx->dev, "DROP stream %d failed %d, stopping DSP\n",
+			str_id, ret);
+		sst_clv_quarantine_stream(ctx, str_info);
+	}
+	return ret;
+}
+
+int sst_pause_stream_mfld(struct intel_sst_drv *ctx, int str_id)
+{
+	struct stream_info *str_info = get_stream_info(ctx, str_id);
+	int ret;
+
+	if (!str_info)
+		return -EINVAL;
+	if (str_info->status == STREAM_PAUSED)
+		return 0;
+	if (str_info->status != STREAM_RUNNING &&
+	    str_info->status != STREAM_INIT)
+		return -EBADRQC;
+
+	/* Trigger context cannot wait for the DSP reply (L17). */
+	if (in_atomic() || irqs_disabled())
+		ret = sst_clv_post_short_mfld(ctx, IPC_IA_PAUSE_STREAM,
+					      str_id);
+	else
+		ret = sst_send_sync_msg_mfld(ctx, IPC_IA_PAUSE_STREAM, str_id);
+	if (!ret) {
+		str_info->prev = str_info->status;
+		str_info->status = STREAM_PAUSED;
+	}
+	return ret;
+}
+
+int sst_resume_stream_mfld(struct intel_sst_drv *ctx, int str_id)
+{
+	struct stream_info *str_info = get_stream_info(ctx, str_id);
+	int ret;
+
+	if (!str_info)
+		return -EINVAL;
+	if (str_info->status != STREAM_PAUSED)
+		return -EBADRQC;
+
+	/* Trigger context cannot wait for the DSP reply (L17). */
+	if (in_atomic() || irqs_disabled())
+		ret = sst_clv_post_short_mfld(ctx, IPC_IA_RESUME_STREAM,
+					      str_id);
+	else
+		ret = sst_send_sync_msg_mfld(ctx, IPC_IA_RESUME_STREAM,
+					     str_id);
+	if (!ret) {
+		str_info->status = str_info->prev;
+		str_info->prev = STREAM_PAUSED;
+	}
+	return ret;
+}
+
+int sst_free_stream_mfld(struct intel_sst_drv *ctx, int str_id)
+{
+	struct stream_info *str_info = get_stream_info(ctx, str_id);
+	int ret;
+
+	if (!str_info)
+		return -EINVAL;
+
+	mutex_lock(&str_info->lock);
+	if (str_info->status == STREAM_UN_INIT) {
+		mutex_unlock(&str_info->lock);
+		return -EBADRQC;
+	}
+	str_info->prev = str_info->status;
+	str_info->status = STREAM_UN_INIT;
+	mutex_unlock(&str_info->lock);
+
+	/*
+	 * Resolve a queued trigger-path DROP before tearing the stream down;
+	 * the DMA ring may already be gone, so the DSP must have stopped.
+	 */
+	ret = sst_clv_drop_wait(ctx, str_id);
+	if (ret)
+		dev_err(ctx->dev, "DROP wait before FREE failed %d\n", ret);
+
+	ret = sst_send_sync_msg_mfld(ctx, IPC_IA_FREE_STREAM, str_id);
+	if (ret) {
+		dev_err(ctx->dev, "FREE stream %d failed %d, quarantined\n",
+			str_id, ret);
+		sst_clv_quarantine_stream(ctx, str_info);
+		sst_clv_drain_dsp(ctx);
+	} else {
+		str_info->quarantined = false;
+		sst_clean_stream(str_info);
+	}
+	return ret;
+}
+
+/* OSC_CLK_AUDIO = 0, 19.2 MHz: SCU IPC 0xE6, {clk, 0x03} */
+void sst_clv_osc_clk_enable(struct intel_sst_drv *ctx)
+{
+	u8 wbuf[2] = { 0, 0x03 };
+	int ret;
+
+	ret = intel_scu_ipc_dev_command_with_size(NULL, 0xE6, 0, wbuf,
+						  sizeof(wbuf), sizeof(wbuf),
+						  NULL, 0);
+	if (ret)
+		dev_warn(ctx->dev, "OSC_CLK_AUDIO enable failed: %d\n", ret);
+	else
+		dev_dbg(ctx->dev, "OSC_CLK_AUDIO enabled (19.2 MHz)\n");
+}
+
+struct intel_sst_ops sst_mfld_ops = {
+	.interrupt = intel_sst_interrupt_mfld,
+	.irq_thread = intel_sst_irq_thread_mfld,
+	.clear_interrupt = intel_sst_clear_intr_mfld,
+	.start = sst_start_mfld,
+	.reset = intel_sst_reset_dsp_mfld,
+	.post_message = sst_post_message_mfld,
+	.process_reply = sst_process_reply_mfld,
+	.alloc_stream = sst_alloc_stream_mfld,
+	.post_download = sst_post_download_clv,
+};
