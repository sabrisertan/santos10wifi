+static int santos10_usb_phy_init(struct device *dev)
+{
+	int ret;
+
+	ret = devm_gpio_request_one(dev, SANTOS10_USB_PHY_CS_GPIO,
+				    GPIOF_OUT_INIT_HIGH, "usb_phy_cs");
+	if (ret) {
+		dev_err(dev, "santos10-usb: failed to request usb_phy_cs (gpio %d): %d\n",
+			SANTOS10_USB_PHY_CS_GPIO, ret);
+		return ret;
+	}
+
+	ret = devm_gpio_request_one(dev, SANTOS10_USB_PHY_RST_GPIO,
+				    GPIOF_OUT_INIT_LOW, "usb_phy_rst");
+	if (ret) {
+		dev_err(dev, "santos10-usb: failed to request usb_phy_rst (gpio %d): %d\n",
+			SANTOS10_USB_PHY_RST_GPIO, ret);
+		return ret;
+	}
+
+	usleep_range(200, 500);
+	gpio_set_value(SANTOS10_USB_PHY_RST_GPIO, 1);
+
+	dev_info(dev, "santos10-usb: TUSB1210 PHY powered (gpio %d) and reset released (gpio %d)\n",
+		 SANTOS10_USB_PHY_CS_GPIO, SANTOS10_USB_PHY_RST_GPIO);
+	return 0;
