diff --git a/arch/x86/platform/intel-mid/santos10-ashmem.c b/arch/x86/platform/intel-mid/santos10-ashmem.c
new file mode 100644
index 0000000000000000000000000000000000000000..10f9374758f61477ccdcd7e8f7b08dcd81ab1856
--- /dev/null
+++ b/arch/x86/platform/intel-mid/santos10-ashmem.c
@@ -0,0 +1,299 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Santos10 minimal ashmem-compatible driver (bring-up).
+ *
+ * Why: TWRP recovery's software renderer (GGL) creates its JIT code
+ * cache via ashmem_create_region(); without /dev/ashmem the region
+ * creation fails and the process dies in __android_log_assert (ud2,
+ * proven #64). Upstream 7.2 removed ashmem entirely (userspace moved
+ * to memfd, but the frozen TWRP binaries cannot), and backporting the
+ * full pinned/purged/shrinker implementation is unjustified for one
+ * JIT scratch area — so this implements exactly the ABI surface GGL
+ * exercises, backed by directly inserted pages:
+ *
+ *   open, SET_NAME/GET_NAME, SET_SIZE/GET_SIZE, SET/GET_PROT_MASK
+ *   (vintage set_prot_mask semantics: only narrowing; PROT_READ under
+ *   READ_IMPLIES_EXEC implies PROT_EXEC),
+ *   PIN/UNPIN (always NOT_PURGED; nothing here is ever purged),
+ *   mmap (vm_insert_page loop honouring the protection mask, vm_pgoff
+ *   and VM_MAY* limits; PROT_EXEC works, x86 needs no icache
+ *   maintenance), release (frees everything).
+ *
+ * Read-only userspace ABI compatibility is with bionic's
+ * <linux/ashmem.h> (magic 'A', numbers 1-8, ASHMEM_NAME_LEN 256,
+ * struct ashmem_pin { u32 offset, len }). No purge/shrinker support:
+ * PURGE ioctls return -EINVAL. Misc device => /dev/ashmem via devtmpfs,
+ * which our boot flow mounts (A56).
+ *
+ * SELinux note: PROT_EXEC mappings are subject to the platform execmem
+ * policy; any denial will show in audit and is the observable next step,
+ * not a silent failure.
+ */
+
+#define pr_fmt(fmt) "santos10-ashmem: " fmt
+
+#include <linux/file.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/miscdevice.h>
+#include <linux/mm.h>
+#include <linux/mman.h>
+#include <linux/mutex.h>
+#include <linux/personality.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+#define SANTOS10_ASHMEM_NAME		"ashmem"
+#define SANTOS10_ASHMEM_NAME_LEN	256
+/* NOTE: vintage ABI magic is 0x77 (__ASHMEMIOC in 3.4 ashmem.h), NOT 'A'.
+ * Verified against the frozen binaries: their ashmem_create_region uses
+ * SET_NAME=0x41007701 (_IOW(0x77,1,char[256])) and SET_SIZE=0x40047703
+ * (_IOW(0x77,3,size_t)). Using 'A' mismatches every ioctl (proven #67). */
+#define SANTOS10_ASHMEM_IOC_MAGIC	0x77
+
+#define SANTOS10_ASHMEM_SET_NAME \
+	_IOW(SANTOS10_ASHMEM_IOC_MAGIC, 1, char[SANTOS10_ASHMEM_NAME_LEN])
+#define SANTOS10_ASHMEM_GET_NAME \
+	_IOR(SANTOS10_ASHMEM_IOC_MAGIC, 2, char[SANTOS10_ASHMEM_NAME_LEN])
+#define SANTOS10_ASHMEM_SET_SIZE \
+	_IOW(SANTOS10_ASHMEM_IOC_MAGIC, 3, size_t)
+#define SANTOS10_ASHMEM_GET_SIZE \
+	_IO(SANTOS10_ASHMEM_IOC_MAGIC, 4)
+#define SANTOS10_ASHMEM_SET_PROT_MASK \
+	_IOW(SANTOS10_ASHMEM_IOC_MAGIC, 5, unsigned long)
+#define SANTOS10_ASHMEM_GET_PROT_MASK \
+	_IO(SANTOS10_ASHMEM_IOC_MAGIC, 6)
+#define SANTOS10_ASHMEM_PIN \
+	_IOW(SANTOS10_ASHMEM_IOC_MAGIC, 7, struct santos10_ashmem_pin)
+#define SANTOS10_ASHMEM_UNPIN \
+	_IOW(SANTOS10_ASHMEM_IOC_MAGIC, 8, struct santos10_ashmem_pin)
+
+#define SANTOS10_ASHMEM_NOT_PURGED	0
+
+struct santos10_ashmem_pin {
+	__u32 offset;
+	__u32 len;
+};
+
+struct santos10_ashmem_area {
+	struct mutex lock;
+	char name[SANTOS10_ASHMEM_NAME_LEN];
+	struct page **pages;
+	unsigned long npages;
+	size_t size;
+	unsigned long prot_mask;
+};
+
+static int santos10_ashmem_open(struct inode *inode, struct file *file)
+{
+	struct santos10_ashmem_area *asma;
+
+	asma = kzalloc(sizeof(*asma), GFP_KERNEL);
+	if (!asma)
+		return -ENOMEM;
+
+	mutex_init(&asma->lock);
+	asma->prot_mask = PROT_READ | PROT_WRITE | PROT_EXEC;
+	file->private_data = asma;
+	pr_info("ashmem open by %s[%d]\n", current->comm, task_pid_nr(current));
+	return nonseekable_open(inode, file);
+}
+
+static int santos10_ashmem_release(struct inode *inode, struct file *file)
+{
+	struct santos10_ashmem_area *asma = file->private_data;
+	unsigned long i;
+
+	if (asma->pages) {
+		for (i = 0; i < asma->npages; i++)
+			__free_page(asma->pages[i]);
+		kfree(asma->pages);
+	}
+	kfree(asma);
+	return 0;
+}
+
+static long santos10_ashmem_ioctl(struct file *file, unsigned int cmd,
+				  unsigned long arg)
+{
+	struct santos10_ashmem_area *asma = file->private_data;
+	size_t size;
+	unsigned long i;
+	long ret = 0;
+
+	mutex_lock(&asma->lock);
+	switch (cmd) {
+	case SANTOS10_ASHMEM_SET_NAME:
+		if (copy_from_user(asma->name, (void __user *)arg,
+				   SANTOS10_ASHMEM_NAME_LEN - 1))
+			ret = -EFAULT;
+		else
+			asma->name[SANTOS10_ASHMEM_NAME_LEN - 1] = '\0';
+		pr_info("ashmem ioctl SET_NAME='%s' rc=%ld (%s[%d])\n",
+			ret ? "<fault>" : asma->name, ret,
+			current->comm, task_pid_nr(current));
+		break;
+	case SANTOS10_ASHMEM_GET_NAME:
+		if (copy_to_user((void __user *)arg, asma->name,
+				 SANTOS10_ASHMEM_NAME_LEN))
+			ret = -EFAULT;
+		break;
+	case SANTOS10_ASHMEM_SET_SIZE:
+		/* Classic ashmem ABI (hostile review catch, verified): bionic
+		 * calls ioctl(fd, ASHMEM_SET_SIZE, size) BY VALUE, and the
+		 * original driver does asma->size = (size_t)arg — no
+		 * get_user/copy_from_user. Treating arg as a pointer faults
+		 * (e.g. 1 MiB size reads as address 0x100000 -> -EFAULT). */
+		size = (size_t)arg;
+		if (asma->pages) {
+			ret = -EINVAL;
+			break;
+		}
+		asma->npages = PAGE_ALIGN(size) >> PAGE_SHIFT;
+		if (!asma->npages) {
+			ret = -EINVAL;
+			break;
+		}
+		asma->pages = kcalloc(asma->npages, sizeof(*asma->pages),
+				      GFP_KERNEL);
+		if (!asma->pages) {
+			ret = -ENOMEM;
+			break;
+		}
+		for (i = 0; i < asma->npages; i++) {
+			asma->pages[i] = alloc_page(GFP_KERNEL | __GFP_ZERO);
+			if (!asma->pages[i]) {
+				while (i--)
+					__free_page(asma->pages[i]);
+				kfree(asma->pages);
+				asma->pages = NULL;
+				asma->npages = 0;
+				ret = -ENOMEM;
+				break;
+			}
+		}
+		if (!ret)
+			asma->size = size;
+		pr_info("ashmem ioctl SET_SIZE=%zu npages=%lu rc=%ld (%s[%d])\n",
+			size, asma->npages, ret,
+			current->comm, task_pid_nr(current));
+		break;
+	case SANTOS10_ASHMEM_GET_SIZE:
+		ret = asma->size;
+		break;
+	case SANTOS10_ASHMEM_SET_PROT_MASK:
+		/* Vintage set_prot_mask (3.4 ashmem.c): the user can only
+		 * remove, not add, protection bits. */
+		if ((asma->prot_mask & arg) != arg) {
+			ret = -EINVAL;
+			break;
+		}
+		/* Does the application expect PROT_READ to imply PROT_EXEC? */
+		if ((arg & PROT_READ) &&
+		    (current->personality & READ_IMPLIES_EXEC))
+			arg |= PROT_EXEC;
+		asma->prot_mask = arg;
+		break;
+	case SANTOS10_ASHMEM_GET_PROT_MASK:
+		ret = asma->prot_mask;
+		break;
+	case SANTOS10_ASHMEM_PIN:
+	case SANTOS10_ASHMEM_UNPIN:
+		/* Nothing is ever purged; pinning is a no-op success. */
+		ret = SANTOS10_ASHMEM_NOT_PURGED;
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+	mutex_unlock(&asma->lock);
+	pr_info("ashmem ioctl cmd=0x%x arg=0x%lx rc=%ld (%s[%d])\n",
+		cmd, arg, ret, current->comm, task_pid_nr(current));
+	return ret;
+}
+
+/* Mirror of the golden 3.4 driver's calc_vm_may_flags() (ashmem.c:280). */
+static inline unsigned long santos10_ashmem_may_flags(unsigned long prot)
+{
+	return _calc_vm_trans(prot, PROT_READ, VM_MAYREAD) |
+	       _calc_vm_trans(prot, PROT_WRITE, VM_MAYWRITE) |
+	       _calc_vm_trans(prot, PROT_EXEC, VM_MAYEXEC);
+}
+
+static int santos10_ashmem_mmap(struct file *file, struct vm_area_struct *vma)
+{
+	struct santos10_ashmem_area *asma = file->private_data;
+	unsigned long off;
+	unsigned long addr;
+	unsigned long i;
+	unsigned long nr_pages;
+	int ret = 0;
+
+	mutex_lock(&asma->lock);
+	if (!asma->pages || !asma->npages || !asma->size) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	/* Requested protection bits must match our allowed protection mask
+	 * (golden 3.4 ashmem.c:301). vm_flags also carries VM_MAY*, so the
+	 * check is narrowed down to the three access bits. */
+	if ((vma->vm_flags & ~calc_vm_prot_bits(asma->prot_mask, 0)) &
+	    calc_vm_prot_bits(PROT_READ | PROT_WRITE | PROT_EXEC, 0)) {
+		ret = -EPERM;
+		goto out;
+	}
+	/* A later mprotect() must not be able to add what the mask removes
+	 * (golden 3.4 ashmem.c:306). */
+	vm_flags_clear(vma, santos10_ashmem_may_flags(~asma->prot_mask));
+
+	off = vma->vm_pgoff;
+	nr_pages = (vma->vm_end - vma->vm_start) >> PAGE_SHIFT;
+	if (off > asma->npages || nr_pages > asma->npages - off) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	addr = vma->vm_start;
+	for (i = 0; i < nr_pages; i++, addr += PAGE_SIZE) {
+		ret = vm_insert_page(vma, addr, asma->pages[off + i]);
+		if (ret)
+			break;
+	}
+	pr_info("area '%s' mapped %lu pages at pgoff %lu rc=%d\n",
+		asma->name[0] ? asma->name : "<unnamed>", i, off, ret);
+out:
+	mutex_unlock(&asma->lock);
+	return ret;
+}
+
+static const struct file_operations santos10_ashmem_fops = {
+	.owner = THIS_MODULE,
+	.open = santos10_ashmem_open,
+	.release = santos10_ashmem_release,
+	.unlocked_ioctl = santos10_ashmem_ioctl,
+	.compat_ioctl = santos10_ashmem_ioctl,
+	.mmap = santos10_ashmem_mmap,
+};
+
+static struct miscdevice santos10_ashmem_misc = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = SANTOS10_ASHMEM_NAME,
+	.fops = &santos10_ashmem_fops,
+};
+
+static int __init santos10_ashmem_init(void)
+{
+	int ret;
+
+	ret = misc_register(&santos10_ashmem_misc);
+	if (ret) {
+		pr_err("misc_register failed: %d\n", ret);
+		return ret;
+	}
+
+	pr_info("/dev/%s compat ready\n", SANTOS10_ASHMEM_NAME);
+	return 0;
+}
+device_initcall(santos10_ashmem_init);
diff --git a/arch/x86/platform/intel-mid/santos10-audio-machine.c b/arch/x86/platform/intel-mid/santos10-audio-machine.c
new file mode 100644
index 0000000000000000000000000000000000000000..1eeadbea9786d0642ceacfd73cab3109689c34f2
--- /dev/null
+++ b/arch/x86/platform/intel-mid/santos10-audio-machine.c
@@ -0,0 +1,183 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * santos10-audio-machine.c - cloverview_audio card for Samsung Santos10.
+ *
+ * Golden 3.4 topology (ctp_common.c / ctp_rhb_wm1811.c): card
+ * "cloverview_audio", ASP link wm8994-aif1 <-> Headset-cpu-dai on the SST
+ * platform, WM1811 master in DSP_B mode, FLL1 fed from the 19.2 MHz MCLK1.
+ *
+ * This is only the machine glue; PCM/DMA is provided by sst-mfld-platform.
+ */
+#define pr_fmt(fmt) "santos10-audio: " fmt
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/platform_data/x86/intel_scu_ipc.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/soc-dai.h>
+
+/* 3.4 wm8994.h ids kept local to avoid the codec header coupling */
+#define SANTOS10_WM8994_FLL1		1
+#define SANTOS10_WM8994_FLL_SRC_MCLK1	1
+#define SANTOS10_WM8994_SYSCLK_FLL1	3
+
+/* CLV audio oscillator: OSC_CLK_AUDIO, 19.2 MHz (3.4 SCU osc clk) */
+#define SANTOS10_MCLK1			19200000
+
+/* 3.4 intel_sst.c: I2S0 CLK/FS/TXD/RXD are GPIO 4..7, ALT_1 */
+#define SANTOS10_I2S0_CLK_GPIO		4
+#define SANTOS10_I2S0_FS_GPIO		5
+#define SANTOS10_I2S0_TXD_GPIO		6
+#define SANTOS10_I2S0_RXD_GPIO		7
+#define SANTOS10_I2S0_ALT		1
+
+extern int santos10_lnw_gpio_set_alt(unsigned int gpio, unsigned int alt);
+
+/*
+ * 3.4 muxed these in the SST probe; without the mux the LPE SSP never
+ * sees BCLK/FRAME and the firmware stops after one period
+ * (tstamp.hardware_counter stays 0).
+ */
+static void santos10_i2s0_pinmux(void)
+{
+	static const unsigned int pins[] = {
+		SANTOS10_I2S0_CLK_GPIO, SANTOS10_I2S0_FS_GPIO,
+		SANTOS10_I2S0_TXD_GPIO, SANTOS10_I2S0_RXD_GPIO,
+	};
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(pins); i++) {
+		ret = santos10_lnw_gpio_set_alt(pins[i], SANTOS10_I2S0_ALT);
+		if (ret)
+			pr_warn("I2S0 gpio %u mux failed: %d\n", pins[i], ret);
+	}
+}
+
+static int santos10_asp_hw_params(struct snd_pcm_substream *substream,
+				  struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *codec_dai = snd_soc_rtd_to_codec(rtd, 0);
+	unsigned int pll_out = params_rate(params) * 256;
+	int ret;
+
+	santos10_i2s0_pinmux();
+
+	/* 3.4 ctp_set_asp_clk_fmt(): FLL1 from MCLK1, sysclk = FLL1 */
+	ret = snd_soc_dai_set_pll(codec_dai, SANTOS10_WM8994_FLL1,
+				  SANTOS10_WM8994_FLL_SRC_MCLK1,
+				  SANTOS10_MCLK1, pll_out);
+	if (ret < 0) {
+		dev_err(codec_dai->dev, "Unable to configure FLL1: %d\n", ret);
+		return ret;
+	}
+
+	ret = snd_soc_dai_set_sysclk(codec_dai, SANTOS10_WM8994_SYSCLK_FLL1,
+				     pll_out, SND_SOC_CLOCK_IN);
+	if (ret < 0)
+		dev_err(codec_dai->dev, "Unable to switch to FLL1: %d\n", ret);
+
+	return ret;
+}
+
+static const struct snd_soc_ops santos10_asp_ops = {
+	.hw_params = santos10_asp_hw_params,
+};
+
+SND_SOC_DAILINK_DEFS(santos10_asp,
+	DAILINK_COMP_ARRAY(COMP_CPU("Headset-cpu-dai")),
+	DAILINK_COMP_ARRAY(COMP_CODEC("wm8994-codec", "wm8994-aif1")),
+	DAILINK_COMP_ARRAY(COMP_PLATFORM("sst-mfld-platform")));
+
+static struct snd_soc_dai_link santos10_asp_link = {
+	.name = "Cloverview ASP",
+	.stream_name = "Audio",
+	.dai_fmt = SND_SOC_DAIFMT_DSP_B | SND_SOC_DAIFMT_NB_NF |
+		   SND_SOC_DAIFMT_CBP_CFP,
+	.ops = &santos10_asp_ops,
+	SND_SOC_DAILINK_REG(santos10_asp),
+};
+
+/* 3.4 ctp_common.c: IHFAMP_SD_N is SCU register GPIOHVCTL bit-field 0x3d */
+#define SANTOS10_GPIOHVCTL		0x70
+#define SANTOS10_GPIO_AMP_ON		0x3d
+#define SANTOS10_GPIO_AMP_OFF		0x00
+
+static int santos10_spk_event(struct snd_soc_dapm_widget *w,
+			      struct snd_kcontrol *kcontrol, int event)
+{
+	struct intel_scu_ipc_dev *scu;
+	u8 val;
+	int ret;
+
+	if (event & SND_SOC_DAPM_POST_PMU)
+		val = SANTOS10_GPIO_AMP_ON;
+	else if (event & SND_SOC_DAPM_PRE_PMD)
+		val = SANTOS10_GPIO_AMP_OFF;
+	else
+		return 0;
+
+	scu = intel_scu_ipc_dev_get();
+	if (!scu)
+		return -ENODEV;
+	ret = intel_scu_ipc_dev_iowrite8(scu, SANTOS10_GPIOHVCTL, val);
+	intel_scu_ipc_dev_put(scu);
+
+	return ret;
+}
+
+static const struct snd_soc_dapm_widget santos10_dapm_widgets[] = {
+	SND_SOC_DAPM_HP("HP", NULL),
+	SND_SOC_DAPM_SPK("SPK", santos10_spk_event),
+	SND_SOC_DAPM_LINE("LINE", NULL),
+	SND_SOC_DAPM_LINE("HDMI", NULL),
+	SND_SOC_DAPM_MIC("Headset Mic", NULL),
+	SND_SOC_DAPM_MIC("Main Mic", NULL),
+};
+
+/* 3.4 ctp_rhb_wm1811.c ctp_audio_map; sinks live in wm_hubs.c */
+static const struct snd_soc_dapm_route santos10_audio_map[] = {
+	{ "HP", NULL, "HPOUT1L" },
+	{ "HP", NULL, "HPOUT1R" },
+	{ "SPK", NULL, "SPKOUTLN" },
+	{ "SPK", NULL, "SPKOUTLP" },
+	{ "SPK", NULL, "SPKOUTRN" },
+	{ "SPK", NULL, "SPKOUTRP" },
+	{ "LINE", NULL, "LINEOUT2N" },
+	{ "LINE", NULL, "LINEOUT2P" },
+	{ "HDMI", NULL, "LINEOUT1N" },
+	{ "HDMI", NULL, "LINEOUT1P" },
+};
+
+static struct snd_soc_card santos10_card = {
+	.name = "cloverview_audio",
+	.owner = THIS_MODULE,
+	.dai_link = &santos10_asp_link,
+	.num_links = 1,
+	.dapm_widgets = santos10_dapm_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(santos10_dapm_widgets),
+	.dapm_routes = santos10_audio_map,
+	.num_dapm_routes = ARRAY_SIZE(santos10_audio_map),
+};
+
+static int santos10_machine_probe(struct platform_device *pdev)
+{
+	struct snd_soc_card *card = &santos10_card;
+
+	santos10_i2s0_pinmux();
+
+	card->dev = &pdev->dev;
+	return devm_snd_soc_register_card(&pdev->dev, card);
+}
+
+static struct platform_driver santos10_machine_driver = {
+	.probe = santos10_machine_probe,
+	.driver = {
+		.name = "santos10-audio-machine",
+	},
+};
+module_platform_driver(santos10_machine_driver);
+
+MODULE_DESCRIPTION("Santos10 cloverview_audio machine driver (WM1811 ASP)");
+MODULE_LICENSE("GPL v2");
diff --git a/arch/x86/platform/intel-mid/santos10-audio.c b/arch/x86/platform/intel-mid/santos10-audio.c
new file mode 100644
index 0000000000000000000000000000000000000000..9aca6930d671ce34a079494674cfd48647eb1f0b
--- /dev/null
+++ b/arch/x86/platform/intel-mid/santos10-audio.c
@@ -0,0 +1,204 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Santos10 (GT-P5200/GT-P5210/GT-P5220) WM1811 audio transport bring-up.
+ *
+ * Ported from the Samsung 3.4 kernel board code:
+ *   arch/x86/platform/intel-mid/sec_libs/platform_wm8994.c
+ *   arch/x86/platform/intel-mid/sec_libs/platform_wm8994_regulator.c
+ *   arch/x86/platform/intel-mid/board-santos10-sfi.c
+ *   arch/x86/platform/intel-mid/board-santos10-muxset-r01.c
+ *
+ * 3.4 goldens preserved here:
+ *   - WM1811 MFD on I2C bus 1, address 0x1a, id string "wm8994"
+ *     (keeps the wm8994 supply set: DBVDD, DCVDD, AVDD1, AVDD2, CPVDD,
+ *      SPKVDD1, SPKVDD2; the ID register then promotes the type to WM1811)
+ *   - gpio_defaults and DRC configuration tables
+ *   - LDO1 (AVDD1 3.0V) / LDO2 (DCVDD 1.0V) with CODEC_LDO_EN as the
+ *     wlf,ldo1ena enable GPIO (GP_AON_076 = global GPIO 76)
+ *   - always-on fixed supplies: DBVDD/AVDD2/CPVDD and SPKVDD1/2
+ *
+ * No machine driver is registered here: the Cloverview SST PCI function
+ * (8086:08e7) and its golden CPU DAI semantics are not supported by the
+ * stock 7.2 SST driver yet, so a card could only defer.
+ */
+#define pr_fmt(fmt) "santos10-audio: " fmt
+
+#include <linux/gpio/machine.h>
+#include <linux/i2c.h>
+#include <linux/init.h>
+#include <linux/mfd/wm8994/pdata.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/fixed.h>
+#include <linux/regulator/machine.h>
+#include <sound/pcm.h>
+
+#define SANTOS10_CODEC_I2C_BUS		1
+#define SANTOS10_CODEC_I2C_ADDR		0x1a
+#define SANTOS10_CODEC_LDO_EN_GPIO	76
+#define SANTOS10_CODEC_DEV_NAME		"1-001a"
+#define SANTOS10_AON_GPIOCHIP		"0000:00:02.1"
+
+/* Always-on rails DBVDD/AVDD2/CPVDD (VCC_1.8V_PDA) */
+static struct regulator_consumer_supply santos10_vcc18_consumers[] = {
+	REGULATOR_SUPPLY("DBVDD", SANTOS10_CODEC_DEV_NAME),
+	REGULATOR_SUPPLY("AVDD2", SANTOS10_CODEC_DEV_NAME),
+	REGULATOR_SUPPLY("CPVDD", SANTOS10_CODEC_DEV_NAME),
+};
+
+static struct regulator_init_data santos10_vcc18_data = {
+	.constraints = {
+		.always_on = 1,
+	},
+	.num_consumer_supplies = ARRAY_SIZE(santos10_vcc18_consumers),
+	.consumer_supplies = santos10_vcc18_consumers,
+};
+
+static struct fixed_voltage_config santos10_vcc18_config = {
+	.supply_name = "VCC_1.8V_PDA",
+	.microvolts = 1800000,
+	.init_data = &santos10_vcc18_data,
+};
+
+static struct platform_device santos10_vcc18_device = {
+	.name = "reg-fixed-voltage",
+	.id = 0,
+	.dev = {
+		.platform_data = &santos10_vcc18_config,
+	},
+};
+
+/* Always-on rails SPKVDD1/2 (V_BAT) */
+static struct regulator_consumer_supply santos10_vbat_consumers[] = {
+	REGULATOR_SUPPLY("SPKVDD1", SANTOS10_CODEC_DEV_NAME),
+	REGULATOR_SUPPLY("SPKVDD2", SANTOS10_CODEC_DEV_NAME),
+};
+
+static struct regulator_init_data santos10_vbat_data = {
+	.constraints = {
+		.always_on = 1,
+	},
+	.num_consumer_supplies = ARRAY_SIZE(santos10_vbat_consumers),
+	.consumer_supplies = santos10_vbat_consumers,
+};
+
+static struct fixed_voltage_config santos10_vbat_config = {
+	.supply_name = "V_BAT",
+	.microvolts = 3700000,
+	.init_data = &santos10_vbat_data,
+};
+
+static struct platform_device santos10_vbat_device = {
+	.name = "reg-fixed-voltage",
+	.id = 1,
+	.dev = {
+		.platform_data = &santos10_vbat_config,
+	},
+};
+
+/* Codec internal LDOs: AVDD1 (LDO1) and DCVDD (LDO2) */
+static struct regulator_consumer_supply santos10_avdd1_supply =
+	REGULATOR_SUPPLY("AVDD1", SANTOS10_CODEC_DEV_NAME);
+static struct regulator_consumer_supply santos10_dcvdd_supply =
+	REGULATOR_SUPPLY("DCVDD", SANTOS10_CODEC_DEV_NAME);
+
+static struct regulator_init_data santos10_ldo1_data = {
+	.constraints = {
+		.name = "AVDD1_3.0V",
+		.valid_ops_mask = REGULATOR_CHANGE_STATUS,
+	},
+	.num_consumer_supplies = 1,
+	.consumer_supplies = &santos10_avdd1_supply,
+};
+
+static struct regulator_init_data santos10_ldo2_data = {
+	.constraints = {
+		.name = "DCVDD_1.0V",
+	},
+	.num_consumer_supplies = 1,
+	.consumer_supplies = &santos10_dcvdd_supply,
+};
+
+static struct wm8994_drc_cfg santos10_drc_cfgs[] = {
+	{
+		.name = "Default",
+		.regs = { 0x0098, 0x0845, 0x0, 0x0, 0x0 },
+	},
+	{
+		.name = "Speakers Media",
+		.regs = { 0x0050, 0x000c, 0x0018, 0x00e5, 0x0 },
+	},
+	{
+		.name = "Speakers Voip",
+		.regs = { 0x0050, 0x000c, 0x0018, 0x00e5, 0x0 },
+	},
+};
+
+static struct wm8994_override_params santos10_wm8994_override = {
+	.format[0] = SNDRV_PCM_FORMAT_S32_LE,
+	.format[1] = SNDRV_PCM_FORMAT_S16_LE,
+	.format[2] = 0,
+	.slots = 2,
+};
+
+static struct wm8994_pdata santos10_wm8994_pdata = {
+	.gpio_defaults = {
+		[0] = 0x0001,
+		[2] = 0x8100,
+		[3] = 0x8100,
+		[4] = 0x8100,
+		[6] = 0x0100,
+		[7] = 0x8100,
+		[8] = 0x0100,
+		[9] = 0x0100,
+		[10] = 0x0100,
+	},
+	.ldo = {
+		{ .init_data = &santos10_ldo1_data },
+		{ .init_data = &santos10_ldo2_data },
+	},
+	.ldo_ena_always_driven = 1,
+	.num_drc_cfgs = ARRAY_SIZE(santos10_drc_cfgs),
+	.drc_cfgs = santos10_drc_cfgs,
+	.override_params = &santos10_wm8994_override,
+	.fixed_fll = true,
+	.force_fll_reprogram = true,
+	.dsp_b_lrclk_inv_disable = true,
+};
+
+/*
+ * CODEC_LDO_EN (GP_AON_076) is the parent-scoped LDO1 enable GPIO looked up
+ * by the WM8994 regulator driver as "wlf,ldo1ena".
+ */
+static struct gpiod_lookup_table santos10_wm8994_ldo_gpios = {
+	.dev_id = SANTOS10_CODEC_DEV_NAME,
+	.table = {
+		GPIO_LOOKUP(SANTOS10_AON_GPIOCHIP, SANTOS10_CODEC_LDO_EN_GPIO,
+			    "wlf,ldo1ena", GPIO_ACTIVE_HIGH),
+		{ }
+	},
+};
+
+static struct i2c_board_info santos10_wm8994_board_info = {
+	I2C_BOARD_INFO("wm8994", SANTOS10_CODEC_I2C_ADDR),
+	.platform_data = &santos10_wm8994_pdata,
+};
+
+static int __init santos10_audio_init(void)
+{
+	gpiod_add_lookup_table(&santos10_wm8994_ldo_gpios);
+
+	if (platform_device_register(&santos10_vcc18_device) ||
+	    platform_device_register(&santos10_vbat_device))
+		return -ENODEV;
+
+	i2c_register_board_info(SANTOS10_CODEC_I2C_BUS,
+				&santos10_wm8994_board_info, 1);
+
+	platform_device_register_simple("santos10-audio-machine", -1, NULL, 0);
+
+	pr_debug("WM1811 transport registered (i2c-%d 0x%02x, LDO en GPIO %d)\n",
+		SANTOS10_CODEC_I2C_BUS, SANTOS10_CODEC_I2C_ADDR,
+		SANTOS10_CODEC_LDO_EN_GPIO);
+	return 0;
+}
+arch_initcall(santos10_audio_init);
diff --git a/arch/x86/platform/intel-mid/santos10-backlight.c b/arch/x86/platform/intel-mid/santos10-backlight.c
new file mode 100644
index 0000000000000000000000000000000000000000..7d08b7afbeeb92e7a296f9492c17e9f97639e6b2
--- /dev/null
+++ b/arch/x86/platform/intel-mid/santos10-backlight.c
@@ -0,0 +1,221 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * santos10-backlight: Display backlight driver for Samsung Santos10
+ * Controls Samsung cmc624 PWM via DesignWare I2C adapter 0 (0000:00:00.3 @ 0x38)
+ * and GPIO 127 (RST).
+ * Exposes /sys/class/backlight/panel.
+ */
+
+#define pr_fmt(fmt) "santos10-backlight: " fmt
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/gpio/consumer.h>
+#include <linux/gpio.h>
+#include <linux/i2c.h>
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/swab.h>
+
+#define SANTOS10_GPIO_BL_RST		127
+#define SANTOS10_BUS_BL			0
+#define SANTOS10_ADDR_CMC624		0x38
+
+#define SANTOS10_PWM_MIN		25	/* 0x0019 */
+#define SANTOS10_PWM_DEF		950	/* 0x03B6 */
+#define SANTOS10_PWM_MAX		1765	/* 0x06E5 */
+
+struct santos10_bl_data {
+	struct i2c_client *client;
+	struct backlight_device *bd;
+	int gpio_rst;
+	int last_brightness;
+};
+
+static int santos10_bl_set_pwm(struct santos10_bl_data *data, int brightness)
+{
+	struct i2c_client *c = data->client;
+	u16 pwm_val;
+	int ret;
+
+	if (brightness <= 0) {
+		/*
+		 * Golden on->off ordering: program CMC624 PWM 0 first
+		 * while reset is still asserted (active high), then
+		 * deassert backlight reset.
+		 */
+		ret = i2c_smbus_write_word_data(c, 0x00, swab16(0x0001)); /* Bank 1 */
+		if (ret < 0)
+			return ret;
+		ret = i2c_smbus_write_word_data(c, 0xF8, swab16(0x0011));
+		if (ret < 0)
+			return ret;
+		ret = i2c_smbus_write_word_data(c, 0xF9, swab16(0x0000));
+		if (ret < 0)
+			return ret;
+		ret = i2c_smbus_write_word_data(c, 0x00, swab16(0x0000)); /* Bank 0 */
+		if (ret < 0)
+			return ret;
+		ret = i2c_smbus_write_word_data(c, 0xFD, swab16(0xFFFF));
+		if (ret < 0)
+			return ret;
+		ret = i2c_smbus_write_word_data(c, 0xFE, swab16(0xFFFF));
+		if (ret < 0)
+			return ret;
+		ret = i2c_smbus_write_word_data(c, 0xFF, swab16(0x0000));
+		if (ret < 0)
+			return ret;
+
+		gpio_set_value(data->gpio_rst, 0);
+		return 0;
+	}
+
+	/*
+	 * Golden off->on ordering: assert backlight reset (active high),
+	 * wait golden 1 ms for CMC624 wake before issuing SMBus commands.
+	 */
+	if (data->last_brightness <= 0) {
+		gpio_set_value(data->gpio_rst, 1);
+		usleep_range(1000, 2000);
+	} else {
+		gpio_set_value(data->gpio_rst, 1);
+	}
+
+	pwm_val = SANTOS10_PWM_MIN +
+		  ((brightness - 1) * (SANTOS10_PWM_MAX - SANTOS10_PWM_MIN)) / 254;
+
+	ret = i2c_smbus_write_word_data(c, 0x00, swab16(0x0001)); /* Bank 1 */
+	if (ret < 0)
+		return ret;
+	ret = i2c_smbus_write_word_data(c, 0xF8, swab16(0x0011));
+	if (ret < 0)
+		return ret;
+	ret = i2c_smbus_write_word_data(c, 0xF9, swab16(pwm_val));
+	if (ret < 0)
+		return ret;
+
+	ret = i2c_smbus_write_word_data(c, 0x00, swab16(0x0000)); /* Bank 0 */
+	if (ret < 0)
+		return ret;
+	ret = i2c_smbus_write_word_data(c, 0xFD, swab16(0xFFFF));
+	if (ret < 0)
+		return ret;
+	ret = i2c_smbus_write_word_data(c, 0xFE, swab16(0xFFFF));
+	if (ret < 0)
+		return ret;
+	ret = i2c_smbus_write_word_data(c, 0xFF, swab16(0x0000));
+	if (ret < 0)
+		return ret;
+
+	return 0;
+}
+
+static int santos10_bl_update_status(struct backlight_device *bd)
+{
+	struct santos10_bl_data *data = bl_get_data(bd);
+	int brightness = backlight_get_brightness(bd);
+	int ret;
+
+	ret = santos10_bl_set_pwm(data, brightness);
+	if (ret == 0)
+		data->last_brightness = brightness;
+
+	return ret;
+}
+
+static int santos10_bl_get_brightness(struct backlight_device *bd)
+{
+	struct santos10_bl_data *data = bl_get_data(bd);
+	return data->last_brightness;
+}
+
+static const struct backlight_ops santos10_bl_ops = {
+	.update_status = santos10_bl_update_status,
+	.get_brightness = santos10_bl_get_brightness,
+};
+
+static int santos10_backlight_probe(struct platform_device *pdev)
+{
+	struct santos10_bl_data *data;
+	struct backlight_properties props;
+	struct i2c_adapter *adap;
+	int ret;
+
+	if (!gpio_to_desc(SANTOS10_GPIO_BL_RST))
+		return dev_err_probe(&pdev->dev, -EPROBE_DEFER,
+				     "waiting for CORE gpiochip (RST)\n");
+
+	adap = i2c_get_adapter(SANTOS10_BUS_BL);
+	if (!adap)
+		return dev_err_probe(&pdev->dev, -EPROBE_DEFER,
+				     "waiting for i2c-%d\n", SANTOS10_BUS_BL);
+
+	data = devm_kzalloc(&pdev->dev, sizeof(*data), GFP_KERNEL);
+	if (!data) {
+		i2c_put_adapter(adap);
+		return -ENOMEM;
+	}
+
+	data->gpio_rst = SANTOS10_GPIO_BL_RST;
+	ret = devm_gpio_request_one(&pdev->dev, data->gpio_rst,
+				    GPIOF_OUT_INIT_HIGH, "backlight_reset");
+	if (ret) {
+		i2c_put_adapter(adap);
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to request backlight_reset gpio\n");
+	}
+
+	data->client = i2c_new_dummy_device(adap, SANTOS10_ADDR_CMC624);
+	i2c_put_adapter(adap);
+	if (IS_ERR(data->client))
+		return dev_err_probe(&pdev->dev, PTR_ERR(data->client),
+				     "failed to create cmc624 dummy client\n");
+
+	memset(&props, 0, sizeof(props));
+	props.type = BACKLIGHT_RAW;
+	props.max_brightness = 255;
+	props.brightness = 134; /* default level */
+
+	data->bd = devm_backlight_device_register(&pdev->dev, "panel",
+						  &pdev->dev, data,
+						  &santos10_bl_ops, &props);
+	if (IS_ERR(data->bd)) {
+		i2c_unregister_device(data->client);
+		return dev_err_probe(&pdev->dev, PTR_ERR(data->bd),
+				     "failed to register backlight device\n");
+	}
+
+	/*
+	 * Non-destructive first-boot path: do NOT issue CMC624 PWM
+	 * transaction during probe. Preserves bootloader-configured
+	 * visible display and avoids bus wedges during early boot.
+	 */
+	data->last_brightness = props.brightness;
+	platform_set_drvdata(pdev, data);
+
+	dev_info(&pdev->dev, "panel backlight registered on i2c-%d (addr 0x%02x, rst %d)\n",
+		 SANTOS10_BUS_BL, SANTOS10_ADDR_CMC624, data->gpio_rst);
+	return 0;
+}
+
+static struct platform_driver santos10_backlight_driver = {
+	.probe = santos10_backlight_probe,
+	.driver = {
+		.name = "santos10-backlight",
+	},
+};
+
+static int __init santos10_backlight_init(void)
+{
+	platform_driver_register(&santos10_backlight_driver);
+	platform_device_register_simple("santos10-backlight", -1, NULL, 0);
+
+	return 0;
+}
+late_initcall(santos10_backlight_init);
+
+MODULE_AUTHOR("Antigravity");
+MODULE_DESCRIPTION("Samsung Santos10 Backlight Driver");
+MODULE_LICENSE("GPL");
diff --git a/arch/x86/platform/intel-mid/santos10-console-tty.c b/arch/x86/platform/intel-mid/santos10-console-tty.c
new file mode 100644
index 0000000000000000000000000000000000000000..12633166da5b4272196ca0151258b5ca33ddb05c
--- /dev/null
+++ b/arch/x86/platform/intel-mid/santos10-console-tty.c
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Santos10 minimal console-tty shim (bring-up).
+ *
+ * Problem (proven A57/#61): /dev/console fails with -ENODEV — the node
+ * exists but no driver sits behind it (7.2 has no Cloverview HSU driver;
+ * 3.4's mfd.c is 2600 lines, 8250_mid has no 08fc-ff IDs). Without an
+ * openable console, /init cannot start its stdio and product userspace
+ * is unreachable.
+ *
+ * This shim provides the smallest possible pair:
+ *  - a 1-port tty driver ("scon") whose writes go straight to the
+ *    persistent sec_log ring (init's console output is therefore captured
+ *    in last_kmsg for free), reads never return data;
+ *  - a struct console whose .device resolves /dev/console opens to that
+ *    tty. Its printk .write is deliberately a no-op: dmesg already flows
+ *    through sec_log_buf, and duplicating every byte would corrupt the
+ *    initcall-trace analysis, not help it.
+ *
+ * Also hosts the userspace failsafe: a one-shot timer (A58: 90 s, A82:
+ * 1800 s now that SSH sessions are productive) armed at registration. A99:
+ * RETIRED — the handler only logs, never resets (Void+SSH is reliable;
+ * golden p10 is the recovery path). The 90 s tick remains as a session
+ * timestamp in the log.
+ */
+
+#define pr_fmt(fmt) "santos10-con: " fmt
+
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <linux/timer.h>
+#include <linux/tty.h>
+#include <linux/tty_driver.h>
+#include <linux/tty_port.h>
+
+extern void santos10_sec_log_emergency_write(const char *s,
+					     unsigned int count);
+extern void santos10_warm_reset(void);
+
+static struct tty_driver *santos10_con_driver;
+static struct tty_port santos10_con_port;
+
+static int santos10_con_tty_open(struct tty_struct *tty, struct file *filp)
+{
+	return 0;
+}
+
+static void santos10_con_tty_close(struct tty_struct *tty, struct file *filp)
+{
+}
+
+static void santos10_con_tty_hangup(struct tty_struct *tty)
+{
+}
+
+static ssize_t santos10_con_tty_write(struct tty_struct *tty, const u8 *buf,
+				      size_t count)
+{
+	if (!count)
+		return 0;
+	santos10_sec_log_emergency_write(buf, count);
+	return count;
+}
+
+static unsigned int santos10_con_tty_write_room(struct tty_struct *tty)
+{
+	return 64 * 1024;
+}
+
+static unsigned int santos10_con_tty_chars_in_buffer(struct tty_struct *tty)
+{
+	return 0;
+}
+
+static const struct tty_operations santos10_con_tty_ops = {
+	.open = santos10_con_tty_open,
+	.close = santos10_con_tty_close,
+	.hangup = santos10_con_tty_hangup,
+	.write = santos10_con_tty_write,
+	.write_room = santos10_con_tty_write_room,
+	.chars_in_buffer = santos10_con_tty_chars_in_buffer,
+};
+
+static struct tty_driver *santos10_con_device(struct console *c, int *index)
+{
+	*index = 0;
+	return santos10_con_driver;
+}
+
+static int santos10_con_console_setup(struct console *c, char *options)
+{
+	return 0;
+}
+
+/* printk path: no-op by design (see file header). */
+static void santos10_con_console_write(struct console *c, const char *s,
+				       unsigned int count)
+{
+}
+
+static struct console santos10_con_console = {
+	.name = "santos10con",
+	.write = santos10_con_console_write,
+	.device = santos10_con_device,
+	.setup = santos10_con_console_setup,
+	.flags = CON_PRINTBUFFER | CON_ENABLED,
+	.index = -1,
+};
+
+#define SANTOS10_USERSPACE_TIMEOUT (90 * HZ)
+
+static struct timer_list santos10_userspace_timer;
+
+static void santos10_userspace_timeout(struct timer_list *t)
+{
+	/* A99: failsafe RETIRED. The 90 s warm reset was an early-bring-up
+	 * guard (A58/A82); Void now boots reliably with WiFi SSH, and the
+	 * timer was killing interactive I2C sessions mid-diagnosis.
+	 * Golden p10 remains the recovery path. Log and disarm. */
+	pr_info("santos10: userspace failsafe retired, no reset\n");
+}
+
+static int __init santos10_con_init(void)
+{
+	int ret;
+
+	santos10_con_driver = tty_alloc_driver(1,
+			TTY_DRIVER_REAL_RAW | TTY_DRIVER_DYNAMIC_DEV);
+	if (IS_ERR(santos10_con_driver))
+		return PTR_ERR(santos10_con_driver);
+
+	santos10_con_driver->driver_name = "santos10con";
+	santos10_con_driver->name = "scon";
+	santos10_con_driver->major = 0;
+	santos10_con_driver->minor_start = 0;
+	santos10_con_driver->type = TTY_DRIVER_TYPE_CONSOLE;
+	santos10_con_driver->init_termios = tty_std_termios;
+	tty_set_operations(santos10_con_driver, &santos10_con_tty_ops);
+
+	/* B3-SCON: the port was never linked (A58/A64 "does not set
+	 * tty->port" warning + console open err=-22). Same minimal pattern
+	 * as ttynull: init + link, no port ops needed for a write-only
+	 * sec_log sink.
+	 */
+	tty_port_init(&santos10_con_port);
+	tty_port_link_device(&santos10_con_port, santos10_con_driver, 0);
+
+	ret = tty_register_driver(santos10_con_driver);
+	if (ret) {
+		pr_err("tty_register_driver failed: %d\n", ret);
+		tty_driver_kref_put(santos10_con_driver);
+		return ret;
+	}
+
+	register_console(&santos10_con_console);
+	pr_info("santos10con tty+console registered, userspace failsafe retired (no reset)\n");
+
+	timer_setup(&santos10_userspace_timer, santos10_userspace_timeout, 0);
+	mod_timer(&santos10_userspace_timer,
+		  jiffies + SANTOS10_USERSPACE_TIMEOUT);
+	return 0;
+}
+device_initcall(santos10_con_init);
diff --git a/arch/x86/platform/intel-mid/santos10-disp-census.c b/arch/x86/platform/intel-mid/santos10-disp-census.c
new file mode 100644
index 0000000000000000000000000000000000000000..939a89eff3b575e0df916926a14d0ef1eba9b648
--- /dev/null
+++ b/arch/x86/platform/intel-mid/santos10-disp-census.c
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * santos10-disp-census: read-only retained-state snapshot of the
+ * Cloverview display engine (M3 first discriminant).
+ *
+ * SAFETY: strictly read-only. No pci_enable_device, no MSI/IRQ, no
+ * mem-region request held, no register writes of any kind. A single
+ * transient BAR0 mapping is taken after PCI enumeration, 17 dwords
+ * are read with readl(), then unmapped. Cannot change hardware state.
+ *
+ * Offsets are the Medfield/Cloverview display values from the golden
+ * 3.4 tree (drivers/staging/intel_media/display/pnw/drv/
+ * psb_intel_reg.h). One compact pr_info line; analysis is host-side.
+ */
+#define pr_fmt(fmt) "santos10-dispcensus: " fmt
+
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/pci.h>
+
+#define SANTOS10_GFX_VID	0x8086
+#define SANTOS10_GFX_DID	0x08c8
+
+/* BAR0 offsets (golden psb_intel_reg.h) */
+#define R_PIPEACONF	0x70008	/* bit31 = pipe enable */
+#define R_PIPEASTAT	0x70024	/* status/underrun */
+#define R_DSPACNTR	0x70180	/* bit31 = plane enable */
+#define R_DSPALINOFF	0x70184
+#define R_DSPASTRIDE	0x70188
+#define R_DSPAPOS	0x7018c
+#define R_DSPASIZE	0x70190
+#define R_DSPASURF	0x7019c	/* surface address */
+#define R_HTOTAL_A	0x60000
+#define R_VTOTAL_A	0x6000c
+#define R_DPLL_A	0x06014
+#define R_FPA0		0x06040
+#define R_MIPI		0x61190	/* bit31 = port enable */
+#define R_DEV_READY	0x0b000	/* bit0 = device ready */
+#define R_DSI_FUNC	0x0b00c
+#define R_PP_STATUS	0x61200
+#define R_PP_CONTROL	0x61204	/* bit31 = panel power on */
+
+static int __init santos10_dispcensus_init(void)
+{
+	struct pci_dev *pdev;
+	void __iomem *mmio;
+
+	pdev = pci_get_device(SANTOS10_GFX_VID, SANTOS10_GFX_DID, NULL);
+	if (!pdev) {
+		pr_info("00:02.0 8086:08c8 absent\n");
+		return 0;
+	}
+	if (!(pci_resource_flags(pdev, 0) & IORESOURCE_MEM) ||
+	    pci_resource_len(pdev, 0) < 0x80000) {
+		pr_info("BAR0 unassigned/too small flags=0x%lx len=%llu\n",
+			(unsigned long)pci_resource_flags(pdev, 0),
+			(unsigned long long)pci_resource_len(pdev, 0));
+		pci_dev_put(pdev);
+		return 0;
+	}
+	mmio = pci_iomap(pdev, 0, 0x80000);
+	if (!mmio) {
+		pr_info("BAR0 iomap failed\n");
+		pci_dev_put(pdev);
+		return 0;
+	}
+	pr_info("pipe=%08x stat=%08x plane=%08x linoff=%08x stride=%08x pos=%08x size=%08x surf=%08x\n",
+		readl(mmio + R_PIPEACONF), readl(mmio + R_PIPEASTAT),
+		readl(mmio + R_DSPACNTR), readl(mmio + R_DSPALINOFF),
+		readl(mmio + R_DSPASTRIDE), readl(mmio + R_DSPAPOS),
+		readl(mmio + R_DSPASIZE), readl(mmio + R_DSPASURF));
+	pr_info("htotal=%08x vtotal=%08x dpll=%08x fpa0=%08x mipi=%08x devrdy=%08x dsifunc=%08x ppstat=%08x ppctl=%08x\n",
+		readl(mmio + R_HTOTAL_A), readl(mmio + R_VTOTAL_A),
+		readl(mmio + R_DPLL_A), readl(mmio + R_FPA0),
+		readl(mmio + R_MIPI), readl(mmio + R_DEV_READY),
+		readl(mmio + R_DSI_FUNC), readl(mmio + R_PP_STATUS),
+		readl(mmio + R_PP_CONTROL));
+	pci_iounmap(pdev, mmio);
+	pci_dev_put(pdev);
+	return 0;
+}
+late_initcall(santos10_dispcensus_init);
diff --git a/arch/x86/platform/intel-mid/santos10-gpio-lnw.c b/arch/x86/platform/intel-mid/santos10-gpio-lnw.c
new file mode 100644
index 0000000000000000000000000000000000000000..acd31880d8d2e824251e12f0e4f359130844e380
--- /dev/null
+++ b/arch/x86/platform/intel-mid/santos10-gpio-lnw.c
@@ -0,0 +1,460 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * santos10-gpio-lnw: Langwell GPIO + IRQ driver for Cloverview
+ * (00:02.1 AON + 00:03.5 CORE, 96 pins each).
+ *
+ * Register truth ported from 3.4 gpio-langwell.c (register map, GAFR,
+ * GRER/GFER/GPIT/GPIM IRQ model, GEDR demux, BAR1 firmware bases).
+ * Framework ported to 7.2: gpiochip_add_data + gpio_irq_chip domain
+ * (replaces legacy irq_base numbering), devm style, no runtime PM v1,
+ * no debounce v1, no FLIS (Tangier-only), no Xen.
+ *
+ * Static gpio bases from firmware BAR1 keep golden global numbering
+ * (0-95 on 02.1, 96-191 on 03.5) so every documented pin (WLAN_EN=170,
+ * TSP_INT=62, ...) works unchanged. IRQ numbers are domain-dynamic;
+ * consumers must use gpio_to_irq(), never hardcoded IRQs.
+ */
+#define pr_fmt(fmt) "santos10-gpio: " fmt
+
+#include <linux/bitops.h>
+#include <linux/err.h>
+#include <linux/gpio/driver.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/pci.h>
+#include <linux/platform_device.h>
+#include <linux/spinlock.h>
+
+#define LNW_GPIO_AON	0
+#define LNW_GPIO_CORE	1
+
+int santos10_lnw_gpio_set_alt(unsigned int gpio, unsigned int alt);
+
+#define LNW_IRQ_EDGE	(1 << 0)
+#define LNW_IRQ_LEVEL	(1 << 1)
+
+#define LNW_NGPIO	96
+#define LNW_NREG	(LNW_NGPIO / 32)
+
+enum lnw_gpio_reg {
+	LNW_GPLR = 0,
+	LNW_GPDR = 1,
+	LNW_GPSR = 2,
+	LNW_GPCR = 3,
+	LNW_GRER = 4,
+	LNW_GFER = 5,
+	LNW_GEDR = 6,
+	LNW_GAFR = 7,
+	LNW_GPIT = 10,
+};
+
+struct lnw_gpio {
+	struct gpio_chip chip;
+	void __iomem *reg_base;
+	spinlock_t lock;
+	unsigned int irq_type;	/* LNW_IRQ_EDGE, AON adds LEVEL */
+	struct pci_dev *pdev;
+};
+
+#define LNW_GPIO_MAX_CTRL	2
+static struct lnw_gpio *lnw_gpio_ctrls[LNW_GPIO_MAX_CTRL];
+
+static void __iomem *lnw_reg(struct lnw_gpio *lnw, unsigned int offset,
+			     enum lnw_gpio_reg reg)
+{
+	unsigned int r = offset / 32;
+
+	return lnw->reg_base + reg * LNW_NREG * 4 + r * 4;
+}
+
+static int lnw_gpio_request(struct gpio_chip *chip, unsigned int offset)
+{
+	struct lnw_gpio *lnw = gpiochip_get_data(chip);
+	void __iomem *gafr = lnw->reg_base + LNW_GAFR * LNW_NREG * 4 +
+		(offset / 16) * 4;
+	unsigned long flags;
+	u32 v;
+	int shift = (offset % 16) * 2;
+
+	/* GPIO mode (clear 2-bit alt function), 3.4-exact */
+	spin_lock_irqsave(&lnw->lock, flags);
+	v = readl(gafr);
+	v &= ~(3u << shift);
+	writel(v, gafr);
+	spin_unlock_irqrestore(&lnw->lock, flags);
+	return 0;
+}
+
+/*
+ * Set the 2-bit GAFR alt function of a global pin, 3.4
+ * lnw_gpio_set_alt() non-Tangier sequence. Needed by the audio machine
+ * driver to mux GPIO 4..7 (I2S0 CLK/FS/TXD/RXD) to ALT_1.
+ */
+int santos10_lnw_gpio_set_alt(unsigned int gpio, unsigned int alt)
+{
+	struct lnw_gpio *lnw = NULL;
+	void __iomem *gafr;
+	unsigned long flags;
+	unsigned int off;
+	u32 v;
+	int i, shift;
+
+	for (i = 0; i < LNW_GPIO_MAX_CTRL; i++) {
+		if (lnw_gpio_ctrls[i] &&
+		    gpio >= lnw_gpio_ctrls[i]->chip.base &&
+		    gpio < lnw_gpio_ctrls[i]->chip.base +
+			   lnw_gpio_ctrls[i]->chip.ngpio) {
+			lnw = lnw_gpio_ctrls[i];
+			break;
+		}
+	}
+	if (!lnw)
+		return -ENODEV;
+
+	off = gpio - lnw->chip.base;
+	gafr = lnw->reg_base + LNW_GAFR * LNW_NREG * 4 + (off / 16) * 4;
+	shift = (off % 16) * 2;
+
+	spin_lock_irqsave(&lnw->lock, flags);
+	v = readl(gafr);
+	v &= ~(3u << shift);
+	v |= (alt & 3u) << shift;
+	writel(v, gafr);
+	spin_unlock_irqrestore(&lnw->lock, flags);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(santos10_lnw_gpio_set_alt);
+
+static int lnw_gpio_get_direction(struct gpio_chip *chip, unsigned int offset)
+{
+	struct lnw_gpio *lnw = gpiochip_get_data(chip);
+
+	if (readl(lnw_reg(lnw, offset, LNW_GPDR)) & BIT(offset % 32))
+		return GPIO_LINE_DIRECTION_OUT;
+	return GPIO_LINE_DIRECTION_IN;
+}
+
+static int lnw_gpio_direction_input(struct gpio_chip *chip, unsigned int offset)
+{
+	struct lnw_gpio *lnw = gpiochip_get_data(chip);
+	void __iomem *gpdr = lnw_reg(lnw, offset, LNW_GPDR);
+	unsigned long flags;
+	u32 v;
+
+	spin_lock_irqsave(&lnw->lock, flags);
+	v = readl(gpdr);
+	v &= ~BIT(offset % 32);
+	writel(v, gpdr);
+	spin_unlock_irqrestore(&lnw->lock, flags);
+	return 0;
+}
+
+static int lnw_gpio_direction_output(struct gpio_chip *chip,
+				     unsigned int offset, int value)
+{
+	struct lnw_gpio *lnw = gpiochip_get_data(chip);
+	void __iomem *gpdr = lnw_reg(lnw, offset, LNW_GPDR);
+	unsigned long flags;
+	u32 v;
+
+	if (value)
+		writel(BIT(offset % 32), lnw_reg(lnw, offset, LNW_GPSR));
+	else
+		writel(BIT(offset % 32), lnw_reg(lnw, offset, LNW_GPCR));
+
+	spin_lock_irqsave(&lnw->lock, flags);
+	v = readl(gpdr);
+	v |= BIT(offset % 32);
+	writel(v, gpdr);
+	spin_unlock_irqrestore(&lnw->lock, flags);
+	return 0;
+}
+
+static int lnw_gpio_get(struct gpio_chip *chip, unsigned int offset)
+{
+	struct lnw_gpio *lnw = gpiochip_get_data(chip);
+
+	return !!(readl(lnw_reg(lnw, offset, LNW_GPLR)) & BIT(offset % 32));
+}
+
+static int lnw_gpio_set(struct gpio_chip *chip, unsigned int offset, int value)
+{
+	struct lnw_gpio *lnw = gpiochip_get_data(chip);
+
+	if (value)
+		writel(BIT(offset % 32), lnw_reg(lnw, offset, LNW_GPSR));
+	else
+		writel(BIT(offset % 32), lnw_reg(lnw, offset, LNW_GPCR));
+	return 0;
+}
+
+/* Alt-function helper (2-bit GAFR) lands with the display/i2c pinmux user;
+ * omitted in v1 (no callers yet). */
+
+static int lnw_irq_type(struct irq_data *d, unsigned int type)
+{
+	struct lnw_gpio *lnw = irq_data_get_irq_chip_data(d);
+	unsigned int gpio = irqd_to_hwirq(d);
+	unsigned long flags;
+	void __iomem *grer = lnw_reg(lnw, gpio, LNW_GRER);
+	void __iomem *gfer = lnw_reg(lnw, gpio, LNW_GFER);
+	u32 v;
+	int ret = 0;
+
+	if (gpio >= lnw->chip.ngpio)
+		return -EINVAL;
+
+	/* level capable (AON) has extra GPIT registers */
+	if (lnw->irq_type & LNW_IRQ_LEVEL) {
+		void __iomem *gpit = lnw_reg(lnw, gpio, LNW_GPIT);
+		void __iomem *gpip = lnw_reg(lnw, gpio, LNW_GFER);
+
+		spin_lock_irqsave(&lnw->lock, flags);
+		if (type & IRQ_TYPE_LEVEL_MASK) {
+			v = readl(gpit) | BIT(gpio % 32);
+			writel(v, gpit);
+			if (type & IRQ_TYPE_LEVEL_LOW)
+				v = readl(gpip) | BIT(gpio % 32);
+			else
+				v = readl(gpip) & ~BIT(gpio % 32);
+			writel(v, gpip);
+			irq_set_handler_locked(d, handle_level_irq);
+		} else if (type & IRQ_TYPE_EDGE_BOTH) {
+			v = readl(gpit) & ~BIT(gpio % 32);
+			writel(v, gpit);
+			if (type & IRQ_TYPE_EDGE_RISING)
+				v = readl(grer) | BIT(gpio % 32);
+			else
+				v = readl(grer) & ~BIT(gpio % 32);
+			writel(v, grer);
+			if (type & IRQ_TYPE_EDGE_FALLING)
+				v = readl(gfer) | BIT(gpio % 32);
+			else
+				v = readl(gfer) & ~BIT(gpio % 32);
+			writel(v, gfer);
+			irq_set_handler_locked(d, handle_edge_irq);
+		}
+		spin_unlock_irqrestore(&lnw->lock, flags);
+	} else {
+		if (type & IRQ_TYPE_LEVEL_MASK) {
+			ret = -EINVAL;
+		} else if (type & IRQ_TYPE_EDGE_BOTH) {
+			spin_lock_irqsave(&lnw->lock, flags);
+			if (type & IRQ_TYPE_EDGE_RISING)
+				v = readl(grer) | BIT(gpio % 32);
+			else
+				v = readl(grer) & ~BIT(gpio % 32);
+			writel(v, grer);
+			if (type & IRQ_TYPE_EDGE_FALLING)
+				v = readl(gfer) | BIT(gpio % 32);
+			else
+				v = readl(gfer) & ~BIT(gpio % 32);
+			writel(v, gfer);
+			spin_unlock_irqrestore(&lnw->lock, flags);
+		}
+	}
+	return ret;
+}
+
+static void lnw_irq_mask_unmask(struct irq_data *d, bool unmask)
+{
+	struct lnw_gpio *lnw = irq_data_get_irq_chip_data(d);
+	unsigned int gpio = irqd_to_hwirq(d);
+	void __iomem *gpit;
+	u32 v;
+
+	if (gpio >= lnw->chip.ngpio)
+		return;
+
+	/* Cloverview AON level: gate GPIM by GPIT state, 3.4-exact.
+	 * Edge-only (CORE): mask/unmask are passthrough — edges latch in
+	 * GEDR and the demux dispatches latched bits only. */
+	if ((lnw->irq_type & LNW_IRQ_LEVEL) &&
+	    (lnw->pdev->device == 0x08eb)) {
+		void __iomem *gpim = lnw_reg(lnw, gpio, LNW_GRER);
+
+		gpit = lnw_reg(lnw, gpio, LNW_GPIT);
+		if (readl(gpit) & BIT(gpio % 32)) {
+			v = readl(gpim);
+			if (unmask)
+				v |= BIT(gpio % 32);
+			else
+				v &= ~BIT(gpio % 32);
+			writel(v, gpim);
+		}
+	}
+}
+
+static void lnw_irq_mask(struct irq_data *d)
+{
+	lnw_irq_mask_unmask(d, false);
+}
+
+static void lnw_irq_unmask(struct irq_data *d)
+{
+	lnw_irq_mask_unmask(d, true);
+}
+
+static void lnw_irq_ack(struct irq_data *d)
+{
+}
+
+static void lnw_irq_shutdown(struct irq_data *d)
+{
+	struct lnw_gpio *lnw = irq_data_get_irq_chip_data(d);
+	unsigned int gpio = irqd_to_hwirq(d);
+	unsigned long flags;
+	void __iomem *grer = lnw_reg(lnw, gpio, LNW_GRER);
+	void __iomem *gfer = lnw_reg(lnw, gpio, LNW_GFER);
+	u32 v;
+
+	spin_lock_irqsave(&lnw->lock, flags);
+	v = readl(grer) & ~BIT(gpio % 32);
+	writel(v, grer);
+	v = readl(gfer) & ~BIT(gpio % 32);
+	writel(v, gfer);
+	spin_unlock_irqrestore(&lnw->lock, flags);
+}
+
+static int lnw_irq_set_wake(struct irq_data *d, unsigned int on)
+{
+	return 0;
+}
+
+static struct irq_chip lnw_irqchip = {
+	.name			= "LNW-GPIO",
+	.flags			= IRQCHIP_SET_TYPE_MASKED,
+	.irq_mask		= lnw_irq_mask,
+	.irq_unmask		= lnw_irq_unmask,
+	.irq_set_type		= lnw_irq_type,
+	.irq_set_wake		= lnw_irq_set_wake,
+	.irq_ack		= lnw_irq_ack,
+	.irq_shutdown		= lnw_irq_shutdown,
+};
+
+/* Chained demux: runs in parent (PCI line) context, 3.4-exact logic. */
+static void lnw_irq_handler(struct irq_desc *desc)
+{
+	struct gpio_chip *gc = irq_desc_get_handler_data(desc);
+	struct lnw_gpio *lnw = gpiochip_get_data(gc);
+	unsigned int base, gpio;
+	u32 mask, pending;
+	void __iomem *gp_reg;
+
+	chained_irq_enter(irq_desc_get_chip(desc), desc);
+	for (base = 0; base < lnw->chip.ngpio; base += 32) {
+		gp_reg = lnw_reg(lnw, base, LNW_GEDR);
+		pending = readl(gp_reg);
+		while (pending) {
+			gpio = __ffs(pending);
+			mask = BIT(gpio);
+			pending &= ~mask;
+			/* Clear before handling so we can't lose an edge */
+			writel(mask, gp_reg);
+			generic_handle_domain_irq(gc->irq.domain,
+						  base + gpio);
+			pending = readl(gp_reg);
+		}
+	}
+	chained_irq_exit(irq_desc_get_chip(desc), desc);
+}
+
+static int lnw_gpio_probe(struct pci_dev *pdev, const struct pci_device_id *id)
+{
+	struct device *dev = &pdev->dev;
+	struct lnw_gpio *lnw;
+	void __iomem *bar1;
+	u32 gpio_base;
+	unsigned int *parents;
+	int ret, i;
+
+	lnw = devm_kzalloc(dev, sizeof(*lnw), GFP_KERNEL);
+	if (!lnw)
+		return -ENOMEM;
+
+	ret = pcim_enable_device(pdev);
+	if (ret)
+		return ret;
+	ret = pcim_iomap_regions(pdev, BIT(0), "santos10-gpio-lnw");
+	if (ret)
+		return ret;
+	lnw->reg_base = pcim_iomap_table(pdev)[0];
+
+	/* BAR1 (IO) word1 = firmware gpio base; word0 = legacy irq base
+	 * (unused: domains allocate IRQs dynamically). Same protocol as
+	 * 3.4 and gpio-merrifield. */
+	bar1 = pci_iomap(pdev, 1, 8);
+	if (!bar1)
+		return -ENXIO;
+	gpio_base = readl(bar1 + 4);
+	pci_iounmap(pdev, bar1);
+	dev_info(dev, "firmware gpio base %u\n", gpio_base);
+
+	lnw->pdev = pdev;
+	spin_lock_init(&lnw->lock);
+	lnw->irq_type = (pdev->device == 0x08eb) ?
+		(LNW_IRQ_EDGE | LNW_IRQ_LEVEL) : LNW_IRQ_EDGE;
+
+	lnw->chip.label = dev_name(dev);
+	lnw->chip.parent = dev;
+	lnw->chip.owner = THIS_MODULE;
+	lnw->chip.request = lnw_gpio_request;
+	lnw->chip.get_direction = lnw_gpio_get_direction;
+	lnw->chip.direction_input = lnw_gpio_direction_input;
+	lnw->chip.direction_output = lnw_gpio_direction_output;
+	lnw->chip.get = lnw_gpio_get;
+	lnw->chip.set = lnw_gpio_set;
+	lnw->chip.base = gpio_base;
+	lnw->chip.ngpio = LNW_NGPIO;
+	lnw->chip.can_sleep = false;
+
+	parents = devm_kcalloc(dev, 1, sizeof(*parents), GFP_KERNEL);
+	if (!parents)
+		return -ENOMEM;
+	parents[0] = pdev->irq;
+	lnw->chip.irq.chip = &lnw_irqchip;
+	lnw->chip.irq.parent_handler = lnw_irq_handler;
+	lnw->chip.irq.num_parents = 1;
+	lnw->chip.irq.parents = parents;
+	lnw->chip.irq.default_type = IRQ_TYPE_NONE;
+	lnw->chip.irq.handler = handle_edge_irq;
+
+	ret = devm_gpiochip_add_data(dev, &lnw->chip, lnw);
+	if (ret)
+		return dev_err_probe(dev, ret, "gpiochip add failed\n");
+
+	for (i = 0; i < LNW_GPIO_MAX_CTRL; i++) {
+		if (!lnw_gpio_ctrls[i]) {
+			lnw_gpio_ctrls[i] = lnw;
+			break;
+		}
+	}
+
+	pci_set_drvdata(pdev, lnw);
+	dev_info(dev, "Langwell GPIO %u pins at base %u registered\n",
+		 LNW_NGPIO, gpio_base);
+	return 0;
+}
+
+static const struct pci_device_id lnw_gpio_ids[] = {
+	{ PCI_DEVICE(PCI_VENDOR_ID_INTEL, 0x08eb) }, /* CLV AON */
+	{ PCI_DEVICE(PCI_VENDOR_ID_INTEL, 0x08f7) }, /* CLV CORE */
+	{ }
+};
+MODULE_DEVICE_TABLE(pci, lnw_gpio_ids);
+
+static struct pci_driver lnw_gpio_driver = {
+	.name		= "santos10-gpio-lnw",
+	.id_table	= lnw_gpio_ids,
+	.probe		= lnw_gpio_probe,
+};
+module_pci_driver(lnw_gpio_driver);
+
+MODULE_AUTHOR("santos10 bring-up");
+MODULE_DESCRIPTION("Intel Cloverview Langwell GPIO+IRQ (ported register truth)");
+MODULE_LICENSE("GPL v2");
diff --git a/arch/x86/platform/intel-mid/santos10-p8ro.c b/arch/x86/platform/intel-mid/santos10-p8ro.c
new file mode 100644
index 0000000000000000000000000000000000000000..cd2c1bc41dbf5ab509034a8da9062971d8c6179a
--- /dev/null
+++ b/arch/x86/platform/intel-mid/santos10-p8ro.c
@@ -0,0 +1,191 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * santos10-p8ro: B3-P8RO explicit gate.
+ *
+ * Read-only identity probe of the VOIDROOT p8 under Linux 7.2 with the
+ * alternate-GPT policy active. A kernel thread polls for /dev/mmcblk0p8 and
+ * mounts it MS_RDONLY + "norecovery" (zero writes, not even journal
+ * replay), then reports: statfs geometry, filesystem UUID, /sbin/init
+ * presence+size, and the first line of /etc/os-release. Unmounts and
+ * exits with a single gate PASS/FAIL marker. Disjoint from the TWRP
+ * userspace scan; proves the same identity from the kernel side.
+ *
+ * The poll mounts immediately and retries -ENOENT until a deadline:
+ * /init mounts tmpfs over /dev and ueventd coldplug repopulates it, so a
+ * node seen early may be gone at mount time.
+ */
+#define pr_fmt(fmt) "santos10-p8ro: " fmt
+
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/file.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/kthread.h>
+#include <linux/mount.h>
+#include <linux/slab.h>
+#include <linux/statfs.h>
+#include <uapi/linux/mount.h>
+
+#define SANTOS10_P8RO_DEV	"/dev/mmcblk0p8"
+#define SANTOS10_P8RO_DEADLINE_MS	75000
+#define SANTOS10_P8RO_POLL_MS	500
+
+static void santos10_p8ro_sanitize(char *buf, size_t len)
+{
+	size_t i;
+
+	for (i = 0; i < len && buf[i]; i++) {
+		if (buf[i] == '\n' || buf[i] == '\r') {
+			buf[i] = '\0';
+			break;
+		}
+		if (buf[i] < 0x20 || buf[i] > 0x7e)
+			buf[i] = '?';
+	}
+}
+
+static int santos10_p8ro_probe(void)
+{
+	struct file_system_type *type;
+	struct vfsmount *mnt;
+	struct path root;
+	struct kstatfs st;
+	struct file *f;
+	char *data_page;
+	char *buf;
+	loff_t pos;
+	ssize_t n;
+	int fails = 0;
+
+	type = get_fs_type("ext4");
+	if (!type) {
+		pr_err("get_fs_type ext4 failed FAIL\n");
+		return -ENODEV;
+	}
+
+	/*
+	 * Mount data must be a writable page: the LSM hook
+	 * (security_sb_eat_lsm_opts) edits the option buffer in place.
+	 * A string literal here faults (#70 root cause). Same pattern
+	 * as init/do_mounts.c do_mount_root().
+	 */
+	data_page = kmalloc(PAGE_SIZE, GFP_KERNEL);
+	if (!data_page) {
+		put_filesystem(type);
+		pr_err("no memory for mount data FAIL\n");
+		return -ENOMEM;
+	}
+	strscpy_pad(data_page, "norecovery", PAGE_SIZE);
+
+	mnt = vfs_kern_mount(type, MS_RDONLY, SANTOS10_P8RO_DEV, data_page);
+	kfree(data_page);
+	put_filesystem(type);
+	if (IS_ERR(mnt)) {
+		pr_err("mount %s ro,norecovery rc=%ld FAIL\n",
+		       SANTOS10_P8RO_DEV, PTR_ERR(mnt));
+		return PTR_ERR(mnt);
+	}
+	pr_info("mounted %s ro,norecovery rc=0\n", SANTOS10_P8RO_DEV);
+
+	root.mnt = mnt;
+	root.dentry = mnt->mnt_root;
+
+	if (vfs_statfs(&root, &st) == 0)
+		pr_info("statfs blocks=%llu bsize=%lu rc=0\n",
+			(unsigned long long)st.f_blocks,
+			(unsigned long)st.f_bsize);
+	else {
+		pr_err("statfs failed\n");
+		fails++;
+	}
+
+	pr_info("uuid=%pU\n", &mnt->mnt_sb->s_uuid);
+
+	f = file_open_root_mnt(mnt, "/sbin/init", O_RDONLY, 0);
+	if (IS_ERR(f)) {
+		pr_err("open /sbin/init rc=%ld\n", PTR_ERR(f));
+		fails++;
+	} else {
+		pr_info("sbin_init size=%lld rc=0\n",
+			(long long)i_size_read(file_inode(f)));
+		fput(f);
+	}
+
+	buf = kmalloc(256, GFP_KERNEL);
+	if (!buf) {
+		pr_err("no memory for os-release read\n");
+		fails++;
+	} else {
+		f = file_open_root_mnt(mnt, "/etc/os-release", O_RDONLY, 0);
+		if (IS_ERR(f)) {
+			pr_err("open /etc/os-release rc=%ld\n", PTR_ERR(f));
+			fails++;
+		} else {
+			pos = 0;
+			n = kernel_read(f, buf, 255, &pos);
+			if (n < 0) {
+				pr_err("read /etc/os-release rc=%zd\n", n);
+				fails++;
+			} else {
+				buf[n] = '\0';
+				santos10_p8ro_sanitize(buf, n);
+				pr_info("os_release line1='%s' rc=0\n", buf);
+			}
+			fput(f);
+		}
+		kfree(buf);
+	}
+
+	kern_unmount(mnt);
+	pr_info("unmounted rc=0\n");
+
+	pr_info("gate %s\n", fails ? "FAIL" : "PASS");
+	return fails ? -EIO : 0;
+}
+
+static int santos10_p8ro_thread(void *arg)
+{
+	unsigned long waited = 0;
+	struct file *f;
+	int rc;
+
+	/*
+	 * /dev identity is not stable across /init's tmpfs mount over
+	 * /dev + ueventd coldplug (#71 root cause: node seen on devtmpfs
+	 * at ~4.8 s, gone at mount time ~6.8 s). So never cache "device
+	 * exists": poll the node and mount immediately, retrying -ENOENT
+	 * until the deadline (inside the 90 s userspace failsafe).
+	 */
+	while (waited < SANTOS10_P8RO_DEADLINE_MS) {
+		f = filp_open(SANTOS10_P8RO_DEV, O_RDONLY, 0);
+		if (!IS_ERR(f)) {
+			fput(f);
+			pr_info("node present after %lums, mounting\n", waited);
+			rc = santos10_p8ro_probe();
+			if (rc == 0)
+				return 0;
+			if (rc != -ENOENT)
+				return 0;
+			pr_info("mount rc=-ENOENT, retrying\n");
+		}
+		msleep(SANTOS10_P8RO_POLL_MS);
+		waited += SANTOS10_P8RO_POLL_MS;
+	}
+	pr_err("node/mount never stabilized FAIL\n");
+	return 0;
+}
+
+static int __init santos10_p8ro_init(void)
+{
+	struct task_struct *t;
+
+	t = kthread_run(santos10_p8ro_thread, NULL, "santos10-p8ro");
+	if (IS_ERR(t)) {
+		pr_err("kthread start rc=%ld\n", PTR_ERR(t));
+		return PTR_ERR(t);
+	}
+	pr_info("probe thread started\n");
+	return 0;
+}
+late_initcall(santos10_p8ro_init);
diff --git a/arch/x86/platform/intel-mid/santos10-power-board.c b/arch/x86/platform/intel-mid/santos10-power-board.c
new file mode 100644
index 0000000000000000000000000000000000000000..9ca5cc9b0f046e829e37edbd54731df36edb136e
--- /dev/null
+++ b/arch/x86/platform/intel-mid/santos10-power-board.c
@@ -0,0 +1,288 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * santos10-power-board: Board integration for Samsung Santos10 power surfaces:
+ *  - i2c-gpio.6: MAX77693 PMIC / Charger / MUIC (SDA=10, SCL=11, IRQ=89)
+ *  - i2c-gpio.7: MAX17050 Fuel Gauge (SDA=9, SCL=8, IRQ=94)
+ *  - gpio-keys: Power (92) & Home (32) [no autorepeat, rep=0]
+ *               Vol Up (30) & Vol Down (31) [autorepeat, rep=1]
+ */
+
+#define pr_fmt(fmt) "santos10-power: " fmt
+
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/gpio/consumer.h>
+#include <linux/gpio/machine.h>
+#include <linux/gpio.h>
+#include <linux/gpio_keys.h>
+#include <linux/i2c.h>
+#include <linux/init.h>
+#include <linux/input.h>
+#include <linux/irq.h>
+#include <linux/module.h>
+#include <linux/platform_data/i2c-gpio.h>
+#include <linux/platform_device.h>
+
+#define SANTOS10_AON_GPIOCHIP		"0000:00:02.1"
+
+#define SANTOS10_GPIO_PMIC_SDA		10
+#define SANTOS10_GPIO_PMIC_SCL		11
+#define SANTOS10_GPIO_PMIC_IRQ		89
+
+#define SANTOS10_GPIO_FG_SDA		9
+#define SANTOS10_GPIO_FG_SCL		8
+#define SANTOS10_GPIO_FG_IRQ		94
+
+#define SANTOS10_GPIO_KEY_PWR		92
+#define SANTOS10_GPIO_KEY_VOLUP		30
+#define SANTOS10_GPIO_KEY_VOLDN		31
+#define SANTOS10_GPIO_KEY_HOME		32
+
+#define SANTOS10_BUS_PMIC		6
+#define SANTOS10_BUS_FG			7
+
+#define SANTOS10_ADDR_PMIC		0x66
+#define SANTOS10_ADDR_FG		0x36
+
+static struct i2c_gpio_platform_data santos10_i2c6_pdata = {
+	.udelay = 5, /* 100 kHz */
+	.timeout = HZ / 10,
+};
+
+static struct gpiod_lookup_table santos10_i2c6_gpios = {
+	.dev_id = "i2c-gpio.6",
+	.table = {
+		GPIO_LOOKUP(SANTOS10_AON_GPIOCHIP, SANTOS10_GPIO_PMIC_SDA,
+			    "sda", GPIO_ACTIVE_HIGH),
+		GPIO_LOOKUP(SANTOS10_AON_GPIOCHIP, SANTOS10_GPIO_PMIC_SCL,
+			    "scl", GPIO_ACTIVE_HIGH),
+		{ }
+	},
+};
+
+static const struct platform_device_info santos10_i2c6_devinfo = {
+	.name = "i2c-gpio",
+	.id = SANTOS10_BUS_PMIC,
+	.data = &santos10_i2c6_pdata,
+	.size_data = sizeof(santos10_i2c6_pdata),
+};
+
+static struct i2c_gpio_platform_data santos10_i2c7_pdata = {
+	.udelay = 5, /* 100 kHz */
+	.timeout = HZ / 10,
+};
+
+static struct gpiod_lookup_table santos10_i2c7_gpios = {
+	.dev_id = "i2c-gpio.7",
+	.table = {
+		GPIO_LOOKUP(SANTOS10_AON_GPIOCHIP, SANTOS10_GPIO_FG_SDA,
+			    "sda", GPIO_ACTIVE_HIGH),
+		GPIO_LOOKUP(SANTOS10_AON_GPIOCHIP, SANTOS10_GPIO_FG_SCL,
+			    "scl", GPIO_ACTIVE_HIGH),
+		{ }
+	},
+};
+
+static const struct platform_device_info santos10_i2c7_devinfo = {
+	.name = "i2c-gpio",
+	.id = SANTOS10_BUS_FG,
+	.data = &santos10_i2c7_pdata,
+	.size_data = sizeof(santos10_i2c7_pdata),
+};
+
+/* Power and Home keys: no repeat (matching golden 3.4 board-santos10-input.c) */
+static const struct gpio_keys_button santos10_gpio_buttons_pwr_home[] = {
+	{
+		.code = KEY_POWER,
+		.gpio = SANTOS10_GPIO_KEY_PWR,
+		.active_low = 0,
+		.desc = "Power",
+		.type = EV_KEY,
+		.wakeup = 1,
+		.debounce_interval = 15,
+	},
+	{
+		.code = KEY_HOMEPAGE,
+		.gpio = SANTOS10_GPIO_KEY_HOME,
+		.active_low = 1,
+		.desc = "Home",
+		.type = EV_KEY,
+		.wakeup = 0,
+		.debounce_interval = 15,
+	},
+};
+
+static const struct gpio_keys_platform_data santos10_gpio_keys_pwr_home_pdata = {
+	.buttons = santos10_gpio_buttons_pwr_home,
+	.nbuttons = ARRAY_SIZE(santos10_gpio_buttons_pwr_home),
+	.rep = 0,
+	.name = "sec_key",
+};
+
+/* Volume keys: autorepeat enabled (rep = 1) */
+static const struct gpio_keys_button santos10_gpio_buttons_vol[] = {
+	{
+		.code = KEY_VOLUMEUP,
+		.gpio = SANTOS10_GPIO_KEY_VOLUP,
+		.active_low = 1,
+		.desc = "Volume Up",
+		.type = EV_KEY,
+		.wakeup = 0,
+		.debounce_interval = 15,
+	},
+	{
+		.code = KEY_VOLUMEDOWN,
+		.gpio = SANTOS10_GPIO_KEY_VOLDN,
+		.active_low = 1,
+		.desc = "Volume Down",
+		.type = EV_KEY,
+		.wakeup = 0,
+		.debounce_interval = 15,
+	},
+};
+
+static const struct gpio_keys_platform_data santos10_gpio_keys_vol_pdata = {
+	.buttons = santos10_gpio_buttons_vol,
+	.nbuttons = ARRAY_SIZE(santos10_gpio_buttons_vol),
+	.rep = 1,
+	.name = "sec_key_vol",
+};
+
+struct santos10_power_data {
+	struct platform_device *pdev_keys_pwr;
+	struct platform_device *pdev_keys_vol;
+	struct i2c_client *client_pmic;
+	struct i2c_client *client_fg;
+};
+
+static int santos10_power_board_probe(struct platform_device *pdev)
+{
+	struct santos10_power_data *priv;
+	struct i2c_adapter *adap6, *adap7;
+	struct i2c_board_info info_pmic, info_fg;
+	int irq_pmic, irq_fg, ret;
+
+	/* Verify GPIO dependencies */
+	if (!gpio_to_desc(SANTOS10_GPIO_PMIC_IRQ) ||
+	    !gpio_to_desc(SANTOS10_GPIO_FG_IRQ) ||
+	    !gpio_to_desc(SANTOS10_GPIO_KEY_PWR))
+		return dev_err_probe(&pdev->dev, -EPROBE_DEFER,
+				     "waiting for AON gpiochip\n");
+
+	/* The PMIC interrupt line must be an input before gpio_to_irq(). */
+	ret = devm_gpio_request_one(&pdev->dev, SANTOS10_GPIO_PMIC_IRQ,
+				    GPIOF_IN, "IF_PMIC_IRQ");
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to prepare PMIC IRQ GPIO\n");
+
+	irq_pmic = gpio_to_irq(SANTOS10_GPIO_PMIC_IRQ);
+	if (irq_pmic < 0)
+		return dev_err_probe(&pdev->dev, irq_pmic,
+				     "waiting for PMIC IRQ\n");
+
+	ret = irq_set_irq_type(irq_pmic, IRQ_TYPE_EDGE_FALLING);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to set PMIC IRQ trigger\n");
+
+	irq_fg = gpio_to_irq(SANTOS10_GPIO_FG_IRQ);
+	if (irq_fg < 0)
+		return dev_err_probe(&pdev->dev, irq_fg,
+				     "waiting for FG IRQ\n");
+
+	/* Verify I2C adapters */
+	adap6 = i2c_get_adapter(SANTOS10_BUS_PMIC);
+	if (!adap6)
+		return dev_err_probe(&pdev->dev, -EPROBE_DEFER,
+				     "waiting for i2c-%d\n", SANTOS10_BUS_PMIC);
+
+	adap7 = i2c_get_adapter(SANTOS10_BUS_FG);
+	if (!adap7) {
+		i2c_put_adapter(adap6);
+		return dev_err_probe(&pdev->dev, -EPROBE_DEFER,
+				     "waiting for i2c-%d\n", SANTOS10_BUS_FG);
+	}
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv) {
+		i2c_put_adapter(adap6);
+		i2c_put_adapter(adap7);
+		return -ENOMEM;
+	}
+
+	/* Register MAX77693 */
+	memset(&info_pmic, 0, sizeof(info_pmic));
+	strscpy(info_pmic.type, "max77693", sizeof(info_pmic.type));
+	info_pmic.addr = SANTOS10_ADDR_PMIC;
+	info_pmic.irq = irq_pmic;
+
+	priv->client_pmic = i2c_new_client_device(adap6, &info_pmic);
+	i2c_put_adapter(adap6);
+	if (IS_ERR(priv->client_pmic)) {
+		i2c_put_adapter(adap7);
+		return dev_err_probe(&pdev->dev, PTR_ERR(priv->client_pmic),
+				     "failed to create max77693 client\n");
+	}
+
+	/* Register MAX17050 */
+	memset(&info_fg, 0, sizeof(info_fg));
+	strscpy(info_fg.type, "max17050", sizeof(info_fg.type));
+	info_fg.addr = SANTOS10_ADDR_FG;
+	info_fg.irq = irq_fg;
+
+	priv->client_fg = i2c_new_client_device(adap7, &info_fg);
+	i2c_put_adapter(adap7);
+	if (IS_ERR(priv->client_fg)) {
+		i2c_unregister_device(priv->client_pmic);
+		return dev_err_probe(&pdev->dev, PTR_ERR(priv->client_fg),
+				     "failed to create max17050 client\n");
+	}
+
+	/* Register gpio-keys: Power and Home (rep = 0) */
+	priv->pdev_keys_pwr = platform_device_register_data(&pdev->dev, "gpio-keys", 0,
+							    &santos10_gpio_keys_pwr_home_pdata,
+							    sizeof(santos10_gpio_keys_pwr_home_pdata));
+	if (IS_ERR(priv->pdev_keys_pwr))
+		dev_warn(&pdev->dev, "failed to register gpio-keys pwr/home: %ld\n",
+			 PTR_ERR(priv->pdev_keys_pwr));
+
+	/* Register gpio-keys: Volume Up and Down (rep = 1) */
+	priv->pdev_keys_vol = platform_device_register_data(&pdev->dev, "gpio-keys", 1,
+							    &santos10_gpio_keys_vol_pdata,
+							    sizeof(santos10_gpio_keys_vol_pdata));
+	if (IS_ERR(priv->pdev_keys_vol))
+		dev_warn(&pdev->dev, "failed to register gpio-keys volume: %ld\n",
+			 PTR_ERR(priv->pdev_keys_vol));
+
+	platform_set_drvdata(pdev, priv);
+	dev_info(&pdev->dev, "power board active: PMIC i2c-%d virq=%d, FG i2c-%d virq=%d, keys registered (pwr/home rep=0, vol rep=1)\n",
+		 SANTOS10_BUS_PMIC, irq_pmic, SANTOS10_BUS_FG, irq_fg);
+	return 0;
+}
+
+static struct platform_driver santos10_power_board_driver = {
+	.probe = santos10_power_board_probe,
+	.driver = {
+		.name = "santos10-power-board",
+	},
+};
+
+static int __init santos10_power_board_init(void)
+{
+	gpiod_add_lookup_table(&santos10_i2c6_gpios);
+	platform_device_register_full(&santos10_i2c6_devinfo);
+
+	gpiod_add_lookup_table(&santos10_i2c7_gpios);
+	platform_device_register_full(&santos10_i2c7_devinfo);
+
+	platform_driver_register(&santos10_power_board_driver);
+	platform_device_register_simple("santos10-power-board", -1, NULL, 0);
+
+	return 0;
+}
+late_initcall(santos10_power_board_init);
+
+MODULE_AUTHOR("Antigravity");
+MODULE_DESCRIPTION("Samsung Santos10 Power Board Integration");
+MODULE_LICENSE("GPL");
diff --git a/arch/x86/platform/intel-mid/santos10-sec-log.c b/arch/x86/platform/intel-mid/santos10-sec-log.c
new file mode 100644
index 0000000000000000000000000000000000000000..c0de654e277f4518c5dd18dc324a93cf41285d4a
--- /dev/null
+++ b/arch/x86/platform/intel-mid/santos10-sec-log.c
@@ -0,0 +1,695 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung Santos10 persistent sec_log compatibility console.
+ *
+ * The shipping boot chain and Linux 3.4 kernel share a persistent ring at
+ * the physical range provided by sec_log=<size>@<address>.  Santos10 uses
+ * 2052K@0x10000000: a 4 KiB metadata page followed by a 2 MiB byte ring.
+ * The monotonically increasing u32 write count lives at metadata offset +4.
+ *
+ * Keep this deliberately small.  It only reserves the supplied RAM range
+ * and appends printk console bytes in the legacy layout.  It does not expose
+ * proc/sysfs nodes, reset the ring, or pull in Samsung SEC_DEBUG machinery.
+ */
+
+#define pr_fmt(fmt) "santos10-sec-log: " fmt
+
+#include <linux/atomic.h>
+#include <linux/bitops.h>
+#include <linux/cacheflush.h>
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/log2.h>
+#include <linux/memblock.h>
+#include <linux/mm.h>
+#include <linux/panic.h>
+#include <linux/preempt.h>
+#include <linux/printk.h>
+#include <linux/sizes.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+#include <asm/e820/api.h>
+#include <asm/page.h>
+#include <asm/setup.h>
+
+#define SANTOS10_SEC_LOG_META_SIZE	SZ_4K
+
+static phys_addr_t sec_log_phys __initdata;
+static size_t sec_log_total_size __initdata;
+static size_t sec_log_data_size;
+static size_t sec_log_mask;
+static u32 *sec_log_count;
+static char *sec_log_data;
+static bool sec_log_registered;
+
+static void santos10_sec_log_flush(void *addr, size_t len)
+{
+	unsigned long p = (unsigned long)addr;
+	unsigned long end = p + len;
+
+	for (p &= ~63UL; p < end; p += 64)
+		asm volatile("clflush %0" : "+m" (*(char *)p));
+	asm volatile("mfence" : : : "memory");
+}
+
+/*
+ * Lock-free tagged reservation with a bounded unpublished window,
+ * strict contiguous publication and an authorised last-gasp seal.
+ *
+ * Every writer (printk console callback, emergency mailbox, scon tty)
+ * reserves a unique chunk with one lock-free CAS-retry on the packed
+ * head and claims a table slot with a tagged CAS.  The slot tag carries
+ * the chunk end, a slot generation and a state, so a writer that was
+ * frozen and later resumes cannot complete or corrupt a slot that has
+ * been retired or reused.  A chunk is marked complete only after its
+ * bytes were flushed, and the visible count is only advanced to the end
+ * of the contiguous run of complete chunks: ordinary publication never
+ * advertises bytes that have not reached RAM and never regresses.
+ *
+ * Circular-ring invariant: the persistent ring is 2 MiB and the legacy
+ * reader reconstructs the whole ring from the persistent count, so an
+ * unpublished byte cursor running beyond count can physically alias
+ * already-published recovery content even while count is frozen.  The
+ * reservation therefore refuses ordinary writers once the unpublished
+ * distance would exceed sec_log_unpublished_max (a quarter of the data
+ * ring).  Outstanding, dropped or refused ordinary traffic can then
+ * alias only the oldest quarter of the recoverable log; the newest
+ * three quarters - and therefore any committed marker or sealed
+ * last-gasp tail - stay physically intact.
+ *
+ * A permanently stalled writer still blocks contiguous publication of
+ * every later chunk, so with only a legacy contiguous u32 count a later
+ * record cannot be both contiguous and visible.  The last-gasp mailbox
+ * (A44 stall timer, A49 EHCI storm) resolves this in favour of the
+ * recovery contract: it reserves regardless of the window (its seal
+ * resets the window), seals, i.e. advances the persistent count to its
+ * own flushed end, retires the unresolved prefix and moves the
+ * publication frontier past itself.  Deliberate tradeoff: the sealed
+ * prefix is whatever is already in RAM - bytes older writers flushed, or
+ * stale bytes - so the legacy log may show a partial or stale line
+ * there.  Because the pre-seal backlog is bounded below the ring size,
+ * an older stalled range is logically before the last-gasp record and
+ * cannot alias its physical position.
+ *
+ * Ordinary writers never seal.  When a slot cannot be claimed (genuine
+ * capacity exhaustion, stale occupants are reclaimed first) the bytes
+ * are still stored inside the bounded window but the record is dropped
+ * and publication stops there until an authorised last-gasp seal retires
+ * the range; the record is never silently omitted from an otherwise
+ * publishable stream.  Refusing a reservation is not an error path: it
+ * bounds physical aliasing when publication is stalled.
+ *
+ * The reservation is a 64-bit CAS retry loop on x86-32: lock-free (no
+ * owner lock is held by a frozen peer), but it retries under contention,
+ * so it is not formally wait-free.  No path sleeps, and no path waits for
+ * another writer's completion state.
+ */
+/* --- L06 host-test extractable state (keep markers) --- */
+#define SANTOS10_SEC_LOG_CHUNK_MAX	SZ_512
+#define SANTOS10_SEC_LOG_CHUNK_SHIFT	10
+#define SANTOS10_SEC_LOG_CHUNK_RECORDS	(1U << SANTOS10_SEC_LOG_CHUNK_SHIFT)
+#define SANTOS10_SEC_LOG_CHUNK_MASK	(SANTOS10_SEC_LOG_CHUNK_RECORDS - 1)
+
+#define SANTOS10_SEC_LOG_SLOT_FREE	0U
+#define SANTOS10_SEC_LOG_SLOT_CLAIMED	1U
+#define SANTOS10_SEC_LOG_SLOT_COMPLETE	2U
+
+struct santos10_sec_log_chunk {
+	/* (end << 32) | (generation << 2) | state */
+	atomic64_t tag;
+};
+
+static atomic64_t sec_log_head = ATOMIC64_INIT(0);
+static atomic_t sec_log_publish = ATOMIC_INIT(0);
+static struct santos10_sec_log_chunk sec_log_chunks[SANTOS10_SEC_LOG_CHUNK_RECORDS];
+static atomic_t sec_log_seals = ATOMIC_INIT(0);
+static atomic_t sec_log_reclaimed = ATOMIC_INIT(0);
+static atomic_t sec_log_dropped = ATOMIC_INIT(0);
+static atomic_t sec_log_refused = ATOMIC_INIT(0);
+static atomic_t sec_log_abandoned = ATOMIC_INIT(0);
+static size_t sec_log_unpublished_max;
+static size_t sec_log_residency_margin;
+/*
+ * Physical write hazards.  A reserved ticket is a hazard until its writer
+ * is done touching the ring (finalized), because a stalled writer can
+ * resume and store into its reserved bytes at any time.  sec_log_hazard
+ * packs the start byte and ticket of the oldest unfinalized reservation:
+ * no ordinary reservation may advance the head within
+ * sec_log_residency_margin of wrapping onto that range, so a live hazard
+ * always stays physically resident.  Finalized tickets are recorded in
+ * sec_log_final; sec_log_rec_start carries each ticket's start for the
+ * floor advance.
+ */
+static atomic64_t sec_log_hazard = ATOMIC64_INIT(0);
+static unsigned long sec_log_final[BITS_TO_LONGS(SANTOS10_SEC_LOG_CHUNK_RECORDS)];
+static u32 sec_log_rec_start[SANTOS10_SEC_LOG_CHUNK_RECORDS];
+/* --- end L06 host-test extractable state --- */
+
+static u64 santos10_sec_log_slot_tag(u32 ticket, u32 end, u32 state)
+{
+	return ((u64)end << 32) |
+	       ((u64)(ticket >> SANTOS10_SEC_LOG_CHUNK_SHIFT) << 2) |
+	       state;
+}
+
+static u32 santos10_sec_log_tag_state(u64 tag)
+{
+	return (u32)(tag & 3);
+}
+
+static u32 santos10_sec_log_tag_end(u64 tag)
+{
+	return (u32)(tag >> 32);
+}
+
+static u32 santos10_sec_log_tag_gen(u64 tag)
+{
+	return (u32)((tag >> 2) & 0x3fffffff);
+}
+
+static void santos10_sec_log_count_advance(u32 end)
+{
+	for (;;) {
+		u32 cur = READ_ONCE(*sec_log_count);
+
+		if ((s32)(end - cur) <= 0)
+			return;
+		if (cmpxchg(sec_log_count, cur, end) == cur) {
+			santos10_sec_log_flush(sec_log_count,
+					       sizeof(*sec_log_count));
+			return;
+		}
+	}
+}
+
+/*
+ * The publication frontier is monotonic: a seal that finishes late (or an
+ * older seal racing a newer one) must never move it backwards.  A record
+ * behind the frontier has been published or sealed and can never become
+ * current again.
+ */
+static void santos10_sec_log_publish_advance(u32 target)
+{
+	for (;;) {
+		u32 cur = (u32)atomic_read(&sec_log_publish);
+
+		if ((s32)(target - cur) <= 0)
+			return;
+		if (atomic_cmpxchg(&sec_log_publish, cur, target) == cur)
+			return;
+	}
+}
+
+static bool santos10_sec_log_obsolete(u32 ticket)
+{
+	u32 frontier = (u32)atomic_read(&sec_log_publish);
+
+	return (s32)(frontier - ticket) > 0;
+}
+
+static void santos10_sec_log_retire_slot(struct santos10_sec_log_chunk *chunk,
+					 u64 tag)
+{
+	atomic64_cmpxchg(&chunk->tag, tag, 0);
+}
+
+static void santos10_sec_log_seal(u32 ticket, u32 end)
+{
+	unsigned int i;
+
+	/*
+	 * Publish the count first: if the frontier moved before the count,
+	 * an ordinary publisher at the new frontier could CAS the count
+	 * straight to a later record end and skip this seal's range (or an
+	 * unfinished gap in it).  With the count already at this chunk's
+	 * flushed end, such a CAS fails the monotonic guard and the
+	 * publisher simply drops out.
+	 */
+	santos10_sec_log_count_advance(end);
+	santos10_sec_log_publish_advance(ticket + 1);
+
+	/*
+	 * Retire every record up to and including this chunk.  The bytes of
+	 * an older record are already in RAM: a writer flushes its copy
+	 * before it installs its state, and an interrupted copy leaves
+	 * stale bytes (the documented A44 tradeoff).
+	 */
+	for (i = 0; i < SANTOS10_SEC_LOG_CHUNK_RECORDS; i++) {
+		u64 tag = atomic64_read(&sec_log_chunks[i].tag);
+		u32 t;
+
+		if (santos10_sec_log_tag_state(tag) !=
+		    SANTOS10_SEC_LOG_SLOT_COMPLETE)
+			continue;	/* CLAIMED stays a physical hazard */
+		t = (santos10_sec_log_tag_gen(tag) <<
+		     SANTOS10_SEC_LOG_CHUNK_SHIFT) | i;
+		if ((s32)(ticket - t) >= 0)
+			santos10_sec_log_retire_slot(&sec_log_chunks[i], tag);
+	}
+
+	atomic_inc(&sec_log_seals);
+}
+
+static void santos10_sec_log_publish(void)
+{
+	for (;;) {
+		u32 ticket = (u32)atomic_read(&sec_log_publish);
+		struct santos10_sec_log_chunk *chunk =
+			&sec_log_chunks[ticket & SANTOS10_SEC_LOG_CHUNK_MASK];
+		u64 tag = atomic64_read(&chunk->tag);
+		u32 cur, end;
+
+		if (santos10_sec_log_tag_gen(tag) !=
+		    (ticket >> SANTOS10_SEC_LOG_CHUNK_SHIFT) ||
+		    santos10_sec_log_tag_state(tag) !=
+		    SANTOS10_SEC_LOG_SLOT_COMPLETE)
+			return;
+
+		end = santos10_sec_log_tag_end(tag);
+		if (atomic_cmpxchg(&sec_log_publish, ticket, ticket + 1) != ticket)
+			continue;
+
+		cur = READ_ONCE(*sec_log_count);
+		if ((s32)(end - cur) > 0 &&
+		    cmpxchg(sec_log_count, cur, end) == cur)
+			santos10_sec_log_flush(sec_log_count,
+					       sizeof(*sec_log_count));
+
+		atomic64_cmpxchg(&chunk->tag, tag, 0);
+	}
+}
+
+static bool santos10_sec_log_claim(u32 ticket, u32 end)
+{
+	struct santos10_sec_log_chunk *chunk =
+		&sec_log_chunks[ticket & SANTOS10_SEC_LOG_CHUNK_MASK];
+	u64 expected = 0;
+
+	return atomic64_try_cmpxchg(&chunk->tag, &expected,
+			santos10_sec_log_slot_tag(ticket, end,
+						  SANTOS10_SEC_LOG_SLOT_CLAIMED));
+}
+
+static bool santos10_sec_log_complete(u32 ticket, u32 end)
+{
+	struct santos10_sec_log_chunk *chunk =
+		&sec_log_chunks[ticket & SANTOS10_SEC_LOG_CHUNK_MASK];
+	u64 expected = santos10_sec_log_slot_tag(ticket, end,
+						 SANTOS10_SEC_LOG_SLOT_CLAIMED);
+
+	return atomic64_try_cmpxchg(&chunk->tag, &expected,
+			santos10_sec_log_slot_tag(ticket, end,
+						  SANTOS10_SEC_LOG_SLOT_COMPLETE));
+}
+
+/*
+ * A claim collision is either stale metadata (the occupant ticket is
+ * already behind the publication frontier, e.g. a writer that passed its
+ * early obsolete check and was later sealed) or genuine capacity
+ * exhaustion.  Stale metadata is reclaimed and the claim retried; only
+ * genuine exhaustion is reported to the caller.
+ */
+static bool santos10_sec_log_claim_or_reclaim(u32 ticket, u32 end)
+{
+	for (;;) {
+		struct santos10_sec_log_chunk *chunk;
+		u64 tag;
+		u32 frontier, t, state;
+
+		if (santos10_sec_log_claim(ticket, end))
+			return true;
+
+		chunk = &sec_log_chunks[ticket & SANTOS10_SEC_LOG_CHUNK_MASK];
+		tag = atomic64_read(&chunk->tag);
+		state = santos10_sec_log_tag_state(tag);
+		if (state == SANTOS10_SEC_LOG_SLOT_FREE)
+			continue;	/* raced with a retire: retry claim */
+
+		t = (santos10_sec_log_tag_gen(tag) <<
+		     SANTOS10_SEC_LOG_CHUNK_SHIFT) |
+		    (ticket & SANTOS10_SEC_LOG_CHUNK_MASK);
+		frontier = (u32)atomic_read(&sec_log_publish);
+		if (state == SANTOS10_SEC_LOG_SLOT_COMPLETE &&
+		    (s32)(frontier - t) > 0) {
+			/* obsolete completion metadata: safe to reclaim */
+			if (atomic64_cmpxchg(&chunk->tag, tag, 0) == tag)
+				atomic_inc(&sec_log_reclaimed);
+			continue;
+		}
+
+		/* a CLAIMED slot is a live write hazard: never reclaim */
+		return false;	/* busy hazard / genuine exhaustion */
+	}
+}
+
+static void santos10_sec_log_hazard_advance(void)
+{
+	for (;;) {
+		u64 hz = atomic64_read(&sec_log_hazard);
+		u64 head = atomic64_read(&sec_log_head);
+		u32 ticket = (u32)hz;
+		u32 start = (u32)(hz >> 32);
+		u32 head_ticket = (u32)head;
+		u32 head_start = (u32)(head >> 32);
+		u64 next;
+
+		while (ticket < head_ticket &&
+		       test_and_clear_bit(ticket & SANTOS10_SEC_LOG_CHUNK_MASK,
+					  sec_log_final)) {
+			ticket++;
+			start = (ticket == head_ticket) ?
+					head_start :
+					sec_log_rec_start[ticket &
+						SANTOS10_SEC_LOG_CHUNK_MASK];
+		}
+		if (ticket == head_ticket)
+			start = head_start;
+		next = ((u64)start << 32) | ticket;
+		if (atomic64_try_cmpxchg(&sec_log_hazard, &hz, next))
+			return;
+	}
+}
+
+/*
+ * Mark this ticket as no longer touching the ring and release its hazard.
+ */
+static void santos10_sec_log_finalize(u32 ticket)
+{
+	set_bit(ticket & SANTOS10_SEC_LOG_CHUNK_MASK, sec_log_final);
+	santos10_sec_log_hazard_advance();
+}
+
+/*
+ * Reserve a unique, ordered byte range and a ticket with one lock-free
+ * CAS-retry on the packed head.  Ordinary writers are refused once the
+ * unpublished distance would exceed sec_log_unpublished_max; the 2 MiB
+ * circular ring then cannot have future/hidden traffic alias the newest
+ * 3/4 of the recoverable log (and never the last-gasp tail).  The
+ * last-gasp path reserves regardless: it seals immediately, which resets
+ * the window, and its own record is logically after every older writer,
+ * so an older stalled range cannot alias it once the backlog is below the
+ * ring size.
+ */
+static bool santos10_sec_log_reserve(unsigned int count, bool force,
+				     u32 *ticket, u32 *start)
+{
+	for (;;) {
+		u64 head = atomic64_read(&sec_log_head);
+		u64 next;
+		u32 first, t, window, cur;
+
+		first = (u32)(head >> 32);
+		t = (u32)head;
+		if (!force) {
+			u64 hazard = atomic64_read(&sec_log_hazard);
+			u32 hstart = (u32)(hazard >> 32);
+			u32 hticket = (u32)hazard;
+
+			cur = READ_ONCE(*sec_log_count);
+			window = first - cur;
+			if (window > sec_log_unpublished_max ||
+			    count > sec_log_unpublished_max - window)
+				return false;
+			/*
+			 * Never wrap onto a live physical write hazard:
+			 * its table slot would be hit again after
+			 * SANTOS10_SEC_LOG_CHUNK_RECORDS tickets, and its
+			 * ring bytes after one data_size of reservations.
+			 */
+			if ((u32)(t - hticket) >=
+			    SANTOS10_SEC_LOG_CHUNK_RECORDS)
+				return false;
+			if ((u32)(first - hstart) + count >
+			    sec_log_data_size - sec_log_residency_margin)
+				return false;
+		}
+		next = ((u64)(first + count) << 32) | (u64)(t + 1);
+		if (atomic64_try_cmpxchg(&sec_log_head, &head, next)) {
+			*ticket = t;
+			*start = first;
+			return true;
+		}
+	}
+}
+
+static void santos10_sec_log_store(const char *s, u32 start,
+				   unsigned int count)
+{
+	size_t first, pos;
+
+	pos = start & sec_log_mask;
+	first = min_t(size_t, count, sec_log_data_size - pos);
+	memcpy(sec_log_data + pos, s, first);
+	santos10_sec_log_flush(sec_log_data + pos, first);
+	if (count > first) {
+		memcpy(sec_log_data, s + first, count - first);
+		santos10_sec_log_flush(sec_log_data, count - first);
+	}
+}
+
+static void __santos10_sec_log_write_chunk(const char *s, unsigned int count,
+					   bool last_gasp)
+{
+	u32 ticket, start, end;
+
+	preempt_disable();
+
+	if (!santos10_sec_log_reserve(count, last_gasp, &ticket, &start)) {
+		/*
+		 * Unpublished window or physical-hazard bound full: refuse
+		 * without consuming a byte range or touching the ring.
+		 */
+		atomic_inc(&sec_log_refused);
+		preempt_enable();
+		return;
+	}
+	end = start + count;
+	/*
+	 * This ticket is now a physical write hazard until finalized: a
+	 * stalled writer may resume and store here at any time.
+	 */
+	sec_log_rec_start[ticket & SANTOS10_SEC_LOG_CHUNK_MASK] = start;
+	smp_wmb();
+
+	/*
+	 * A seal that already advanced the frontier past this ticket owns
+	 * this range logically.  An obsolete ordinary writer does not
+	 * install metadata or move the frontier.  An obsolete *authorised
+	 * last-gasp* writer still restores its bytes while they are
+	 * resident; the hazard floor guarantees residency for a live
+	 * ticket, and the check below is the belt-and-braces bound.
+	 */
+	if (unlikely(santos10_sec_log_obsolete(ticket))) {
+		if (last_gasp) {
+			u64 head = atomic64_read(&sec_log_head);
+			u32 count_now = READ_ONCE(*sec_log_count);
+			u32 first = (u32)(head >> 32);
+
+			if ((s32)(count_now - end) >= 0 &&
+			    (u32)(first - start) <=
+				    sec_log_data_size - sec_log_residency_margin)
+				santos10_sec_log_store(s, start, count);
+			else
+				atomic_inc(&sec_log_abandoned);
+		}
+		goto finalize;
+	}
+
+	/*
+	 * Claim the slot before copying so a stalled writer owns its slot;
+	 * a later ticket that wraps onto it then sees a live hazard instead
+	 * of stealing the slot from the stalled writer.  Only obsolete
+	 * COMPLETE metadata is reclaimable; CLAIMED is never reclaimed.
+	 */
+	if (unlikely(!santos10_sec_log_claim_or_reclaim(ticket, end))) {
+		santos10_sec_log_store(s, start, count);
+
+		if (last_gasp)
+			santos10_sec_log_seal(ticket, end);
+		else
+			atomic_inc(&sec_log_dropped);
+		goto finalize;
+	}
+
+	santos10_sec_log_store(s, start, count);
+
+	if (unlikely(!santos10_sec_log_complete(ticket, end)))
+		goto finalize;
+
+	if (unlikely(santos10_sec_log_obsolete(ticket))) {
+		/* count already covers it; retire our own COMPLETE metadata */
+		struct santos10_sec_log_chunk *chunk =
+			&sec_log_chunks[ticket & SANTOS10_SEC_LOG_CHUNK_MASK];
+
+		santos10_sec_log_retire_slot(chunk,
+			santos10_sec_log_slot_tag(ticket, end,
+						  SANTOS10_SEC_LOG_SLOT_COMPLETE));
+		goto finalize;
+	}
+
+	santos10_sec_log_publish();
+
+	if (last_gasp && (s32)(end - READ_ONCE(*sec_log_count)) > 0)
+		santos10_sec_log_seal(ticket, end);
+
+finalize:
+	santos10_sec_log_finalize(ticket);
+	preempt_enable();
+}
+
+static void __santos10_sec_log_write_nolock(const char *s,
+					      unsigned int count,
+					      bool last_gasp)
+{
+	if (!sec_log_data || !sec_log_count || !count)
+		return;
+
+	while (count) {
+		unsigned int n = min_t(unsigned int, count,
+				       SANTOS10_SEC_LOG_CHUNK_MAX);
+
+		__santos10_sec_log_write_chunk(s, n, last_gasp);
+		s += n;
+		count -= n;
+	}
+}
+
+static void santos10_sec_log_write(struct console *console, const char *s,
+				   unsigned int count)
+{
+	__santos10_sec_log_write_nolock(s, count, false);
+}
+
+#ifdef CONFIG_X86_SANTOS10
+/*
+ * Diagnostic A44: last-gasp mailbox for the initcall stall detector and
+ * the EHCI IRQ-storm watchdog.  Bypasses printk and console_lock entirely
+ * and appends directly to the persistent ring.  If the console path is
+ * wedged (e.g. console_lock held forever by a hung CPU) while timers
+ * still run, the STALL line still lands in DRAM before the warm reset,
+ * and the seal makes the persistent count cover it even when an older
+ * writer never completes.  A present STALL line with no corresponding
+ * printk output proves the machine was alive and only the console path
+ * was dead.
+ */
+void santos10_sec_log_emergency_write(const char *s, unsigned int count);
+void santos10_sec_log_emergency_write(const char *s, unsigned int count)
+{
+	__santos10_sec_log_write_nolock(s, count, false);
+}
+
+void santos10_sec_log_last_gasp_write(const char *s, unsigned int count);
+void santos10_sec_log_last_gasp_write(const char *s, unsigned int count)
+{
+	__santos10_sec_log_write_nolock(s, count, true);
+}
+#endif
+
+static struct console santos10_sec_log_console = {
+	.name = "sec_log_buf",
+	.write = santos10_sec_log_write,
+	.flags = CON_PRINTBUFFER | CON_ENABLED | CON_ANYTIME | CON_BOOT,
+	.index = -1,
+};
+
+static int __init santos10_sec_log_setup(char *str)
+{
+	unsigned long long parsed_phys;
+	unsigned long long parsed_size;
+	char *end;
+	void *base;
+
+	if (!str || sec_log_registered)
+		return 0;
+
+	santos_early_c_trace('L');
+
+	parsed_size = memparse(str, &end);
+	if (!parsed_size || *end != '@')
+		goto invalid;
+
+	if (kstrtoull(end + 1, 0, &parsed_phys))
+		goto invalid;
+
+	if (parsed_size > SIZE_MAX ||
+	    (phys_addr_t)parsed_phys != parsed_phys)
+		goto invalid;
+
+	sec_log_phys = (phys_addr_t)parsed_phys;
+	sec_log_total_size = (size_t)parsed_size;
+
+	if (!IS_ALIGNED(sec_log_phys, PAGE_SIZE) ||
+	    !IS_ALIGNED(sec_log_total_size, PAGE_SIZE) ||
+	    sec_log_total_size <= SANTOS10_SEC_LOG_META_SIZE)
+		goto invalid_reset;
+
+	sec_log_data_size = sec_log_total_size - SANTOS10_SEC_LOG_META_SIZE;
+	if (!is_power_of_2(sec_log_data_size))
+		goto invalid_reset;
+
+	if (!e820__mapped_all(sec_log_phys, sec_log_phys + sec_log_total_size, E820_TYPE_RAM)) {
+		pr_err("range %pa+%zx is not System RAM in e820\n",
+		       &sec_log_phys, sec_log_total_size);
+		goto invalid_reset;
+	}
+
+	if (memblock_reserve(sec_log_phys, sec_log_total_size)) {
+		pr_err("failed to reserve %pa+%zx in memblock\n",
+		       &sec_log_phys, sec_log_total_size);
+		goto invalid_reset;
+	}
+
+	/* Santos10 sec_log lives in low directly mapped RAM. */
+	base = __va(sec_log_phys);
+	sec_log_count = (u32 *)(base + sizeof(u32));
+	sec_log_data = (char *)base + SANTOS10_SEC_LOG_META_SIZE;
+	sec_log_mask = sec_log_data_size - 1;
+
+	/*
+	 * Continue the persistent count: the reservation keeps the byte
+	 * offset in its upper half; tickets start at zero for this boot.
+	 * Must be set before register_console() replays the printk buffer.
+	 * A sealed last-gasp record from a previous boot is preserved
+	 * because the byte cursor resumes at the published count.
+	 */
+	sec_log_unpublished_max = sec_log_data_size / 4;
+	sec_log_residency_margin = sec_log_data_size / 8;
+	atomic64_set(&sec_log_hazard,
+		     (u64)READ_ONCE(*sec_log_count) << 32);
+	memset(sec_log_final, 0, sizeof(sec_log_final));
+	memset(sec_log_rec_start, 0, sizeof(sec_log_rec_start));
+	atomic64_set(&sec_log_head,
+		     (u64)READ_ONCE(*sec_log_count) << 32);
+	atomic_set(&sec_log_publish, 0);
+	memset(sec_log_chunks, 0, sizeof(sec_log_chunks));
+
+	/* The shipping cmdline contains loglevel=0; bring-up needs full replay. */
+	santos10_force_console_verbose();
+	panic_timeout = 5;
+	add_preferred_console("sec_log_buf", 0, NULL);
+	register_console(&santos10_sec_log_console);
+	sec_log_registered = true;
+	santos_early_c_trace('!');
+
+	console_lock();
+	console_unlock();
+
+	pr_notice("persistent console active at %pa+%zx, data=%zx count=%u\n",
+		  &sec_log_phys, sec_log_total_size, sec_log_data_size,
+		  READ_ONCE(*sec_log_count));
+	return 0;
+
+invalid_reset:
+	santos_early_c_trace('?');
+	sec_log_phys = 0;
+	sec_log_total_size = 0;
+	sec_log_data_size = 0;
+invalid:
+	santos_early_c_trace('?');
+	pr_err("invalid sec_log parameter '%s'\n", str ?: "<null>");
+	return 0;
+}
+early_param("sec_log", santos10_sec_log_setup);
diff --git a/arch/x86/platform/intel-mid/santos10-touch-board.c b/arch/x86/platform/intel-mid/santos10-touch-board.c
new file mode 100644
index 0000000000000000000000000000000000000000..77bc97112101bf32b5b4e4126c90f969c1ec2e71
--- /dev/null
+++ b/arch/x86/platform/intel-mid/santos10-touch-board.c
@@ -0,0 +1,209 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * santos10-touch-board: static I2C client for the mxt1188s.
+ *
+ * Golden maps it to SFI bus 2 (2-004a); 7.2 has no SFI-dev support, so
+ * instantiate statically once the adapter exists. TSP power sequencing
+ * (EN -> EN2 -> RST, vendor order) lives in santos10-touch-pwr; by the
+ * time the adapter is up the chip is alive.
+ * IRQ comes from the langwell demux (TSP_INT = global GPIO 62).
+ * Driver: mainline atmel_mxt_ts (board type string match).
+ *
+ * The i2c adapter, the AON gpiochip (IRQ) and the touch power rails are
+ * device dependencies: a one-shot gpio_to_irq() after a fixed adapter wait
+ * loses touch for the whole boot if the gpiochip is not registered yet,
+ * and the 30 s chip-ACK poll cannot substitute for power that arrives
+ * after it expired (the probe has already bound; no new thread starts).
+ * This is a platform driver instead; probe defers (-EPROBE_DEFER) until
+ * all three suppliers are ready and the driver core re-probes when they
+ * bind.  Only then is the readiness-poll thread started.
+ */
+#define pr_fmt(fmt) "santos10-touchboard: " fmt
+
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/gpio.h>
+#include <linux/i2c.h>
+#include <linux/init.h>
+#include <linux/input-event-codes.h>
+#include <linux/kthread.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+#include <linux/string.h>
+
+extern bool santos10_touch_power_ready(void);
+
+#define SANTOS10_TOUCH_BUS	2
+#define SANTOS10_TOUCH_ADDR	0x4a
+#define SANTOS10_TSP_INT_GPIO	62
+#define SANTOS10_POLL_MS	500
+#define SANTOS10_TIMEOUT_MS	30000
+
+/*
+ * Golden board-santos10-input.c exposes six T15 Key Array entries in this
+ * order: dummy_home1, dummy_home2, dummy_menu, dummy_back, menu, back.
+ * Mainline atmel_mxt_ts consumes one linux,keycodes entry per T15 bit and has
+ * no golden dummy metadata. KEY_RESERVED preserves the four dummy bit slots
+ * without enabling an input key; the final two entries are real Menu/Back.
+ */
+static const u32 santos10_touch_keycodes[] = {
+	KEY_RESERVED,	/* dummy_home1, mask 0x01 */
+	KEY_RESERVED,	/* dummy_home2, mask 0x02 */
+	KEY_RESERVED,	/* dummy_menu,  mask 0x04 */
+	KEY_RESERVED,	/* dummy_back,  mask 0x08 */
+	KEY_MENU,	/* menu,        mask 0x10 */
+	KEY_BACK,	/* back,        mask 0x20 */
+};
+
+/* Mainline atmel_mxt refuses devices without a "compatible" property
+ * (fails -ENXIO before any I2C). Our static client has no firmware
+ * node, so attach a software node.
+ * atmel,wakeup-method=1 (I2C_SCL): the 1188S dozes after seconds idle;
+ * without this the driver's wake-and-retry stays disabled. */
+static const struct property_entry santos10_touch_props[] = {
+	PROPERTY_ENTRY_STRING("compatible", "atmel,maxtouch"),
+	PROPERTY_ENTRY_U32_ARRAY("linux,keycodes", santos10_touch_keycodes),
+	PROPERTY_ENTRY_U32("atmel,wakeup-method", 1),
+	{ }
+};
+
+static const struct software_node santos10_touch_swnode = {
+	.name = "mxt1188s",
+	.properties = santos10_touch_props,
+};
+
+static int santos10_touchboard_thread(void *arg)
+{
+	int irq = (int)(long)arg;
+	struct i2c_adapter *adap;
+	struct i2c_board_info info;
+	struct i2c_client *client;
+	union i2c_smbus_data dummy;
+	unsigned long waited = 0;
+	int rc;
+
+	memset(&info, 0, sizeof(info));
+	strscpy(info.type, "atmel_mxt_ts", sizeof(info.type));
+	info.addr = SANTOS10_TOUCH_ADDR;
+	info.swnode = &santos10_touch_swnode;
+	info.irq = irq;
+
+	while (waited < SANTOS10_TIMEOUT_MS) {
+		adap = i2c_get_adapter(SANTOS10_TOUCH_BUS);
+		if (adap)
+			break;
+		msleep(SANTOS10_POLL_MS);
+		waited += SANTOS10_POLL_MS;
+	}
+	if (!adap) {
+		pr_err("i2c-%d never appeared FAIL\n", SANTOS10_TOUCH_BUS);
+		return 0;
+	}
+
+	/* Readiness gate (no spam): the chip needs ~1 s after the
+	 * touch-pwr power cycle (NVRAM load + first calibration) before
+	 * it answers; creating the client earlier makes the driver's
+	 * first probe hit a dead chip (-121, no retry). Poll one bare
+	 * read until ACK, then create exactly once. */
+	rc = -ENODEV;
+	waited = 0;
+	while (waited < SANTOS10_TIMEOUT_MS) {
+		dummy.byte = 0x00;
+		rc = i2c_smbus_xfer(adap, SANTOS10_TOUCH_ADDR, 0,
+				    I2C_SMBUS_BYTE, 0, I2C_SMBUS_READ,
+				    &dummy);
+		if (rc == 0)
+			break;
+		msleep(SANTOS10_POLL_MS);
+		waited += SANTOS10_POLL_MS;
+	}
+	if (rc) {
+		pr_err("0x4a never acked FAIL\n");
+		i2c_put_adapter(adap);
+		return 0;
+	}
+	/* Settle: ACK means the I2C engine is up, but NVRAM load + first
+	 * calibration still run; the driver's multi-byte probe immediately
+	 * after ACK can catch the chip mid-cal. Golden waits 150 ms+ here. */
+	msleep(500);
+
+	client = i2c_new_client_device(adap, &info);
+	i2c_put_adapter(adap);
+	if (IS_ERR(client)) {
+		pr_err("new client rc=%ld FAIL\n", PTR_ERR(client));
+		return 0;
+	}
+	pr_info("client 2-004a created (virq=%d), driver binding async\n", irq);
+	return 0;
+}
+
+static int santos10_touchboard_probe(struct platform_device *pdev)
+{
+	struct i2c_adapter *adap;
+	struct task_struct *t;
+	int irq;
+
+	if (!santos10_touch_power_ready())
+		return dev_err_probe(&pdev->dev, -EPROBE_DEFER,
+				     "waiting for touch power\n");
+
+	adap = i2c_get_adapter(SANTOS10_TOUCH_BUS);
+	if (!adap)
+		return dev_err_probe(&pdev->dev, -EPROBE_DEFER,
+				     "waiting for i2c-%d\n",
+				     SANTOS10_TOUCH_BUS);
+	i2c_put_adapter(adap);
+
+	irq = gpio_to_irq(SANTOS10_TSP_INT_GPIO);
+	if (irq < 0) {
+		/*
+		 * gpio_to_irq() reports a missing gpiochip as -EINVAL
+		 * (gpio_to_desc()==NULL) and an irqchip still being
+		 * registered as -EPROBE_DEFER; both are dependencies.
+		 */
+		if (irq == -EPROBE_DEFER ||
+		    gpio_to_desc(SANTOS10_TSP_INT_GPIO) == NULL)
+			return dev_err_probe(&pdev->dev, -EPROBE_DEFER,
+					     "waiting for TSP_INT gpio %d\n",
+					     SANTOS10_TSP_INT_GPIO);
+		return dev_err_probe(&pdev->dev, irq,
+				     "gpio_to_irq(%d) failed\n",
+				     SANTOS10_TSP_INT_GPIO);
+	}
+
+	t = kthread_run(santos10_touchboard_thread, (void *)(long)irq,
+			"santos10-touchbd");
+	if (IS_ERR(t))
+		return dev_err_probe(&pdev->dev, PTR_ERR(t),
+				     "kthread start failed\n");
+
+	dev_info(&pdev->dev, "board thread started (virq=%d)\n", irq);
+	return 0;
+}
+
+static struct platform_driver santos10_touchboard_driver = {
+	.probe = santos10_touchboard_probe,
+	.driver = {
+		.name = "santos10-touch-board",
+	},
+};
+
+static int __init santos10_touchboard_init(void)
+{
+	struct platform_device *pdev;
+	int rc;
+
+	rc = platform_driver_register(&santos10_touchboard_driver);
+	if (rc)
+		return rc;
+
+	pdev = platform_device_register_simple("santos10-touch-board", -1,
+					       NULL, 0);
+	if (IS_ERR(pdev)) {
+		platform_driver_unregister(&santos10_touchboard_driver);
+		pr_err("platform device register rc=%ld\n", PTR_ERR(pdev));
+		return PTR_ERR(pdev);
+	}
+	return 0;
+}
+late_initcall(santos10_touchboard_init);
diff --git a/arch/x86/platform/intel-mid/santos10-touch-pwr.c b/arch/x86/platform/intel-mid/santos10-touch-pwr.c
new file mode 100644
index 0000000000000000000000000000000000000000..d1249936ea592e54747d50b078d484754346c2cb
--- /dev/null
+++ b/arch/x86/platform/intel-mid/santos10-touch-pwr.c
@@ -0,0 +1,127 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * santos10-touch-pwr: I-b TSP power sequencing via gpiochip.
+ *
+ * Golden atmel sequence (board-santos10-input.c santos10_atmel_set_power):
+ * EN(TSP_LDO_ON=158)=1, 20 ms, EN2(TSP_SW3_EN=144)=1, 20 ms,
+ * RST(TSP_RST=153)=1, 150 ms. All init-LOW. Golden TSP_INT=62 stays input
+ * (driver takes the IRQ later).
+ *
+ * The CORE Langwell gpiochip (PCI 0000:00:03.5) is a device dependency:
+ * gpio_request_one() returns -EPROBE_DEFER while the gpiochip is absent
+ * and the driver core re-probes when it binds, however late that is.  A
+ * fixed 30 s poll would leave the rails off (and the chip dead) forever
+ * if the gpiochip appeared after the deadline.  Partial acquisition is
+ * rolled back before deferring; real errors are terminal.
+ *
+ * Successful power sequencing (EN/EN2/RST all read back high) is latched
+ * and exported for santos10-touch-board.  The 30 s ACK poll in the board
+ * thread is a post-power chip-readiness gate; it must not stand in for
+ * the power dependency.
+ */
+#define pr_fmt(fmt) "santos10-touch: " fmt
+
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/gpio.h>
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#define TSP_LDO_ON	158
+#define TSP_SW3_EN	144
+#define TSP_RST		153
+
+/* Prototype for -Wmissing-prototypes; consumer is santos10-touch-board.c. */
+bool santos10_touch_power_ready(void);
+
+static bool santos10_touch_power_done;
+
+/*
+ * Dependency contract used by santos10-touch-board.c: true only after the
+ * EN/EN2/RST sequence completed and all three rails read back high.
+ * Cross-context readers use READ_ONCE.
+ */
+bool santos10_touch_power_ready(void)
+{
+	return READ_ONCE(santos10_touch_power_done);
+}
+EXPORT_SYMBOL_GPL(santos10_touch_power_ready);
+
+static int santos10_touch_probe(struct platform_device *pdev)
+{
+	int rc, level;
+
+	rc = gpio_request_one(TSP_LDO_ON, GPIOF_OUT_INIT_LOW, "TSP_LDO_ON");
+	if (rc)
+		return dev_err_probe(&pdev->dev, rc,
+				     "request TSP_LDO_ON gpio %d\n",
+				     TSP_LDO_ON);
+	rc = gpio_request_one(TSP_SW3_EN, GPIOF_OUT_INIT_LOW, "TSP_SW3_EN");
+	if (rc)
+		goto out_en;
+	rc = gpio_request_one(TSP_RST, GPIOF_OUT_INIT_LOW, "TSP_RST");
+	if (rc)
+		goto out_en2;
+
+	/* golden atmel sequence */
+	gpio_set_value(TSP_LDO_ON, 1);
+	msleep(20);
+	gpio_set_value(TSP_SW3_EN, 1);
+	msleep(20);
+	gpio_set_value(TSP_RST, 1);
+	msleep(150);
+
+	level = gpio_get_value(TSP_LDO_ON) &
+		gpio_get_value(TSP_SW3_EN) &
+		gpio_get_value(TSP_RST);
+	/* keep requests: rails stay driven for the session */
+	if (!level)
+		return dev_err_probe(&pdev->dev, -EIO,
+				     "levels EN=%d EN2=%d RST=%d, rails not up\n",
+				     gpio_get_value(TSP_LDO_ON),
+				     gpio_get_value(TSP_SW3_EN),
+				     gpio_get_value(TSP_RST));
+
+	WRITE_ONCE(santos10_touch_power_done, true);
+	dev_info(&pdev->dev, "levels EN=%d EN2=%d RST=%d gate PASS\n",
+		 gpio_get_value(TSP_LDO_ON),
+		 gpio_get_value(TSP_SW3_EN),
+		 gpio_get_value(TSP_RST));
+	return 0;
+
+out_en2:
+	gpio_free(TSP_SW3_EN);
+out_en:
+	gpio_free(TSP_LDO_ON);
+	return dev_err_probe(&pdev->dev, rc, "request touch power gpio\n");
+}
+
+static struct platform_driver santos10_touch_driver = {
+	.probe = santos10_touch_probe,
+	.driver = {
+		.name = "santos10-touch-pwr",
+	},
+};
+
+static int __init santos10_touch_init(void)
+{
+	struct platform_device *pdev;
+	int rc;
+
+	rc = platform_driver_register(&santos10_touch_driver);
+	if (rc)
+		return rc;
+
+	pdev = platform_device_register_simple("santos10-touch-pwr", -1,
+					       NULL, 0);
+	if (IS_ERR(pdev)) {
+		platform_driver_unregister(&santos10_touch_driver);
+		pr_err("platform device register rc=%ld\n", PTR_ERR(pdev));
+		return PTR_ERR(pdev);
+	}
+
+	pr_info("power driver registered\n");
+	return 0;
+}
+late_initcall(santos10_touch_init);
diff --git a/arch/x86/platform/intel-mid/santos10-touch-tap.c b/arch/x86/platform/intel-mid/santos10-touch-tap.c
new file mode 100644
index 0000000000000000000000000000000000000000..60794de54062f9985e9d5014ebcb34af7f4c525e
--- /dev/null
+++ b/arch/x86/platform/intel-mid/santos10-touch-tap.c
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * santos10-touch-tap: touch-event counter.
+ *
+ * A passive input_handler matching touchscreen devices. Counts input
+ * events per device; the periodic total is dev_dbg (quiet by default),
+ * connect/disconnect stay pr_info as bind proof. Read-only tap.
+ */
+#define pr_fmt(fmt) "santos10-touchtap: " fmt
+
+#include <linux/delay.h>
+#include <linux/atomic.h>
+#include <linux/err.h>
+#include <linux/init.h>
+#include <linux/input.h>
+#include <linux/kthread.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#define SANTOS10_TAP_REPORT_MS	10000
+
+struct santos10_tap_data {
+	struct input_handle handle;
+	struct list_head node;
+	atomic_t count;
+};
+
+static LIST_HEAD(santos10_tap_list);
+
+/* Serialize list walk vs connect/disconnect. */
+static DEFINE_MUTEX(santos10_tap_lock);
+
+static void santos10_tap_event(struct input_handle *handle, unsigned int type,
+			       unsigned int code, int value)
+{
+	struct santos10_tap_data *tap =
+		container_of(handle, struct santos10_tap_data, handle);
+
+	atomic_inc(&tap->count);
+}
+
+static int santos10_tap_connect(struct input_handler *handler,
+				struct input_dev *dev,
+				const struct input_device_id *id)
+{
+	struct santos10_tap_data *tap;
+	int rc;
+
+	tap = kzalloc(sizeof(*tap), GFP_KERNEL);
+	if (!tap)
+		return -ENOMEM;
+
+	tap->handle.dev = input_get_device(dev);
+	tap->handle.handler = handler;
+	tap->handle.name = "santos10-tap";
+
+	rc = input_register_handle(&tap->handle);
+	if (rc) {
+		input_put_device(dev);
+		kfree(tap);
+		return rc;
+	}
+	rc = input_open_device(&tap->handle);
+	if (rc) {
+		input_unregister_handle(&tap->handle);
+		input_put_device(dev);
+		kfree(tap);
+		return rc;
+	}
+	mutex_lock(&santos10_tap_lock);
+	list_add_tail(&tap->node, &santos10_tap_list);
+	mutex_unlock(&santos10_tap_lock);
+	pr_info("tapped '%s'\n", dev->name);
+	return 0;
+}
+
+static void santos10_tap_disconnect(struct input_handle *handle)
+{
+	struct santos10_tap_data *tap =
+		container_of(handle, struct santos10_tap_data, handle);
+
+	mutex_lock(&santos10_tap_lock);
+	list_del(&tap->node);
+	mutex_unlock(&santos10_tap_lock);
+	input_close_device(handle);
+	input_unregister_handle(handle);
+	input_put_device(handle->dev);
+	kfree(tap);
+}
+
+static const struct input_device_id santos10_tap_ids[] = {
+	{
+		.flags = INPUT_DEVICE_ID_MATCH_EVBIT,
+		.evbit = { BIT_MASK(EV_ABS) },
+	},
+	{ },
+};
+
+static struct input_handler santos10_tap_handler = {
+	.event		= santos10_tap_event,
+	.connect	= santos10_tap_connect,
+	.disconnect	= santos10_tap_disconnect,
+	.name		= "santos10-tap",
+	.id_table	= santos10_tap_ids,
+};
+
+static int santos10_tap_thread(void *arg)
+{
+	struct santos10_tap_data *tap;
+	int total;
+
+	msleep(15000);
+	for (;;) {
+		total = 0;
+		mutex_lock(&santos10_tap_lock);
+		list_for_each_entry(tap, &santos10_tap_list, node)
+			total += atomic_read(&tap->count);
+		mutex_unlock(&santos10_tap_lock);
+		pr_debug("touch events total=%d\n", total);
+		msleep(SANTOS10_TAP_REPORT_MS);
+	}
+	return 0; /* unreachable */
+}
+
+static int __init santos10_tap_init(void)
+{
+	struct task_struct *t;
+	int rc;
+
+	rc = input_register_handler(&santos10_tap_handler);
+	if (rc) {
+		pr_err("handler register rc=%d FAIL\n", rc);
+		return rc;
+	}
+	t = kthread_run(santos10_tap_thread, NULL, "santos10-taptap");
+	if (IS_ERR(t)) {
+		pr_err("kthread start rc=%ld\n", PTR_ERR(t));
+		input_unregister_handler(&santos10_tap_handler);
+		return PTR_ERR(t);
+	}
+	pr_info("tap registered\n");
+	return 0;
+}
+late_initcall(santos10_tap_init);
diff --git a/arch/x86/platform/intel-mid/santos10-wlan-check.c b/arch/x86/platform/intel-mid/santos10-wlan-check.c
new file mode 100644
index 0000000000000000000000000000000000000000..8ab6d555a1a3208d3ad5837bd1144b86d0452ba9
--- /dev/null
+++ b/arch/x86/platform/intel-mid/santos10-wlan-check.c
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * santos10-wlan-check: W4b netdev-presence probe.
+ *
+ * brcmfmac does not log the netdev name, and TWRP userspace cannot report
+ * it, so look it up from the kernel side: poll rtnl for "wlan0", then
+ * report flags, operstate, MAC, and whether a wiphy (cfg80211) is
+ * attached. Read-only; changes nothing.
+ */
+#define pr_fmt(fmt) "santos10-wlancheck: " fmt
+
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/init.h>
+#include <linux/kthread.h>
+#include <linux/netdevice.h>
+#include <net/net_namespace.h>
+
+#define SANTOS10_WLANCHECK_POLL_MS	1000
+#define SANTOS10_WLANCHECK_TIMEOUT_MS	60000
+
+static int santos10_wlancheck_thread(void *arg)
+{
+	unsigned long waited = 0;
+	struct net_device *dev;
+
+	/* brcmfmac binds ~5 s, dongle boots ~5 s; start polling early. */
+	while (waited < SANTOS10_WLANCHECK_TIMEOUT_MS) {
+		dev = dev_get_by_name(&init_net, "wlan0");
+		if (dev) {
+			pr_info("wlan0 present after %lums flags=0x%x operstate=%u MAC=%pM wiphy=%d\n",
+				waited, dev->flags, dev->operstate,
+				dev->dev_addr,
+				dev->ieee80211_ptr != NULL);
+			dev_put(dev);
+			pr_info("gate PASS\n");
+			return 0;
+		}
+		msleep(SANTOS10_WLANCHECK_POLL_MS);
+		waited += SANTOS10_WLANCHECK_POLL_MS;
+	}
+	pr_info("wlan0 absent after %lums FAIL\n", waited);
+	return 0;
+}
+
+static int __init santos10_wlancheck_init(void)
+{
+	struct task_struct *t;
+
+	t = kthread_run(santos10_wlancheck_thread, NULL, "santos10-wlancheck");
+	if (IS_ERR(t)) {
+		pr_err("kthread start rc=%ld\n", PTR_ERR(t));
+		return PTR_ERR(t);
+	}
+	pr_info("check thread started\n");
+	return 0;
+}
+late_initcall(santos10_wlancheck_init);
diff --git a/arch/x86/platform/intel-mid/santos10-wlan-pwr.c b/arch/x86/platform/intel-mid/santos10-wlan-pwr.c
new file mode 100644
index 0000000000000000000000000000000000000000..615b78bfa0db8d8646925a14f0e0d4310dfe1bce
--- /dev/null
+++ b/arch/x86/platform/intel-mid/santos10-wlan-pwr.c
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * santos10-wlan-pwr: W2 power sequencing for the BCM4334 via the
+ * santos10-gpio-lnw chip (WLAN_EN = global GPIO 170).
+ *
+ * Golden sequence (board-santos10-wlan.c): WLAN_EN low (reset edge),
+ * 100 ms, high, 300 ms settle.
+ *
+ * Dependency handling: the CORE Langwell gpiochip (PCI 0000:00:03.5) is a
+ * device dependency, not a wall-clock one.  A late_initcall thread with a
+ * fixed 30 s poll loses WLAN permanently if the gpiochip appears after the
+ * deadline.  This is a platform driver instead: gpio_request_one() reports
+ * the missing gpiochip as -EPROBE_DEFER and the driver core re-probes the
+ * device whenever a new supplier binds (driver_bound() triggers deferred
+ * probing).  Real failures (busy/invalid line) are terminal and logged as
+ * such; they are not masked by a retry loop.
+ *
+ * The completed sequence is latched and exported, but only after the
+ * readback gate confirms WLAN_EN asserted.  The SDIO host scan for
+ * the soldered BCM4334 is one-shot (drivers/mmc/core/core.c mmc_rescan():
+ * non-removable host scans once), so sdhci-pci defers the 08fa slot until
+ * this latch is set; otherwise an early scan misses the unpowered card for
+ * the whole boot with no rescan path.
+ */
+#define pr_fmt(fmt) "santos10-wlan: " fmt
+
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/gpio.h>
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#define SANTOS10_WLAN_EN_GPIO	170
+
+/* Prototype for -Wmissing-prototypes; the consumer lives in sdhci-pci-core.c. */
+bool santos10_wlan_power_ready(void);
+
+static bool santos10_wlan_power_done;
+
+/*
+ * Dependency contract used by sdhci-pci-core.c (CLV_SDIO1 8086:08fa):
+ * true only after the WLAN_EN reset/power sequence completed AND the
+ * readback gate saw the line asserted.  A failed readback keeps the
+ * supplier not-ready, so the one-shot 08fa scan stays blocked instead of
+ * running against an unpowered card.  Cross-context readers use READ_ONCE.
+ */
+bool santos10_wlan_power_ready(void)
+{
+	return READ_ONCE(santos10_wlan_power_done);
+}
+EXPORT_SYMBOL_GPL(santos10_wlan_power_ready);
+
+static int santos10_wlan_probe(struct platform_device *pdev)
+{
+	int rc, level;
+
+	rc = gpio_request_one(SANTOS10_WLAN_EN_GPIO, GPIOF_OUT_INIT_LOW,
+			      "WLAN_EN");
+	if (rc)
+		return dev_err_probe(&pdev->dev, rc,
+				     "request WLAN_EN gpio %d\n",
+				     SANTOS10_WLAN_EN_GPIO);
+
+	/* reset edge then power, golden-exact delays */
+	gpio_set_value(SANTOS10_WLAN_EN_GPIO, 0);
+	msleep(100);
+	gpio_set_value(SANTOS10_WLAN_EN_GPIO, 1);
+	msleep(300);
+
+	level = gpio_get_value(SANTOS10_WLAN_EN_GPIO);
+	/* keep the request: WLAN_EN stays driven for the session */
+	if (level != 1)
+		return dev_err_probe(&pdev->dev, -EIO,
+				     "WLAN_EN readback %d, power not asserted\n",
+				     level);
+
+	WRITE_ONCE(santos10_wlan_power_done, true);
+	dev_info(&pdev->dev, "WLAN_EN level=%d gate PASS\n", level);
+	return 0;
+}
+
+static struct platform_driver santos10_wlan_driver = {
+	.probe = santos10_wlan_probe,
+	.driver = {
+		.name = "santos10-wlan-pwr",
+	},
+};
+
+static int __init santos10_wlan_init(void)
+{
+	struct platform_device *pdev;
+	int rc;
+
+	rc = platform_driver_register(&santos10_wlan_driver);
+	if (rc)
+		return rc;
+
+	pdev = platform_device_register_simple("santos10-wlan-pwr", -1,
+					       NULL, 0);
+	if (IS_ERR(pdev)) {
+		platform_driver_unregister(&santos10_wlan_driver);
+		pr_err("platform device register rc=%ld\n", PTR_ERR(pdev));
+		return PTR_ERR(pdev);
+	}
+
+	pr_info("power driver registered\n");
+	return 0;
+}
+late_initcall(santos10_wlan_init);
diff --git a/arch/x86/platform/intel-mid/santos10.c b/arch/x86/platform/intel-mid/santos10.c
new file mode 100644
index 0000000000000000000000000000000000000000..62a2b571e07903ccb7292903d7e07298aefbcaa7
--- /dev/null
+++ b/arch/x86/platform/intel-mid/santos10.c
@@ -0,0 +1,233 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Minimal Samsung Santos10 SFI bring-up probe.
+ *
+ * The shipping 3.4 kernel rewrites the SFI DEVS table with a
+ * Santos-specific static table and intentionally empties the SFI GPIO
+ * table before Intel MID device enumeration.  Do not reproduce that
+ * behaviour until the unmodified firmware tables have been observed on
+ * the modern kernel.
+ */
+
+#define pr_fmt(fmt) "santos10: " fmt
+
+#include <linux/init.h>
+#include <linux/ioport.h>
+#include <linux/kernel.h>
+#include <linux/platform_data/simplefb.h>
+#include <linux/platform_device.h>
+#include <linux/sfi.h>
+#include <linux/string.h>
+
+#include <asm/bootparam.h>
+#include <asm/setup.h>
+
+#define SANTOS10_HW_LEN	32
+
+static char santos10_hardware[SANTOS10_HW_LEN] __initdata;
+static unsigned int santos10_revision __initdata;
+static bool santos10_revision_valid __initdata;
+
+static int __init santos10_hardware_setup(char *str)
+{
+	if (!str)
+		return 0;
+
+	strscpy(santos10_hardware, str, sizeof(santos10_hardware));
+	return 1;
+}
+__setup("androidboot.hardware=", santos10_hardware_setup);
+
+static int __init santos10_revision_setup(char *str)
+{
+	if (!str)
+		return 0;
+
+	if (kstrtouint(str, 0, &santos10_revision))
+		return 0;
+
+	santos10_revision_valid = true;
+	return 1;
+}
+__setup("androidboot.revision=", santos10_revision_setup);
+
+static bool __init santos10_hardware_matches(void)
+{
+	return !strncmp(santos10_hardware, "santos10", 8);
+}
+
+static int __init santos10_sfi_entry_count(struct sfi_table_header *table,
+					    size_t entry_size)
+{
+	u32 payload;
+
+	if (table->len < sizeof(*table)) {
+		pr_err("SFI %.4s: invalid length %u (< %zu)\n",
+		       table->sig, table->len, sizeof(*table));
+		return -EINVAL;
+	}
+
+	payload = table->len - sizeof(*table);
+	if (payload % entry_size) {
+		pr_err("SFI %.4s: payload %u is not a multiple of entry size %zu\n",
+		       table->sig, payload, entry_size);
+		return -EINVAL;
+	}
+
+	return payload / entry_size;
+}
+
+static int __init santos10_sfi_dump_devs(struct sfi_table_header *table)
+{
+	struct sfi_table_simple *sb = (struct sfi_table_simple *)table;
+	struct sfi_device_table_entry *entry;
+	int count, i;
+
+	count = santos10_sfi_entry_count(table,
+				       sizeof(struct sfi_device_table_entry));
+	if (count < 0)
+		return count;
+
+	entry = (struct sfi_device_table_entry *)sb->pentry;
+
+	pr_info("SFI DEVS: %d entries, table length %u\n",
+		count, table->len);
+
+	for (i = 0; i < count; i++, entry++)
+		pr_info("DEVS[%02d] type=%u host=%u addr=0x%04x irq=0x%02x freq=%u name=%.*s\n",
+			i, entry->type, entry->host_num, entry->addr,
+			entry->irq, entry->max_freq, SFI_NAME_LEN,
+			entry->name);
+
+	return 0;
+}
+
+static int __init santos10_sfi_dump_gpio(struct sfi_table_header *table)
+{
+	struct sfi_table_simple *sb = (struct sfi_table_simple *)table;
+	struct sfi_gpio_table_entry *entry;
+	int count, i;
+
+	count = santos10_sfi_entry_count(table,
+				       sizeof(struct sfi_gpio_table_entry));
+	if (count < 0)
+		return count;
+
+	entry = (struct sfi_gpio_table_entry *)sb->pentry;
+
+	pr_info("SFI GPIO: %d entries, table length %u\n",
+		count, table->len);
+
+	for (i = 0; i < count; i++, entry++)
+		pr_info("GPIO[%02d] controller=%.*s pin=%u name=%.*s\n",
+			i, SFI_NAME_LEN, entry->controller_name,
+			entry->pin_no, SFI_NAME_LEN, entry->pin_name);
+
+	return 0;
+}
+
+static int __init santos10_sfi_census_init(void)
+{
+	int devs_rc, gpio_rc;
+
+	if (!santos10_hardware_matches())
+		return 0;
+
+	if (santos10_revision_valid)
+		pr_info("detected %s revision %u, MID subarch=%u\n",
+			santos10_hardware, santos10_revision,
+			boot_params.hdr.hardware_subarch);
+	else
+		pr_info("detected %s, revision unknown, MID subarch=%u\n",
+			santos10_hardware,
+			boot_params.hdr.hardware_subarch);
+
+	if (boot_params.hdr.hardware_subarch != X86_SUBARCH_INTEL_MID) {
+		pr_err("bootloader subarch=%u, expected Intel MID=%u; SFI census skipped\n",
+		       boot_params.hdr.hardware_subarch, X86_SUBARCH_INTEL_MID);
+		return 0;
+	}
+
+	/*
+	 * Census only.  The shipping kernel modifies these tables before
+	 * device registration.  M2B0 deliberately observes them first.
+	 */
+	devs_rc = sfi_table_parse(SFI_SIG_DEVS, NULL, NULL,
+				 santos10_sfi_dump_devs);
+	gpio_rc = sfi_table_parse(SFI_SIG_GPIO, NULL, NULL,
+				 santos10_sfi_dump_gpio);
+
+	pr_info("SFI census complete: DEVS rc=%d GPIO rc=%d\n",
+		devs_rc, gpio_rc);
+
+	return 0;
+}
+arch_initcall(santos10_sfi_census_init);
+
+/*
+ * Diagnostic A59: headless RAM framebuffer for TWRP recovery bring-up.
+ *
+ * TWRP's recovery dies ~0.4 s after exec in __android_log_assert (ud2,
+ * deterministic, #62) with no display driver present: minui/gr_init
+ * cannot open /dev/graphics/fb0 and the UI startup asserts. Rather than
+ * reverse-engineering which assert, provide what it wants: a dumb
+ * framebuffer backed by the S-Boot bootfb reservation (0x3f000000,
+ * e820-reserved, already a framebuffer — the frozen logo lives there).
+ * No panel/DSI init happens; the screen keeps showing whatever S-Boot
+ * left. Draws land in RAM, invisible but harmless. If recovery runs
+ * past UI init with this present, the assert is proven framebuffer
+ * hunger; if it crashes identically, the assert lies elsewhere.
+ *
+ * P5210 panel geometry (1280x800 xrgb8888); stride 5120; 4 MiB used of
+ * the 16 MiB reservation. No fbcon (console stays on sec_log).
+ */
+#define SANTOS10_BOOTFB_BASE	0x3f000000UL
+#define SANTOS10_BOOTFB_WIDTH	1280
+#define SANTOS10_BOOTFB_HEIGHT	800
+#define SANTOS10_BOOTFB_STRIDE	(SANTOS10_BOOTFB_WIDTH * 4)
+#define SANTOS10_BOOTFB_SIZE	(SANTOS10_BOOTFB_STRIDE * SANTOS10_BOOTFB_HEIGHT)
+
+static struct simplefb_platform_data santos10_fb_data __initdata = {
+	.width = SANTOS10_BOOTFB_WIDTH,
+	.height = SANTOS10_BOOTFB_HEIGHT,
+	.stride = SANTOS10_BOOTFB_STRIDE,
+	.format = "x8r8g8b8",
+};
+
+static struct resource santos10_fb_res __initdata =
+	DEFINE_RES_MEM(SANTOS10_BOOTFB_BASE, SANTOS10_BOOTFB_SIZE);
+
+static int __init santos10_headless_fb_init(void)
+{
+	struct platform_device *pdev;
+	int ret;
+
+	if (!santos10_hardware_matches())
+		return 0;
+
+	pdev = platform_device_alloc("simple-framebuffer", 0);
+	if (!pdev)
+		return -ENOMEM;
+
+	ret = platform_device_add_resources(pdev, &santos10_fb_res, 1);
+	if (ret)
+		goto err;
+	ret = platform_device_add_data(pdev, &santos10_fb_data,
+				       sizeof(santos10_fb_data));
+	if (ret)
+		goto err;
+	ret = platform_device_add(pdev);
+	if (ret)
+		goto err;
+
+	pr_info("headless simplefb registered at %#lx (%ux%u, %s)\n",
+		SANTOS10_BOOTFB_BASE, SANTOS10_BOOTFB_WIDTH,
+		SANTOS10_BOOTFB_HEIGHT, santos10_fb_data.format);
+	return 0;
+
+err:
+	pr_err("headless simplefb register failed: %d\n", ret);
+	platform_device_put(pdev);
+	return ret;
+}
+arch_initcall(santos10_headless_fb_init);
