+#ifdef CONFIG_X86_SANTOS10
+/*
+ * santos10wifi: the primary GPT on this device's eMMC is stale (writes to
+ * the primary metadata region do not persist) while the alternate GPT
+ * carries the current layout (18-entry, expanded VOIDROOT p8). Golden
+ * Linux 3.4 #7 proved this selection at runtime.
+ *
+ * Limit the override to the disk the block driver declares as the target
+ * (the soldered eMMC, via prefer_alternate_gpt): removable SD/USB media
+ * and drivers without the callback keep the upstream primary-first
+ * behavior even when their GPT copies disagree.
+ */
+static bool santos10_prefer_alternate_gpt(struct gendisk *disk,
+					  const gpt_header *pgpt,
+					  const gpt_header *agpt)
+{
+	if (!disk->fops->prefer_alternate_gpt ||
+	    !disk->fops->prefer_alternate_gpt(disk))
+		return false;
+
+	return le32_to_cpu(pgpt->partition_entry_array_crc32) !=
+	       le32_to_cpu(agpt->partition_entry_array_crc32);
+}
+#endif
+
 /**
