  * @state: disk parsed partitions
@@ -636,6 +661,23 @@ static int find_valid_gpt(struct parsed_partitions *state, gpt_header **gpt,
 
         compare_gpts(pgpt, agpt, lastlba);
 
+#ifdef CONFIG_X86_SANTOS10
+        /*
+         * Healthy+agreeing copies keep the normal upstream behavior
+         * below; the differing case overrides it only for the declared
+         * target disk (see santos10_prefer_alternate_gpt()).
+         */
+        if (good_pgpt && good_agpt &&
+            santos10_prefer_alternate_gpt(disk, pgpt, agpt)) {
+                pr_warn("GPT:santos: primary/alternate differ, using alternate GPT.\n");
+                *gpt = agpt;
+                *ptes = aptes;
+                kfree(pgpt);
+                kfree(pptes);
+                return 1;
+        }
+#endif
+
         /* The good cases */
         if (good_pgpt) {
                 *gpt  = pgpt;
