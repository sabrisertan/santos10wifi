 /*
@@ -121,6 +122,75 @@ static int mfld_setup(struct pci_dev *pdev, struct dw_pci_controller *c)
 	return -ENODEV;
 }
 
+#ifdef CONFIG_X86_SANTOS10
+/* Golden-exact SCL counts (3.4 ctp_i2c_scl_cfg). The DW input clock on
+ * Cloverview is ~100 MHz, not the 17/20.5 MHz nominal: SS 492+499 and
+ * FS 89+152 counts only make sense against ~100 MHz. 7.2 keeps explicit
+ * non-zero counts verbatim (computation skipped), so this programs
+ * golden-identical on-wire timing. sda_hold untouched (3.4 never sets
+ * it for CLV either). */
+static struct dw_scl_sda_cfg clv_config = {
+	.ss_hcnt = 0x1EC,
+	.ss_lcnt = 0x1F3,
+	.fs_hcnt = 0x59,
+	.fs_lcnt = 0x98,
+};
+
+static u32 clv_get_clk_rate_khz(struct dw_i2c_dev *dev)
+{
+	struct pci_dev *pdev = to_pci_dev(dev->dev);
+
+	/* Golden-exact per-controller input clocks (3.4 cloverview_N):
+	 * bus 2 (08E4, touch) runs STD on 20500; the rest FAST on 17000. */
+	if (pdev->device == 0x08E4)
+		return 20500;
+	return 17000;
+}
+
+static int clv_setup(struct pci_dev *pdev, struct dw_pci_controller *c)
+{
+	struct dw_i2c_dev *dev = pci_get_drvdata(pdev);
+
+	/* Golden-survivor set (08F4/08F6 stay out, 3.4 hack parity).
+	 * Numbering fits the gpio-i2c gaps: DW takes 0,1,2,4. Speeds are
+	 * golden-exact per controller (3.4 cloverview_N bus_cfg).
+	 *
+	 * A101: Cloverview DW reads COMP_PARAM_1 as 0 (A100a proof), so
+	 * 7.2 believes fifo depth 1 and STAGES multi-byte transfers one
+	 * command at a time. With EMPTYFIFO_HOLD off, the HW STOPs the bus
+	 * the moment TX FIFO empties mid-transfer (A100b trace: STOP_DET +
+	 * RX_FULL after byte0 with no master STOP pushed). The 3.4
+	 * intel-mid driver pushes up to 255 commands upfront and caps
+	 * transfers at 256 B ("I2C FIFO cannot support larger than 256
+	 * bytes") — the real FIFOs are 256 deep. Preset 256/256 so every
+	 * transfer <=255 goes out whole; set_fifo_size keeps presets
+	 * (detected 1 < MIN_DEPTH 2, no clobber). */
+	dev->tx_fifo_depth = 256;
+	dev->rx_fifo_depth = 256;
+	switch (pdev->device) {
+	case 0x08E2:
+		c->bus_num = 0;
+		dev->timings.bus_freq_hz = I2C_MAX_FAST_MODE_FREQ;
+		break;
+	case 0x08E3:
+		c->bus_num = 1;
+		dev->timings.bus_freq_hz = I2C_MAX_FAST_MODE_FREQ;
+		break;
+	case 0x08E4:
+		c->bus_num = 2;
+		dev->timings.bus_freq_hz = I2C_MAX_STANDARD_MODE_FREQ;
+		break;
+	case 0x08F5:
+		c->bus_num = 4;
+		dev->timings.bus_freq_hz = I2C_MAX_FAST_MODE_FREQ;
+		break;
+	default:
+		return -ENODEV;
+	}
+	return 0;
+}
+#endif
+
