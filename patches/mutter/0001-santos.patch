+
+static MetaBacklight *
+meta_output_santos_create_backlight (MetaOutput  *output,
+                                     GError     **error)
+{
+  MetaMonitor *monitor = meta_output_get_monitor (output);
+  MetaBackend *backend = meta_monitor_get_backend (monitor);
+  const MetaOutputInfo *output_info = meta_output_get_info (output);
+
+  /* Reuse the stock sysfs discovery (firmware -> platform -> connector
+   * -> first raw for builtin panels). The Santos panel
+   * (/sys/class/backlight/panel, type raw) is picked by the raw
+   * fallback, so the Shell/Settings brightness UI and brightness keys
+   * drive the proven backlight path with udev change sync, no custom
+   * code and no session/logind dependency (direct sysfs write as the
+   * product user via the video-group rule).
+   */
+  return META_BACKLIGHT (meta_backlight_sysfs_new (backend,
+                                                  output_info,
+                                                  error));
+}
+
+static void
+meta_output_santos_class_init (MetaOutputSantosClass *klass)
+{
+  MetaOutputClass *output_class = META_OUTPUT_CLASS (klass);
+
+  output_class->create_backlight = meta_output_santos_create_backlight;
+}
+
+MetaOutputSantos *
+meta_output_santos_new (MetaGpu        *gpu,
+                        uint64_t        id,
+                        MetaOutputInfo *info)
+{
+  return g_object_new (META_TYPE_OUTPUT_SANTOS,
+                       "id", id,
+                       "gpu", gpu,
+                       "info", info,
+                       NULL);
+}
