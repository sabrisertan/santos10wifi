diff --git a/src/backends/santos/santos_hwc.c b/src/backends/santos/santos_hwc.c
new file mode 100644
index 0000000000000000000000000000000000000000..2438c8ba19f35fb140b80aee0b3328c8bcdadf01
--- /dev/null
+++ b/src/backends/santos/santos_hwc.c
@@ -0,0 +1,642 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Standalone Santos HWC 1.3 display helper implementation.
+ * Direct C extraction of accepted graphics/qt6-hwc/santos.cpp logic.
+ * No Qt dependencies whatsoever.
+ */
+
+#include "santos_hwc.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <errno.h>
+#include <sys/ioctl.h>
+#include <linux/fb.h>
+#include <sync/sync.h>
+#include <inttypes.h>
+#include <glib.h>
+
+#include <hardware/hardware.h>
+#include <hardware/hwcomposer.h>
+#include <hybris/hwcomposerwindow/hwcomposer.h>
+
+struct santos_hwc {
+    hwc_composer_device_1_t *device;
+    hwc_display_contents_1_t *contents[HWC_NUM_DISPLAY_TYPES];
+    hwc_layer_1_t *target_layer;
+    struct ANativeWindow *native_window;
+
+    int32_t width;
+    int32_t height;
+    int32_t vsync_period_ns;
+    int32_t dpi_x;
+    int32_t dpi_y;
+
+    uint32_t vsync_count;
+    uint32_t present_count;
+    uint32_t present_errors;
+    uint32_t retire_waits;
+    uint32_t retire_timeouts;
+    uint32_t retire_timeout_ms;
+
+    uint64_t target_generation;
+    uint64_t completed_generation;
+    bool last_present_success;
+    int last_prepare_rc;
+    int last_set_rc;
+
+    santos_hwc_inject_fault_t inject_fault;
+    uint32_t inject_count;
+    bool enable_runtime_trigger;
+
+    bool vsync_enabled;
+    bool verbose;
+
+    /*
+     * Callback registration is a lifetime contract, not just a pointer
+     * publication.  The HWC callback takes the short global admission lock,
+     * snapshots the callback and data, and accounts for the invocation before
+     * releasing it.  Unregister sets both fields to NULL and waits for that
+     * count to drain before returning.  The callback body never runs under
+     * this lock.
+     */
+    GCond vsync_idle;
+    unsigned int vsync_in_flight;
+    bool vsync_sync_initialized;
+    santos_hwc_vsync_cb_t vsync_cb;
+    void *vsync_cb_data;
+
+    void *user_data;
+};
+
+/* Zero-initialized GMutex is a valid static GLib mutex. */
+static GMutex g_hwc_active_lock;
+static santos_hwc_t *g_hwc_active = NULL;
+
+static void hwc_procs_invalidate(const struct hwc_procs *procs)
+{
+    (void)procs;
+}
+
+static void hwc_procs_hotplug(const struct hwc_procs *procs, int disp, int connected)
+{
+    (void)procs;
+    (void)disp;
+    (void)connected;
+}
+
+static void hwc_procs_vsync(const struct hwc_procs *procs, int disp, int64_t timestamp)
+{
+    santos_hwc_t *ctx;
+    santos_hwc_vsync_cb_t cb;
+    void *data;
+
+    (void)procs;
+    if (disp != 0)
+        return;
+
+    /*
+     * Admission and active-context publication share this short lock.  That
+     * closes the load-before-lock race: close() cannot clear/free the active
+     * context between this snapshot and the in-flight increment.
+     */
+    g_mutex_lock(&g_hwc_active_lock);
+    ctx = g_hwc_active;
+    if (ctx) {
+        __atomic_add_fetch(&ctx->vsync_count, 1u, __ATOMIC_RELAXED);
+
+        cb = ctx->vsync_cb;
+        data = ctx->vsync_cb_data;
+        if (cb)
+            ctx->vsync_in_flight++;
+    }
+    g_mutex_unlock(&g_hwc_active_lock);
+
+    if (!ctx || !cb)
+        return;
+
+    cb(timestamp, data);
+
+    g_mutex_lock(&g_hwc_active_lock);
+    g_assert (ctx->vsync_in_flight > 0);
+    ctx->vsync_in_flight--;
+    if (ctx->vsync_in_flight == 0)
+        g_cond_broadcast(&ctx->vsync_idle);
+    g_mutex_unlock(&g_hwc_active_lock);
+}
+
+static const hwc_procs_t s_hwc_procs = {
+    .invalidate = hwc_procs_invalidate,
+    .vsync = hwc_procs_vsync,
+    .hotplug = hwc_procs_hotplug,
+};
+
+static void santos_hwc_close(santos_hwc_t *ctx);
+
+static void wait_retire(santos_hwc_t *ctx, int retire_fd)
+{
+    if (retire_fd < 0)
+        return;
+    ctx->retire_waits++;
+    const int rc = sync_wait(retire_fd, (int)ctx->retire_timeout_ms);
+    close(retire_fd);
+    if (rc != 0) {
+        ctx->retire_timeouts++;
+        fprintf(stderr, "[SANTOS_HWC] WARN: retire fence wait rc=%d timeout=%ums (timeouts=%u)\n",
+                rc, ctx->retire_timeout_ms, ctx->retire_timeouts);
+    }
+}
+
+static void retire_unconsumed_acquire(santos_hwc_t *ctx,
+                                      struct ANativeWindowBuffer *buffer)
+{
+    const int acquire_fd = ctx->target_layer->acquireFenceFd;
+    int wait_rc = 0;
+
+    /* The synthetic path never called HWC set(), so this fd is still ours. */
+    ctx->target_layer->acquireFenceFd = -1;
+    if (acquire_fd >= 0) {
+        /* Do not make the buffer reusable until the producer has finished. */
+        wait_rc = sync_wait(acquire_fd, -1);
+        close(acquire_fd);
+    }
+
+    /* The fd above is now closed; clear the native slot before reuse. */
+    HWCNativeBufferSetFence(buffer, -1);
+    ctx->target_layer->releaseFenceFd = -1;
+
+    if (wait_rc != 0) {
+        fprintf(stderr,
+                "[SANTOS_HWC] WARN: synthetic acquire fence wait rc=%d fd=%d\n",
+                wait_rc, acquire_fd);
+    }
+}
+
+static void present_callback(void *user_data, struct ANativeWindow *window,
+                             struct ANativeWindowBuffer *buffer)
+{
+    santos_hwc_t *ctx = (santos_hwc_t *)user_data;
+    (void)window;
+
+    int oldRetire = ctx->contents[0]->retireFenceFd;
+    ctx->contents[0]->retireFenceFd = -1;
+    ctx->target_layer->handle = buffer->handle;
+
+    /*
+     * Normative L13 contract:
+     * Producer/acquire fence lives in the native buffer's real fence slot.
+     * HWC set() takes ownership of the acquire fence fd.
+     */
+    ctx->target_layer->acquireFenceFd = HWCNativeBufferGetFence(buffer);
+    ctx->target_layer->releaseFenceFd = -1;
+
+    int rc = 0;
+    if (ctx->inject_count > 0 && ctx->inject_fault == SANTOS_HWC_INJECT_FAIL_PREPARE) {
+        ctx->inject_count--;
+        rc = -1;
+        fprintf(stderr, "[SANTOS_HWC] INJECTED FAULT: simulated prepare failure (remaining=%u)\n",
+                ctx->inject_count);
+    } else {
+        rc = ctx->device->prepare(ctx->device, HWC_NUM_DISPLAY_TYPES, ctx->contents);
+    }
+
+    if (rc) {
+        ctx->present_errors++;
+        ctx->last_prepare_rc = rc;
+        ctx->last_set_rc = 0;
+        ctx->last_present_success = false;
+        ctx->completed_generation = ctx->target_generation;
+        fprintf(stderr, "[SANTOS_HWC] ERROR: prepare failed: %d (frame dropped, errors=%u, gen=%" PRIu64 ")\n",
+                rc, ctx->present_errors, ctx->target_generation);
+        /* A. prepare() failed: set() was never called.  The native buffer
+         * still owns the producer fence; only discard the layer's transient
+         * alias so a closed/stale integer cannot be reused on the next frame.
+         */
+        ctx->target_layer->acquireFenceFd = -1;
+        wait_retire(ctx, oldRetire);
+        return;
+    }
+
+    bool synthetic_set_failure = false;
+    if (ctx->inject_count > 0 && ctx->inject_fault == SANTOS_HWC_INJECT_FAIL_SET) {
+        ctx->inject_count--;
+        rc = -1;
+        synthetic_set_failure = true;
+        fprintf(stderr, "[SANTOS_HWC] INJECTED FAULT: simulated set failure (remaining=%u)\n",
+                ctx->inject_count);
+    } else {
+        rc = ctx->device->set(ctx->device, HWC_NUM_DISPLAY_TYPES, ctx->contents);
+    }
+
+    if (rc) {
+        ctx->present_errors++;
+        ctx->last_prepare_rc = 0;
+        ctx->last_set_rc = rc;
+        ctx->last_present_success = false;
+        ctx->completed_generation = ctx->target_generation;
+        fprintf(stderr, "[SANTOS_HWC] ERROR: set failed: %d (frame dropped, errors=%u, gen=%" PRIu64 ")\n",
+                rc, ctx->present_errors, ctx->target_generation);
+
+        if (synthetic_set_failure) {
+            /*
+             * C. Test-only synthetic pre-set failure: set() was NOT called,
+             * therefore HWC did not consume the acquire fence.  Retire that
+             * producer fence before making the native buffer immediately
+             * reusable, then clear both representations of its state.
+             */
+            retire_unconsumed_acquire(ctx, buffer);
+        } else {
+            /*
+             * B. Real HWC device->set() failure: HWC received ownership of
+             * acquireFenceFd according to the HWC contract.  Do not close or
+             * reuse that integer here; transfer the result fence exactly once
+             * and clear the layer state before the next callback.
+             */
+            const int releaseFd = ctx->target_layer->releaseFenceFd;
+            ctx->target_layer->acquireFenceFd = -1;
+            HWCNativeBufferSetFence(buffer, releaseFd);
+            ctx->target_layer->releaseFenceFd = -1;
+            if (ctx->contents[0]->retireFenceFd >= 0) {
+                close(ctx->contents[0]->retireFenceFd);
+                ctx->contents[0]->retireFenceFd = -1;
+            }
+        }
+        wait_retire(ctx, oldRetire);
+        return;
+    }
+
+    /* Success: replace acquire fence with HWC release fence (or -1) exactly once */
+    const int releaseFd = ctx->target_layer->releaseFenceFd;
+    ctx->target_layer->acquireFenceFd = -1;
+    HWCNativeBufferSetFence(buffer, releaseFd);
+    ctx->target_layer->releaseFenceFd = -1;
+    wait_retire(ctx, oldRetire);
+
+    ctx->last_prepare_rc = 0;
+    ctx->last_set_rc = 0;
+    ctx->last_present_success = true;
+    ctx->completed_generation = ctx->target_generation;
+
+    ctx->present_count++;
+    if (ctx->verbose || ctx->present_count <= 3 || ctx->present_count % 60 == 0) {
+        uint32_t current_vsyncs = __atomic_load_n(&ctx->vsync_count, __ATOMIC_RELAXED);
+        printf("[SANTOS_HWC] present=%u vsync=%u release_fd=%d errors=%u retire_timeouts=%u\n",
+               ctx->present_count, current_vsyncs, releaseFd,
+               ctx->present_errors, ctx->retire_timeouts);
+        fflush(stdout);
+    }
+}
+
+static int santos_hwc_open(santos_hwc_t *ctx, bool verbose)
+{
+    memset(ctx, 0, sizeof(*ctx));
+    g_cond_init(&ctx->vsync_idle);
+    ctx->vsync_sync_initialized = true;
+    ctx->verbose = verbose;
+    int failure_rc;
+
+    /* Timeout configuration */
+    const char *timeout_env = getenv("SANTOS_RETIRE_TIMEOUT_MS");
+    ctx->retire_timeout_ms = (timeout_env && atoi(timeout_env) > 0) ? (uint32_t)atoi(timeout_env) : 1000u;
+
+    /* Fault injection configuration (default OFF) */
+    const char *fault_env = getenv("SANTOS_HWC_INJECT_FAULT");
+    const char *trigger_env = getenv("SANTOS_HWC_ENABLE_FAULT_TRIGGER");
+    ctx->enable_runtime_trigger = (trigger_env && atoi(trigger_env) > 0);
+    if (ctx->enable_runtime_trigger) {
+        fprintf(stderr, "[SANTOS_HWC] Runtime fault trigger enabled via SANTOS_HWC_ENABLE_FAULT_TRIGGER\n");
+    }
+    if (fault_env) {
+        if (strncmp(fault_env, "prepare:", 8) == 0) {
+            ctx->inject_fault = SANTOS_HWC_INJECT_FAIL_PREPARE;
+            ctx->inject_count = (uint32_t)atoi(fault_env + 8);
+            fprintf(stderr, "[SANTOS_HWC] Armed initial fault injection: PREPARE count=%u\n", ctx->inject_count);
+        } else if (strncmp(fault_env, "set:", 4) == 0) {
+            ctx->inject_fault = SANTOS_HWC_INJECT_FAIL_SET;
+            ctx->inject_count = (uint32_t)atoi(fault_env + 4);
+            fprintf(stderr, "[SANTOS_HWC] Armed initial fault injection: SET count=%u\n", ctx->inject_count);
+        }
+    }
+
+    /* Unblank fb0 */
+    int fb_fd = open("/dev/fb0", O_RDWR | O_CLOEXEC);
+    if (fb_fd >= 0) {
+        if (ioctl(fb_fd, FBIOBLANK, 0) < 0) {
+            fprintf(stderr, "[SANTOS_HWC] WARN: FBIOBLANK 0 ioctl failed: %s\n", strerror(errno));
+        }
+        close(fb_fd);
+    }
+
+    const hw_module_t *module = NULL;
+    int err = hw_get_module("hwcomposer", &module);
+    if (err || !module) {
+        fprintf(stderr, "[SANTOS_HWC] FATAL: hw_get_module('hwcomposer') failed: %d (%s)\n",
+                err, strerror(-err));
+        return -1;
+    }
+
+    err = hwc_open_1(module, &ctx->device);
+    if (err || !ctx->device) {
+        fprintf(stderr, "[SANTOS_HWC] FATAL: hwc_open_1 failed: %d\n", err);
+        failure_rc = -2;
+        goto fail;
+    }
+
+    uint32_t configs[5];
+    size_t count = 5;
+    err = ctx->device->getDisplayConfigs(ctx->device, 0, configs, &count);
+    if (err || count == 0) {
+        fprintf(stderr, "[SANTOS_HWC] FATAL: getDisplayConfigs failed: %d, count=%zu\n", err, count);
+        failure_rc = -3;
+        goto fail;
+    }
+
+    const uint32_t attrs[] = {
+        HWC_DISPLAY_WIDTH,
+        HWC_DISPLAY_HEIGHT,
+        HWC_DISPLAY_VSYNC_PERIOD,
+        HWC_DISPLAY_DPI_X,
+        HWC_DISPLAY_DPI_Y,
+        HWC_DISPLAY_NO_ATTRIBUTE
+    };
+    int32_t values[5] = {0};
+    err = ctx->device->getDisplayAttributes(ctx->device, 0, configs[0], attrs, values);
+    if (err || values[0] <= 0 || values[1] <= 0) {
+        fprintf(stderr, "[SANTOS_HWC] FATAL: getDisplayAttributes failed: %d (w=%d, h=%d)\n",
+                err, values[0], values[1]);
+        failure_rc = -4;
+        goto fail;
+    }
+
+    ctx->width = values[0];
+    ctx->height = values[1];
+    ctx->vsync_period_ns = values[2];
+    ctx->dpi_x = values[3];
+    ctx->dpi_y = values[4];
+
+    printf("[SANTOS_HWC] Discovered display: %dx%d @ %d ns/frame (%.2f Hz), dpi=(%d, %d)\n",
+           ctx->width, ctx->height, ctx->vsync_period_ns,
+           (ctx->vsync_period_ns > 0) ? (1e9 / ctx->vsync_period_ns) : 0.0,
+           ctx->dpi_x, ctx->dpi_y);
+
+    if (ctx->device->blank) {
+        err = ctx->device->blank(ctx->device, 0, 0); /* unblank */
+        if (err) {
+            fprintf(stderr, "[SANTOS_HWC] WARN: hwc->blank(0, 0) unblank returned %d\n", err);
+        }
+    }
+
+    if (!ctx->device->registerProcs || !ctx->device->eventControl) {
+        fprintf(stderr, "[SANTOS_HWC] FATAL: vsync hooks missing in HWC device\n");
+        failure_rc = -5;
+        goto fail;
+    }
+
+    /* Allocate HWC contents list for 2 layers (FRAMEBUFFER + FRAMEBUFFER_TARGET) */
+    hwc_display_contents_1_t *list = (hwc_display_contents_1_t *)calloc(
+        1, sizeof(hwc_display_contents_1_t) + 2 * sizeof(hwc_layer_1_t));
+    if (!list) {
+        fprintf(stderr, "[SANTOS_HWC] FATAL: allocation of display contents failed\n");
+        failure_rc = -6;
+        goto fail;
+    }
+
+    ctx->contents[0] = list;
+    list->retireFenceFd = -1;
+    list->flags = HWC_GEOMETRY_CHANGED;
+    list->numHwLayers = 2;
+
+    for (int i = 0; i < 2; ++i) {
+        hwc_layer_1_t *layer = &list->hwLayers[i];
+        layer->compositionType = i ? HWC_FRAMEBUFFER_TARGET : HWC_FRAMEBUFFER;
+        layer->blending = HWC_BLENDING_NONE;
+        layer->sourceCropf.left = 0.0f;
+        layer->sourceCropf.top = 0.0f;
+        layer->sourceCropf.right = (float)ctx->width;
+        layer->sourceCropf.bottom = (float)ctx->height;
+        layer->displayFrame.left = 0;
+        layer->displayFrame.top = 0;
+        layer->displayFrame.right = ctx->width;
+        layer->displayFrame.bottom = ctx->height;
+        layer->visibleRegionScreen.numRects = 1;
+        layer->visibleRegionScreen.rects = &layer->displayFrame;
+        layer->acquireFenceFd = -1;
+        layer->releaseFenceFd = -1;
+    }
+    ctx->target_layer = &list->hwLayers[1];
+
+    /* Create ANativeWindow backed by HWComposerNativeWindow */
+    ctx->native_window = HWCNativeWindowCreate(
+        ctx->width, ctx->height, HAL_PIXEL_FORMAT_RGBA_8888,
+        present_callback, ctx);
+    if (!ctx->native_window) {
+        fprintf(stderr, "[SANTOS_HWC] FATAL: HWCNativeWindowCreate failed\n");
+        failure_rc = -7;
+        goto fail;
+    }
+
+    /*
+     * Do not expose ctx to asynchronous HWC callbacks until every fallible
+     * pre-success allocation/construction path has completed.  Once the
+     * native window exists, callback-owned state is intentionally retained
+     * for process lifetime by santos_hwc_close().
+     */
+    ctx->device->registerProcs(ctx->device, &s_hwc_procs);
+    g_mutex_lock(&g_hwc_active_lock);
+    g_hwc_active = ctx;
+    g_mutex_unlock(&g_hwc_active_lock);
+    err = ctx->device->eventControl(ctx->device, 0, HWC_EVENT_VSYNC, 1);
+    if (err) {
+        fprintf(stderr, "[SANTOS_HWC] WARN: eventControl VSYNC enable returned %d\n", err);
+    } else {
+        ctx->vsync_enabled = true;
+    }
+
+    printf("[SANTOS_HWC] Initialized successfully: %dx%d, ANativeWindow=%p\n",
+           ctx->width, ctx->height, (void *)ctx->native_window);
+    return 0;
+
+fail:
+    santos_hwc_close(ctx);
+    return failure_rc;
+}
+
+void *santos_hwc_get_native_window(santos_hwc_t *ctx)
+{
+    return ctx ? (void *)ctx->native_window : NULL;
+}
+
+static void santos_hwc_close(santos_hwc_t *ctx)
+{
+    if (!ctx)
+        return;
+
+    printf("[SANTOS_HWC] Closing HWC display helper...\n");
+
+    /* Drain any remaining retire fence */
+    if (ctx->contents[0] && ctx->contents[0]->retireFenceFd >= 0) {
+        wait_retire(ctx, ctx->contents[0]->retireFenceFd);
+        ctx->contents[0]->retireFenceFd = -1;
+    }
+
+    /*
+     * Close the active-context admission gate first, then drain callbacks
+     * that already took the snapshot before touching HWC/object lifetime.
+     */
+    g_mutex_lock(&g_hwc_active_lock);
+    if (g_hwc_active == ctx)
+        g_hwc_active = NULL;
+    g_mutex_unlock(&g_hwc_active_lock);
+
+    santos_hwc_set_vsync_callback(ctx, NULL, NULL);
+
+    /* Disable vsync */
+    if (ctx->device && ctx->device->eventControl && ctx->vsync_enabled) {
+        ctx->device->eventControl(ctx->device, 0, HWC_EVENT_VSYNC, 0);
+        ctx->vsync_enabled = false;
+    }
+
+    /*
+     * Once HWCNativeWindowCreate succeeds, the legacy HWC/native-window path
+     * retains the callback and its user data. This is the accepted Qt oracle:
+     * callback-owned ctx, contents, target_layer, device and native_window are
+     * process-lifetime state. Do not free them here and do not invent native
+     * window destruction on this BSP; process termination reclaims them.
+     */
+    if (ctx->native_window) {
+        printf("[SANTOS_HWC] Callback state retained until process exit\n");
+        return;
+    }
+
+    if (ctx->contents[0]) {
+        free(ctx->contents[0]);
+        ctx->contents[0] = NULL;
+        ctx->target_layer = NULL;
+    }
+
+    if (ctx->device) {
+        hwc_close_1(ctx->device);
+        ctx->device = NULL;
+    }
+
+    printf("[SANTOS_HWC] Shutdown complete. Total presents=%u, vsyncs=%u, errors=%u, retire_timeouts=%u\n",
+           ctx->present_count, ctx->vsync_count, ctx->present_errors, ctx->retire_timeouts);
+}
+
+santos_hwc_t *santos_hwc_create(bool verbose)
+{
+    santos_hwc_t *ctx = (santos_hwc_t *)calloc(1, sizeof(*ctx));
+    if (!ctx)
+        return NULL;
+    if (santos_hwc_open(ctx, verbose) != 0) {
+        santos_hwc_destroy(ctx);
+        return NULL;
+    }
+    return ctx;
+}
+
+void santos_hwc_destroy(santos_hwc_t *ctx)
+{
+    if (!ctx)
+        return;
+    santos_hwc_close(ctx);
+    if (!ctx->native_window) {
+        if (ctx->vsync_sync_initialized) {
+            g_cond_clear(&ctx->vsync_idle);
+            ctx->vsync_sync_initialized = false;
+        }
+        free(ctx);
+    }
+}
+
+void santos_hwc_arm_frame(santos_hwc_t *ctx, uint64_t frame_seq)
+{
+    if (!ctx)
+        return;
+    ctx->target_generation = frame_seq;
+    ctx->completed_generation = 0;
+    ctx->last_present_success = false;
+    ctx->last_prepare_rc = 0;
+    ctx->last_set_rc = 0;
+
+    /*
+     * Zero-cost runtime fault trigger:
+     * Only poll filesystem if explicitly enabled via SANTOS_HWC_ENABLE_FAULT_TRIGGER.
+     */
+    if (__builtin_expect(ctx->enable_runtime_trigger, 0) && ctx->inject_count == 0) {
+        FILE *f = fopen("/run/santos_hwc_fault", "r");
+        if (f) {
+            char mode[32] = {0};
+            uint32_t count = 1;
+            if (fscanf(f, "%31s %u", mode, &count) >= 1) {
+                if (count == 0)
+                    count = 1;
+                if (strcmp(mode, "prepare") == 0) {
+                    ctx->inject_fault = SANTOS_HWC_INJECT_FAIL_PREPARE;
+                    ctx->inject_count = count;
+                    fprintf(stderr, "[SANTOS_HWC] Armed fault injection from /run/santos_hwc_fault: PREPARE count=%u\n", count);
+                } else if (strcmp(mode, "set") == 0) {
+                    ctx->inject_fault = SANTOS_HWC_INJECT_FAIL_SET;
+                    ctx->inject_count = count;
+                    fprintf(stderr, "[SANTOS_HWC] Armed fault injection from /run/santos_hwc_fault: SET count=%u\n", count);
+                }
+            }
+            fclose(f);
+            /* Consume only an explicitly enabled test trigger. */
+            unlink("/run/santos_hwc_fault");
+        }
+    }
+}
+
+bool santos_hwc_end_frame(santos_hwc_t *ctx, uint64_t frame_seq)
+{
+    if (!ctx)
+        return false;
+
+    /* Verify that the completed callback strictly matches this frame's generation */
+    if (ctx->completed_generation != frame_seq) {
+        fprintf(stderr, "[SANTOS_HWC] Generation mismatch: expected %" PRIu64 ", completed %" PRIu64 "\n",
+                frame_seq, ctx->completed_generation);
+        return false;
+    }
+
+    bool success = ctx->last_present_success;
+    /* Consume and reset so no subsequent frame can reuse stale status */
+    ctx->target_generation = 0;
+    ctx->completed_generation = 0;
+    ctx->last_present_success = false;
+
+    return success;
+}
+
+void santos_hwc_inject_fault(santos_hwc_t *ctx, santos_hwc_inject_fault_t fault, uint32_t count)
+{
+    if (!ctx)
+        return;
+    ctx->inject_fault = fault;
+    ctx->inject_count = count;
+}
+
+void santos_hwc_set_vsync_callback(santos_hwc_t *ctx, santos_hwc_vsync_cb_t cb, void *user_data)
+{
+    if (!ctx || !ctx->vsync_sync_initialized)
+        return;
+
+    /*
+     * Publish NULL first even when replacing a callback.  That closes the
+     * admission gate, drains already admitted callbacks, and avoids waiting
+     * forever while a continuously-running provider admits replacements.
+     * Only then publish the new callback/data pair.
+     */
+    g_mutex_lock(&g_hwc_active_lock);
+    ctx->vsync_cb = NULL;
+    ctx->vsync_cb_data = NULL;
+    while (ctx->vsync_in_flight != 0)
+        g_cond_wait(&ctx->vsync_idle, &g_hwc_active_lock);
+    ctx->vsync_cb_data = user_data;
+    ctx->vsync_cb = cb;
+    g_mutex_unlock(&g_hwc_active_lock);
+}
diff --git a/src/backends/santos/santos_hwc.h b/src/backends/santos/santos_hwc.h
new file mode 100644
index 0000000000000000000000000000000000000000..fae979fb4ba8983748b2975063541d07100249b9
--- /dev/null
+++ b/src/backends/santos/santos_hwc.h
@@ -0,0 +1,46 @@
+/*
+ * Santos HWC helper for Mutter display backend
+ */
+
+#ifndef SANTOS_HWC_H
+#define SANTOS_HWC_H
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct santos_hwc santos_hwc_t;
+
+typedef enum {
+    SANTOS_HWC_INJECT_NONE = 0,
+    SANTOS_HWC_INJECT_FAIL_PREPARE = 1,
+    /* Test-only pre-set failure; never calls device->set(). */
+    SANTOS_HWC_INJECT_FAIL_SET = 2,
+} santos_hwc_inject_fault_t;
+
+santos_hwc_t *santos_hwc_create(bool verbose);
+void *santos_hwc_get_native_window(santos_hwc_t *ctx);
+void santos_hwc_destroy(santos_hwc_t *ctx);
+
+void santos_hwc_arm_frame(santos_hwc_t *ctx, uint64_t frame_seq);
+bool santos_hwc_end_frame(santos_hwc_t *ctx, uint64_t frame_seq);
+void santos_hwc_inject_fault(santos_hwc_t *ctx, santos_hwc_inject_fault_t fault, uint32_t count);
+
+typedef void (*santos_hwc_vsync_cb_t)(int64_t timestamp_ns, void *user_data);
+
+/*
+ * Registration is synchronized with hwc_procs_vsync(): setting cb to NULL
+ * closes callback admission and waits until every callback that already
+ * admitted itself has returned.  The callback body runs outside the
+ * registration lock, so the caller must not unregister from inside cb.
+ */
+void santos_hwc_set_vsync_callback(santos_hwc_t *ctx, santos_hwc_vsync_cb_t cb, void *user_data);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SANTOS_HWC_H */
