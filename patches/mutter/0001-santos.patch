--- /dev/null
+++ b/src/backends/santos/meta-backend-santos.c
@@ -0,0 +1,406 @@
+/*
+ * Copyright (C) 2026 Santos Project
+ *
+ * Minimal Mutter Santos Backend implementation.
+ */
+
+#include "config.h"
+
+#include "backends/santos/meta-backend-santos.h"
+#include "backends/santos/meta-clutter-backend-santos.h"
+#include "backends/santos/meta-gpu-santos.h"
+#include "backends/santos/meta-monitor-manager-santos.h"
+#include "backends/santos/meta-renderer-santos.h"
+
+#include "backends/meta-backend-private.h"
+#include "backends/meta-color-manager.h"
+#include "backends/meta-cursor-tracker-private.h"
+#include "backends/meta-launcher.h"
+#include "backends/meta-monitor-manager-private.h"
+#include "backends/meta-stage-private.h"
+#include "backends/native/meta-device-pool-private.h"
+#include "backends/native/meta-pointer-constraint-native.h"
+#include "backends/native/meta-seat-native.h"
+#include "backends/native/meta-input-thread.h"
+
+struct _MetaBackendSantos
+{
+  MetaBackend parent;
+
+  MetaDevicePool *device_pool;
+};
+
+static void
+initable_iface_init (GInitableIface *initable_iface);
+
+G_DEFINE_FINAL_TYPE_WITH_CODE (MetaBackendSantos, meta_backend_santos,
+                               META_TYPE_BACKEND,
+                               G_IMPLEMENT_INTERFACE (G_TYPE_INITABLE,
+                                                      initable_iface_init))
+
+static gboolean
+meta_backend_santos_init_basic (MetaBackend  *backend,
+                                GError      **error)
+{
+  MetaBackendSantos *self = META_BACKEND_SANTOS (backend);
+  MetaGpuSantos *gpu;
+
+  if (meta_backend_get_launcher (backend))
+    self->device_pool = meta_device_pool_new (backend);
+
+  gpu = meta_gpu_santos_new (backend);
+  meta_backend_add_gpu (backend, META_GPU (gpu));
+
+  return TRUE;
+}
+
+static ClutterBackend *
+meta_backend_santos_create_clutter_backend (MetaBackend    *backend,
+                                            ClutterContext *context)
+{
+  return meta_clutter_backend_santos_new (backend, context);
+}
+
+static gboolean
+meta_backend_santos_create_launcher (MetaBackend   *backend,
+                                     MetaLauncher **launcher_out,
+                                     GError       **error)
+{
+  g_autoptr (MetaLauncher) launcher = NULL;
+  g_autoptr (GError) local_error = NULL;
+
+  /* The standalone fallback is a successful result. Keep optional launcher
+   * errors local so TRUE can never be paired with a caller-visible error. */
+  (void) error;
+
+  launcher = meta_launcher_new (backend, &local_error);
+  if (!launcher)
+    {
+      g_message ("Santos backend: running without logind launcher: %s",
+                 local_error ? local_error->message : "none");
+      *launcher_out = NULL;
+      return TRUE;
+    }
+
+  if (!meta_launcher_take_control (launcher, &local_error))
+    {
+      g_warning ("Santos backend: failed to take control of session, falling back to standalone: %s",
+                 local_error ? local_error->message : "unknown error");
+      *launcher_out = NULL;
+      return TRUE;
+    }
+
+  *launcher_out = g_steal_pointer (&launcher);
+  return TRUE;
+}
+
+static ClutterSeat *
+meta_backend_santos_create_default_seat (MetaBackend  *backend,
+                                         GError      **error)
+{
+  ClutterContext *clutter_context = meta_backend_get_clutter_context (backend);
+  MetaLauncher *launcher = meta_backend_get_launcher (backend);
+  const char *seat_id = "seat0";
+  MetaSeatNativeFlag flags = META_SEAT_NATIVE_FLAG_NONE;
+
+  if (launcher && meta_launcher_get_seat_id (launcher))
+    seat_id = meta_launcher_get_seat_id (launcher);
+
+  return CLUTTER_SEAT (g_object_new (META_TYPE_SEAT_NATIVE,
+                                     "backend", backend,
+                                     "context", clutter_context,
+                                     "seat-id", seat_id,
+                                     "name", seat_id,
+                                     "flags", flags,
+                                     NULL));
+}
+
+static MetaMonitorManager *
+meta_backend_santos_create_monitor_manager (MetaBackend  *backend,
+                                            GError      **error)
+{
+  return META_MONITOR_MANAGER (meta_monitor_manager_santos_new (backend, error));
+}
+
+static MetaColorManager *
+meta_backend_santos_create_color_manager (MetaBackend *backend)
+{
+  return g_object_new (META_TYPE_COLOR_MANAGER,
+                       "backend", backend,
+                       NULL);
+}
+
+static MetaRenderer *
+meta_backend_santos_create_renderer (MetaBackend  *backend,
+                                     GError      **error)
+{
+  return META_RENDERER (meta_renderer_santos_new (backend, error));
+}
+
+static MetaBackendCapabilities
+meta_backend_santos_get_capabilities (MetaBackend *backend)
+{
+  return META_BACKEND_CAPABILITY_NONE;
+}
+
+static void
+meta_backend_santos_update_stage (MetaBackend *backend)
+{
+  ClutterActor *stage = meta_backend_get_stage (backend);
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+  int width, height;
+
+  meta_stage_rebuild_views (META_STAGE (stage));
+
+  meta_monitor_manager_get_screen_size (monitor_manager, &width, &height);
+  clutter_actor_set_size (stage, width, height);
+}
+
+static void
+meta_backend_santos_update_viewports (MetaBackend *backend)
+{
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+  ClutterBackend *clutter_backend = meta_backend_get_clutter_backend (backend);
+  MetaSeatNative *seat =
+    META_SEAT_NATIVE (clutter_backend_get_default_seat (clutter_backend));
+  MetaViewportInfo *viewports;
+
+  viewports = meta_monitor_manager_get_viewports (monitor_manager);
+  meta_seat_native_set_viewports (seat, viewports);
+  g_object_unref (viewports);
+}
+
+static gboolean
+meta_backend_santos_init_post (MetaBackend  *backend,
+                               GError      **error)
+{
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+  ClutterBackend *clutter_backend = meta_backend_get_clutter_backend (backend);
+  ClutterSeat *seat = clutter_backend_get_default_seat (clutter_backend);
+
+  g_signal_connect_swapped (monitor_manager, "monitors-changed-internal",
+                            G_CALLBACK (meta_backend_santos_update_viewports),
+                            backend);
+  meta_backend_santos_update_viewports (backend);
+
+  if (seat)
+    meta_seat_native_start (META_SEAT_NATIVE (seat));
+
+  return TRUE;
+}
+
+static MetaInputSettings *
+meta_backend_santos_get_input_settings (MetaBackend *backend)
+{
+  ClutterBackend *clutter_backend = meta_backend_get_clutter_backend (backend);
+  ClutterSeat *seat = clutter_backend_get_default_seat (clutter_backend);
+
+  if (seat)
+    {
+      MetaSeatNative *seat_native = META_SEAT_NATIVE (seat);
+      if (seat_native->impl)
+        return meta_seat_impl_get_input_settings (seat_native->impl);
+    }
+
+  return NULL;
+}
+
+static void
+meta_backend_santos_dispose (GObject *object)
+{
+  MetaBackendSantos *self = META_BACKEND_SANTOS (object);
+
+  G_OBJECT_CLASS (meta_backend_santos_parent_class)->dispose (object);
+
+  g_clear_object (&self->device_pool);
+}
+
+static MetaCursorRenderer *
+meta_backend_santos_get_cursor_renderer (MetaBackend   *backend,
+                                         ClutterSprite *sprite)
+{
+  ClutterBackend *clutter_backend = meta_backend_get_clutter_backend (backend);
+
+  if (!clutter_backend || !META_IS_CLUTTER_BACKEND_SANTOS (clutter_backend))
+    return NULL;
+
+  /* Santos has no KMS cursor plane. Use the base renderer so the cursor is
+   * composited by the software stage overlay rather than importing
+   * MetaCursorRendererNative's KMS/GBM contract. */
+  return meta_clutter_backend_santos_maybe_ensure_cursor_renderer (
+    META_CLUTTER_BACKEND_SANTOS (clutter_backend), sprite);
+}
+
+static void
+meta_backend_santos_remove_cursor_renderer (MetaBackend   *backend,
+                                             ClutterSprite *sprite)
+{
+  ClutterBackend *clutter_backend = meta_backend_get_clutter_backend (backend);
+
+  if (!clutter_backend || !META_IS_CLUTTER_BACKEND_SANTOS (clutter_backend))
+    return;
+
+  meta_clutter_backend_santos_remove_cursor_renderer (
+    META_CLUTTER_BACKEND_SANTOS (clutter_backend), sprite);
+}
+
+static MetaLogicalMonitor *
+meta_backend_santos_get_current_logical_monitor (MetaBackend *backend)
+{
+  MetaCursorTracker *cursor_tracker = meta_backend_get_cursor_tracker (backend);
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+  graphene_point_t point;
+
+  meta_cursor_tracker_get_pointer (cursor_tracker, &point, NULL);
+  return meta_monitor_manager_get_logical_monitor_at (monitor_manager,
+                                                       point.x, point.y);
+}
+
+static void
+meta_backend_santos_set_keymap_cb (GObject      *source_object,
+                                   GAsyncResult *result,
+                                   gpointer       user_data)
+{
+  MetaSeatNative *seat_native = META_SEAT_NATIVE (source_object);
+  g_autoptr (GTask) task = G_TASK (user_data);
+  g_autoptr (GError) error = NULL;
+
+  if (!meta_seat_native_set_keymap_finish (seat_native, result, &error))
+    {
+      g_task_return_error (task, g_steal_pointer (&error));
+      return;
+    }
+
+  g_task_return_boolean (task, TRUE);
+}
+
+static void
+meta_backend_santos_set_keymap_async (MetaBackend           *backend,
+                                      MetaKeymapDescription *description,
+                                      xkb_layout_index_t     layout_index,
+                                      GTask                 *task)
+{
+  ClutterBackend *clutter_backend = meta_backend_get_clutter_backend (backend);
+  ClutterSeat *seat = clutter_backend_get_default_seat (clutter_backend);
+
+  meta_seat_native_set_keymap_async (META_SEAT_NATIVE (seat),
+                                     description,
+                                     layout_index,
+                                     g_task_get_cancellable (task),
+                                     meta_backend_santos_set_keymap_cb,
+                                     task);
+}
+
+static void
+meta_backend_santos_set_pointer_constraint (MetaBackend           *backend,
+                                            MetaPointerConstraint *constraint)
+{
+  ClutterBackend *clutter_backend = meta_backend_get_clutter_backend (backend);
+  ClutterSeat *seat = clutter_backend_get_default_seat (clutter_backend);
+  g_autoptr (MetaPointerConstraintImpl) constraint_impl = NULL;
+  MtkRegion *region;
+
+  if (constraint)
+    {
+      graphene_point_t origin;
+      double min_edge_distance;
+
+      region = meta_pointer_constraint_get_region (constraint, &origin);
+      min_edge_distance =
+        meta_pointer_constraint_get_min_edge_distance (constraint);
+      constraint_impl = meta_pointer_constraint_impl_native_new (constraint,
+                                                                 seat,
+                                                                 region,
+                                                                 origin,
+                                                                 min_edge_distance);
+    }
+
+  meta_seat_native_set_pointer_constraint (META_SEAT_NATIVE (seat),
+                                           constraint_impl);
+}
+
+static struct xkb_keymap *
+meta_backend_santos_get_xkb_keymap (MetaBackend *backend)
+{
+  ClutterBackend *clutter_backend = meta_backend_get_clutter_backend (backend);
+  ClutterSeat *seat = clutter_backend_get_default_seat (clutter_backend);
+
+  if (seat)
+    return meta_seat_native_get_xkb_keymap (META_SEAT_NATIVE (seat));
+
+  return NULL;
+}
+
+static MetaKeymapDescription *
+meta_backend_santos_get_keymap_description (MetaBackend *backend)
+{
+  ClutterBackend *clutter_backend = meta_backend_get_clutter_backend (backend);
+  ClutterSeat *seat = clutter_backend_get_default_seat (clutter_backend);
+
+  if (seat)
+    return meta_seat_native_get_keymap_description (META_SEAT_NATIVE (seat));
+
+  return NULL;
+}
+
+static xkb_layout_index_t
+meta_backend_santos_get_keymap_layout_group (MetaBackend *backend)
+{
+  ClutterBackend *clutter_backend = meta_backend_get_clutter_backend (backend);
+  ClutterSeat *seat = clutter_backend_get_default_seat (clutter_backend);
+
+  if (seat)
+    return meta_seat_native_get_keyboard_layout_index (META_SEAT_NATIVE (seat));
+
+  return 0;
+}
+
+static void
+meta_backend_santos_init (MetaBackendSantos *self)
+{
+}
+
+static void
+meta_backend_santos_class_init (MetaBackendSantosClass *klass)
+{
+  MetaBackendClass *backend_class = META_BACKEND_CLASS (klass);
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->dispose = meta_backend_santos_dispose;
+  backend_class->init_basic = meta_backend_santos_init_basic;
+  backend_class->init_post = meta_backend_santos_init_post;
+  backend_class->create_clutter_backend = meta_backend_santos_create_clutter_backend;
+  backend_class->create_launcher = meta_backend_santos_create_launcher;
+  backend_class->create_default_seat = meta_backend_santos_create_default_seat;
+  backend_class->create_monitor_manager = meta_backend_santos_create_monitor_manager;
+  backend_class->create_color_manager = meta_backend_santos_create_color_manager;
+  backend_class->create_renderer = meta_backend_santos_create_renderer;
+  backend_class->get_capabilities = meta_backend_santos_get_capabilities;
+  backend_class->update_stage = meta_backend_santos_update_stage;
+  backend_class->get_input_settings = meta_backend_santos_get_input_settings;
+  backend_class->get_cursor_renderer = meta_backend_santos_get_cursor_renderer;
+  backend_class->remove_cursor_renderer = meta_backend_santos_remove_cursor_renderer;
+  backend_class->get_current_logical_monitor =
+    meta_backend_santos_get_current_logical_monitor;
+  backend_class->set_keymap_async = meta_backend_santos_set_keymap_async;
+  backend_class->get_xkb_keymap = meta_backend_santos_get_xkb_keymap;
+  backend_class->get_keymap_description = meta_backend_santos_get_keymap_description;
+  backend_class->get_keymap_layout_group = meta_backend_santos_get_keymap_layout_group;
+  backend_class->set_pointer_constraint =
+    meta_backend_santos_set_pointer_constraint;
+}
+
+MetaDevicePool *
+meta_backend_santos_get_device_pool (MetaBackendSantos *backend)
+{
+  return backend->device_pool;
+}
+
+static void
+initable_iface_init (GInitableIface *initable_iface)
+{
+}
