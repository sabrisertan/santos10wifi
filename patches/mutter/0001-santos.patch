+{
+  MetaGpu parent;
+};
+
+G_DEFINE_FINAL_TYPE (MetaGpuSantos, meta_gpu_santos, META_TYPE_GPU)
+
+static gboolean
+meta_gpu_santos_read_current (MetaGpu  *gpu,
+                              GError  **error)
+{
+  MetaCrtcModeInfo *mode_info;
+  MetaCrtcMode *mode;
+  MetaCrtcSantos *crtc;
+  MetaOutputInfo *output_info;
+  MetaOutputSantos *output;
+
+  mode_info = meta_crtc_mode_info_new ();
+  mode_info->width = 1280;
+  mode_info->height = 800;
+  mode_info->refresh_rate = 60.0f;
+  mode_info->refresh_rate_mode = META_CRTC_REFRESH_RATE_MODE_FIXED;
+  mode_info->pixel_clock_khz = 71100;
+  mode_info->flags = META_CRTC_MODE_FLAG_NONE;
+
+  mode = g_object_new (META_TYPE_CRTC_MODE,
+                       "id", (uint64_t) 1,
+                       "name", "1280x800",
+                       "info", mode_info,
+                       NULL);
+  meta_crtc_mode_info_unref (mode_info);
+
+  crtc = meta_crtc_santos_new (gpu, 1);
+
+  output_info = meta_output_info_new ();
+  output_info->name = g_strdup ("DSI-1");
+  output_info->vendor = g_strdup ("Samsung");
+  output_info->product = g_strdup ("GT-P5210");
+  output_info->serial = g_strdup ("00000000");
+  output_info->width_mm = 217;
+  output_info->height_mm = 136;
+  output_info->subpixel_order = META_SUBPIXEL_ORDER_UNKNOWN;
+  output_info->connector_type = META_CONNECTOR_TYPE_DSI;
+  output_info->panel_orientation_transform = MTK_MONITOR_TRANSFORM_NORMAL;
+  output_info->preferred_mode = mode;
+  output_info->modes = g_new0 (MetaCrtcMode *, 1);
+  output_info->modes[0] = g_object_ref (mode);
+  output_info->n_modes = 1;
+  output_info->possible_crtcs = g_new0 (MetaCrtc *, 1);
+  output_info->possible_crtcs[0] = META_CRTC (crtc);
+  output_info->n_possible_crtcs = 1;
+
+  output = meta_output_santos_new (gpu, 1, output_info);
+  meta_output_info_unref (output_info);
+
+  meta_gpu_take_modes (gpu, g_list_append (NULL, mode));
+  meta_gpu_take_crtcs (gpu, g_list_append (NULL, crtc));
+  meta_gpu_take_outputs (gpu, g_list_append (NULL, output));
+
+  return TRUE;
+}
+
+static void
+meta_gpu_santos_init (MetaGpuSantos *gpu_santos)
+{
+}
+
+static void
+meta_gpu_santos_class_init (MetaGpuSantosClass *klass)
+{
+  MetaGpuClass *gpu_class = META_GPU_CLASS (klass);
+
+  gpu_class->read_current = meta_gpu_santos_read_current;
+}
+
+MetaGpuSantos *
+meta_gpu_santos_new (MetaBackend *backend)
+{
+  return g_object_new (META_TYPE_GPU_SANTOS,
+                       "backend", backend,
+                       NULL);
+}
