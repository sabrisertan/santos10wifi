@@ -0,0 +1,176 @@
+/*
+ * Copyright (C) 2026 Santos Project
+ *
+ * Minimal Mutter Santos Display EGL implementation.
+ */
+
+#include "config.h"
+
+#include "cogl/cogl.h"
+#include "backends/santos/meta-renderer-display-egl-santos.h"
+
+#include <EGL/egl.h>
+#include "cogl/cogl-display-egl-private.h"
+#include "cogl/cogl-renderer-egl.h"
+
+struct _MetaRendererDisplayEglSantos
+{
+  CoglDisplayEGL parent;
+};
+
+G_DEFINE_FINAL_TYPE (MetaRendererDisplayEglSantos,
+                     meta_renderer_display_egl_santos,
+                     COGL_TYPE_DISPLAY_EGL)
+
+static int
+meta_renderer_display_egl_santos_add_config_attributes (CoglDisplayEGL *cogl_display_egl,
+                                                        EGLint         *attributes)
+{
+  int i = 0;
+
+  attributes[i++] = EGL_SURFACE_TYPE;
+  attributes[i++] = EGL_WINDOW_BIT;
+  attributes[i++] = EGL_RENDERABLE_TYPE;
+  attributes[i++] = EGL_OPENGL_ES2_BIT;
+
+  return i;
+}
+
+static gboolean
+meta_renderer_display_egl_santos_choose_config (CoglDisplayEGL  *cogl_display_egl,
+                                                EGLint          *attributes,
+                                                EGLConfig       *out_config,
+                                                GError         **error)
+{
+  CoglDisplay *cogl_display = COGL_DISPLAY (cogl_display_egl);
+  CoglRenderer *cogl_renderer = cogl_display_get_renderer (cogl_display);
+  CoglRendererEGL *renderer_egl = COGL_RENDERER_EGL (cogl_renderer);
+  EGLDisplay edpy = cogl_renderer_egl_get_edisplay (renderer_egl);
+  EGLConfig configs[32];
+  EGLint num_configs = 0;
+  static const EGLint config_attribs[] = {
+    EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+    EGL_RED_SIZE, 8,
+    EGL_GREEN_SIZE, 8,
+    EGL_BLUE_SIZE, 8,
+    EGL_ALPHA_SIZE, 8,
+    EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+    EGL_NONE
+  };
+
+  if (!eglChooseConfig (edpy, config_attribs, configs, G_N_ELEMENTS (configs), &num_configs) ||
+      num_configs <= 0)
+    {
+      g_set_error (error, COGL_WINSYS_ERROR, COGL_WINSYS_ERROR_CREATE_CONTEXT,
+                   "Failed to choose RGBA8888 window EGLConfig for Santos HWC");
+      return FALSE;
+    }
+
+  *out_config = configs[0];
+  return TRUE;
+}
+
+static EGLSurface
+create_dummy_pbuffer_surface (CoglRendererEGL  *renderer_egl,
+                              GError          **error)
+{
+  EGLConfig pbuffer_config;
+  static const EGLint pbuffer_config_attribs[] = {
+    EGL_SURFACE_TYPE, EGL_PBUFFER_BIT,
+    EGL_RED_SIZE, 1,
+    EGL_GREEN_SIZE, 1,
+    EGL_BLUE_SIZE, 1,
+    EGL_ALPHA_SIZE, 0,
+    EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+    EGL_NONE
+  };
+  static const EGLint pbuffer_attribs[] = {
+    EGL_WIDTH, 16,
+    EGL_HEIGHT, 16,
+    EGL_NONE
+  };
+
+  if (!cogl_renderer_egl_choose_first_config (renderer_egl,
+                                              pbuffer_config_attribs,
+                                              &pbuffer_config,
+                                              error))
+    return EGL_NO_SURFACE;
+
+  return cogl_renderer_egl_create_pbuffer_surface (renderer_egl,
+                                                   pbuffer_config,
+                                                   pbuffer_attribs,
+                                                   error);
+}
+
+static gboolean
+meta_renderer_display_egl_santos_context_created (CoglDisplayEGL  *cogl_display_egl,
+                                                  GError         **error)
+{
+  CoglRenderer *cogl_renderer =
+    cogl_display_get_renderer (COGL_DISPLAY (cogl_display_egl));
+  CoglRendererEGL *renderer_egl = COGL_RENDERER_EGL (cogl_renderer);
+
+  if (!cogl_renderer_egl_has_feature (renderer_egl,
+                                      COGL_EGL_WINSYS_FEATURE_SURFACELESS_CONTEXT))
+    {
+      cogl_display_egl_set_dummy_surface (cogl_display_egl,
+                                          create_dummy_pbuffer_surface (renderer_egl,
+                                                                        error));
+      if (cogl_display_egl_get_dummy_surface (cogl_display_egl) == EGL_NO_SURFACE)
+        return FALSE;
+    }
+
+  if (!cogl_display_egl_make_current (cogl_display_egl,
+                                      cogl_display_egl_get_dummy_surface (cogl_display_egl),
+                                      cogl_display_egl_get_dummy_surface (cogl_display_egl),
+                                      cogl_display_egl_get_egl_context (cogl_display_egl)))
+    {
+      g_set_error (error, COGL_WINSYS_ERROR,
+                   COGL_WINSYS_ERROR_CREATE_CONTEXT,
+                   "Failed to make context current on Santos dummy surface");
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
+static void
+meta_renderer_display_egl_santos_cleanup_context (CoglDisplayEGL *cogl_display_egl)
+{
+  CoglRenderer *cogl_renderer =
+    cogl_display_get_renderer (COGL_DISPLAY (cogl_display_egl));
+
+  if (cogl_display_egl_get_dummy_surface (cogl_display_egl) != EGL_NO_SURFACE)
+    {
+      cogl_renderer_egl_destroy_surface (COGL_RENDERER_EGL (cogl_renderer),
+                                         cogl_display_egl_get_dummy_surface (cogl_display_egl),
+                                         NULL);
+      cogl_display_egl_set_dummy_surface (cogl_display_egl, EGL_NO_SURFACE);
+    }
+}
+
+static void
+meta_renderer_display_egl_santos_init (MetaRendererDisplayEglSantos *display_egl)
+{
+}
+
+static void
+meta_renderer_display_egl_santos_class_init (MetaRendererDisplayEglSantosClass *klass)
+{
+  CoglDisplayEGLClass *egl_class = COGL_DISPLAY_EGL_CLASS (klass);
+
+  egl_class->add_config_attributes = meta_renderer_display_egl_santos_add_config_attributes;
+  egl_class->choose_config = meta_renderer_display_egl_santos_choose_config;
+  egl_class->context_created = meta_renderer_display_egl_santos_context_created;
+  egl_class->cleanup_context = meta_renderer_display_egl_santos_cleanup_context;
+}
+
+MetaRendererDisplayEglSantos *
+meta_renderer_display_egl_santos_new (CoglRenderer *renderer)
+{
+  g_return_val_if_fail (renderer != NULL, NULL);
+
+  return g_object_new (META_TYPE_RENDERER_DISPLAY_EGL_SANTOS,
+                       "renderer", renderer,
+                       NULL);
+}
