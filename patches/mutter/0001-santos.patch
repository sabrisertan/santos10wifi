diff --git a/src/backends/santos/meta-onscreen-santos.c b/src/backends/santos/meta-onscreen-santos.c
new file mode 100644
index 0000000000000000000000000000000000000000..a6a6205fd42b58110e20382607cfb70ea781f5b1
--- /dev/null
+++ b/src/backends/santos/meta-onscreen-santos.c
@@ -0,0 +1,176 @@
+/*
+ * Copyright (C) 2026 Santos Project
+ *
+ * Minimal Mutter Santos Onscreen implementation.
+ */
+
+#include "config.h"
+
+#include "cogl/cogl.h"
+#include "backends/santos/meta-onscreen-santos.h"
+#include "backends/santos/meta-renderer-santos.h"
+
+#include <EGL/egl.h>
+#include "clutter/clutter-mutter.h"
+#include "cogl/cogl-context-private.h"
+#include "cogl/cogl-display-egl.h"
+#include "cogl/cogl-frame-info-private.h"
+#include "cogl/cogl-framebuffer-driver.h"
+#include "cogl/cogl-onscreen-private.h"
+#include "cogl/cogl-renderer-egl.h"
+#include "backends/meta-backend-private.h"
+#include "backends/meta-renderer.h"
+#include "meta/meta-context.h"
+#include "clutter/clutter.h"
+
+struct _MetaOnscreenSantos
+{
+  CoglOnscreenEgl parent;
+
+  MetaRendererSantos *renderer_santos;
+  santos_hwc_t *hwc;
+  unsigned int sequence;
+  uint64_t target_frames;
+  gboolean last_frame_failed;
+};
+
+G_DEFINE_FINAL_TYPE (MetaOnscreenSantos, meta_onscreen_santos, COGL_TYPE_ONSCREEN_EGL)
+
+static gboolean
+meta_onscreen_santos_swap_buffers_with_damage (CoglOnscreen    *onscreen,
+                                               const MtkRegion *region,
+                                               CoglFrameInfo   *frame_info,
+                                               gpointer         user_data)
+{
+  MetaOnscreenSantos *self = META_ONSCREEN_SANTOS (onscreen);
+  ClutterFrame *frame = user_data;
+  uint64_t target_gen;
+
+  target_gen = ++self->target_frames;
+  santos_hwc_arm_frame (self->hwc, target_gen);
+
+  /*
+   * Parent swap_buffers_with_damage binds context, flushes state, and
+   * invokes eglSwapBuffers(). Under Android/libhybris EGL, eglSwapBuffers
+   * synchronously executes santos_hwc's present_callback, queuing and
+   * retiring the frame on the hardware display panel.
+   */
+  if (!COGL_ONSCREEN_CLASS (meta_onscreen_santos_parent_class)->
+         swap_buffers_with_damage (onscreen, region, frame_info, user_data))
+    {
+      if (frame)
+        clutter_frame_set_result (frame, CLUTTER_FRAME_RESULT_IDLE);
+      return FALSE;
+    }
+
+  /*
+   * L126: Verify that the synchronous HWC present callback actually succeeded
+   * for this exact frame generation. If HWC prepare or set failed, the
+   * hardware dropped the frame; we must NOT report presentation to Mutter
+   * or Wayland clients, must NOT fabricate timestamps, and must mark
+   * the ClutterFrame as IDLE so the frame clock can reschedule/retry.
+   */
+  if (!santos_hwc_end_frame (self->hwc, target_gen))
+    {
+      if (frame)
+        clutter_frame_set_result (frame, CLUTTER_FRAME_RESULT_IDLE);
+      self->last_frame_failed = TRUE;
+      g_warning ("[SANTOS_ONSCREEN] Frame gen=%" G_GUINT64_FORMAT
+                 " present FAILED -> CLUTTER_FRAME_RESULT_IDLE (sequence=%u unchanged)",
+                 target_gen, self->sequence);
+      return FALSE;
+    }
+
+  if (self->last_frame_failed)
+    {
+      self->last_frame_failed = FALSE;
+      g_message ("[SANTOS_ONSCREEN] Frame gen=%" G_GUINT64_FORMAT
+                 " present RECOVERED -> PENDING_PRESENTED sequence=%u",
+                 target_gen, self->sequence + 1);
+    }
+
+  if (frame)
+    clutter_frame_set_result (frame, CLUTTER_FRAME_RESULT_PENDING_PRESENTED);
+
+  /*
+   * L125 / Honest Presentation Feedback:
+   * Santos PSB VSYNC provides a proven hardware refresh scheduling clock,
+   * but Candidate3B / HWC retirement does NOT provide proven frame scanout time.
+   * The scheduling timestamp is a CLOCK_MONOTONIC software observation of a
+   * hardware counter transition, not hardware-captured presentation time.
+   * Marking symbolic presentation resets the ClutterFrameClock cleanly via
+   * notify_ready without fabricating physical scanout metadata.
+   */
+  frame_info->presentation_time_us = 0;
+  frame_info->refresh_rate = 60.0f;
+  frame_info->flags = COGL_FRAME_INFO_FLAG_SYMBOLIC;
+  frame_info->sequence = ++self->sequence;
+
+  _cogl_onscreen_notify_frame_sync (onscreen, frame_info);
+  _cogl_onscreen_notify_complete (onscreen, frame_info);
+
+  return TRUE;
+}
+
+static void
+meta_onscreen_santos_init (MetaOnscreenSantos *self)
+{
+}
+
+static void
+meta_onscreen_santos_class_init (MetaOnscreenSantosClass *klass)
+{
+  CoglOnscreenClass *onscreen_class = COGL_ONSCREEN_CLASS (klass);
+
+  onscreen_class->swap_buffers_with_damage =
+    meta_onscreen_santos_swap_buffers_with_damage;
+}
+
+MetaOnscreenSantos *
+meta_onscreen_santos_new (MetaRendererSantos *renderer_santos,
+                          CoglContext        *cogl_context,
+                          int                 width,
+                          int                 height)
+{
+  MetaOnscreenSantos *self;
+  CoglFramebufferDriverConfig driver_config;
+  CoglDisplay *display;
+  CoglRenderer *renderer;
+  CoglRendererEGL *renderer_egl;
+  EGLDisplay edpy;
+  EGLConfig config;
+  void *win;
+  EGLSurface surface;
+
+  driver_config = (CoglFramebufferDriverConfig) {
+    .type = COGL_FRAMEBUFFER_DRIVER_TYPE_BACK,
+  };
+
+  self = g_object_new (META_TYPE_ONSCREEN_SANTOS,
+                       "context", cogl_context,
+                       "driver-config", &driver_config,
+                       "width", width,
+                       "height", height,
+                       NULL);
+
+  self->renderer_santos = renderer_santos;
+  self->hwc = meta_renderer_santos_get_hwc (renderer_santos);
+
+  display = cogl_context_get_display (cogl_context);
+  renderer = cogl_context_get_renderer (cogl_context);
+  renderer_egl = COGL_RENDERER_EGL (renderer);
+  edpy = cogl_renderer_egl_get_edisplay (renderer_egl);
+  config = cogl_display_egl_get_egl_config (COGL_DISPLAY_EGL (display));
+
+  win = santos_hwc_get_native_window (self->hwc);
+  if (!win)
+    g_error ("santos_hwc_get_native_window returned NULL");
+
+  surface = eglCreateWindowSurface (edpy, config, (EGLNativeWindowType) win, NULL);
+  if (surface == EGL_NO_SURFACE)
+    g_error ("eglCreateWindowSurface failed for Santos HWC: 0x%x", (unsigned int) eglGetError ());
+
+  cogl_onscreen_egl_set_egl_surface (COGL_ONSCREEN_EGL (self), surface);
+
+  return self;
+}
