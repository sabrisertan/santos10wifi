+/*
+ * Copyright (C) 2026 Santos Project
+ *
+ * Minimal Mutter Santos Clutter backend implementation.
+ */
+
+#include "config.h"
+
+#include "backends/santos/meta-clutter-backend-santos.h"
+
+#include <glib-object.h>
+
+#include "backends/meta-cursor-renderer.h"
+#include "clutter/clutter-backend-private.h"
+#include "clutter/clutter-key-focus.h"
+#include "clutter/clutter-sprite-private.h"
+#include "backends/santos/meta-renderer-display-egl-santos.h"
+#include "backends/santos/meta-stage-santos.h"
+#include "backends/meta-backend-private.h"
+#include "backends/meta-renderer.h"
+#include "backends/native/meta-sprite-native.h"
+#include "clutter/clutter.h"
+#include "cogl/cogl-context-egl.h"
+
+struct _MetaClutterBackendSantos
+{
+  ClutterBackend parent;
+
+  MetaBackend *backend;
+
+  gboolean disposed;
+
+  GHashTable *touch_sprites;
+  GHashTable *stylus_sprites;
+  GHashTable *cursor_renderers;
+  ClutterSprite *pointer_sprite;
+  ClutterKeyFocus *key_focus;
+};
+
+G_DEFINE_FINAL_TYPE (MetaClutterBackendSantos,
+                     meta_clutter_backend_santos,
+                     CLUTTER_TYPE_BACKEND)
+
+static CoglRenderer *
+meta_clutter_backend_santos_get_renderer (ClutterBackend  *clutter_backend,
+                                          GError         **error)
+{
+  MetaClutterBackendSantos *self = META_CLUTTER_BACKEND_SANTOS (clutter_backend);
+  MetaRenderer *renderer = meta_backend_get_renderer (self->backend);
+
+  return meta_renderer_create_cogl_renderer (renderer);
+}
+
+static CoglDisplay *
+meta_clutter_backend_santos_get_display (ClutterBackend  *clutter_backend,
+                                         CoglRenderer    *cogl_renderer,
+                                         GError         **error)
+{
+  return COGL_DISPLAY (meta_renderer_display_egl_santos_new (cogl_renderer));
+}
+
+static CoglContext *
+meta_clutter_backend_santos_get_context (ClutterBackend  *clutter_backend,
+                                         CoglDisplay     *display,
+                                         GError         **error)
+{
+  return cogl_context_egl_new (display, error);
+}
+
+static ClutterStageWindow *
+meta_clutter_backend_santos_create_stage (ClutterBackend  *clutter_backend,
+                                          ClutterStage    *wrapper,
+                                          GError         **error)
+{
+  MetaClutterBackendSantos *self = META_CLUTTER_BACKEND_SANTOS (clutter_backend);
+
+  return CLUTTER_STAGE_WINDOW (meta_stage_santos_new (self->backend, wrapper));
+}
+
+static ClutterSeat *
+meta_clutter_backend_santos_get_default_seat (ClutterBackend *clutter_backend)
+{
+  MetaClutterBackendSantos *self = META_CLUTTER_BACKEND_SANTOS (clutter_backend);
+
+  return meta_backend_get_default_seat (self->backend);
+}
+
+static ClutterKeyFocus *
+meta_clutter_backend_santos_get_key_focus (ClutterBackend *clutter_backend,
+                                           ClutterStage   *stage)
+{
+  MetaClutterBackendSantos *self = META_CLUTTER_BACKEND_SANTOS (clutter_backend);
+
+  if (self->disposed)
+    return NULL;
+
+  if (!self->key_focus)
+    {
+      self->key_focus =
+        g_object_new (CLUTTER_TYPE_KEY_FOCUS,
+                      "stage", stage,
+                      NULL);
+    }
+
+  return self->key_focus;
+}
+
+static ClutterSprite *
+meta_clutter_backend_santos_create_sprite (ClutterBackend     *clutter_backend,
+                                           ClutterStage       *stage,
+                                           const ClutterEvent *for_event)
+{
+  MetaClutterBackendSantos *self =
+    META_CLUTTER_BACKEND_SANTOS (clutter_backend);
+  ClutterInputDevice *device;
+  ClutterInputDevice *sprite_device = NULL;
+  ClutterEventSequence *sequence = NULL;
+  ClutterSpriteRole role;
+
+  device = clutter_event_get_source_device (for_event);
+
+  if (clutter_event_get_event_sequence (for_event))
+    role = CLUTTER_SPRITE_ROLE_TOUCHPOINT;
+  else if (clutter_input_device_get_capabilities (device) ==
+           CLUTTER_INPUT_CAPABILITY_TABLET_TOOL)
+    role = CLUTTER_SPRITE_ROLE_TABLET;
+  else
+    role = CLUTTER_SPRITE_ROLE_POINTER;
+
+  if (role == CLUTTER_SPRITE_ROLE_TABLET)
+    sprite_device = device;
+  else if (role == CLUTTER_SPRITE_ROLE_TOUCHPOINT)
+    sequence = clutter_event_get_event_sequence (for_event);
+
+  return g_object_new (META_TYPE_SPRITE_NATIVE,
+                       "backend", self->backend,
+                       "stage", stage,
+                       "sprite-device", sprite_device,
+                       "sequence", sequence,
+                       "role", role,
+                       NULL);
+}
+
+static ClutterSprite *
+meta_clutter_backend_santos_ensure_sprite (ClutterBackend     *clutter_backend,
+                                           ClutterStage       *stage,
+                                           const ClutterEvent *for_event,
+                                           GHashTable         *sprites,
+                                           gpointer            key)
+{
+  ClutterSprite *sprite;
+
+  sprite = g_hash_table_lookup (sprites, key);
+  if (!sprite)
+    {
+      sprite = meta_clutter_backend_santos_create_sprite (clutter_backend,
+                                                          stage,
+                                                          for_event);
+      g_hash_table_insert (sprites, key, sprite);
+    }
+
+  return sprite;
+}
+
+static void
+meta_clutter_backend_santos_ensure_pointer_sprite (ClutterBackend *clutter_backend,
+                                                   ClutterStage   *stage)
+{
+  MetaClutterBackendSantos *self =
+    META_CLUTTER_BACKEND_SANTOS (clutter_backend);
+
+  if (self->pointer_sprite)
+    return;
+
+  self->pointer_sprite =
+    g_object_new (META_TYPE_SPRITE_NATIVE,
+                  "backend", self->backend,
+                  "stage", stage,
+                  "role", CLUTTER_SPRITE_ROLE_POINTER,
+                  NULL);
+}
+
+static ClutterSprite *
+meta_clutter_backend_santos_get_sprite (ClutterBackend     *clutter_backend,
+                                        ClutterStage       *stage,
+                                        const ClutterEvent *for_event)
+{
+  MetaClutterBackendSantos *self =
+    META_CLUTTER_BACKEND_SANTOS (clutter_backend);
+  ClutterInputDevice *source_device;
+  ClutterEventSequence *event_sequence;
+  ClutterInputDeviceType device_type;
+
+  if (self->disposed)
+    return NULL;
+
+  event_sequence = clutter_event_get_event_sequence (for_event);
+  if (event_sequence)
+    {
+      return meta_clutter_backend_santos_ensure_sprite (
+        clutter_backend, stage, for_event, self->touch_sprites,
+        event_sequence);
+    }
+
+  source_device = clutter_event_get_source_device (for_event);
+  device_type = clutter_input_device_get_device_type (source_device);
+
+  if (device_type == CLUTTER_TABLET_DEVICE ||
+      device_type == CLUTTER_PEN_DEVICE ||
+      device_type == CLUTTER_ERASER_DEVICE)
+    {
+      return meta_clutter_backend_santos_ensure_sprite (
+        clutter_backend, stage, for_event, self->stylus_sprites,
+        source_device);
+    }
+
+  if (device_type == CLUTTER_POINTER_DEVICE ||
+      device_type == CLUTTER_TOUCHPAD_DEVICE)
+    {
+      if (!self->pointer_sprite)
+        self->pointer_sprite =
+          meta_clutter_backend_santos_create_sprite (clutter_backend,
+                                                     stage,
+                                                     for_event);
+
+      return self->pointer_sprite;
+    }
+
+  return NULL;
+}
+
+static ClutterSprite *
+meta_clutter_backend_santos_get_pointer_sprite (ClutterBackend *clutter_backend,
+                                                ClutterStage   *stage)
+{
+  MetaClutterBackendSantos *self =
+    META_CLUTTER_BACKEND_SANTOS (clutter_backend);
+
+  if (self->disposed)
+    return NULL;
+
+  meta_clutter_backend_santos_ensure_pointer_sprite (clutter_backend, stage);
+  return self->pointer_sprite;
+}
+
+static void
+meta_clutter_backend_santos_drop_cursor_renderer (gpointer user_data)
+{
+  MetaCursorRenderer *cursor_renderer = user_data;
+
+  meta_cursor_renderer_set_sprite (cursor_renderer, NULL);
+  g_object_unref (cursor_renderer);
+}
+
+MetaCursorRenderer *
+meta_clutter_backend_santos_maybe_ensure_cursor_renderer (MetaClutterBackendSantos *self,
+                                                          ClutterSprite            *sprite)
+{
+  MetaCursorRenderer *cursor_renderer;
+
+  if (self->disposed ||
+      clutter_sprite_get_role (sprite) == CLUTTER_SPRITE_ROLE_TOUCHPOINT ||
+      !clutter_focus_get_current_actor (CLUTTER_FOCUS (sprite)))
+    return NULL;
+
+  cursor_renderer = g_hash_table_lookup (self->cursor_renderers, sprite);
+  if (!cursor_renderer)
+    {
+      cursor_renderer = meta_cursor_renderer_new (self->backend);
+      g_hash_table_insert (self->cursor_renderers, sprite, cursor_renderer);
+      meta_cursor_renderer_set_sprite (cursor_renderer, sprite);
+    }
+
+  return cursor_renderer;
+}
+
+void
+meta_clutter_backend_santos_remove_cursor_renderer (MetaClutterBackendSantos *self,
+                                                    ClutterSprite            *sprite)
+{
+  if (!self || !sprite || !self->cursor_renderers)
+    return;
+
+  g_hash_table_remove (self->cursor_renderers, sprite);
+}
+
+static void
+meta_clutter_backend_santos_destroy_sprite (ClutterBackend *clutter_backend,
+                                            ClutterSprite  *sprite)
+{
+  MetaClutterBackendSantos *self =
+    META_CLUTTER_BACKEND_SANTOS (clutter_backend);
+
+  g_object_ref (sprite);
+  meta_clutter_backend_santos_remove_cursor_renderer (self, sprite);
+  g_hash_table_remove (self->touch_sprites,
+                       clutter_sprite_get_sequence (sprite));
+  g_hash_table_remove (self->stylus_sprites,
+                       clutter_sprite_get_sprite_device (sprite));
+
+  if (self->pointer_sprite == sprite)
+    g_clear_object (&self->pointer_sprite);
+
+  g_object_unref (sprite);
+}
+
+static gboolean
+meta_clutter_backend_santos_foreach_sprite (ClutterBackend               *clutter_backend,
+                                            ClutterStage                 *stage,
+                                            ClutterStageInputForeachFunc  func,
+                                            gpointer                      user_data)
+{
+  MetaClutterBackendSantos *self =
+    META_CLUTTER_BACKEND_SANTOS (clutter_backend);
+  GHashTableIter iter;
+  ClutterSprite *sprite;
+
+  if (self->pointer_sprite &&
+      !func (stage, self->pointer_sprite, user_data))
+    return FALSE;
+
+  g_hash_table_iter_init (&iter, self->stylus_sprites);
+  while (g_hash_table_iter_next (&iter, NULL, (gpointer *) &sprite))
+    {
+      if (!func (stage, sprite, user_data))
+        return FALSE;
+    }
+
+  g_hash_table_iter_init (&iter, self->touch_sprites);
+  while (g_hash_table_iter_next (&iter, NULL, (gpointer *) &sprite))
+    {
+      if (!func (stage, sprite, user_data))
+        return FALSE;
+    }
+
+  return TRUE;
+}
+
+static gboolean
+meta_clutter_backend_santos_is_display_server (ClutterBackend *clutter_backend)
+{
+  return TRUE;
+}
+
+static ClutterCursor *
+meta_clutter_backend_santos_get_cursor (ClutterBackend    *clutter_backend,
+                                        ClutterCursorType  cursor_type)
+{
+  MetaClutterBackendSantos *self =
+    META_CLUTTER_BACKEND_SANTOS (clutter_backend);
+
+  return meta_backend_get_cursor (self->backend, cursor_type);
+}
+
+static void
+meta_clutter_backend_santos_constructed (GObject *object)
+{
+  MetaClutterBackendSantos *self = META_CLUTTER_BACKEND_SANTOS (object);
+
+  G_OBJECT_CLASS (meta_clutter_backend_santos_parent_class)->constructed (object);
+
+  self->touch_sprites =
+    g_hash_table_new_full (NULL, NULL, NULL, g_object_unref);
+  self->stylus_sprites =
+    g_hash_table_new_full (NULL, NULL, NULL, g_object_unref);
+  self->cursor_renderers =
+    g_hash_table_new_full (NULL, NULL, NULL,
+                           meta_clutter_backend_santos_drop_cursor_renderer);
+}
+
+static void
+meta_clutter_backend_santos_dispose (GObject *object)
+{
+  MetaClutterBackendSantos *self = META_CLUTTER_BACKEND_SANTOS (object);
+
+  self->disposed = TRUE;
+
+  g_clear_pointer (&self->cursor_renderers, g_hash_table_unref);
+  g_clear_object (&self->pointer_sprite);
+  g_clear_pointer (&self->touch_sprites, g_hash_table_unref);
+  g_clear_pointer (&self->stylus_sprites, g_hash_table_unref);
+  g_clear_object (&self->key_focus);
+
+  G_OBJECT_CLASS (meta_clutter_backend_santos_parent_class)->dispose (object);
+}
+
+static void
+meta_clutter_backend_santos_init (MetaClutterBackendSantos *self)
+{
+}
+
+static void
+meta_clutter_backend_santos_class_init (MetaClutterBackendSantosClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  ClutterBackendClass *clutter_backend_class = CLUTTER_BACKEND_CLASS (klass);
+
+  object_class->constructed = meta_clutter_backend_santos_constructed;
+  object_class->dispose = meta_clutter_backend_santos_dispose;
+
+  clutter_backend_class->get_renderer = meta_clutter_backend_santos_get_renderer;
+  clutter_backend_class->get_display = meta_clutter_backend_santos_get_display;
+  clutter_backend_class->get_context = meta_clutter_backend_santos_get_context;
+  clutter_backend_class->create_stage = meta_clutter_backend_santos_create_stage;
+  clutter_backend_class->get_default_seat = meta_clutter_backend_santos_get_default_seat;
+  clutter_backend_class->is_display_server = meta_clutter_backend_santos_is_display_server;
+  clutter_backend_class->get_sprite = meta_clutter_backend_santos_get_sprite;
+  clutter_backend_class->get_pointer_sprite = meta_clutter_backend_santos_get_pointer_sprite;
+  clutter_backend_class->destroy_sprite = meta_clutter_backend_santos_destroy_sprite;
+  clutter_backend_class->get_key_focus = meta_clutter_backend_santos_get_key_focus;
+  clutter_backend_class->get_cursor = meta_clutter_backend_santos_get_cursor;
+  clutter_backend_class->foreach_sprite = meta_clutter_backend_santos_foreach_sprite;
+}
+
+ClutterBackend *
+meta_clutter_backend_santos_new (MetaBackend    *backend,
+                                 ClutterContext *context)
+{
+  MetaClutterBackendSantos *self;
+
+  self = g_object_new (META_TYPE_CLUTTER_BACKEND_SANTOS,
+                       "context", context,
+                       NULL);
+  self->backend = backend;
+
+  return CLUTTER_BACKEND (self);
+}
