diff --git a/src/backends/santos/meta-renderer-santos.c b/src/backends/santos/meta-renderer-santos.c
new file mode 100644
index 0000000000000000000000000000000000000000..b4164288b2bed9fc6b5b641e95dbb738cff24050
--- /dev/null
+++ b/src/backends/santos/meta-renderer-santos.c
@@ -0,0 +1,165 @@
+/*
+ * Copyright (C) 2026 Santos Project
+ *
+ * Minimal Mutter Santos Renderer implementation.
+ */
+
+#include "config.h"
+
+#include "backends/santos/meta-renderer-santos.h"
+#include "backends/santos/meta-onscreen-santos.h"
+#include "backends/santos/meta-frame-clock-driver-santos.h"
+#include "backends/meta-backend-private.h"
+#include "backends/meta-renderer-view.h"
+
+#include <EGL/egl.h>
+#include "cogl/cogl-context-private.h"
+#include "cogl/cogl-display-egl-private.h"
+#include "cogl/cogl-renderer-egl.h"
+
+struct _MetaRendererSantos
+{
+  MetaRenderer parent;
+
+  santos_hwc_t *hwc;
+  MetaSantosFrameClockDriver *driver;
+};
+
+G_DEFINE_FINAL_TYPE (MetaRendererSantos, meta_renderer_santos, META_TYPE_RENDERER)
+
+santos_hwc_t *
+meta_renderer_santos_get_hwc (MetaRendererSantos *renderer_santos)
+{
+  return renderer_santos->hwc;
+}
+
+static CoglRenderer *
+meta_renderer_santos_create_cogl_renderer (MetaRenderer *renderer)
+{
+  CoglRendererEGL *renderer_egl;
+  EGLDisplay edpy;
+
+  renderer_egl = cogl_renderer_egl_new ();
+
+  edpy = eglGetDisplay (EGL_DEFAULT_DISPLAY);
+  if (edpy == EGL_NO_DISPLAY)
+    g_error ("eglGetDisplay failed for Santos HWC");
+
+  cogl_renderer_egl_set_edisplay (renderer_egl, edpy);
+
+  return COGL_RENDERER (renderer_egl);
+}
+
+static MetaRendererView *
+meta_renderer_santos_create_view (MetaRenderer        *renderer,
+                                  MetaLogicalMonitor  *logical_monitor,
+                                  MetaMonitor         *monitor,
+                                  MetaOutput          *output,
+                                  MetaCrtc            *crtc,
+                                  GError             **error)
+{
+  MetaRendererSantos *self = META_RENDERER_SANTOS (renderer);
+  MetaBackend *backend = meta_renderer_get_backend (renderer);
+  ClutterBackend *clutter_backend = meta_backend_get_clutter_backend (backend);
+  CoglContext *cogl_context = clutter_backend_get_cogl_context (clutter_backend);
+  CoglDisplay *cogl_display = cogl_context_get_display (cogl_context);
+  CoglDisplayEGL *cogl_display_egl = COGL_DISPLAY_EGL (cogl_display);
+  MetaOnscreenSantos *onscreen;
+  MetaRendererView *view;
+  MtkRectangle view_layout;
+  EGLSurface egl_surface;
+
+  view_layout = (MtkRectangle) {
+    .x = 0,
+    .y = 0,
+    .width = 1280,
+    .height = 800,
+  };
+
+  onscreen = meta_onscreen_santos_new (self, cogl_context, 1280, 800);
+
+  view = g_object_new (META_TYPE_RENDERER_VIEW,
+                       "name", meta_output_get_name (output),
+                       "backend", backend,
+                       "stage", meta_backend_get_stage (backend),
+                       "layout", &view_layout,
+                       "crtc", crtc,
+                       "scale", 1.0f,
+                       "framebuffer", COGL_FRAMEBUFFER (onscreen),
+                       "use-shadowfb", FALSE,
+                       "transform", MTK_MONITOR_TRANSFORM_NORMAL,
+                       "refresh-rate", 60.0f,
+                       NULL);
+
+  egl_surface = cogl_onscreen_egl_get_egl_surface (COGL_ONSCREEN_EGL (onscreen));
+  cogl_display_egl_make_current (cogl_display_egl,
+                                 egl_surface,
+                                 egl_surface,
+                                 cogl_display_egl_get_egl_context (cogl_display_egl));
+
+  ClutterStageView *stage_view = CLUTTER_STAGE_VIEW (view);
+  ClutterFrameClock *frame_clock = clutter_stage_view_get_frame_clock (stage_view);
+
+  if (self->driver)
+    {
+      meta_santos_frame_clock_driver_detach (self->driver);
+      g_clear_object (&self->driver);
+    }
+
+  self->driver = meta_santos_frame_clock_driver_new (frame_clock, self->hwc);
+  clutter_frame_clock_set_passive (frame_clock,
+                                   CLUTTER_FRAME_CLOCK_DRIVER (self->driver));
+  clutter_frame_clock_schedule_update (frame_clock);
+
+  g_object_unref (onscreen);
+  return view;
+}
+
+static void
+meta_renderer_santos_dispose (GObject *object)
+{
+  MetaRendererSantos *self = META_RENDERER_SANTOS (object);
+
+  if (self->driver)
+    {
+      meta_santos_frame_clock_driver_detach (self->driver);
+      g_clear_object (&self->driver);
+    }
+
+  if (self->hwc)
+    {
+      santos_hwc_destroy (self->hwc);
+      self->hwc = NULL;
+    }
+
+  G_OBJECT_CLASS (meta_renderer_santos_parent_class)->dispose (object);
+}
+
+static void
+meta_renderer_santos_init (MetaRendererSantos *self)
+{
+  self->hwc = santos_hwc_create (FALSE);
+  if (!self->hwc)
+    g_error ("Failed to open Santos HWC display device");
+}
+
+static void
+meta_renderer_santos_class_init (MetaRendererSantosClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  MetaRendererClass *renderer_class = META_RENDERER_CLASS (klass);
+
+  object_class->dispose = meta_renderer_santos_dispose;
+
+  renderer_class->create_cogl_renderer = meta_renderer_santos_create_cogl_renderer;
+  renderer_class->create_view = meta_renderer_santos_create_view;
+}
+
+MetaRendererSantos *
+meta_renderer_santos_new (MetaBackend  *backend,
+                          GError      **error)
+{
+  return g_object_new (META_TYPE_RENDERER_SANTOS,
+                       "backend", backend,
+                       NULL);
+}
