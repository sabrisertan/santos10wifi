+{
+  MetaMonitorManager parent;
+};
+
+static void
+initable_iface_init (GInitableIface *initable_iface);
+
+G_DEFINE_FINAL_TYPE_WITH_CODE (MetaMonitorManagerSantos, meta_monitor_manager_santos,
+                               META_TYPE_MONITOR_MANAGER,
+                               G_IMPLEMENT_INTERFACE (G_TYPE_INITABLE,
+                                                      initable_iface_init))
+
+static gboolean
+meta_monitor_manager_santos_initable_init (GInitable     *initable,
+                                           GCancellable  *cancellable,
+                                           GError       **error)
+{
+  return TRUE;
+}
+
+static void
+initable_iface_init (GInitableIface *initable_iface)
+{
+  initable_iface->init = meta_monitor_manager_santos_initable_init;
+}
+
+static void
+meta_monitor_manager_santos_ensure_initial_config (MetaMonitorManager *manager)
+{
+  MetaMonitorsConfig *config;
+
+  config = meta_monitor_manager_ensure_configured (manager);
+  meta_monitor_manager_update_logical_state (manager, config, NULL);
+}
+
+static void
+meta_monitor_manager_santos_apply_crtc_assignments (MetaMonitorManager *manager,
+                                                    GPtrArray           *crtc_assignments,
+                                                    GPtrArray           *output_assignments)
+{
+  MetaBackend *backend = meta_monitor_manager_get_backend (manager);
+  GList *to_configure_outputs = NULL;
+  GList *to_configure_crtcs = NULL;
+  GList *l;
+
+  /* A new configuration may omit an object that was assigned previously.
+   * Keep the complete GPU inventory so those stale assignments are cleared. */
+  for (l = meta_backend_get_gpus (backend); l; l = l->next)
+    {
+      MetaGpu *gpu = l->data;
+
+      to_configure_outputs =
+        g_list_concat (to_configure_outputs,
+                       g_list_copy (meta_gpu_get_outputs (gpu)));
+      to_configure_crtcs =
+        g_list_concat (to_configure_crtcs,
+                       g_list_copy (meta_gpu_get_crtcs (gpu)));
+    }
+
+  if (crtc_assignments)
+    {
+      for (unsigned int i = 0; i < crtc_assignments->len; i++)
+        {
+          MetaCrtcAssignment *crtc_assignment =
+            g_ptr_array_index (crtc_assignments, i);
+          MetaCrtc *crtc = crtc_assignment->crtc;
+
+          to_configure_crtcs = g_list_remove (to_configure_crtcs, crtc);
+
+          if (!crtc_assignment->mode)
+            {
+              meta_crtc_unset_config (crtc);
+            }
+          else
+            {
+              MetaCrtcConfig *crtc_config;
+
+              crtc_config = meta_crtc_config_new (&crtc_assignment->layout,
+                                                  crtc_assignment->mode,
+                                                  crtc_assignment->transform);
+              meta_crtc_set_config (crtc, crtc_config,
+                                    crtc_assignment->backend_private);
+
+              for (unsigned int j = 0;
+                   j < crtc_assignment->outputs->len;
+                   j++)
+                {
+                  MetaOutput *output =
+                    g_ptr_array_index (crtc_assignment->outputs, j);
+                  MetaOutputAssignment *output_assignment;
+
+                  to_configure_outputs =
+                    g_list_remove (to_configure_outputs, output);
+                  output_assignment = meta_find_output_assignment (
+                    output_assignments ?
+                      (MetaOutputAssignment **) output_assignments->pdata : NULL,
+                    output_assignments ? output_assignments->len : 0,
+                    output);
+                  meta_output_assign_crtc (output, crtc, output_assignment);
+                }
+            }
+        }
+    }
+
+  g_list_foreach (to_configure_crtcs,
+                  (GFunc) meta_crtc_unset_config,
+                  NULL);
+  g_list_foreach (to_configure_outputs,
+                  (GFunc) meta_output_unassign_crtc,
+                  NULL);
+  g_list_free (to_configure_crtcs);
+  g_list_free (to_configure_outputs);
+}
+
+static gboolean
+meta_monitor_manager_santos_apply_monitors_config (MetaMonitorManager        *manager,
+                                                   MetaMonitorsConfig        *config,
+                                                   MetaMonitorsConfigMethod   method,
+                                                   GError                   **error)
+{
+  GPtrArray *crtc_assignments;
+  GPtrArray *output_assignments;
+
+  if (!config)
+    {
+      meta_monitor_manager_santos_apply_crtc_assignments (manager, NULL, NULL);
+      manager->screen_width = 1280;
+      manager->screen_height = 800;
+      meta_monitor_manager_rebuild (manager, NULL);
+      return TRUE;
+    }
+
+  if (!meta_monitor_config_manager_assign (manager, config,
+                                           &crtc_assignments,
+                                           &output_assignments,
+                                           error))
+    return FALSE;
+
+  if (method == META_MONITORS_CONFIG_METHOD_VERIFY)
+    {
+      g_ptr_array_free (crtc_assignments, TRUE);
+      g_ptr_array_free (output_assignments, TRUE);
+      return TRUE;
+    }
+
+  meta_monitor_manager_santos_apply_crtc_assignments (manager,
+                                                       crtc_assignments,
+                                                       output_assignments);
+
+  g_ptr_array_free (crtc_assignments, TRUE);
+  g_ptr_array_free (output_assignments, TRUE);
+
+  manager->screen_width = 1280;
+  manager->screen_height = 800;
+  meta_monitor_manager_rebuild (manager, config);
+
+  return TRUE;
+}
+
+static float
+meta_monitor_manager_santos_calculate_monitor_mode_scale (MetaMonitorManager           *manager,
+                                                          MetaLogicalMonitorLayoutMode  layout_mode,
+                                                          MetaMonitor                  *monitor,
+                                                          MetaMonitorMode              *monitor_mode)
+{
+  return 1.0f;
+}
+
+static float *
+meta_monitor_manager_santos_calculate_supported_scales (MetaMonitorManager           *manager,
+                                                        MetaLogicalMonitorLayoutMode  layout_mode,
+                                                        MetaMonitor                  *monitor,
+                                                        MetaMonitorMode              *monitor_mode,
+                                                        int                          *n_supported_scales)
+{
+  float *scales;
+
+  scales = g_new0 (float, 1);
+  scales[0] = 1.0f;
+  *n_supported_scales = 1;
+
+  return scales;
+}
+
+static MetaMonitorManagerCapability
+meta_monitor_manager_santos_get_capabilities (MetaMonitorManager *manager)
+{
+  return META_MONITOR_MANAGER_CAPABILITY_NONE;
+}
+
+static gboolean
+meta_monitor_manager_santos_get_max_screen_size (MetaMonitorManager *manager,
+                                                 int                *max_width,
+                                                 int                *max_height)
+{
+  if (max_width)
+    *max_width = 1280;
+  if (max_height)
+    *max_height = 800;
+
+  return TRUE;
+}
+
+static MetaLogicalMonitorLayoutMode
+meta_monitor_manager_santos_get_default_layout_mode (MetaMonitorManager *manager)
+{
+  return META_LOGICAL_MONITOR_LAYOUT_MODE_LOGICAL;
+}
+
+static void
+meta_monitor_manager_santos_init (MetaMonitorManagerSantos *manager_santos)
+{
+}
+
+static void
+meta_monitor_manager_santos_class_init (MetaMonitorManagerSantosClass *klass)
+{
+  MetaMonitorManagerClass *manager_class = META_MONITOR_MANAGER_CLASS (klass);
+
+  manager_class->ensure_initial_config = meta_monitor_manager_santos_ensure_initial_config;
+  manager_class->apply_monitors_config = meta_monitor_manager_santos_apply_monitors_config;
+  manager_class->calculate_monitor_mode_scale = meta_monitor_manager_santos_calculate_monitor_mode_scale;
+  manager_class->calculate_supported_scales = meta_monitor_manager_santos_calculate_supported_scales;
+  manager_class->get_capabilities = meta_monitor_manager_santos_get_capabilities;
+  manager_class->get_max_screen_size = meta_monitor_manager_santos_get_max_screen_size;
+  manager_class->get_default_layout_mode = meta_monitor_manager_santos_get_default_layout_mode;
+}
+
+MetaMonitorManagerSantos *
+meta_monitor_manager_santos_new (MetaBackend  *backend,
+                                 GError      **error)
+{
+  return g_initable_new (META_TYPE_MONITOR_MANAGER_SANTOS,
+                         NULL, error,
+                         "backend", backend,
+                         NULL);
+}
