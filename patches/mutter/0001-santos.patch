diff --git a/src/backends/santos/meta-frame-clock-driver-santos.c b/src/backends/santos/meta-frame-clock-driver-santos.c
new file mode 100644
index 0000000000000000000000000000000000000000..e7e5251ece5a3a34477c9233dcb7984a1b12eece
--- /dev/null
+++ b/src/backends/santos/meta-frame-clock-driver-santos.c
@@ -0,0 +1,544 @@
+/*
+ * Copyright (C) 2026 Santos Project
+ *
+ * Santos Hardware VSYNC Frame Clock Driver for Mutter / Clutter.
+ *
+ * Connects the Santos PSB VSYNC provider (WAIT on Pipe-A hardware frame
+ * counter advance, ~59.94 Hz) to Clutter's passive frame clock scheduling
+ * boundary via the HWC vsync callback and an eventfd main-thread bridge.
+ * The eventfd is only a wakeup token; request-generation state is authoritative
+ * for deciding which hardware observation may dispatch.
+ */
+
+#include "config.h"
+
+#include "backends/santos/meta-frame-clock-driver-santos.h"
+
+#include <sys/eventfd.h>
+#include <unistd.h>
+#include <glib.h>
+
+struct _MetaSantosFrameClockDriver
+{
+  ClutterFrameClockDriver parent;
+
+  ClutterFrameClock *frame_clock;
+  santos_hwc_t *hwc;
+
+  int event_fd;
+  GSource *event_source;
+
+  GMutex state_lock;
+  GCond state_idle;
+  gboolean detaching;
+  gboolean detached;
+
+  guint fallback_timeout_id;
+  guint64 fallback_generation;
+
+  guint64 request_generation;
+  gboolean update_requested;
+  gboolean hardware_event_pending;
+  gboolean hardware_event_queued;
+  guint64 hardware_event_generation;
+  int64_t hardware_event_timestamp_ns;
+  int64_t last_vsync_ns;
+
+  guint64 hardware_dispatch_count;
+  guint64 fallback_dispatch_count;
+  gboolean proof_enabled;
+  guint proof_dispatch_limit;
+};
+
+G_DEFINE_FINAL_TYPE (MetaSantosFrameClockDriver,
+                     meta_santos_frame_clock_driver,
+                     CLUTTER_TYPE_FRAME_CLOCK_DRIVER)
+
+typedef struct _SantosVsyncSource
+{
+  GSource source;
+  MetaSantosFrameClockDriver *driver;
+  gpointer fd_tag;
+} SantosVsyncSource;
+
+static void
+drain_event_fd_locked (MetaSantosFrameClockDriver *driver);
+
+static void
+meta_santos_frame_clock_driver_dispatch (MetaSantosFrameClockDriver *driver,
+                                         int64_t                    time_us,
+                                         int64_t                    hardware_timestamp_ns,
+                                         gboolean                   hardware,
+                                         guint64                    generation);
+
+static gboolean
+santos_vsync_source_prepare (GSource *source,
+                             int     *timeout)
+{
+  *timeout = -1;
+  return FALSE;
+}
+
+static gboolean
+santos_vsync_source_check (GSource *source)
+{
+  SantosVsyncSource *vsource = (SantosVsyncSource *) source;
+  GIOCondition revents;
+
+  revents = g_source_query_unix_fd (source, vsource->fd_tag);
+  return (revents & G_IO_IN) != 0;
+}
+
+static gboolean
+santos_vsync_source_dispatch (GSource     *source,
+                              GSourceFunc  callback,
+                              gpointer     user_data)
+{
+  SantosVsyncSource *vsource = (SantosVsyncSource *) source;
+  MetaSantosFrameClockDriver *driver = vsource->driver;
+  guint fallback_id = 0;
+  int64_t hardware_timestamp_ns = 0;
+  guint64 hardware_generation = 0;
+  gboolean dispatch_hardware = FALSE;
+  gboolean was_detached;
+  uint64_t val = 0;
+  ssize_t ret;
+
+  (void) callback;
+  (void) user_data;
+
+  g_mutex_lock (&driver->state_lock);
+
+  /* Drain all notifications.  There is at most one queued token per request,
+   * but draining also disposes of a token left by a completed old request. */
+  if (!driver->detached && driver->event_fd >= 0)
+    {
+      do
+        ret = read (driver->event_fd, &val, sizeof (val));
+      while (ret == (ssize_t) sizeof (val));
+      driver->hardware_event_queued = FALSE;
+    }
+
+  if (!driver->detached && driver->update_requested &&
+      driver->hardware_event_pending &&
+      driver->hardware_event_generation == driver->request_generation)
+    {
+      dispatch_hardware = TRUE;
+      hardware_timestamp_ns = driver->hardware_event_timestamp_ns;
+      hardware_generation = driver->hardware_event_generation;
+      driver->hardware_event_pending = FALSE;
+      driver->update_requested = FALSE;
+      fallback_id = driver->fallback_timeout_id;
+      driver->fallback_timeout_id = 0;
+    }
+
+  was_detached = driver->detached;
+  g_mutex_unlock (&driver->state_lock);
+
+  if (fallback_id != 0)
+    g_source_remove (fallback_id);
+
+  if (dispatch_hardware)
+    {
+      int64_t hardware_timestamp_us = hardware_timestamp_ns / 1000;
+
+      /* The timestamp is a CLOCK_MONOTONIC software observation of the
+       * hardware counter transition, not hardware-captured presentation time. */
+      meta_santos_frame_clock_driver_dispatch (driver,
+                                               hardware_timestamp_us,
+                                               hardware_timestamp_ns,
+                                               TRUE,
+                                               hardware_generation);
+    }
+
+  return was_detached ? G_SOURCE_REMOVE : G_SOURCE_CONTINUE;
+}
+
+static void
+santos_vsync_source_finalize (GSource *source)
+{
+}
+
+static GSourceFuncs santos_vsync_source_funcs = {
+  santos_vsync_source_prepare,
+  santos_vsync_source_check,
+  santos_vsync_source_dispatch,
+  santos_vsync_source_finalize,
+};
+
+static gboolean
+santos_frame_clock_driver_fallback_timeout (gpointer user_data)
+{
+  MetaSantosFrameClockDriver *driver = user_data;
+
+  guint64 generation = 0;
+  int64_t hardware_timestamp_ns = 0;
+  gboolean dispatch_hardware = FALSE;
+  gboolean dispatch_fallback = FALSE;
+
+  g_mutex_lock (&driver->state_lock);
+
+  if (driver->detached || !driver->update_requested ||
+      driver->fallback_generation != driver->request_generation)
+    {
+      driver->fallback_timeout_id = 0;
+      g_mutex_unlock (&driver->state_lock);
+      return G_SOURCE_REMOVE;
+    }
+
+  driver->fallback_timeout_id = 0;
+  generation = driver->request_generation;
+
+  /* A hardware tick may already be pending even though this timer was
+   * dispatched first after a delayed main-loop turn.  It wins over fallback. */
+  if (driver->hardware_event_pending &&
+      driver->hardware_event_generation == generation)
+    {
+      dispatch_hardware = TRUE;
+      hardware_timestamp_ns = driver->hardware_event_timestamp_ns;
+      driver->hardware_event_pending = FALSE;
+      driver->update_requested = FALSE;
+      driver->hardware_event_queued = FALSE;
+      drain_event_fd_locked (driver);
+    }
+  else
+    {
+      dispatch_fallback = TRUE;
+      driver->update_requested = FALSE;
+      driver->hardware_event_pending = FALSE;
+      driver->hardware_event_queued = FALSE;
+      drain_event_fd_locked (driver);
+    }
+
+  g_mutex_unlock (&driver->state_lock);
+
+  if (dispatch_hardware)
+    {
+      /* This is still a hardware-backed dispatch; the timer only won main
+       * context ordering, not the source of the timestamp. */
+      meta_santos_frame_clock_driver_dispatch (driver,
+                                               hardware_timestamp_ns / 1000,
+                                               hardware_timestamp_ns,
+                                               TRUE,
+                                               generation);
+    }
+  else if (dispatch_fallback)
+    {
+      int64_t now_us = g_get_monotonic_time ();
+      g_warning_once ("[SANTOS_VSYNC] Hardware VSYNC timeout (>50ms); falling back to software dispatch");
+      meta_santos_frame_clock_driver_dispatch (driver,
+                                               now_us,
+                                               0,
+                                               FALSE,
+                                               generation);
+    }
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+meta_santos_frame_clock_driver_schedule_update (ClutterFrameClockDriver *clock_driver)
+{
+  MetaSantosFrameClockDriver *driver =
+    META_SANTOS_FRAME_CLOCK_DRIVER (clock_driver);
+
+  g_mutex_lock (&driver->state_lock);
+
+  if (driver->detached || driver->update_requested)
+    {
+      g_mutex_unlock (&driver->state_lock);
+      return;
+    }
+
+  driver->request_generation++;
+  if (driver->request_generation == 0)
+    driver->request_generation = 1;
+
+  /* A true fallback may leave an eventfd token for the already-completed
+   * request.  Remove it before exposing the new generation. */
+  drain_event_fd_locked (driver);
+  driver->hardware_event_pending = FALSE;
+  driver->hardware_event_queued = FALSE;
+  driver->hardware_event_generation = 0;
+  driver->hardware_event_timestamp_ns = 0;
+  driver->update_requested = TRUE;
+  driver->fallback_generation = driver->request_generation;
+
+  if (driver->fallback_timeout_id == 0)
+    {
+      driver->fallback_timeout_id =
+        g_timeout_add_full (CLUTTER_PRIORITY_REDRAW, 50,
+                            santos_frame_clock_driver_fallback_timeout,
+                            driver, NULL);
+    }
+
+  g_mutex_unlock (&driver->state_lock);
+}
+
+static void
+on_hwc_vsync (int64_t timestamp_ns, void *user_data)
+{
+  MetaSantosFrameClockDriver *driver = user_data;
+  uint64_t val = 1;
+
+  if (!driver)
+    return;
+
+  g_mutex_lock (&driver->state_lock);
+
+  if (driver->detached)
+    {
+      g_mutex_unlock (&driver->state_lock);
+      return;
+    }
+
+  driver->last_vsync_ns = timestamp_ns;
+
+  if (!driver->update_requested)
+    {
+      /* Idle gating suppresses main-loop wakeups, not the HWC provider's
+       * hardware-counter observation or its small callback bookkeeping cost. */
+      g_mutex_unlock (&driver->state_lock);
+      return;
+    }
+
+  if (!driver->hardware_event_pending)
+    {
+      driver->hardware_event_pending = TRUE;
+      driver->hardware_event_generation = driver->request_generation;
+    }
+  driver->hardware_event_timestamp_ns = timestamp_ns;
+
+  /* Keep the notification and the generation state under one lock.  The
+   * eventfd token is only a wakeup; the pending generation below is authoritative. */
+  if (!driver->hardware_event_queued && driver->event_fd >= 0)
+    {
+      ssize_t ret = write (driver->event_fd, &val, sizeof (val));
+      if (ret == (ssize_t) sizeof (val))
+        driver->hardware_event_queued = TRUE;
+    }
+
+  g_mutex_unlock (&driver->state_lock);
+}
+
+static void
+drain_event_fd_locked (MetaSantosFrameClockDriver *driver)
+{
+  uint64_t val;
+
+  if (driver->event_fd < 0)
+    return;
+
+  while (read (driver->event_fd, &val, sizeof (val)) == (ssize_t) sizeof (val))
+    ;
+}
+
+static void
+meta_santos_frame_clock_driver_dispatch (MetaSantosFrameClockDriver *driver,
+                                         int64_t                    time_us,
+                                         int64_t                    hardware_timestamp_ns,
+                                         gboolean                   hardware,
+                                         guint64                    generation)
+{
+  ClutterFrameClock *frame_clock;
+  guint64 dispatch_number = 0;
+  gboolean proof_log = FALSE;
+
+  g_mutex_lock (&driver->state_lock);
+  if (driver->detached || !driver->frame_clock)
+    {
+      g_mutex_unlock (&driver->state_lock);
+      return;
+    }
+
+  if (hardware)
+    {
+      dispatch_number = ++driver->hardware_dispatch_count;
+      proof_log = driver->proof_enabled && driver->proof_dispatch_limit > 0;
+      if (proof_log)
+        driver->proof_dispatch_limit--;
+    }
+  else
+    {
+      driver->fallback_dispatch_count++;
+    }
+
+  frame_clock = driver->frame_clock;
+  g_mutex_unlock (&driver->state_lock);
+
+  clutter_frame_clock_dispatch (frame_clock, time_us);
+
+  if (proof_log)
+    g_message ("[SANTOS_VSYNC] Mutter hardware-backed frame-clock dispatch #%"
+               G_GUINT64_FORMAT " generation=%" G_GUINT64_FORMAT
+               " timestamp_ns=%" G_GINT64_FORMAT,
+               dispatch_number, generation, hardware_timestamp_ns);
+}
+
+void
+meta_santos_frame_clock_driver_detach (MetaSantosFrameClockDriver *driver)
+{
+  santos_hwc_t *hwc;
+  GSource *event_source;
+  ClutterFrameClock *frame_clock;
+  guint fallback_id;
+  int event_fd;
+  guint64 hardware_dispatch_count;
+  guint64 fallback_dispatch_count;
+  gboolean proof_enabled;
+
+  if (!driver)
+    return;
+
+  g_mutex_lock (&driver->state_lock);
+  while (driver->detaching)
+    g_cond_wait (&driver->state_idle, &driver->state_lock);
+  if (driver->detached)
+    {
+      g_mutex_unlock (&driver->state_lock);
+      return;
+    }
+  driver->detaching = TRUE;
+  hwc = driver->hwc;
+  driver->hwc = NULL;
+  g_mutex_unlock (&driver->state_lock);
+
+  /* This is the lifetime barrier: no callback can still hold driver as its
+   * user_data once the eventfd/source/object below are released. */
+  if (hwc)
+    santos_hwc_set_vsync_callback (hwc, NULL, NULL);
+
+  g_mutex_lock (&driver->state_lock);
+  driver->detached = TRUE;
+  driver->detaching = FALSE;
+
+  fallback_id = driver->fallback_timeout_id;
+  driver->fallback_timeout_id = 0;
+  event_source = driver->event_source;
+  driver->event_source = NULL;
+  event_fd = driver->event_fd;
+  driver->event_fd = -1;
+  frame_clock = driver->frame_clock;
+  driver->frame_clock = NULL;
+  hardware_dispatch_count = driver->hardware_dispatch_count;
+  fallback_dispatch_count = driver->fallback_dispatch_count;
+  proof_enabled = driver->proof_enabled;
+  g_cond_broadcast (&driver->state_idle);
+  g_mutex_unlock (&driver->state_lock);
+
+  if (fallback_id != 0)
+    g_source_remove (fallback_id);
+
+  if (event_source)
+    {
+      g_source_destroy (event_source);
+      g_source_unref (event_source);
+    }
+
+  if (event_fd >= 0)
+    close (event_fd);
+
+  if (frame_clock)
+    {
+      g_object_remove_weak_pointer (G_OBJECT (frame_clock),
+                                    (gpointer *) &driver->frame_clock);
+    }
+
+  if (proof_enabled)
+    g_message ("[SANTOS_VSYNC] Mutter frame-clock proof summary: hardware_dispatches=%"
+               G_GUINT64_FORMAT " fallback_dispatches=%" G_GUINT64_FORMAT,
+               hardware_dispatch_count, fallback_dispatch_count);
+}
+
+static void
+meta_santos_frame_clock_driver_dispose (GObject *object)
+{
+  MetaSantosFrameClockDriver *driver =
+    META_SANTOS_FRAME_CLOCK_DRIVER (object);
+
+  meta_santos_frame_clock_driver_detach (driver);
+
+  G_OBJECT_CLASS (meta_santos_frame_clock_driver_parent_class)->dispose (object);
+}
+
+static void
+meta_santos_frame_clock_driver_finalize (GObject *object)
+{
+  MetaSantosFrameClockDriver *driver =
+    META_SANTOS_FRAME_CLOCK_DRIVER (object);
+
+  g_cond_clear (&driver->state_idle);
+  g_mutex_clear (&driver->state_lock);
+
+  G_OBJECT_CLASS (meta_santos_frame_clock_driver_parent_class)->finalize (object);
+}
+
+static void
+meta_santos_frame_clock_driver_init (MetaSantosFrameClockDriver *driver)
+{
+  driver->event_fd = -1;
+  g_mutex_init (&driver->state_lock);
+  g_cond_init (&driver->state_idle);
+}
+
+static void
+meta_santos_frame_clock_driver_class_init (MetaSantosFrameClockDriverClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  ClutterFrameClockDriverClass *driver_class =
+    CLUTTER_FRAME_CLOCK_DRIVER_CLASS (klass);
+
+  object_class->dispose = meta_santos_frame_clock_driver_dispose;
+  object_class->finalize = meta_santos_frame_clock_driver_finalize;
+  driver_class->schedule_update = meta_santos_frame_clock_driver_schedule_update;
+}
+
+MetaSantosFrameClockDriver *
+meta_santos_frame_clock_driver_new (ClutterFrameClock *frame_clock,
+                                    santos_hwc_t       *hwc)
+{
+  MetaSantosFrameClockDriver *driver;
+  SantosVsyncSource *vsource;
+  GSource *source;
+  GMainContext *main_context;
+
+  driver = g_object_new (META_TYPE_SANTOS_FRAME_CLOCK_DRIVER, NULL);
+
+  driver->hwc = hwc;
+  driver->frame_clock = frame_clock;
+  g_object_add_weak_pointer (G_OBJECT (frame_clock),
+                             (gpointer *) &driver->frame_clock);
+
+  driver->event_fd = eventfd (0, EFD_CLOEXEC | EFD_NONBLOCK);
+  if (driver->event_fd < 0)
+    g_error ("Failed to create eventfd for Santos VSYNC driver: %m");
+
+  source = g_source_new (&santos_vsync_source_funcs, sizeof (SantosVsyncSource));
+  vsource = (SantosVsyncSource *) source;
+  vsource->driver = driver;
+  vsource->fd_tag = g_source_add_unix_fd (source, driver->event_fd, G_IO_IN);
+
+  g_source_set_name (source, "[mutter] Santos VSYNC driver source");
+  g_source_set_priority (source, CLUTTER_PRIORITY_REDRAW);
+  g_source_set_can_recurse (source, FALSE);
+
+  main_context = g_main_context_ref_thread_default ();
+  g_source_attach (source, main_context);
+  g_main_context_unref (main_context);
+
+  driver->event_source = source;
+
+  {
+    const char *proof_env = g_getenv ("SANTOS_VSYNC_PROOF_DISPATCHES");
+    if (proof_env && *proof_env)
+      {
+        guint64 requested = g_ascii_strtoull (proof_env, NULL, 10);
+        driver->proof_dispatch_limit = (guint) MIN (requested, (guint64) G_MAXUINT);
+        driver->proof_enabled = driver->proof_dispatch_limit > 0;
+      }
+  }
+
+  santos_hwc_set_vsync_callback (hwc, on_hwc_vsync, driver);
+
+  return driver;
+}
