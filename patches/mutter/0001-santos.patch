@@ -0,0 +1,20 @@
+/*
+ * Copyright (C) 2026 Santos Project
+ *
+ * Minimal Mutter Santos Renderer implementation.
+ */
+
+#pragma once
+
+#include "backends/meta-renderer.h"
+#include "backends/santos/santos_hwc.h"
+
+#define META_TYPE_RENDERER_SANTOS (meta_renderer_santos_get_type ())
+G_DECLARE_FINAL_TYPE (MetaRendererSantos, meta_renderer_santos,
+                      META, RENDERER_SANTOS,
+                      MetaRenderer)
+
+MetaRendererSantos * meta_renderer_santos_new (MetaBackend  *backend,
+                                               GError      **error);
+
+santos_hwc_t * meta_renderer_santos_get_hwc (MetaRendererSantos *renderer_santos);
diff --git a/src/backends/santos/meta-stage-santos.c b/src/backends/santos/meta-stage-santos.c
new file mode 100644
index 0000000000000000000000000000000000000000..a502e806cb4502c3ea406a3aa389a61f1eaaed46
--- /dev/null
+++ b/src/backends/santos/meta-stage-santos.c
@@ -0,0 +1,110 @@
+/*
+ * Copyright (C) 2026 Santos Project
+ *
+ * Minimal Mutter Santos Stage implementation.
+ */
+
+#include "config.h"
+
+#include "backends/santos/meta-stage-santos.h"
+#include "backends/meta-backend-private.h"
+#include "backends/meta-renderer.h"
+
+struct _MetaStageSantos
+{
+  MetaStageImpl parent;
+};
+
+G_DEFINE_FINAL_TYPE (MetaStageSantos, meta_stage_santos, META_TYPE_STAGE_IMPL)
+
+static gboolean
+meta_stage_santos_can_clip_redraws (ClutterStageWindow *stage_window)
+{
+  return TRUE;
+}
+
+static void
+meta_stage_santos_get_geometry (ClutterStageWindow *stage_window,
+                                MtkRectangle       *geometry)
+{
+  MetaStageImpl *stage_impl = META_STAGE_IMPL (stage_window);
+  MetaBackend *backend = meta_stage_impl_get_backend (stage_impl);
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+
+  if (monitor_manager)
+    {
+      int width, height;
+
+      meta_monitor_manager_get_screen_size (monitor_manager, &width, &height);
+      *geometry = (MtkRectangle) {
+        .width = width,
+        .height = height,
+      };
+    }
+  else
+    {
+      *geometry = (MtkRectangle) {
+        .width = 1280,
+        .height = 800,
+      };
+    }
+}
+
+static GList *
+meta_stage_santos_get_views (ClutterStageWindow *stage_window)
+{
+  MetaStageImpl *stage_impl = META_STAGE_IMPL (stage_window);
+  MetaBackend *backend = meta_stage_impl_get_backend (stage_impl);
+  MetaRenderer *renderer = meta_backend_get_renderer (backend);
+
+  return meta_renderer_get_views (renderer);
+}
+
+static void
+meta_stage_santos_redraw_view (ClutterStageWindow *stage_window,
+                               ClutterStageView   *view,
+                               ClutterFrame       *frame)
+{
+  CLUTTER_STAGE_WINDOW_CLASS (meta_stage_santos_parent_class)->
+      redraw_view (stage_window, view, frame);
+
+  if (!clutter_frame_has_result (frame))
+    clutter_frame_set_result (frame, CLUTTER_FRAME_RESULT_PENDING_PRESENTED);
+}
+
+static void
+meta_stage_santos_finish_frame (ClutterStageWindow *stage_window,
+                                ClutterStageView   *stage_view,
+                                ClutterFrame       *frame)
+{
+  if (!clutter_frame_has_result (frame))
+    clutter_frame_set_result (frame, CLUTTER_FRAME_RESULT_IDLE);
+}
+
+static void
+meta_stage_santos_init (MetaStageSantos *self)
+{
+}
+
+static void
+meta_stage_santos_class_init (MetaStageSantosClass *klass)
+{
+  ClutterStageWindowClass *window_class = CLUTTER_STAGE_WINDOW_CLASS (klass);
+
+  window_class->can_clip_redraws = meta_stage_santos_can_clip_redraws;
+  window_class->get_geometry = meta_stage_santos_get_geometry;
+  window_class->get_views = meta_stage_santos_get_views;
+  window_class->redraw_view = meta_stage_santos_redraw_view;
+  window_class->finish_frame = meta_stage_santos_finish_frame;
+}
+
+MetaStageSantos *
+meta_stage_santos_new (MetaBackend  *backend,
+                       ClutterStage *wrapper)
+{
+  return g_object_new (META_TYPE_STAGE_SANTOS,
+                       "backend", backend,
+                       "wrapper", wrapper,
+                       NULL);
+}
