+ *
+ * Minimal Mutter Santos GPU implementation.
+ */
+
+#include "config.h"
+
+#include "backends/santos/meta-gpu-santos.h"
+#include "backends/santos/meta-crtc-santos.h"
+#include "backends/santos/meta-output-santos.h"
