+/* Shared native-client profile. This runs after compositor environment
+ * sanitization; it never changes Shell's own HWC environment. D-Bus activation
+ * consumes the same file via santos-client-environment at session startup.
+ */
+static void
+santos_apply_client_profile (GAppLaunchContext *context)
+{
+  static const char * const variables[] = {
+    "GDK_BACKEND", "GSK_RENDERER", "GDK_DISABLE", "LD_LIBRARY_PATH", "LD_PRELOAD",
+    "LIBEGL", "LIBGLESV2", "HYBRIS_ANDROID_SDK_VERSION", "HYBRIS_LINKER_DIR",
+    "HYBRIS_EGLPLATFORM", "HYBRIS_EGLPLATFORM_DIR", "EGL_PLATFORM",
+    "SANTOS_EGL_PLATFORM", "ANDROID_ROOT", "ANDROID_DATA", "LD_SHIM_LIBS",
+  };
+  g_autoptr (GKeyFile) profile = g_key_file_new ();
+  g_autoptr (GError) error = NULL;
+  g_autofree char *platform = NULL;
+  guint i;
+
+  if (!g_key_file_load_from_file (profile, "/etc/santos/gtk4-client.ini",
+                                  G_KEY_FILE_NONE, &error))
+    {
+      if (!g_error_matches (error, G_FILE_ERROR, G_FILE_ERROR_NOENT))
+        g_warning ("Cannot read Santos client profile: %s", error->message);
+      return;
+    }
+  if (!g_key_file_get_boolean (profile, "Profile", "Enabled", NULL))
+    return;
+
+  platform = g_key_file_get_string (profile, "Environment", "HYBRIS_EGLPLATFORM", NULL);
+  if (g_strcmp0 (platform, "wayland") != 0)
+    {
+      g_warning ("Santos client profile must select Wayland, not compositor HWC");
+      return;
+    }
+
+  for (i = 0; i < G_N_ELEMENTS (variables); i++)
+    {
+      g_autofree char *value =
+        g_key_file_get_string (profile, "Environment", variables[i], NULL);
+      if (value)
+        g_app_launch_context_setenv (context, variables[i], value);
+    }
+}
+
+static void
+santos_sanitize_app_launch_context (GAppLaunchContext *context)
+{
+  static const char * const compositor_private_vars[] = {
+    /* Compositor-private preloads and library paths */
+    "LD_PRELOAD",
+    "LD_LIBRARY_PATH",
+
+    /* Compositor vendor EGL/GLES provider selection */
+    "LIBEGL",
+    "LIBGLESV2",
+    "EGL_PLATFORM",
+    "HYBRIS_EGLPLATFORM",
+    "HYBRIS_EGLPLATFORM_DIR",
+    "HYBRIS_LINKER_DIR",
+    "HYBRIS_ANDROID_SDK_VERSION",
+    "LD_SHIM_LIBS",
+    "SANTOS_EGL_PLATFORM",
+
+    /* Compositor-only GIR / schema / data / debug variables */
+    "GI_TYPELIB_PATH",
+    "GNOME_SHELL_DATADIR",
+    "GSETTINGS_SCHEMA_DIR",
+    "ICU_DATA",
+    "COGL_DEBUG",
+    "STATE_DIR",
+    "SHELL_BIN",
+    "ANDROID_DATA",
+    "ANDROID_ROOT",
+  };
+  guint i;
+
+  for (i = 0; i < G_N_ELEMENTS (compositor_private_vars); i++)
