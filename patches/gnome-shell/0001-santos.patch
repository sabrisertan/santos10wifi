+      owner = cogl_pipeline_new (context);
+      cache = g_new0 (StBoxShadowCache, 1);
+      g_object_set_data_full (G_OBJECT (owner), "st-box-shadow-cache", cache,
+                              (GDestroyNotify) box_shadow_cache_free);
+      cogl_context_set_named_pipeline (context, &owner_key, owner);
+    }
+  return g_object_get_data (G_OBJECT (owner), "st-box-shadow-cache");
+}
