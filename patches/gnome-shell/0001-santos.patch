+          StIndexedSelector *entry;
+          CRAdditionalSel *additional;
+          GHashTable *table = NULL;
+          const char *key = NULL;
+          GPtrArray *bucket;
+
+          if (!selector->simple_sel)
+            continue;
+
+          entry = g_new0 (StIndexedSelector, 1);
+          entry->statement = statement;
+          entry->selector = selector;
+          entry->last = selector->simple_sel;
+          while (entry->last->next)
+            entry->last = entry->last->next;
+          entry->order = index->entries->len;
+          g_ptr_array_add (index->entries, entry);
+
+          for (additional = entry->last->add_sel;
+               additional; additional = additional->next)
+            {
+              CRString *name = NULL;
+
+              if (additional->type == CLASS_ADD_SELECTOR)
+                {
+                  table = index->by_class;
+                  name = additional->content.class_name;
+                }
+              else if (additional->type == ID_ADD_SELECTOR)
+                {
+                  table = index->by_id;
+                  name = additional->content.id_name;
+                }
+
+              if (name && name->stryng && name->stryng->str)
+                {
+                  key = name->stryng->str;
+                  break;
+                }
+            }
+
+          if (!key)
+            {
+              g_ptr_array_add (index->fallback, entry);
+              continue;
+            }
+
+          bucket = g_hash_table_lookup (table, key);
+          if (!bucket)
+            {
+              bucket = g_ptr_array_new ();
+              g_hash_table_insert (table, g_strdup (key), bucket);
+            }
+          g_ptr_array_add (bucket, entry);
+        }
+    }
+
+  return index;
+}
+
+static int
+compare_indexed_selectors (gconstpointer a,
+                           gconstpointer b)
+{
+  const StIndexedSelector *sa = *(StIndexedSelector * const *) a;
+  const StIndexedSelector *sb = *(StIndexedSelector * const *) b;
+
+  return (sa->order > sb->order) - (sa->order < sb->order);
+}
+
+static void
+append_selector_bucket (GPtrArray *candidates,
+                         GPtrArray *bucket)
+{
+  if (bucket)
+    g_ptr_array_extend (candidates, bucket, NULL, NULL);
+}
+
+static void
+add_matched_properties (StTheme      *theme,
+                        CRStyleSheet *sheet,
+                        StThemeNode  *node,
+                        GPtrArray    *props)
+{
+  StSelectorIndex *index;
+  g_autoptr (GPtrArray) candidates = NULL;
+  GStrv classes;
+  const char *id;
+  StIndexedSelector *previous = NULL;
+  guint i;
+#ifdef ST_THEME_INDEX_VERIFY
+  guint old_len = props->len;
+#endif
+
+  index = g_hash_table_lookup (theme->selector_indexes, sheet);
+  if (!index)
+    {
+      index = selector_index_new (sheet);
+      g_hash_table_insert (theme->selector_indexes, sheet, index);
+    }
+  if (index->has_imports)
+    {
+      add_matched_properties_linear (theme, sheet, node, props);
+      return;
+    }
+
+  candidates = g_ptr_array_new ();
+  append_selector_bucket (candidates, index->fallback);
+  classes = st_theme_node_get_element_classes (node);
+  for (i = 0; classes && classes[i]; i++)
+    append_selector_bucket (candidates,
+                             g_hash_table_lookup (index->by_class, classes[i]));
+  id = st_theme_node_get_element_id (node);
+  if (id)
+    append_selector_bucket (candidates, g_hash_table_lookup (index->by_id, id));
+  g_ptr_array_sort (candidates, compare_indexed_selectors);
+
+  for (i = 0; i < candidates->len; i++)
+    {
+      StIndexedSelector *entry = g_ptr_array_index (candidates, i);
+      gboolean matches = FALSE;
+      enum CRStatus status;
+      CRDeclaration *declaration;
+
+      /* Duplicate class tokens must not duplicate matched declarations. */
+      if (entry == previous)
+        continue;
+      previous = entry;
+      status = sel_matches_style_real (theme, entry->last, node,
+                                       &matches, FALSE, TRUE);
+      if (status != CR_OK || !matches)
+        continue;
+
+      cr_simple_sel_compute_specificity (entry->selector->simple_sel);
+      entry->statement->specificity = entry->selector->simple_sel->specificity;
+      for (declaration = entry->statement->kind.ruleset->decl_list;
+           declaration; declaration = declaration->next)
+        g_ptr_array_add (props, declaration);
+    }
+
+#ifdef ST_THEME_INDEX_VERIFY
+  {
+    g_autoptr (GPtrArray) oracle = g_ptr_array_new ();
+    g_autoptr (GArray) specificity = g_array_new (FALSE, FALSE, sizeof (gulong));
+    static guint checks, failures;
+    gboolean equal;
+
+    for (i = old_len; i < props->len; i++)
+      {
+        CRDeclaration *decl = g_ptr_array_index (props, i);
+        gulong value = decl->parent_statement->specificity;
+        g_array_append_val (specificity, value);
+      }
+    add_matched_properties_linear (theme, sheet, node, oracle);
+    equal = props->len - old_len == oracle->len;
+    for (i = 0; equal && i < oracle->len; i++)
+      {
+        CRDeclaration *decl = g_ptr_array_index (oracle, i);
+        equal = decl == g_ptr_array_index (props, old_len + i) &&
+                decl->parent_statement->specificity ==
+                g_array_index (specificity, gulong, i);
+      }
+    checks++;
+    if (!equal)
+      {
+        failures++;
+        g_warning ("L143VERIFY mismatch check=%u", checks);
+        g_ptr_array_set_size (props, old_len);
+        g_ptr_array_extend (props, oracle, NULL, NULL);
+      }
+    if (checks % 128 == 0)
+      g_message ("L143VERIFY checks=%u failures=%u", checks, failures);
+  }
+#endif
+}
+
 #define ORIGIN_OFFSET_IMPORTANT (NB_ORIGINS)
 #define ORIGIN_OFFSET_EXTENSION (NB_ORIGINS * 2)
 
